    width: 42px;
    margin-right: 15px;
}

.padlock-icon {
    height: 15px;
    width: 15px;
    fill: #43f8c0;
    transition: color .2s ease;
}

.padlock-icon:hover {
    fill: #75fad1;
    transition: color .2s ease;
}

.error-icon {
    margin-right: 10px;
}

.error-icon--aligned-top {
    margin-top: 3px;
}

/* FORM */

.main-form legend {
    font-size: 13px;
    margin-bottom: 30px;
    color: rgba(242, 242, 242, 0.9);
    line-height: 19px;
}

.field-group {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15px;
}

.field-group--no-justify {
    justify-content: unset;
}

.field-group.relative {
    position: relative;
}

.main-form label {
    font-size: 13px;
    color: rgba(242, 242, 242, .6);
}

/* INPUTS */

.basic-input {
    border: 1px solid rgba(242, 242, 242, 0.25);
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.05);
    color: #f2f2f2;
    padding-left: 15px;
    font-family: "LatoWeb", sans-serif;
    font-size: 13px;
    transition: border .2s ease;
}

.basic-input:focus {
    outline: 0 none;
    border: 1px solid #a380d1;
}

.basic-input:hover {
    border: 1px solid rgba(242, 242, 242, 0.5);
    transition: border .2s ease;
}

.basic-input:focus:hover {
    border: 1px solid #a380d1;
}

@-webkit-keyframes autofill {
    0%,100% {
        color: #f2f2f2;
        background: transparent;
    }
}

.basic-input:-webkit-autofill {
    -webkit-animation-delay: 1s;
    -webkit-animation-name: autofill;
    -webkit-animation-fill-mode: both;
}

.basic-input::-webkit-credentials-auto-fill-button {
    background-color: white;
    margin-right: 10px;
}

.basic-input.errored {
    outline: 0 none;
    border: 1px solid #f74638;
}

.basic-input.errored:focus {
    outline: 0 none;
    border: 1px solid #a380d1;
}

.login-input {
    width: 250px;
    height: 36px;
}

/* COMMONS */

.title {
    font-weight: 600;
}

.subtitle {
    font-size: 13px;
    padding-top: 5px;
    font-weight: 300;
    color: rgba(242, 242, 242, 0.9);
}

.error-message {
