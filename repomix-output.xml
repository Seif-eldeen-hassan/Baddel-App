// ── Source-level checks (always run — no build required) ──────────────────────

const APP_JS     = fs.readFileSync(path.join(ROOT, 'src', 'js', 'app.js'), 'utf8');
const PRELOAD_JS = fs.readFileSync(path.join(ROOT, 'preload.js'), 'utf8');
