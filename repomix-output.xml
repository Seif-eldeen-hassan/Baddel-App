                winJoin(drive, 'Program Files',       'Epic Games',   'Launcher', 'Portal', 'Binaries', 'Win64', 'EpicGamesLauncher.exe'),
                winJoin(drive, 'Program Files (x86)', 'Epic Games',   'Launcher', 'Portal', 'Binaries', 'Win64', 'EpicGamesLauncher.exe'),
