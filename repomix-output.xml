}

.main-form label {
    font-size: 13px;
    color: rgba(242, 242, 242, .6);
}

/* INPUTS */

.basic-input {
    border: 1px solid rgba(242, 242, 242, 0.25);
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.05);
    color: #f2f2f2;
