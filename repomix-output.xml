TO REDUCE SIZE. IF YOU HAVE ANY PROBLEMS WITH MISSING CHARS THEN INCLUDE ORIGINAL FONT FILES
*/

@font-face {
    font-family: "LatoWeb";
    font-weight: 400;
    font-style: normal;
    font-display: block;
    src: url("../fonts/LatoWeb/LatoWeb-Regular.ttf") format("truetype");
}

@font-face {
    font-family: "LatoWeb";
    font-weight: 300;
    font-style: normal;
    font-display: block;
    src: url("../fonts/LatoWeb/LatoWeb-Light.ttf") format("truetype");
}

@font-face {
    font-family: "LatoWeb";
    font-weight: 600;
    font-style: normal;
    font-display: block;
    src: url("../fonts/LatoWeb/LatoWeb-Semibold.ttf") format("truetype");
}

/* CONTAINERS */

body {
    font-family: "LatoWeb", sans-serif;
    font-size: 16px;
    color: #f2f2f2;
    background: #2c2b2e;
}

.main-content {
    padding: 30px;
    min-height: 269px;
    display: flex;
    flex-grow: 1;
}

.main-header {
    height: 74px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 30px;
    background: rgba(255, 255, 255, .03);
}

.main-header__container {
    display: flex;
    align-items: center;
}

.main-footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 76px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 21px 30px;
    border-top: 1px solid rgba(242, 242, 242, 0.05);
}

.main-footer__container--left {
    margin-right: auto;
    margin-left: 25px;
}

@media (max-height: 380px) {
    .main-footer {
        position: unset;
        bottom: unset;
        width: unset;
    }
}

.main-footer.not-sticky {
    position: unset;
    bottom: unset;
    width: unset;
}

@media (min-height: 490px) {
    .main-footer.not-sticky {
        position: absolute;
        bottom: 0;
        width: 100%;
    }
}

/* BUTTONS */

.basic-button {
    font-family: "LatoWeb", sans-serif;
}

.forgot-password {
    display: none;
}

.resend-button, .resend-button:visited, .resend-button:active {
    color: #a380d1;
}

.main-footer__button {
    width: 105px;
    height: 35px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 5px;
    color: rgba(242, 242, 242, 0.9);
    background: none;
    font-size: 14px;
    cursor: pointer;
    transition: border .2s ease;
    vertical-align: middle;
}

.main-footer__button--primary {
    background-color: rgb(163, 128, 209);
    border: 0;
    margin-left: 15px;
    font-size: 16px;
    transition: background-color .2s ease;
}

.main-footer__button--primary:hover {
    background-color: rgb(176, 146, 216);
    transition: background-color .2s ease;
}

.main-footer__button--secondary:hover {
    border: 1px solid rgba(242, 242, 242, .6);
    transition: border .2s ease;
}

.steam-help {
    white-space: nowrap;
}

.forgot-password, .forgot-password:visited, .forgot-password:active, .steam-help, .steam-help:visited, .steam-help:active {
    color: rgba(242, 242, 242, 0.4);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
