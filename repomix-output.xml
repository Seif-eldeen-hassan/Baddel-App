/* ========================================= */
/* 💎 CUSTOM TOOLTIPS FOR SHORTCUT BUTTONS   */
/* ========================================= */

/* زرار التشغيل بس هو اللي محتاج relative، لكن زرار المسح واخد absolute من قبل كده */
.asc-play-btn {
    position: relative;
}

/* تصميم البوكس الجديد */
.asc-unpin-btn::before,
.asc-play-btn::before {
    content: attr(data-tooltip); 
    position: absolute;
    right: 125%; 
    top: 50%;
    transform: translateY(-50%) scale(0.8) translateX(5px);
    background: #111;
    color: #fff;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    border: 1px solid #333;
    box-shadow: 0 4px 15px rgba(0,0,0,0.6);
    opacity: 0;
    pointer-events: none;
    white-space: nowrap;
    transition: 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: 100;
}

/* حركة الظهور لما تقف بالماوس */
.asc-unpin-btn:hover::before,
.asc-play-btn:hover::before {
    opacity: 1;
    transform: translateY(-50%) scale(1) translateX(0);
}

/* الكود ده كان موجود عندك بيظهر الزرار لما تقف على الكارت */
.account-shortcut-card:hover .asc-unpin-btn {
    opacity: 1;
    transform: scale(1);
}

/* 🔴 ضيف البلوك ده بقى: لو الماوس واقف على زرار الـ Switch، اخفي زرار الـ X تاني! */
.account-shortcut-card:has(.asc-play-btn:hover) .asc-unpin-btn {
    opacity: 0;
    transform: scale(0.8);
    pointer-events: none;
}

