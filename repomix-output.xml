            appId: card.dataset.appId,
            appName: card.dataset.appName,
            namespace: card.dataset.namespace,
            title: card.dataset.gameTitle || card.dataset.title || card.dataset.titleKey,
        };

        const cardKeys = _agGameCoverKeys(fakeGame);
