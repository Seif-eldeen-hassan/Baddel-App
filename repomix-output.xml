    font-family: var(--font-main, sans-serif);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    white-space: nowrap;
}
.ag-display-trigger:hover { border-color: rgba(255,255,255,0.18); color: #ccc; }
.ag-display-trigger.active { border-color: rgba(255,255,255,0.2); color: #fff; }

.ag-display-panel {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: 220px;
    background: #141414;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    z-index: 200;
    box-shadow: 0 16px 40px rgba(0,0,0,0.6);
    overflow: hidden;
    animation: fadeUp 0.15s ease;
}
.ag-display-panel.active { display: block; }

.adp-section {
    padding: 12px 14px 10px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}
.adp-section:last-child { border-bottom: none; }
.adp-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #444;
    margin-bottom: 10px;
}
.adp-seg {
    display: flex;
    gap: 4px;
}
.adp-seg-btn {
    flex: 1; height: 28px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 6px;
    color: #555; font-size: 0.7rem; font-weight: 600;
    font-family: var(--font-main, sans-serif);
    cursor: pointer;
    transition: background 0.13s, border-color 0.13s, color 0.13s;
}
.adp-seg-btn:hover { background: rgba(255,255,255,0.07); color: #aaa; }
.adp-seg-btn.active { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.2); color: #fff; }

.adp-fields {
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.adp-field-toggle {
    display: flex; align-items: center; gap: 9px;
    padding: 5px 4px;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.12s;
}
.adp-field-toggle:hover { background: rgba(255,255,255,0.04); }
.adp-field-toggle input[type="checkbox"] {
    appearance: none; -webkit-appearance: none;
    width: 14px; height: 14px;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 4px;
    background: rgba(255,255,255,0.03);
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
    transition: background 0.12s, border-color 0.12s;
}
.adp-field-toggle input[type="checkbox"]:checked {
    background: rgba(255,255,255,0.8);
    border-color: rgba(255,255,255,0.8);
}
.adp-field-toggle input[type="checkbox"]:checked::after {
    content: '';
    position: absolute;
    top: 1px; left: 3px;
    width: 5px; height: 8px;
    border: 2px solid #111;
    border-top: none; border-left: none;
    transform: rotate(45deg);
}
.adp-field-toggle span {
    font-size: 0.78rem;
    color: #999;
}
.adp-field-toggle:has(input:checked) span { color: #ddd; }

/* ══════════════════════════════════════════════════════════════
   GRID DENSITY MODIFIERS
══════════════════════════════════════════════════════════════ */
#allGamesGrid.density-compact { --ag-min-card-w: 120px; }
#allGamesGrid.density-normal  { --ag-min-card-w: 160px; }
#allGamesGrid.density-large   { --ag-min-card-w: 210px; }

/* ── Field visibility on cards ─────────────────────── */
#allGamesGrid.hide-title .game-card-title { display: none; }
#allGamesGrid.hide-platforms .agc-badges-strip { display: none !important; }
#allGamesGrid.show-playtime .game-card-meta-playtime,
#allGamesGrid.show-lastPlayed .game-card-meta-lastplayed,
#allGamesGrid.show-installed .game-card-meta-installed,
#allGamesGrid.show-rating .game-card-meta-rating { display: flex; }

/* Extra metadata line under title */
.game-card-meta {
    display: flex; flex-wrap: wrap; gap: 4px;
    padding: 0 0 4px;
}
.game-card-meta-item {
    display: none;
    align-items: center; gap: 3px;
    font-size: 0.65rem; color: #555; font-weight: 600;
}
.game-card-meta-item svg { opacity: 0.5; }

/* ══════════════════════════════════════════════════════════════
   LIST VIEW
══════════════════════════════════════════════════════════════ */
.ag-list-view {
    width: 100%;
    font-size: 0.82rem;
}

.ag-list-header {
    display: grid;
    grid-template-columns: 48px 1fr 140px 100px 120px 36px;
    align-items: center;
    padding: 0 8px;
    height: 30px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    margin-bottom: 4px;
}
.ag-list-header .ag-list-col {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.7px;
    text-transform: uppercase;
    color: #333;
}

.ag-list-row {
    display: grid;
    grid-template-columns: 48px 1fr 140px 100px 120px 36px;
    align-items: center;
    padding: 5px 8px;
    border-radius: 8px;
    cursor: pointer;
    gap: 0;
    position: relative;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
}
.ag-list-row:last-child { border-bottom: none; }
.ag-list-row:hover {
    background: rgba(255,255,255,0.06);
    transform: scale(1.008);
    box-shadow: 0 2px 16px rgba(0,0,0,0.35);
    z-index: 1;
    border-bottom-color: transparent;
}
.ag-list-row:hover .ag-col-title-text { color: #fff; }

.ag-list-col { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 12px; }
.ag-col-thumb { padding-right: 10px; flex-shrink: 0; }
.ag-list-thumb {
    width: 38px; height: 38px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    display: block;
    flex-shrink: 0;
}
.ag-list-thumb-placeholder {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.06);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.ag-col-title-text {
    font-size: 0.84rem;
    font-weight: 600;
    color: #ccc;
    transition: color 0.13s;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.ag-col-meta {
    font-size: 0.72rem;
    color: #444;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.ag-list-badges {
    display: flex; gap: 4px; align-items: center;
    flex-wrap: wrap;
}
.ag-list-badge-img {
    width: 13px; height: 13px;
    object-fit: contain;
    opacity: 0.6;
}
.ag-list-badge-img-invert { filter: brightness(0) invert(1); }

/* Installed icon in list view — same icon for all rows, styling differs by state */
.ag-list-installed-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
}
.ag-list-installed-icon svg {
    color: rgba(255, 255, 255, 0.1);
    transition: color 0.15s;
}
.ag-list-installed-icon.is-installed svg {
    color: rgba(80, 210, 110, 0.85);
    filter: drop-shadow(0 0 4px rgba(80, 210, 110, 0.3));
}

/* List density modifiers */
.ag-list-view.density-compact .ag-list-row { padding: 3px 8px; }
.ag-list-view.density-compact .ag-list-thumb,
.ag-list-view.density-compact .ag-list-thumb-placeholder { width: 28px; height: 28px; border-radius: 50%; }
.ag-list-view.density-compact .ag-list-header,
.ag-list-view.density-compact .ag-list-row {
    grid-template-columns: 38px 1fr 140px 100px 120px 36px;
}
.ag-list-view.density-comfortable .ag-list-row { padding: 9px 8px; }
.ag-list-view.density-comfortable .ag-list-thumb,
.ag-list-view.density-comfortable .ag-list-thumb-placeholder { width: 48px; height: 48px; border-radius: 50%; }
.ag-list-view.density-comfortable .ag-list-header,
.ag-list-view.density-comfortable .ag-list-row {
    grid-template-columns: 58px 1fr 140px 100px 120px 36px;
}

/* Play button column */
.ag-col-play {
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; width: 36px;
}
.ag-list-play-btn {
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.04);
    color: #666;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    opacity: 0;
    padding: 0;
    transition: opacity 0.15s ease, background 0.15s ease, color 0.15s ease;
}
.ag-list-row:hover .ag-list-play-btn { opacity: 1; }
.ag-list-play-btn:hover {
    background: rgba(255,255,255,0.9);
    color: #000;
    border-color: transparent;
}

/* Hide list columns by field setting */
.ag-list-view.hide-platforms .ag-list-field-platforms,
.ag-list-view.hide-platforms .ag-col-platforms { display: none; }
.ag-list-view.hide-playtime .ag-list-field-playtime,
.ag-list-view.hide-playtime .ag-col-playtime { display: none; }
.ag-list-view.hide-lastPlayed .ag-list-field-lastPlayed,
.ag-list-view.hide-lastPlayed .ag-col-lastplayed { display: none; }
.ag-list-view.hide-installed .ag-list-field-installed,
.ag-list-view.hide-installed .ag-col-installed { display: none; }
.ag-list-view.hide-title .ag-col-title-text { opacity: 0.3; }

/* ── Post-Add Account Guide Card ─────────────────────────────────────────── */
@keyframes pagSlideIn {
    from { opacity: 0; transform: translateY(-10px); }
    to   { opacity: 1; transform: translateY(0); }
}

.post-add-guide {
    animation: pagSlideIn 0.25s ease forwards;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.08);
    background: #1c1c1c;
    padding: 16px 18px;
    margin: 0 0 14px 0;
}

.pag-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.pag-title {
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.01em;
}

.pag-dismiss {
    background: none;
    border: none;
    color: #777;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    padding: 0 0 0 8px;
    transition: color 0.15s;
}
.pag-dismiss:hover { color: #bbb; }

.pag-subtitle {
    font-size: 11.5px;
    color: #999;
    margin-bottom: 12px;
}

.pag-steps {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 12px;
}

.pag-step {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 12px;
    color: #ccc;
    line-height: 1.4;
}

.pag-step-num {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    color: #000;
    margin-top: 1px;
}

.pag-warning {
    font-size: 11px;
    color: #e8a000;
    background: rgba(232,160,0,0.08);
    border-left: 3px solid #e8a000;
    border-radius: 0 4px 4px 0;
    padding: 6px 8px;
    margin-bottom: 12px;
}

.pag-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.pag-btn-primary {
    flex: 1;
    min-width: 0;
    padding: 8px 12px;
    border: none;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: filter 0.15s, transform 0.1s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.pag-btn-primary:hover { filter: brightness(1.12); transform: translateY(-1px); }
.pag-btn-primary:active { transform: translateY(0); filter: brightness(0.95); }

.pag-btn-secondary {
    padding: 8px 12px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 7px;
    background: transparent;
    color: #999;
    font-size: 12px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
}
.pag-btn-secondary:hover { color: #ccc; border-color: rgba(255,255,255,0.25); }

/* ── Save Current button pulse ───────────────────────────────────────────── */
@keyframes accBtnPulse {
    0%   { box-shadow: 0 0 0 0 var(--pulse-color, rgba(255,255,255,0.4)); }
    60%  { box-shadow: 0 0 0 6px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
}

.acc-btn-pulse {
    animation: accBtnPulse 1.4s ease infinite;
}

/* ── Empty-state wrap — direct child of .accounts-page (column-flex) ────── */
/* Sits outside .accounts-list-section so no parent padding interferes.     */
.accounts-onboard-wrap {
    flex: 1;
    width: 100%;
    min-height: clamp(360px, 52vh, 620px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 80px 48px 56px;
    box-sizing: border-box;
    background: #080808;
}

/* ── Onboarding card ─────────────────────────────────────────────────────── */
.acc-onboard-card {
    max-width: 860px;
    width: 100%;
    margin: 0 auto;
    background: linear-gradient(160deg, #111214 0%, #0d0d0f 100%);
    border-radius: 20px;
    padding: 40px 44px;
    display: flex;
    flex-direction: column;
    gap: 28px;
}

.acc-onboard-top {
    display: flex;
    align-items: center;
    gap: 20px;
}

.acc-onboard-logo {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
}

.acc-onboard-logo img {
    width: 34px;
    height: 34px;
    object-fit: contain;
}

.acc-onboard-title {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
    margin: 0 0 4px;
}

.acc-onboard-sub {
    font-size: 13.5px;
    color: #888;
    margin: 0;
    line-height: 1.5;
}

.acc-onboard-steps {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.acc-onboard-step {
    display: flex;
    align-items: flex-start;
    gap: 14px;
}

.acc-onboard-step-num {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    margin-top: 2px;
}

.acc-onboard-step-text {
    font-size: 14px;
    color: #ccc;
    line-height: 1.5;
    padding-top: 4px;
}

.acc-onboard-step-text strong {
    color: #fff;
}

.acc-onboard-warning {
    font-size: 12.5px;
    color: #e8a000;
    background: rgba(232,160,0,0.07);
    border-left: 3px solid #e8a000;
    border-radius: 0 6px 6px 0;
    padding: 9px 12px;
    line-height: 1.5;
}

.acc-onboard-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 4px;
}

.acc-onboard-btn-primary {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 22px;
    border: none;
    border-radius: 10px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: filter 0.15s, transform 0.1s;
    white-space: nowrap;
}
.acc-onboard-btn-primary:hover  { filter: brightness(1.12); transform: translateY(-1px); }
.acc-onboard-btn-primary:active { transform: translateY(0);  filter: brightness(0.92); }

.acc-onboard-btn-secondary {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 18px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    background: transparent;
    color: #aaa;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
}
.acc-onboard-btn-secondary:hover { color: #ddd; border-color: rgba(255,255,255,0.28); }

@media (max-width: 640px) {
    .acc-onboard-card { padding: 28px 22px; }
    .acc-onboard-title { font-size: 17px; }
    .acc-onboard-actions { flex-direction: column; }
    .acc-onboard-btn-primary, .acc-onboard-btn-secondary { width: 100%; justify-content: center; }
}
/* ============================================================ */
/* ACCOUNT SHORTCUTS — Shortcut button, pill, capture modal     */
/* ============================================================ */

.acc-shortcut-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    min-width: 28px;
    padding: 0 6px;
    border-radius: 6px;
    border: 1px solid transparent;
    background: transparent;
    color: #555;
    cursor: pointer;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
    flex-shrink: 0;
}
.acc-shortcut-btn:hover {
    color: #aaa;
    background: rgba(255,255,255,0.06);
    border-color: rgba(255,255,255,0.1);
}
.acc-shortcut-btn.has-shortcut {
    color: #c8f0c8;
    border-color: rgba(100,220,100,0.22);
    background: rgba(40,200,60,0.08);
}
.acc-shortcut-btn.has-shortcut:hover {
    background: rgba(40,200,60,0.14);
    border-color: rgba(100,220,100,0.35);
}

.acc-shortcut-pill {
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.3px;
    white-space: nowrap;
    color: inherit;
}

/* Shortcut capture modal */
.shortcut-capture-box {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.04);
    color: #555;
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    cursor: default;
    user-select: none;
    text-align: center;
    padding: 0 12px;
}
.shortcut-capture-box.is-valid {
    border-color: rgba(18, 206, 24, 0.55);
    background: rgba(18, 206, 24, 0.10);
    color: #d9ffdc;
}
.shortcut-capture-box.is-invalid {
    border-color: rgba(255, 76, 96, 0.65);
    background: rgba(255, 76, 96, 0.08);
    color: #ffd6dc;
}

.shortcut-error {
    min-height: 18px;
    font-size: 12px;
    color: #ff5c6c;
    text-align: center;
    line-height: 1.4;
}

.shortcut-save-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    filter: grayscale(0.2);
}

/* ============================================================ */
/* BADDEL - ADD ACCOUNT MODAL CSS (addAccountModal.css)       */
/* ============================================================ */


/* ============================================================ */
/* 1. MODAL OVERLAY SCROLLBAR                                   */
/* ============================================================ */

#addAccountModalOverlay > div::-webkit-scrollbar {
    width: 4px;
}
#addAccountModalOverlay > div::-webkit-scrollbar-track {
    background: transparent;
}
#addAccountModalOverlay > div::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.1);
    border-radius: 4px;
}

/* ============================================================ */
/* 2. BUTTON PROCESSING STATE (للأزرار اللي بتنتظر)            */
/* ============================================================ */

/* لما أي acc-btn أو acc-switch-btn يبقى processing،
   نمنع التأثيرات المرئية التانية */

.acc-btn[disabled],
.acc-switch-btn[disabled],
.acc-btn-primary[disabled],
.acc-btn-secondary[disabled] {
    cursor: not-allowed !important;
    pointer-events: none;
    opacity: 0.6 !important;
    transform: none !important;
}

/* ============================================================ */
/* 3. ACCOUNTS HERO SECTION - IMPROVED                          */
/* ============================================================ */

/* تحسين الـ hero عشان يبان أحسن مع الـ badge الجديدة */
.accounts-hero-actions {
    flex-wrap: wrap;
    gap: 8px;
}

/* ============================================================ */
/* 4. SAVE CURRENT BADGE (Riot Special Indicator)              */
/* ============================================================ */

/* Badge بيظهر على زرار Save Current لـ Riot يوضح إن محتاج تقفل الـ tray */
.riot-tray-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #ff4655;
    background: rgba(255, 70, 85, 0.12);
    border: 1px solid rgba(255, 70, 85, 0.25);
    border-radius: 4px;
    padding: 2px 6px;
    text-transform: uppercase;
    margin-left: 4px;
}

/* ============================================================ */
/* 5. ACCOUNTS VIEW - INFO BANNER (لما تفتح accounts أول مرة)  */
/* ============================================================ */

.accounts-info-banner {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0 40px 20px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    font-size: 0.76rem;
    color: #666;
    line-height: 1.5;
}

.accounts-info-banner svg {
    flex-shrink: 0;
    margin-top: 1px;
    color: #444;
}

/* ============================================================ */
/* 6. PREVENT SIGNOUT REMINDER (في أسفل الـ accounts view)     */
/* ============================================================ */

.accounts-signout-reminder {
    margin: 16px 40px 0;
    padding: 10px 14px;
    background: rgba(255, 59, 48, 0.05);
    border: 1px solid rgba(255, 59, 48, 0.12);
    border-radius: 8px;
    font-size: 0.72rem;
    color: #664;
    color: rgba(255, 100, 80, 0.7);
    display: flex;
    align-items: center;
    gap: 8px;
}

.accounts-signout-reminder svg {
    flex-shrink: 0;
    color: rgba(255, 59, 48, 0.5);
}

/* ============================================================ */
/* 7. ACCOUNT CARD - ACTIVE/CURRENT INDICATOR                  */
/* ============================================================ */

/* لو عايز تضيف حاجة زي "Current" badge على الـ card الحالي */
.account-card.is-current {
    border-color: rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
}

.acc-current-badge {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

/* ============================================================ */
/* 8. PROCESSING OVERLAY (optional, لو عايز يعمي الـ card)     */
/* ============================================================ */

.account-card.is-processing {
    pointer-events: none;
    opacity: 0.7;
    position: relative;
}

.account-card.is-processing::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.3);
}

/* ============================================================
   ADD GAME MODAL — UNIFIED
   ============================================================ */


.ag-modal {
    width: 640px;
    max-width: 95vw;
    padding: 0;
    overflow: hidden;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    max-height: 82vh;
    background: #111;
    border: 1px solid rgba(255,255,255,0.08);
}

/* Header */
.ag-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 22px 0;
    flex-shrink: 0;
}

.ag-title {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    color: #fff;
    letter-spacing: 0.5px;
}

.ag-close-btn {
    background: transparent;
    border: none;
    color: #555;
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
}
.ag-close-btn:hover { color: #fff; background: rgba(255,255,255,0.07); }

/* Tabs */
.ag-tabs {
    display: flex;
    gap: 4px;
    padding: 16px 22px 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    flex-shrink: 0;
}

.ag-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: none;
    color: #555;
    font-size: 0.78rem;
    font-weight: 600;
    font-family: var(--font-main);
    padding: 8px 14px;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
    letter-spacing: 0.3px;
    position: relative;
    bottom: -1px;
}

.ag-tab:hover { color: #aaa; }

.ag-tab.active {
    color: #fff;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.07);
    border-bottom-color: #111; /* يمشي مع الـ border-bottom للـ tabs */
}

/* Panels */
.ag-panel {
    flex: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
}

/* Browse panel header */
.ag-picker-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: #0d0d0d;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    flex-shrink: 0;
}

.ag-nav-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.07);
    color: #888;
    padding: 6px 8px;
    border-radius: 6px;
    cursor: pointer;
    transition: 0.15s;
    display: flex;
    align-items: center;
}
.ag-nav-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }

.ag-path-text {
    font-size: 0.72rem;
    color: #555;
    font-family: var(--font-code);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
}

/* Dir list */
.ag-dir-list {
    flex: 1;
    overflow-y: auto;
    padding: 6px 8px;
}

.ag-placeholder {
    padding: 30px;
    text-align: center;
    color: #333;
    font-size: 0.82rem;
}

.ag-dir-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.12s;
    user-select: none;
}
.ag-dir-item:hover    { background: rgba(255,255,255,0.05); }
.ag-dir-item.selected { background: rgba(48, 209, 88, 0.1); }

.ag-item-icon {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 16px;
}
.ag-item-icon svg { width: 18px; height: 18px; }

.ag-item-text {
    flex: 1;
    font-size: 0.82rem;
    color: #ccc;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ag-item-badge {
    font-size: 0.65rem;
    font-weight: 700;
    color: #0a84ff;
    background: rgba(10, 132, 255, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    flex-shrink: 0;
}

/* Path panel */
.ag-path-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 28px 24px;
    gap: 14px;
}

.ag-hint {
    font-size: 0.82rem;
    color: #555;
    text-align: center;
}
.ag-hint strong { color: #888; }

.ag-path-input-row {
    display: flex;
    gap: 10px;
    width: 100%;
}

.ag-path-field {
    flex: 1;
    font-family: var(--font-code);
    font-size: 0.82rem;
}

.ag-use-btn {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    color: #fff;
    padding: 0 18px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    transition: 0.15s;
    white-space: nowrap;
}
.ag-use-btn:hover:not(:disabled) { background: rgba(255,255,255,0.15); }
.ag-use-btn:disabled { opacity: 0.3; cursor: default; }

.ag-path-status { font-size: 0.78rem; }

/* Drop panel */
.ag-drop-zone {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 16px;
    border: 2px dashed rgba(255,255,255,0.1);
    border-radius: 16px;
    gap: 10px;
    transition: border-color 0.2s, background 0.2s;
    cursor: default;
    padding: 30px;
}
.ag-drop-zone.drag-over {
    border-color: rgba(48,209,88,0.5);
    background: rgba(48,209,88,0.04);
}
.ag-drop-zone.drop-success {
    border-color: rgba(48,209,88,0.4);
    background: rgba(48,209,88,0.04);
}

.ag-drop-icon { color: rgba(255,255,255,0.12); }

.ag-drop-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ccc;
    font-family: var(--font-heading);
}
.ag-drop-title span { color: #0a84ff; }

.ag-drop-sub {
    font-size: 0.78rem;
    color: #444;
    text-align: center;
    max-width: 300px;
    line-height: 1.6;
}

.ag-drop-feedback { font-size: 0.8rem; }

/* Shared status colors */
.ag-status-ok   { color: #30d158; }
.ag-status-warn { color: #ff9f0a; }

/* Path textarea */
.ag-path-textarea {
    resize: vertical;
    min-height: 72px;
    line-height: 1.6;
}

/* Checkmark icon on file rows — hidden until selected */
.ag-item-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: transparent;
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.12s;
    color: #30d158;
}

.ag-dir-item.selected .ag-item-check { opacity: 1; }
.ag-dir-item.selected { background: rgba(48, 209, 88, 0.1); }
.ag-dir-item.selected .ag-item-text { color: #fff; }

/* Selected games section */
.ag-selected-section {
    border-top: 1px solid rgba(255,255,255,0.06);
    flex-shrink: 0;
    max-height: 220px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}


.ag-selected-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px 4px;
    flex-shrink: 0;
}

.ag-sel-count {
    font-size: 0.72rem;
    font-weight: 600;
    color: #30d158;
    letter-spacing: 0.3px;
}

.ag-clear-btn {
    background: transparent;
    border: none;
    color: #555;
    font-size: 0.72rem;
    cursor: pointer;
    padding: 2px 4px;
    border-radius: 4px;
    transition: color 0.12s;
}
.ag-clear-btn:hover { color: #ff453a; }

.ag-selected-games-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 4px 10px 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

/* Single game row inside review list */
.ag-sel-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border-radius: 8px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.05);
}

.ag-sel-filename {
    font-size: 0.72rem;
    font-family: var(--font-code);
    color: #30d158;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    flex-shrink: 1;
    max-width: 140px;
}

.ag-sel-name-input {
    flex: 1;
    padding: 5px 10px !important;
    font-size: 0.78rem !important;
    min-width: 0;
}

.ag-sel-remove {
    background: transparent;
    border: none;
    color: #444;
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: color 0.12s, background 0.12s;
}
.ag-sel-remove:hover { color: #ff453a; background: rgba(255,69,58,0.1); }

/* Footer */
.ag-footer {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    padding: 14px 16px;
    border-top: 1px solid rgba(255,255,255,0.06);
    flex-shrink: 0;
}


/* ============================================================
   GAME SETTINGS MODAL — UPGRADED
   ============================================================ */

.gs-modal {
    width: 700px;
    max-width: 95vw;
    padding: 28px;
    max-height: 88vh;
    overflow-y: auto;
}

.gs-modal-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
}

/* Images section: 3 columns */
.gs-images-section {
    display: grid;
    grid-template-columns: 160px 1fr 160px;
    gap: 16px;
    margin-top: 18px;
}

.gs-image-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
}


.gs-image-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 600;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

.gs-reset-btn {
    opacity: 0;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.08); /* لون رمادي شفاف هادي جداً */
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.gs-image-block:hover .gs-reset-btn {
    opacity: 1;
    pointer-events: auto;
}

.gs-reset-btn:hover {
    background: rgba(255, 255, 255, 0.15); /* ينور شوية لما تقف عليه */
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-1px);
}

/* Preview wrapper base */
.gs-preview-wrapper {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    background: #0d0d0d;
    border: 1px solid rgba(255,255,255,0.07);
    cursor: default;
    width: 100%; /* ضيف دي عشان تضمن إن العرض مظبوط */
}

/* Hero/Banner: landscape */
.gs-hero-wrapper {
    aspect-ratio: 16 / 7;
    cursor: grab;
}

.gs-hero-img {
    object-fit: cover;
    height: 100%;
    width: auto;
    min-width: 100%;
    position: absolute; /* التعديل السحري: هيمنع الصورة من مط الـ Modal */
    top: 0;             /* التثبيت لفوق */
    left: 0;            /* التثبيت للشمال */
    /* Pan handled via marginLeft JS */
}

/* Cover: portrait (2:3 approx) */
.gs-cover-wrapper {
    aspect-ratio: 2 / 3;
    cursor: grab;
}

.gs-cover-wrapper:active { 
    cursor: grabbing; 
}

.gs-cover-wrapper .gs-preview-img {
    object-fit: cover;
    object-position: center bottom;
}

.gs-hero-wrapper:active { cursor: grabbing; }

.gs-hero-pan-hint {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.62rem;
    color: rgba(255,255,255,0.3);
    background: rgba(0,0,0,0.5);
    padding: 2px 8px;
    border-radius: 10px;
    pointer-events: none;
    white-space: nowrap;
    transition: opacity 0.3s;
}

/* Logo: square transparent-bg */
.gs-logo-wrapper {
    aspect-ratio: 1 / 1;
}

.gs-logo-bg-checker {
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(45deg, #1a1a1a 25%, transparent 25%),
        linear-gradient(-45deg, #1a1a1a 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #1a1a1a 75%),
        linear-gradient(-45deg, transparent 75%, #1a1a1a 75%);
    background-size: 16px 16px;
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    background-color: #111;
    opacity: 0.6;
    pointer-events: none;
}

.gs-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.2s;
}

.gs-logo-img {
    object-fit: contain;
    padding: 10%;
    position: relative;
    z-index: 1;
}

/* Empty logo placeholder */
.gs-logo-empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.72rem;
    color: rgba(255,255,255,0.2);
    z-index: 1;
}

/* Overlay actions (hover reveal) */
.gs-overlay-actions {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0);
    opacity: 0;
    transition: opacity 0.2s, background 0.2s;
    z-index: 10;
}

.gs-preview-wrapper:hover .gs-overlay-actions {
    opacity: 1;
    background: rgba(0,0,0,0.55);
}

.gs-change-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.18);
    color: #fff;
    padding: 7px 14px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    transition: background 0.15s;
}
.gs-change-btn:hover { background: rgba(255,255,255,0.22); }

/* ============================================================
   RESPONSIVE: لو الشاشة ضيقة نحط الـ hero فوق والـ cover+logo تحت
   ============================================================ */
@media (max-width: 580px) {
    .gs-images-section {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto auto;
    }
    .gs-hero-block {
        grid-column: 1 / -1;
        order: -1;
    }
}

/* لما زرار الـ Reset الصغير يتقفل */
.gs-reset-btn:disabled {
    opacity: 0.3; /* خافت */
    background: rgba(255, 255, 255, 0.1); /* رمادي شفاف */
    color: rgba(255, 255, 255, 0.4);
    cursor: not-allowed;
    pointer-events: none; 
    filter: grayscale(1);
    box-shadow: none;
    transform: none;
}

/* لما زرار الـ Reset All الكبير يتقفل */
#btn-reset-all:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
    filter: grayscale(1);
}

/* ============================================================
   BADDEL LAUNCHER - GAME DETAILS PAGE (APPLE TV / PREMIUM EDITION)
   Aesthetic: Ultra-Modern, Minimalist, Cinematic Dark
   ============================================================ */


/* ── CSS Variables ── */
:root {
    --gd-bg: #000000;
    --gd-surface: rgba(255, 255, 255, 0.03);
    --gd-surface-hover: rgba(255, 255, 255, 0.08);
    --gd-border: rgba(255, 255, 255, 0.06);
    --gd-text: #f5f5f7;
    --gd-text-muted: #86868b;
    --gd-accent: #ffffff;
    --gd-green: #30d158;
    --gd-hero-height: 55vh;
    --gd-min-hero-height: 450px;
    --gd-sidebar-width: 280px;
    --gd-radius: 16px;
    --gd-radius-sm: 10px;
    --gd-bezier: cubic-bezier(0.2, 0.8, 0.2, 1);
    /* --font-* variables are defined in fonts.css */
}

/* ============================================================
   ROOT VIEW
   ============================================================ */
#gameDetailsView {
    position: absolute;
    inset: 0;
    background: var(--gd-bg);
    overflow-y: auto;
    overflow-x: hidden;
    font-family: var(--font-main);
    color: var(--gd-text);
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.2) transparent;
}

#gameDetailsView::-webkit-scrollbar { width: 6px; }
#gameDetailsView::-webkit-scrollbar-track { background: transparent; }
#gameDetailsView::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }
#gameDetailsView::-webkit-scrollbar-thumb:hover { background: #555; }

/* ============================================================
   BACK BAR (FROSTED GLASS)
   ============================================================ */
.gd-back-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 40px;
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(25px) saturate(180%);
    -webkit-backdrop-filter: blur(25px) saturate(180%);
    border-bottom: 1px solid var(--gd-border);
}

.gd-back-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--gd-surface);
    border: 1px solid var(--gd-border);
    color: var(--gd-text);
    padding: 8px 16px;
    border-radius: 20px;
    font-family: var(--font-main);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s var(--gd-bezier);
}
.gd-back-btn:hover {
    background: rgba(255,255,255,0.1);
    transform: scale(1.05);
}

.gd-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    font-weight: 500;
}
.gd-breadcrumb-library { color: var(--gd-text-muted); }
.gd-breadcrumb-sep { color: #444; }
.gd-breadcrumb-name { color: var(--gd-text); }

/* ============================================================
   HERO SECTION (CINEMATIC)
   ============================================================ */
.gd-hero {
    position: relative;
    height: var(--gd-hero-height);
    min-height: var(--gd-min-hero-height);
    overflow: hidden;
    flex-shrink: 0;
}

.gd-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 20%;
    transform: scale(1.02);
    transition: background-image 0.8s ease;
    /* Softer than before — heavy darken + saturate read as muddy blue on some Steam assets */
    filter: brightness(0.78) saturate(1.05) contrast(1.02);
    animation: slowHeroZoom 20s infinite alternate linear;
}

/* Procedural “dead game” hero — no photo URL; gradient only */
.gd-hero-bg.gd-procedural-art {
    filter: none;
    animation: gdProceduralHeroDrift 22s ease-in-out infinite alternate;
    background-size: 200% 200%;
    background-position: 50% 50%;
}

@keyframes gdProceduralHeroDrift {
    0% { background-position: 0% 40%; }
    100% { background-position: 100% 60%; }
}

@keyframes slowHeroZoom {
    from { transform: scale(1); }
    to { transform: scale(1.05); }
}

.gd-hero-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #000000 0%, rgba(0,0,0,0.4) 40%, transparent 100%),
                linear-gradient(to right, rgba(0,0,0,0.7) 0%, transparent 50%);
    pointer-events: none;
}

/* ❌ Remove generic gamer lines */
.gd-hero-scanlines { display: none; }

.gd-hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column; /* هنرص العناصر فوق بعض */
    justify-content: flex-end; /* نزقهم لتحت */
    align-items: flex-start; /* نجيبهم كلهم عالشمال */
    padding: 50px 40px;
    /* السطر ده بيمنع أي كلام يروح ناحية اليمين ويستخبى تحت الكارت */
    padding-right: calc(var(--gd-sidebar-width) + 80px); 
}

.gd-title-block {
    flex: none;
    width: 100%;
    margin-bottom: 24px; /* مسافة بين العنوان والزراير */
}

.gd-logo {
    width: 100% !important;
    max-width: 400px !important;
    height: 130px !important; /* بوكس ثابت إجباري */
    object-fit: contain !important;
    object-position: left bottom !important; /* السر هنا: بيلزق الصورة في أرضية البوكس على الشمال */
    margin-bottom: 16px !important; /* قللنا المسافة شوية عشان يقرب من الزراير */
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.5));
    display: block;
}


.gd-title {
    font-family: var(--font-brand);
    font-size: 3.5rem;
    font-weight: 900;
    color: #fff;
    line-height: 1.1;
    margin: 0 0 15px 0;
    letter-spacing: -0.5px;
    text-shadow: 0 4px 20px rgba(0,0,0,0.6);
}

.gd-platforms-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
}

.gd-plat-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
}
.gd-plat-badge img { width: 14px; height: 14px; filter: brightness(0) invert(1); }

/* ── Hero Actions ── */
.gd-action-block {
    display: flex;
    flex-direction: row; /* هنخلي زرار اللعب والـ Stats جنب بعض */
    align-items: center;
    gap: 24px;
    padding-bottom: 0;
    width: 100%;
    flex-wrap: wrap; /* عشان لو الشاشة صغرت ينزلوا سطر جديد شيك */
}
.gd-play-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 40px;
    background: var(--gd-accent);
    color: #000;
    border: none;
    border-radius: 14px;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.3s var(--gd-bezier);
    box-shadow: 0 10px 30px rgba(255,255,255,0.2);
    flex-shrink: 0;
}
.gd-play-btn:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 15px 40px rgba(255,255,255,0.3);
    background: #fff;
}

.gd-play-btn:active { transform: scale(0.98); }

.gd-play-btn.install-mode {
    background: rgba(255,255,255,0.1);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.2);
    box-shadow: none;
}
.gd-play-btn.install-mode:hover { background: rgba(255,255,255,0.2); transform: translateY(-2px); }

/* Download Block iOS Style */
.gd-download-block {
    background: rgba(20, 20, 20, 0.7);
    backdrop-filter: blur(20px);
    border: 1px solid var(--gd-border);
    border-radius: 14px;
    padding: 16px;
    width: 280px;
}
.gd-dl-header { display: flex; justify-content: space-between; margin-bottom: 10px; }
.gd-dl-status { font-size: 0.8rem; font-weight: 600; }
.gd-dl-speed { font-size: 0.75rem; color: var(--gd-text-muted); }
.gd-dl-bar-wrap { height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden; margin-bottom: 8px; }
.gd-dl-bar { height: 100%; background: var(--gd-accent); width: 0%; transition: width 0.3s ease; }
.gd-dl-footer { display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--gd-text-muted); }

.gd-quick-stats { 
    display: flex; 
    gap: 20px; 
    align-items: center;
}
.gd-qs-item { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--gd-text-muted); font-weight: 600; }

/* ============================================================
   BODY LAYOUT
   ============================================================ */
.gd-body {
    display: flex;
    min-height: 50vh;
    padding: 0 40px 60px 40px;
    gap: 40px;
    max-width: 1600px;
    margin: 0 auto;
}
.gd-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
.gd-sidebar { width: var(--gd-sidebar-width); flex-shrink: 0; display: flex; flex-direction: column; gap: 24px; margin-top: -120px; z-index: 10; }

/* ============================================================
   APPLE STYLE TABS (Segmented Control)
   ============================================================ */
.gd-tabs {
    display: inline-flex;
    background: rgba(255,255,255,0.03);
    padding: 5px;
    border-radius: 12px;
    border: 1px solid var(--gd-border);
    margin-bottom: 30px;
    gap: 5px;
    align-self: flex-start;
}

.gd-tab {
    padding: 10px 20px;
    background: transparent;
    border: none;
    color: var(--gd-text-muted);
    font-family: var(--font-main);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.3s var(--gd-bezier);
}
.gd-tab:hover { color: var(--gd-text); background: rgba(255,255,255,0.05); }
.gd-tab.active {
    background: rgba(255,255,255,0.15);
    color: #fff;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
}

.gd-tab-content { animation: gdFadeIn 0.4s var(--gd-bezier); }
@keyframes gdFadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

/* ============================================================
   MAIN CONTENT SECTIONS
   ============================================================ */
.gd-section { margin-bottom: 40px; }

.gd-section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 16px 0;
    padding-bottom: 0;
    border-bottom: none;
}
.gd-section-title svg { color: var(--gd-text-muted); width: 20px; height: 20px; }

.gd-desc {
    font-size: 0.95rem;
    line-height: 1.8;
    color: #aaa;
    font-weight: 500;
}

/* ── Trailer ── */
.gd-trailer-wrap {
    border-radius: var(--gd-radius);
    overflow: hidden;
    background: #000;
    aspect-ratio: 16/9;
    border: 1px solid var(--gd-border);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    position: relative;
}
.gd-trailer { width: 100%; height: 100%; border: none; display: block; }
.gd-trailer-ext-btn {
    position: absolute; top: 15px; right: 15px;
    padding: 8px 14px; background: rgba(0,0,0,0.5); backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1); color: #fff; font-size: 0.8rem;
    border-radius: 8px; cursor: pointer; transition: 0.3s; display: flex; gap: 6px; align-items: center;
}
.gd-trailer-ext-btn:hover { background: rgba(255,255,255,0.1); transform: scale(1.05); }

/* ── Clean Info Grid ── */
.gd-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
}
.gd-info-item {
    background: var(--gd-surface);
    border: 1px solid var(--gd-border);
    border-radius: var(--gd-radius-sm);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: 0.3s ease;
}
.gd-info-item:hover { background: var(--gd-surface-hover); border-color: rgba(255,255,255,0.15); }
.gd-info-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: var(--gd-text-muted); font-weight: 700; }
.gd-info-value { font-size: 0.95rem; color: #fff; font-weight: 600; }

/* ── Tags ── */
.gd-tags { display: flex; flex-wrap: wrap; gap: 10px; }
.gd-tag {
    padding: 8px 16px;
    background: var(--gd-surface);
    border: 1px solid var(--gd-border);
    border-radius: 30px;
    font-size: 0.8rem;
    color: #ccc;
    font-weight: 600;
    transition: all 0.2s ease;
}
.gd-tag:hover { background: rgba(255,255,255,0.1); color: #fff; transform: translateY(-2px); }

/* ── Screenshots ── */
.gd-screenshots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 16px;
}
.gd-screenshot {
    aspect-ratio: 16/9;
    border-radius: var(--gd-radius-sm);
    overflow: hidden;
    cursor: pointer;
    border: 1px solid var(--gd-border);
    transition: all 0.4s var(--gd-bezier);
    position: relative;
}
.gd-screenshot:hover {
    transform: scale(1.03) translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.6);
    border-color: rgba(255,255,255,0.2);
    z-index: 2;
}
.gd-screenshot img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
.gd-screenshot:hover img { transform: scale(1.05); }

.gd-media-trailer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 16px;
}
.gd-media-trailer-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    border: 1px solid var(--gd-border);
    border-radius: var(--gd-radius-sm);
    background: var(--gd-surface);
    color: #fff;
    font: inherit;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.25s var(--gd-bezier);
}
.gd-media-trailer-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255,255,255,0.22);
    box-shadow: 0 14px 30px rgba(0,0,0,0.45);
}
.gd-media-trailer-thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: #111;
}
.gd-media-trailer-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
.gd-media-trailer-play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 54px;
    height: 54px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(0,0,0,0.64);
    border: 1px solid rgba(255,255,255,0.2);
    backdrop-filter: blur(8px);
}
.gd-media-trailer-title {
    padding: 0 14px 14px;
    color: var(--gd-text);
    font-size: 0.9rem;
    font-weight: 700;
}

/* ============================================================
   SIDEBAR (RIGHT)
   ============================================================ */
.gd-cover-wrap {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    /* 2/3 matches Steam/library vertical art; 3/4 was wider → side letterboxing with contain */
    aspect-ratio: 2 / 3;
    background: #111;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 20px 50px rgba(0,0,0,0.7);
    transition: transform 0.5s var(--gd-bezier), box-shadow 0.5s ease;
}
.gd-cover-wrap:hover {
    transform: scale(1.03) translateY(-10px);
    box-shadow: 0 30px 60px rgba(0,0,0,0.9);
    border-color: rgba(255,255,255,0.2);
}
.gd-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    image-rendering: auto;
    /* يطابق .actual-img على كروت المكتبة: zoom + تعتيم عند hover الغلاف */
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.4s ease;
}

.gd-cover-wrap:hover .gd-cover {
    transform: scale(1.05);
    filter: brightness(0.6);
}

.gd-cover-wrap:hover .gd-cover.fallback-hero {
    filter: brightness(0.3) saturate(0.6);
}

.gd-cover-wrap.gd-procedural-card .gd-cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.gd-cover-wrap.gd-procedural-card #gdCoverInitials {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 8vw, 3.4rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.35) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
    filter: drop-shadow(0 4px 24px rgba(0,0,0,0.45));
}

.gd-cover.fallback-hero {
    filter: brightness(0.4) saturate(0.8);
}

.gd-logo-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 85%;
    max-height: 45%;
    object-fit: contain;
    z-index: 2;
    pointer-events: none;
    filter: drop-shadow(0 4px 10px rgba(0,0,0,0.9));
    animation: gdFadeIn 0.6s var(--gd-bezier);
}

/* ══════════════════════════════════════════════════════════════
   SIDEBAR RATING BLOCK — Redesigned (Compact Score Card)
   ══════════════════════════════════════════════════════════════ */

.gd-rating-block {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    text-align: left !important;
    backdrop-filter: none !important;
}

/* ── Ratings Container (sidebar) ── */
.gd-ratings-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    margin-top: 4px;
}

/* ── New Sidebar Score Chip ── */
.gd-rating-group {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 12px 14px;
    min-width: 0;
    flex: unset !important;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s ease, background 0.2s ease;
}

.gd-rating-group::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--pill-color, #fff);
    border-radius: 0 3px 3px 0;
    opacity: 0.7;
}

.gd-rating-group:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.14);
}

.gd-rating-group-label {
    display: none;
}

.gd-rating-group-pills {
    display: flex;
    gap: 8px;
}

/* ── Sidebar Pill (score chip inside the group) ── */
.gd-rating-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
}

.gd-pill-source-icon {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.gd-pill-source-icon img {
    width: 16px;
    height: 16px;
    object-fit: contain;
}

.gd-pill-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
}

.gd-pill-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.gd-pill-sub {
    font-size: 0.62rem;
    color: var(--gd-text-muted);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.gd-pill-score {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 900;
    line-height: 1;
    color: var(--pill-color, #fff);
    display: flex;
    align-items: baseline;
    gap: 1px;
    flex-shrink: 0;
}

.gd-pill-max {
    font-size: 0.65rem;
    opacity: 0.35;
    font-weight: 500;
}

.gd-pill-stars {
    display: flex;
    gap: 2px;
    margin-top: 2px;
}

/* ── More Ratings Button ── */
.gd-more-ratings-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    color: rgba(255,255,255,0.45);
    border-radius: 12px;
    padding: 9px 14px;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    width: 100%;
    transition: all 0.25s ease;
    letter-spacing: 0.3px;
}

.gd-more-ratings-btn:hover {
    background: rgba(255, 255, 255, 0.09);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.2);
    border-style: solid;
    transform: none;
}

/* Sidebar Clean Details */
.gd-detail-list {
    display: flex;
    flex-direction: column;
    background: var(--gd-surface);
    border: 1px solid var(--gd-border);
    border-radius: var(--gd-radius-sm);
    padding: 5px;
}
.gd-detail-row {
    padding: 12px 16px;
    border-bottom: 1px solid var(--gd-border);
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.gd-detail-row:last-child { border-bottom: none; }
.gd-detail-label { font-size: 0.7rem; color: var(--gd-text-muted); font-weight: 600; text-transform: uppercase; }
.gd-detail-value { font-size: 0.85rem; color: #fff; font-weight: 500; }

/* ============================================================
   REQUIREMENTS TAB (CLEAN CARDS)
   ============================================================ */
.gd-req-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
@media (max-width: 800px) { .gd-req-grid { grid-template-columns: 1fr; } }

.gd-req-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--gd-border);
    border-radius: var(--gd-radius);
    padding: 24px;
    backdrop-filter: blur(10px);
}
.gd-req-badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 20px;
    background: rgba(255,255,255,0.05);
    color: #fff;
}
.gd-req-list { display: flex; flex-direction: column; gap: 12px; }
.gd-req-row { display: flex; flex-direction: column; gap: 4px; padding-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.03); }
.gd-req-row:last-child { border-bottom: none; padding-bottom: 0; }
.gd-req-label { font-size: 0.7rem; color: var(--gd-text-muted); font-weight: 700; text-transform: uppercase; }
.gd-req-val { font-size: 0.85rem; color: #ccc; font-weight: 500; line-height: 1.5; }

/* ============================================================
   ACCOUNTS TAB
   ============================================================ */
.gd-accounts-list { display: flex; flex-direction: column; gap: 12px; }
.gd-account-item {
    display: flex; align-items: center; gap: 16px;
    padding: 16px 20px; background: var(--gd-surface);
    border: 1px solid var(--gd-border); border-radius: 14px;
    transition: all 0.3s ease;
}
.gd-account-item:hover { background: var(--gd-surface-hover); border-color: rgba(255, 255, 255, 0.15); transform: translateY(-2px); }
.gd-account-plat-icon { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: #fff; border-radius: 8px; }
.gd-account-plat-icon img { width: 20px; height: 20px; object-fit: contain; }
.gd-account-info { flex: 1; }
.gd-account-name { font-size: 0.95rem; font-weight: 600; color: #fff; }
.gd-account-plat { font-size: 0.75rem; color: var(--gd-text-muted); }
.gd-account-status { padding: 6px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; }
.gd-account-status.owned { background: rgba(48, 209, 88, 0.15); color: var(--gd-green); }

/* ============================================================
   ACHIEVEMENTS TAB
   ============================================================ */
.gd-achievements-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}
.gd-ach-card {
    background: linear-gradient(180deg, rgba(255,255,255,0.035) 0%, rgba(255,255,255,0.02) 100%);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 16px 18px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.25);
}
.gd-ach-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
}
.gd-ach-name { font-size: 0.95rem; font-weight: 800; color: #fff; letter-spacing: 0.2px; }
.gd-ach-meta { font-size: 0.78rem; color: var(--gd-text-muted); font-weight: 600; }
.gd-ach-bar {
    width: 100%;
    height: 9px;
    border-radius: 999px;
    background: rgba(255,255,255,0.09);
    overflow: hidden;
}
.gd-ach-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #30d158, #8ef5b0);
    transition: width 0.35s ease;
}
.gd-ach-sub {
    margin-top: 9px;
    font-size: 0.76rem;
    color: #9a9aa1;
    font-weight: 600;
}
.gd-ach-items {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 340px;
    overflow-y: auto;
    padding-right: 6px;
    border-top: 1px solid rgba(255,255,255,0.05);
    padding-top: 10px;
}
/* Scrollbar styling for achievements */
.gd-ach-items::-webkit-scrollbar {
    width: 4px;
}
.gd-ach-items::-webkit-scrollbar-track {
    background: transparent;
}
.gd-ach-items::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
}
.gd-ach-items::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
}
/* ============================================================
   STEAM REVIEWS STYLING
   ============================================================ */
.gd-review-summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
}
.gd-review-title {
    font-size: 1.6rem;
    font-weight: 900;
    color: #fff;
    line-height: 1.2;
    text-align: center;
}
.gd-review-count {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    opacity: 0.9;
    margin-bottom: 8px;
}
.gd-review-stats {
    display: flex;
    gap: 16px;
    font-size: 0.95rem;
    font-weight: 700;
}
.gd-review-pos {
    color: #30d158; /* Steam Green */
    display: flex;
    align-items: center;
    gap: 6px;
}
.gd-review-neg {
    color: #ff453a; /* Steam Red */
    display: flex;
    align-items: center;
    gap: 6px;
}
.gd-rating-label {
    margin-top: 10px;
    font-size: 0.7rem;
    color: var(--gd-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    opacity: 0.6;
}

.gd-ach-item {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 11px 12px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.07);
    margin-bottom: 0;
}
.gd-ach-icon-wrapper {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 0 10px rgba(255, 170, 0, 0.2);
    background: rgba(0,0,0,0.3);
}
.gd-ach-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.gd-ach-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}
.gd-ach-dot {
    color: #30d158;
    font-size: 1.1rem;
    font-weight: 700;
    width: 44px;
    text-align: center;
}
.gd-ach-item-name {
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.gd-ach-item-desc {
    color: var(--gd-text-muted);
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.2;
}
.gd-ach-item-time {
    color: var(--gd-text-muted);
    font-size: 0.72rem;
    font-weight: 500;
    white-space: nowrap;
    text-align: right;
    min-width: 128px;
}

/* ============================================================
   LIGHTBOX (GALLERY POPUP)
   ============================================================ */
.gd-lightbox {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: rgba(0,0,0,0.95) !important;
    backdrop-filter: blur(25px) !important;
    z-index: 999999 !important; /* عشان يغطي على أي حاجة في اللانشر */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
}
.gd-lightbox.active {
    opacity: 1;
    pointer-events: all;
}
/* ============================================================
   LIGHTBOX IMAGE (SCALING FIXED)
   ============================================================ */
.gd-lightbox-img {
    /* بنستخدم الـ Viewport Units عشان نفرض مساحة 90% من عرض وطول الشاشة كحد أقصى */
    max-width: 90vw; 
    max-height: 90vh;
    
    /* دي أهم خاصية: بتخلي الصورة "تحتوي" نفسها جوة الـ max-width/height من غير ما تتمط */
    object-fit: contain; 
    
    /* عشان نحافظ على شياكة الحواف المدورة والضلال */
    border-radius: 12px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.9);
    
    /* منع أي تداخل مع الأسهم في حالات نادرة */
    display: block; 
}.gd-lightbox-close {
    position: absolute; top: 30px; right: 40px; font-size: 2rem; color: #fff;
    background: rgba(255,255,255,0.1); border: none; width: 44px; height: 44px;
    border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s;
}
.gd-lightbox-close:hover { background: rgba(255,255,255,0.2); transform: scale(1.1); }

.gd-metadata-sources {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--gd-border);
    border-radius: var(--gd-radius);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.gd-ms-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.gd-ms-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--gd-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.gd-ms-trace {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.gd-ms-step {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 8px;
    border-left: 3px solid transparent;
}

.gd-ms-step.success { border-left-color: var(--gd-green); background: rgba(48, 209, 88, 0.05); }
.gd-ms-step.failed { border-left-color: #ff453a; background: rgba(255, 69, 58, 0.05); opacity: 0.7; }
.gd-ms-step.skipped { border-left-color: #8e8e93; opacity: 0.5; }

.gd-ms-step-source {
    font-weight: 600;
    min-width: 120px;
    color: #fff;
}

.gd-ms-step-status {
    font-size: 0.7rem;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(255,255,255,0.1);
    text-transform: uppercase;
}

.gd-ms-step-url {
    color: var(--gd-text-muted);
    font-family: var(--font-code);
    font-size: 0.75rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
}

.gd-ms-step.success .gd-ms-step-status { color: var(--gd-green); background: rgba(48, 209, 88, 0.15); }
.gd-ms-step.failed .gd-ms-step-status { color: #ff453a; background: rgba(255, 69, 58, 0.15); }

/* ============================================================
   PAGE LOAD ANIMATION
   ============================================================ */
#gameDetailsView .gd-body { animation: gdSlideUp 0.6s var(--gd-bezier) both; }
@keyframes gdSlideUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}


/* ============================================================
   LIGHTBOX NAVIGATION ARROWS
   ============================================================ */
.gd-lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s var(--gd-bezier);
    z-index: 2;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
}
.gd-lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-50%) scale(1.1);
}
.gd-lightbox-nav.prev { left: 40px; }
.gd-lightbox-nav.next { right: 40px; }


/* Short Description */
.gd-short-desc {
    color: rgba(255,255,255,0.75);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 12px;
    font-style: italic;
}

/* Long Description with collapse */
.gd-long-desc {
    color: rgba(255,255,255,0.65);
    font-size: 0.88rem;
    line-height: 1.7;
}

.gd-long-desc.collapsed {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* ستايل زرار الـ Show More الجديد - Minimalist & Cinematic */
.gd-show-more-btn {
    pointer-events: auto;
    background: transparent;
    border: none;
    color: var(--gd-text);
    padding: 8px 16px;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 0;
    transition: color 0.3s ease, transform 0.3s ease;
    text-shadow: 0 4px 15px rgba(0,0,0,0.9); /* بيحافظ على قرايته بوضوح فوق التدرج */
}

/* السهم الصغير اللي جنب الكلمة (بدون الحاجة لـ SVG في الـ JS) */
.gd-show-more-btn::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.3s var(--gd-bezier);
}

/* التأثير لما الماوس ييجي عليه */
.gd-show-more-btn:hover {
    color: #fff;
    transform: translateY(2px); /* حركة ناعمة لتحت بتشجع على الكليك */
}

/* شكل الزرار لما الوصف يفتح (Expanded) */
.gd-about-wrapper.expanded .gd-show-more-btn {
    color: var(--gd-text-muted); /* لونه بيطفي شوية عشان التركيز يروح للكلام */
    margin-top: 10px;
}

.gd-about-wrapper.expanded .gd-show-more-btn:hover {
    color: #fff;
}

/* عكس اتجاه السهم لفوق لما يفتح */
.gd-about-wrapper.expanded .gd-show-more-btn::after {
    transform: rotate(-135deg) translateY(-2px); 
}
/* ── Full Markdown Description (About section) ── */
.gd-full-desc {
    color: rgba(255,255,255,0.72);
    font-size: 0.875rem;
    line-height: 1.75;
}

.gd-md-h1, .gd-md-h2 {
    font-size: 1.1rem;
    font-weight: 700;
    color: rgba(255,255,255,0.92);
    margin: 16px 0 6px;
    letter-spacing: 0.01em;
}
.gd-md-h3, .gd-md-h4 {
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    margin: 12px 0 4px;
}
.gd-md-h5, .gd-md-h6 {
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    margin: 8px 0 4px;
}
.gd-md-p {
    margin: 0 0 10px;
}
.gd-md-p:last-child { margin-bottom: 0; }

.gd-md-ul {
    margin: 6px 0 10px 0;
    padding-left: 18px;
    list-style: none;
}
.gd-md-ul li {
    position: relative;
    padding-left: 14px;
    margin-bottom: 4px;
    color: rgba(255,255,255,0.72);
}
.gd-md-ul li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--accent, #7c6cf0);
    font-weight: 700;
}
.gd-md-hr {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.08);
    margin: 14px 0;
}
.gd-md-link {
    color: var(--accent, #7c6cf0);
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.15);
}
.gd-md-link:hover { opacity: 0.8; }


/* تحديد عدد السطور بـ 3 فقط */
.gd-full-desc-text {
    display: -webkit-box;
    -webkit-line-clamp: 3; /* يظهر أول 3 سطور فقط */
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: all 0.3s ease;
}

/* حالة الـ Expanded */
.gd-full-desc-text.expanded {
    -webkit-line-clamp: unset;
    max-height: none;
}


/* الحاوية الأساسية للوصف */
.gd-about-wrapper {
    position: relative;
    margin-bottom: 10px;
}

/* النص مع تحديد 3 سطور */
.gd-full-desc-text {
    display: -webkit-box;
    -webkit-line-clamp: 3; /* أول 3 سطور فقط */
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    transition: all 0.4s ease;
}

/* الـ Fade Overlay (التدرج اللي بيغطي الكلام) */
.gd-about-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50px; /* طول التدرج */
    background: linear-gradient(to bottom, transparent, var(--gd-bg)); /* التدرج من شفاف للون الخلفية الأسود */
    pointer-events: none; /* عشان ميعطلش الكليك على الكلام */
    transition: opacity 0.3s ease;
}
/* الحاوية الأساسية للوصف */
.gd-about-wrapper {
    position: relative;
    margin-bottom: 20px;
}

/* النص مع تحديد 4 سطور عشان يدي مساحة حلوة للـ Fade */
.gd-full-desc-text {
    display: -webkit-box;
    -webkit-line-clamp: 4; 
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    transition: all 0.4s ease;
}

/* الـ Fade Overlay (التدرج اللي بيغطي آخر سطرين) */
.gd-about-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px; /* مساحة التدرج مريحة للعين */
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, var(--gd-bg) 90%);
    display: flex;
    align-items: flex-end; /* بنزق الزرار لآخر التدرج تحت */
    justify-content: center; /* بنسنتر الزرار في النص */
    pointer-events: none; /* عشان التدرج ميعطلش لو اليوزر بيعمل Select للكلام */
    transition: opacity 0.3s ease;
}

/* ستايل زرار الـ Show More */
.gd-show-more-btn {
    pointer-events: auto; /* مهم جداً عشان الزرار يبقى شغال جوه الـ fade */
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--gd-text);
    padding: 6px 24px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.4);
    margin-bottom: 5px; /* رافعينه سنة عن الأرضية */
    transition: all 0.2s ease;
}

.gd-show-more-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.6);
}

/* لما نفتح الوصف: نخفي التدرج ونظهر كل الكلام */
.gd-about-wrapper.expanded .gd-full-desc-text {
    -webkit-line-clamp: unset;
}

.gd-about-wrapper.expanded .gd-about-fade {
    position: relative; /* بنفكه من الـ absolute عشان ينزل طبيعي تحت الكلام */
    height: auto;
    background: none; /* بنشيل التدرج الأسود */
    margin-top: 15px;
}

/* ── More Ratings Button ── */
.gd-more-ratings-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--gd-text-muted);
    border-radius: 20px;
    padding: 6px 12px;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    transition: all 0.3s ease;
    white-space: nowrap;
}

.gd-more-ratings-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateX(3px);
}


/* ══════════════════════════════════════════════════════════════
   RATINGS TAB — Full Redesign (Premium Card Grid)
   ══════════════════════════════════════════════════════════════ */

.gd-detailed-ratings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
    padding: 4px 0;
}

/* ── Base Rating Card ── */
.gd-rating-detailed-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 18px;
    padding: 20px 22px;
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
}

.gd-rating-detailed-card:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.055);
    border-color: rgba(255, 255, 255, 0.13);
}

/* Ambient glow from brand color */
.gd-rating-detailed-card::after {
    content: '';
    position: absolute;
    bottom: -30px;
    right: -20px;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--brand-color, rgba(255,255,255,0.15)) 0%, transparent 70%);
    opacity: 0.12;
    pointer-events: none;
}

/* ── Card Header ── */
.gd-rd-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.gd-rd-source {
    display: flex;
    align-items: center;
    gap: 8px;
}

.gd-rd-source-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 5px 10px;
}

.gd-rd-source-name {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.9px;
    color: rgba(255,255,255,0.55);
    text-transform: uppercase;
}

.gd-rd-icon {
    width: 15px;
    height: 15px;
    object-fit: contain;
}

.gd-rd-icon-rect {
    height: 10px;
    width: auto;
    object-fit: contain;
}

.gd-rd-label {
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--brand-color, #fff);
    background: color-mix(in srgb, var(--brand-color, #fff) 12%, transparent);
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid color-mix(in srgb, var(--brand-color, #fff) 25%, transparent);
    white-space: nowrap;
}

/* ── Score Display ── */
.gd-rd-main {
    display: flex;
    align-items: center;
    gap: 16px;
}

.gd-rd-score-wrap {
    display: flex;
    flex-direction: column;
}

.gd-rd-score-large {
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: -2px;
    line-height: 1;
    color: #fff;
    margin: 0;
}

.gd-rd-max {
    font-size: 1rem;
    opacity: 0.18;
    font-weight: 500;
    letter-spacing: 0;
}

.gd-rd-score-arc {
    position: relative;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
}

.gd-rd-score-arc svg {
    transform: rotate(-90deg);
    width: 64px;
    height: 64px;
}

.gd-rd-arc-track {
    fill: none;
    stroke: rgba(255,255,255,0.07);
    stroke-width: 5;
}

.gd-rd-arc-fill {
    fill: none;
    stroke: var(--brand-color, #fff);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 163;
    stroke-dashoffset: 163;
    transition: stroke-dashoffset 1s cubic-bezier(0.4, 0, 0.2, 1);
}

.gd-rd-arc-text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 900;
    color: #fff;
}

.gd-rd-side-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.gd-rd-score-label {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--brand-color, #fff);
    line-height: 1.2;
}

.gd-rd-score-sub {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.35);
    font-weight: 500;
}

.gd-rd-subtext { display: none; }

/* ── Footer ── */
.gd-rd-footer {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.25);
    padding-top: 10px;
    border-top: 1px solid rgba(255,255,255,0.05);
}

.gd-rd-footer strong {
    color: rgba(255, 255, 255, 0.45);
    font-weight: 700;
}

/* ══════════════════════════════════════════════════════════════
   STEAM CARD — Full-width special layout
   ══════════════════════════════════════════════════════════════ */

.steam-card {
    grid-column: 1 / -1;
}

.gd-rd-sentiment-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

/* Segmented approval bar */
.gd-rd-bar-track {
    height: 8px;
    background: rgba(255, 69, 58, 0.2);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
}

.gd-rd-bar-fill.pos {
    height: 100%;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--brand-color, #30d158), color-mix(in srgb, var(--brand-color, #30d158) 70%, #fff));
    position: relative;
}

.gd-rd-bar-fill.pos::after {
    content: '';
    position: absolute;
    right: 0; top: 0; bottom: 0;
    width: 2px;
    background: rgba(255,255,255,0.4);
}

.gd-rd-counts {
    display: flex;
    justify-content: space-between;
    font-size: 0.73rem;
    font-weight: 800; /* خليها أتقل شوية عشان تبان مع الأيقونة */
    color: rgba(255,255,255,0.5);
    margin-top: 4px;
}

.gd-rd-counts span svg {
