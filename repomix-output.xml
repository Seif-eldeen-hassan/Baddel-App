.ag-list-view.hide-platforms .ag-col-platforms { display: none; }
.ag-list-view.hide-playtime .ag-list-field-playtime,
.ag-list-view.hide-playtime .ag-col-playtime { display: none; }
.ag-list-view.hide-lastPlayed .ag-list-field-lastPlayed,
.ag-list-view.hide-lastPlayed .ag-col-lastplayed { display: none; }
.ag-list-view.hide-installed .ag-list-field-installed,
.ag-list-view.hide-installed .ag-col-installed { display: none; }
.ag-list-view.hide-title .ag-col-title-text { opacity: 0.3; }

/* ── Post-Add Account Guide Card ─────────────────────────────────────────── */
@keyframes pagSlideIn {
    from { opacity: 0; transform: translateY(-10px); }
    to   { opacity: 1; transform: translateY(0); }
}

.post-add-guide {
    animation: pagSlideIn 0.25s ease forwards;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.08);
    background: #1c1c1c;
    padding: 16px 18px;
    margin: 0 0 14px 0;
}

.pag-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.pag-title {
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.01em;
}

.pag-dismiss {
    background: none;
    border: none;
    color: #777;
    font-size: 18px;
    line-height: 1;
