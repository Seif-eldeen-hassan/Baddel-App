    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.pag-title {
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.01em;
}

.pag-dismiss {
    background: none;
    border: none;
    color: #777;
    font-size: 18px;
