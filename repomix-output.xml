                <div class="hero-watermark">${cfg.name.toUpperCase()}</div>

                <div class="accounts-hero-inner-row">
                    <div class="accounts-hero-content-v2">
                        <div class="acc-hero-logo-box">
                            ${logoHtml}
                        </div>
