        const found = pool.find(g =>
            String(g.id) === String(gameId) ||
            String(g.gameId) === String(gameId) ||
            String(g.appid) === String(gameId) ||
            String(g.path) === String(gameId)
        );
        if (found) return found;
    }
    return null;
}

