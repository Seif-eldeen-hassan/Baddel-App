        if (typeof showToast === 'function') {
            showToast('Opening YouTube...', 'success');
        }
        try {
            _openTutorialInBrowser(watchUrl);
        } catch (error) {
            if (typeof showToast === 'function') showToast('Error opening link!', 'error');
        }
