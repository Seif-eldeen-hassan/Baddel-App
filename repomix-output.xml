    if (installed) return installed;
    try {
        const games = await window.electronAPI?.getGames?.();
        if (Array.isArray(games)) {
            window.allGamesData = games;
            try { if (typeof allGamesData !== 'undefined') allGamesData = games; } catch (_) {}
