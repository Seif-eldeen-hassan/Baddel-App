                        Retry Download
                    </button>
                </div>
            </div>

            <!-- State 3: downloaded, ready to restart -->
            <div id="updateStateReady" style="display:none;">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#30d158" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <h2 class="modal-title" style="margin:0; font-size:1.1rem; color:#fff;">Ready to Install</h2>
                </div>
                <p id="updateReadyMsg" style="color:#888; font-size:0.85rem; margin-bottom:20px;">Download complete. Restart now to apply the update.</p>
                <div class="modal-actions" style="justify-content:center;">
                    <button class="btn-cancel" onclick="closeUpdateModal()">Later</button>
                    <button class="btn-primary" onclick="installUpdate()" style="background:#30d158; color:#000;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                        Restart & Install
                    </button>
                </div>
            </div>

        </div>
