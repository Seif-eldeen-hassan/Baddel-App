    return new Promise(resolve => {
        const deadline = Date.now() + timeoutMs;
        const check = () => {
            if (games.every(g => g._heroHydrated) || Date.now() >= deadline) { resolve(); return; }
            setTimeout(check, 200);
        };
        check();
    });
}

