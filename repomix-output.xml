async function _rtia_warmBatch(games) {
    const queue = [...games];
    await Promise.all(
        Array.from({ length: _RTIA_DISK_CONCURRENCY }, async () => {
            while (queue.length) {
                const g = queue.shift();
                if (g) await _rtia_warmOne(g).catch(() => {});
            }
