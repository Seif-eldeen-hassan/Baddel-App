                source: String(t.url || '').startsWith('file://') ? 'file' : 'link',
                creatorOwned: true,
            })),
        },
        assets: {},
    };
    try {
        const ok = await (window.electronAPI.exportCreatorPagePack || window.electronAPI.exportCreatorPage)?.(`${gameName}.baddelpage`, payload);
        if (ok === false) return;
