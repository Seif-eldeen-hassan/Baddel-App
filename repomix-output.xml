                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#12ce18" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
