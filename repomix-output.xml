    test('safeLauncher module loads without throwing', () => {
        assert.doesNotThrow(() => {
            require('../../services/safeLauncher');
        }, 'services/safeLauncher.js must not throw at require() time');
    });

    test('safeLauncher exports openProtocolUrl function', () => {
