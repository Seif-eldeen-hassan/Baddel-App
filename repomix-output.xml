        waitForCacheReady: [],
        getOwnedGames: 0,
    };
    const ownedResponses = [...(options.ownedResponses || [
        { status: 'success', games: [] },
    ])];
    const bridge = {
        calls,
        isRunning: !!options.isRunning,
        _cacheIsReady: true,
        on() {},
        async start() {
            calls.start++;
            bridge.isRunning = true;
        },
        async stop() {
