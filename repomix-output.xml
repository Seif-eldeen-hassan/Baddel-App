    const stored = JSON.parse(sandbox.localStorage.getItem('baddel.sidebar.sections.v1'));
    assert.equal(stored.accounts, false);
    assert.equal(sandbox.localStorage.getItem('baddel.sidebar.collapsed'), '1');
