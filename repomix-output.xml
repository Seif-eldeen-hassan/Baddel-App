/* أضف هذا داخل قسم: 8. ACCOUNT CARDS في ملف accounts.css */

/* Pin/Send to Home button */
.acc-pin-btn {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
