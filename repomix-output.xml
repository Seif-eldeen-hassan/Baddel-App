        if (!vs || !Array.isArray(vs.items) || vs.items.length === 0) return;
        if (!(vs.cardPool instanceof Map) || vs.cardPool.size === 0) return;
        if (!grid) return;
        if (!grid.style.position || grid.style.position === '') grid.style.position = 'relative';
