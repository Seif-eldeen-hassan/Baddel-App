}

// Re-export so tests can read platform metadata without calling findLauncherExe.
function getPlatformInfo(platform) {
    const cfg = _getPlatformConfig(platform);
    if (!cfg) return null;
    return {
        name:       cfg.name,
        dialogTitle: cfg.dialogTitle,
        exeNames:   cfg.exeNames,
