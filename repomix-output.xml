    // Mirrors computeArtFlags + pipelineDecision from heroBackfill.test.js
    function computeHasHero(game, diskHero) {
        return !!(game.heroImage || diskHero);
    }
    const game  = { heroImage: 'file://h.webp', image: 'file://c.webp' };
