    const manual = await getSavedManualLauncherPath(platform);
    if (manual) {
        const r = check(manual);
        if (r) return r;
        // stale — fall through to auto-detection
    }

    // ── B. Env-based candidates ──────────────────────────────────────────────
    for (const c of cfg.envCandidates()) {
        const r = check(c); if (r) return r;
    }

