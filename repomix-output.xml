    assert.match(source, /SyncLogQueue/);
    assert.match(source, /const\s+syncLogQueue\s*=\s*new\s+SyncLogQueue\(/);
    assert.doesNotMatch(source, /const\s+_platformSyncLogWriteQueue\s*=\s*\{\s*\}/);

    for (const symbol of [
