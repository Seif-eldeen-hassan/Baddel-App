        const p = `C:\\NonExistent_baddel_test_xyz\\Ubisoft\\Ubisoft Game Launcher\\${name}`;
        const err = (() => {
            try { return resolver.validateLauncherExe('ubisoft', p); }
            catch (e) { return e; }
