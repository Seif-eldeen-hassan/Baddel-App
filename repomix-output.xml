            rgba(12, 12, 12, 0.78)
        );
    border-color: rgba(255, 255, 255, 0.42);
    transform: translateY(-1px);
    box-shadow:
        0 14px 34px rgba(0, 0, 0, 0.55),
        inset 0 1px 0 rgba(255, 255, 255, 0.16);
}

/* Settings gear: نفس ارتفاع Spin Again وواضح فوق الخلفية */
