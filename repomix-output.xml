        on: () => {},
    },
};

function _mockElectron(fn) {
    const real = Module._load;
    Module._load = (req, ...rest) => {
        if (req === 'electron') return _electronStub;
        return real(req, ...rest);
    };
    try { return fn(); } finally { Module._load = real; }
}

