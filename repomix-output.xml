.gd-media-picker-close:hover { background: rgba(255,255,255,0.1); color: #fff; }
.gd-media-picker-tabs {
    display: flex;
    gap: 4px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
