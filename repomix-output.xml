    cursor: grabbing;
}

.asc-unpin-btn {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 22px;
    height: 22px;
    background: var(--danger, #ff3b30);
    color: white;
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transform: scale(0.8);
    transition: 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: 10;
    box-shadow: 0 2px 8px rgba(255, 59, 48, 0.4);
}

.account-shortcut-card:hover .asc-unpin-btn {
