            }

            // 2) Patch virtual scroller active items.
            if (Array.isArray(window._vs?.items)) {
                window._vs.items.forEach((game) => {
                    if (_agMatchesCoverPayload(game, payload)) {
                        if (_agApplyCoverToGame(game, newCover)) patchedItems++;
