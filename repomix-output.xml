    <div id="updateModal" class="modal-overlay">
        <div class="modal-box confirm-box" style="width: 420px;">

            <!-- State 1: update available, not downloaded yet -->
            <div id="updateStateAvailable">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#12ce18" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                    <h2 class="modal-title" style="margin:0; font-size:1.1rem; color:#fff;">Update Available</h2>
                </div>
                <p id="updateAvailableMsg" style="color:#888; font-size:0.85rem; margin-bottom:20px;">A new version is available.</p>
                <div class="modal-actions" style="justify-content:center;">
                    <button class="btn-cancel" onclick="closeUpdateModal()">Later</button>
                    <button class="btn-primary" id="btnStartDownload" onclick="startUpdateDownload()">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Download Update
                    </button>
                </div>
            </div>

            <!-- State 2: downloading with progress -->
            <div id="updateStateDownloading" style="display:none;">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#12ce18" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    <h2 class="modal-title" style="margin:0; font-size:1.1rem; color:#fff;">Downloading Update</h2>
                </div>
                <p id="updateDownloadInfo" style="color:#888; font-size:0.82rem; margin-bottom:6px;">Preparing download...</p>
                <p id="updateDownloadSubLabel" style="color:#666; font-size:0.78rem; margin-bottom:10px; min-height:1em;"></p>
                <!-- Progress bar -->
                <div style="background:#1a1a1a; border-radius:6px; overflow:hidden; height:6px; margin-bottom:8px;">
                    <div id="updateProgressBar" style="height:100%; width:0%; background:#12ce18; border-radius:6px; transition:width 0.3s ease;"></div>
                </div>
                <div style="display:flex; justify-content:space-between; margin-bottom:18px;">
                    <span id="updateProgressPct" style="color:#888; font-size:0.78rem;">0%</span>
                    <span id="updateProgressSpeed" style="color:#888; font-size:0.78rem;">— MB/s</span>
                </div>
                <div class="modal-actions" style="justify-content:center;">
                    <button class="btn-cancel" onclick="closeUpdateModal()">Hide — Downloading in background</button>
                </div>
            </div>

            <!-- State 4: error during download (never reverts to available — shows retry) -->
            <div id="updateStateError" style="display:none;">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ff3b30" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <h2 class="modal-title" style="margin:0; font-size:1.1rem; color:#fff;">Download Failed</h2>
                </div>
                <p id="updateErrorMsg" style="color:#ff6b60; font-size:0.85rem; margin-bottom:20px;">Something went wrong. Try again.</p>
                <div class="modal-actions" style="justify-content:center;">
                    <button class="btn-cancel" onclick="closeUpdateModal()">Later</button>
                    <button class="btn-primary" id="btnRetryDownload" onclick="startUpdateDownload()">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                        Retry Download
                    </button>
                </div>
            </div>

            <!-- State 3: downloaded, ready to restart -->
            <div id="updateStateReady" style="display:none;">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#30d158" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <h2 class="modal-title" style="margin:0; font-size:1.1rem; color:#fff;">Ready to Install</h2>
                </div>
                <p id="updateReadyMsg" style="color:#888; font-size:0.85rem; margin-bottom:20px;">Download complete. Restart now to apply the update.</p>
                <div class="modal-actions" style="justify-content:center;">
                    <button class="btn-cancel" onclick="closeUpdateModal()">Later</button>
                    <button class="btn-primary" onclick="installUpdate()" style="background:#30d158; color:#000;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                        Restart & Install
                    </button>
                </div>
            </div>

        </div>
    </div>
