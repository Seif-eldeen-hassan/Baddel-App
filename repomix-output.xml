                <div class="platform-actions" style="display: flex; gap: 10px; margin-top: auto; padding-top: 15px; border-top: 1px solid rgba(255,255,255,0.05);">
                    <button id="linkPlatformBtn" class="btn-cancel" style="flex: 1;" onclick="linkNewPlatformAccount()">Link Account</button>
                    <button id="syncPlatformBtn" class="btn-primary" style="flex: 1;" onclick="syncCurrentPlatform()">Sync Library</button>
