    assert.deepEqual(delays, [12000, 15000, 15000]);
    assert.equal(repository.getLibrary('steam')[0].coverUrl, null);
    assert.ok(logs.some((entry) => String(entry[1]).includes('giving up for 10 after 3 attempts')));
