   ============================================================ */

/* خلي منطقة الزراير compact ومش ماسكة عرض كبير */
.roulette-action-panel {
    flex: 0 1 360px;
    max-width: 360px;
    align-items: flex-start;
}

.roulette-controls {
    width: 100%;
    max-width: 320px;
    gap: 10px;
}

.roulette-spin-row {
