}

.epic-lib-thumb-placeholder {
    background: rgba(255,255,255,0.06);
}

.epic-lib-title {
    flex: 1;
    color: #ccc;
    font-size: 0.84rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Platforms Modal Styling */
.platforms-modal {
    width: 480px;
    background: #0f0f0f;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.platforms-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.platform-card {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    padding: 15px;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
