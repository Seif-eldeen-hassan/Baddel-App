    g._agCoverInFlight = false;
    g._agRemoteFallbackReady = false;
    g._agLocalRetryCount = 0;
}

        delete g._agHeroLogoDone;
    };

    const _resetArr = (arr) => {
        if (!Array.isArray(arr)) return 0;
        let changed = 0;

        arr.forEach(g => {
            if (!_resetMatches(g)) return;
            _resetCardGame(g);
            changed++;
