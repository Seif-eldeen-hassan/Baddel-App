    window.__baddelInstalledSnapshot = snapshot;
    window._lastInstalledFilteredGames = snapshot.games;
    console.info('[StartupReadiness]', 'installed-snapshot-ready', { reason, revision: snapshot.revision, count: snapshot.count });
