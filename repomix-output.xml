    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    font-family: var(--font-heading);
}

.sensor-toggle-btn:hover {
