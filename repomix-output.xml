'use strict';

const { app } = require('electron');
const path = require('path');
const fs = require('fs').promises;

const SETTINGS_FILE = () => path.join(app.getPath('userData'), 'quick-switcher-settings.json');

const VALID_POSITIONS = new Set(['right', 'center', 'left', 'top', 'bottom']);

const DEFAULTS = Object.freeze({
    version: 1,
    enabled: true,
    accelerator: 'Ctrl+Alt+B',
    position: 'right',
    closeAfterSwitch: true,
    showOnlyPlatformsWithAccounts: true,
    showSearchOnOpen: true,
    updatedAt: 0,
});

let _cache = null;

function _coerce(raw) {
    const out = { ...DEFAULTS };
    if (typeof raw.enabled === 'boolean') out.enabled = raw.enabled;
    if (typeof raw.accelerator === 'string' && raw.accelerator) out.accelerator = raw.accelerator;
    if (raw.accelerator === null) out.accelerator = null;
    if (typeof raw.position === 'string' && VALID_POSITIONS.has(raw.position)) out.position = raw.position;
    if (typeof raw.closeAfterSwitch === 'boolean') out.closeAfterSwitch = raw.closeAfterSwitch;
    if (typeof raw.showOnlyPlatformsWithAccounts === 'boolean') out.showOnlyPlatformsWithAccounts = raw.showOnlyPlatformsWithAccounts;
    if (typeof raw.showSearchOnOpen === 'boolean') out.showSearchOnOpen = raw.showSearchOnOpen;
    if (typeof raw.updatedAt === 'number') out.updatedAt = raw.updatedAt;
    return out;
}

async function load() {
    if (_cache) return { ..._cache };
    try {
        const raw = await fs.readFile(SETTINGS_FILE(), 'utf8');
        _cache = _coerce(JSON.parse(raw));
    } catch {
        _cache = { ...DEFAULTS };
    }
    return { ..._cache };
}

async function save(partial) {
    const current = await load();
    const merged = _coerce({ ...current, ...partial });
    merged.updatedAt = Date.now();
    _cache = merged;
    await fs.writeFile(SETTINGS_FILE(), JSON.stringify(merged, null, 2), 'utf8');
    return { ...merged };
}

function invalidateCache() { _cache = null; }

module.exports = { load, save, invalidateCache, VALID_POSITIONS, DEFAULTS };
</file>

<file path="src/css/quick-switcher.css">
/* ── Quick Switcher Overlay — Baddel ────────────────────────────────────────── */

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --qs-green:           #12CE18;
    --qs-green-dim:       rgba(18, 206, 24, 0.08);

    --qs-bg:              rgba(10, 11, 12, 0.94);
    --qs-panel-border:    rgba(255, 255, 255, 0.08);
    --qs-inner-border:    rgba(255, 255, 255, 0.04);

    --qs-text-primary:    rgba(255, 255, 255, 0.92);
    --qs-text-secondary:  rgba(255, 255, 255, 0.56);
    --qs-text-muted:      rgba(255, 255, 255, 0.32);

    --qs-hover-bg:        rgba(255, 255, 255, 0.04);
    --qs-selected-bg:     rgba(255, 255, 255, 0.06);
    --qs-selected-border: rgba(18, 206, 24, 0.28);
    --qs-active-bg:       rgba(18, 206, 24, 0.055);

    --qs-row-radius:      10px;
    --qs-section-gap:     14px;
}

/* ── Reset & base ─────────────────────────────────────────────────────────── */

html, body {
    width: 100%;
    height: 100%;
    background: transparent !important;
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
}

/* ── Shell (outer for animation) ──────────────────────────────────────────── */

.quick-switcher-shell {
    width: 100%;
    height: 100%;
    padding: 10px;
    box-sizing: border-box;
    background: transparent;
}

@keyframes qs-enter {
    from {
        opacity: 0;
        transform: translateX(14px) scale(0.978);
    }
    to {
        opacity: 1;
        transform: none;
    }
}

/* ── Panel (the visible glass card) ────────────────────────────────────────── */

.quick-switcher-panel {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    font-family: -apple-system, 'Segoe UI', system-ui, sans-serif;
    font-size: 13px;
    color: var(--qs-text-primary);
    border-radius: 18px;
    animation: qs-enter 0.20s cubic-bezier(0.16, 1, 0.3, 1) both;

    background:
        radial-gradient(ellipse at 12% 0%, rgba(18, 206, 24, 0.07) 0%, transparent 50%),
        linear-gradient(180deg, rgba(18, 18, 18, 0.96) 0%, rgba(5, 6, 6, 0.96) 100%);
    backdrop-filter: blur(28px) saturate(1.2);
    -webkit-backdrop-filter: blur(28px) saturate(1.2);

    border: 1px solid var(--qs-panel-border);
    box-shadow:
        inset 0 0 0 1px var(--qs-inner-border),
        0 24px 60px rgba(0, 0, 0, 0.80),
        0 4px 12px rgba(0, 0, 0, 0.50);
}

/* ── Platform-specific icon fixes (scoped to overlay only) ──────────────────── */

/* Epic Games icon is dark/black — invert it to be visible on dark background */
.quick-switcher-panel [data-platform="epic"] img {
    filter: brightness(0) invert(1);
    opacity: 0.85;
}

/* ── Header ────────────────────────────────────────────────────────────────── */

.quick-switcher-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
    -webkit-app-region: drag;
}

.quick-switcher-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    -webkit-app-region: drag;
}

.quick-switcher-logo {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
}

.quick-switcher-logo-img {
    width: 20px;
    height: 20px;
    object-fit: contain;
}

.quick-switcher-brand-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
}

.quick-switcher-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--qs-text-primary);
    letter-spacing: 0.01em;
    line-height: 1.2;
}

.quick-switcher-subtitle {
    font-size: 11px;
    color: var(--qs-text-muted);
    letter-spacing: 0.01em;
}

.qs-hotkey-hint {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--qs-text-muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    padding: 2px 6px;
    align-self: center;
    white-space: nowrap;
}

.quick-switcher-close {
    -webkit-app-region: no-drag;
    width: 26px;
    height: 26px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    color: var(--qs-text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    flex-shrink: 0;
}
.quick-switcher-close:hover {
    background: rgba(255, 255, 255, 0.10);
    color: var(--qs-text-primary);
    border-color: rgba(255, 255, 255, 0.15);
}

/* ── Search ────────────────────────────────────────────────────────────────── */

.quick-switcher-search-wrap {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 10px 12px 0;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 11px;
    flex-shrink: 0;
    transition: border-color 0.15s, box-shadow 0.15s;
    -webkit-app-region: no-drag;
}

.quick-switcher-search-wrap:focus-within {
    border-color: rgba(18, 206, 24, 0.35);
    box-shadow: 0 0 0 2px rgba(18, 206, 24, 0.07);
}

.qs-search-icon {
    color: var(--qs-text-muted);
    flex-shrink: 0;
}

.quick-switcher-search {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 13px;
    color: var(--qs-text-primary);
    caret-color: var(--qs-green);
    min-width: 0;
}
.quick-switcher-search::placeholder { color: var(--qs-text-muted); }

/* ── Account list ──────────────────────────────────────────────────────────── */

.quick-switcher-list {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 8px 8px 0;
    margin-top: 8px;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.08) transparent;
}
.quick-switcher-list::-webkit-scrollbar        { width: 4px; }
.quick-switcher-list::-webkit-scrollbar-track  { background: transparent; }
.quick-switcher-list::-webkit-scrollbar-thumb  {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
}
.quick-switcher-list::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.18);
}

/* ── Platform group ────────────────────────────────────────────────────────── */

.qs-platform-group {
    margin-bottom: var(--qs-section-gap);
}
.qs-platform-group:last-child { margin-bottom: 0; }

/* ── Platform header ───────────────────────────────────────────────────────── */

.qs-platform-header {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 4px 4px;
    user-select: none;
}

.qs-platform-heading-icon {
    width: 13px;
    height: 13px;
    object-fit: contain;
    flex-shrink: 0;
    opacity: 0.60;
}

.qs-platform-name {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--qs-text-secondary);
}

.qs-platform-count {
    font-size: 9.5px;
    font-weight: 600;
    color: var(--qs-text-muted);
    background: rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    padding: 0px 5px;
    line-height: 1.6;
}

/* ── Account row ───────────────────────────────────────────────────────────── */

.qs-account-row {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 46px;
    padding: 7px 10px 7px 14px;
    margin-bottom: 5px;
    border: 1px solid transparent;
    border-radius: var(--qs-row-radius);
    background: transparent;
    color: var(--qs-text-primary);
    cursor: pointer;
    text-align: left;
    transition: background 0.10s, border-color 0.10s, transform 0.08s;
    position: relative;
}
.qs-account-row:hover {
    background: var(--qs-hover-bg);
}
.qs-account-row.is-selected {
    background: var(--qs-selected-bg);
    border-color: var(--qs-selected-border);
    transform: translateX(2px);
}
.qs-account-row.is-active {
    background: var(--qs-active-bg);
}
.qs-account-row.is-active.is-selected {
    background: rgba(18, 206, 24, 0.09);
    border-color: var(--qs-selected-border);
}
.qs-account-row.is-switching {
    opacity: 0.5;
    pointer-events: none;
}

/* ── Row indicator (green left bar) ────────────────────────────────────────── */

.qs-row-indicator {
    position: absolute;
    left: 4px;
    top: 8px;
    bottom: 8px;
    width: 3px;
    border-radius: 3px;
    background: transparent;
    transition: background 0.12s;
}
.qs-account-row.is-active .qs-row-indicator {
    background: var(--qs-green);
}
.qs-account-row.is-selected .qs-row-indicator {
    background: rgba(18, 206, 24, 0.50);
}
.qs-account-row.is-active.is-selected .qs-row-indicator {
    background: var(--qs-green);
}

/* ── Account icon wrap (platform icon in row) ──────────────────────────────── */

.qs-account-icon-wrap {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
}

.qs-platform-icon {
    width: 16px;
    height: 16px;
    object-fit: contain;
    display: block;
}

.qs-platform-icon-fallback {
    font-size: 10px;
    font-weight: 800;
    color: var(--qs-text-secondary);
    letter-spacing: -0.02em;
    user-select: none;
}

/* ── Account info ──────────────────────────────────────────────────────────── */

.qs-account-main {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
    min-width: 0;
}

.qs-account-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--qs-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.qs-account-row.is-active .qs-account-name {
    color: rgba(255, 255, 255, 0.95);
}

.qs-account-meta {
    font-size: 10.5px;
    color: var(--qs-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ── Account side (badges + enter hint) ─────────────────────────────────────── */

.qs-account-side {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
}

.qs-active-badge {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--qs-green);
    background: rgba(18, 206, 24, 0.10);
    border: 1px solid rgba(18, 206, 24, 0.22);
    border-radius: 4px;
    padding: 1px 5px;
}

.qs-shortcut-pill {
    font-family: 'Consolas', 'SF Mono', 'Cascadia Code', monospace;
    font-size: 9.5px;
    color: var(--qs-text-muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 4px;
    padding: 1px 5px;
    white-space: nowrap;
}

.qs-enter-hint {
    font-size: 13px;
    color: var(--qs-green);
    opacity: 0;
    transition: opacity 0.10s;
    line-height: 1;
}
.qs-account-row:hover .qs-enter-hint,
.qs-account-row.is-selected .qs-enter-hint {
    opacity: 1;
}

/* ── Error bar ─────────────────────────────────────────────────────────────── */

.qs-error-bar {
    margin: 6px 8px 0;
    padding: 0;
    font-size: 11.5px;
    color: #ff5c6c;
    min-height: 0;
    transition: all 0.15s;
}
.qs-error-bar:not(:empty) {
    padding: 7px 11px;
    background: rgba(255, 76, 96, 0.07);
    border: 1px solid rgba(255, 76, 96, 0.22);
    border-radius: 8px;
    min-height: auto;
    margin-bottom: 2px;
}

/* ── Empty state ───────────────────────────────────────────────────────────── */

.qs-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 28px 16px;
    text-align: center;
}

.qs-empty-icon {
    color: var(--qs-text-muted);
    margin-bottom: 4px;
    opacity: 0.6;
}

.qs-empty strong {
    font-size: 13px;
    font-weight: 600;
    color: var(--qs-text-secondary);
}

.qs-empty span {
    font-size: 11.5px;
    color: var(--qs-text-muted);
}

/* ── Loading state ─────────────────────────────────────────────────────────── */

.qs-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 28px 16px;
    color: var(--qs-text-muted);
    font-size: 12.5px;
}

.qs-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.08);
    border-top-color: var(--qs-green);
    border-radius: 50%;
    animation: qs-spin 0.65s linear infinite;
    flex-shrink: 0;
}

@keyframes qs-spin {
    to { transform: rotate(360deg); }
}

/* ── Footer ────────────────────────────────────────────────────────────────── */

.quick-switcher-footer {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 14px 10px;
    margin-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    flex-shrink: 0;
}

.qs-keycap {
    font-family: -apple-system, 'Segoe UI', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.50);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 1px 4px;
    line-height: 1.4;
    user-select: none;
}

.qs-footer-label {
    font-size: 10px;
    color: var(--qs-text-muted);
    margin-right: 3px;
}

.qs-footer-sep {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.18);
    margin: 0 2px;
    user-select: none;
}

/* ── Reduced motion ────────────────────────────────────────────────────────── */

@media (prefers-reduced-motion: reduce) {
    .quick-switcher-panel        { animation: none; }
    .qs-spinner                  { animation: none; border-top-color: var(--qs-text-muted); }
    .qs-account-row              { transition: none; }
    .qs-enter-hint               { transition: none; }
    .qs-row-indicator            { transition: none; }
    .quick-switcher-close        { transition: none; }
    .quick-switcher-search-wrap  { transition: none; }
}
