// ─── buildPlaytimeCache behavior ─────────────────────────────────────────────

test('buildPlaytimeCache: returns empty object for empty array', () => {
    assert.deepEqual(buildPlaytimeCache([]), {});
});

test('buildPlaytimeCache: skips games with no playtime fields', () => {
