/* ❌ UNPIN BUTTON & SORTABLE FOR SHORTCUTS  */
/* ========================================= */
.account-shortcut-card {
    position: relative; /* مهم عشان الزرار يظبط مكانه */
    cursor: grab; /* شكل الماوس كأنه بيمسك الكارت */
}

