/* ============================================================
   BADDEL LAUNCHER — SHARED FONT DEFINITIONS
   All @font-face declarations live here exactly once.
   All CSS files import this via: @import url('./fonts.css');
   Paths are relative to src/css/ → ../../assets/fonts/
   ============================================================ */

/* ── Lufga (premium display / brand titles only) ── */
