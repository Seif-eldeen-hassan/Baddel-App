}
.btn-secondary-hero:hover { background: rgba(255,255,255,0.1); color: white; border-color: rgba(255,255,255,0.2); }

/* ========================================= */
/* 6. RECENTLY PLAYED & LIBRARY HEADER       */
/* ========================================= */
.recently-played-section, .library-section { padding: 30px 40px; }

.section-title {
    font-family: var(--font-heading); font-size: 1.3rem; font-weight: 800;
    margin-bottom: 20px; color: white; display: flex; align-items: center; gap: 10px;
}
.section-title::before { content: ''; display: block; width: 3px; height: 16px; background: var(--accent); border-radius: 3px; }

.library-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; gap: 20px; flex-wrap: wrap;}
.header-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap;}

.add-game-btn { background: #1a1a1a; color: #ccc; border: 1px solid #333; padding: 9px 18px; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer; transition: 0.2s; }
.add-game-btn:hover { background: #222; color: white; border-color: #444; }

.icon-btn {
    background: #1a1a1a; color: #666; border: 1px solid #333;
    width: 36px; height: 36px; border-radius: 8px; cursor: pointer;
    transition: 0.2s; display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
}
.icon-btn:hover { border-color: #444; color: var(--accent); background: #222;}

.search-container input {
    background: #111; border: 1px solid #222; color: white;
    padding: 9px 15px; border-radius: 8px; width: 220px; font-size: 0.85rem; transition: 0.3s;
}
.search-container input:focus {
    border-color: #333; 
    background: #151515; 
    width: 260px; 
}
/* Platform Dropdown */
.custom-dropdown { position: relative; display: inline-block; cursor: pointer; font-size: 0.85rem;}
.dropdown-trigger { background: #1a1a1a; border: 1px solid #333; color: #ccc; padding: 9px 15px; border-radius: 8px; min-width: 140px; display: flex; justify-content: space-between; align-items: center; transition: border-color 0.12s, color 0.12s; }

/* All Accounts pill — override dropdown-trigger min-width */
.ag-account-trigger.dropdown-trigger {
    min-width: unset !important;
    width: auto !important;
    padding: 5px 12px !important;
    border-radius: 20px !important;
    background: rgba(255,255,255,0.05) !important;
    border: 1.5px solid rgba(255,255,255,0.1) !important;
    color: #aaa !important;
    font-size: 0.75rem !important;
    gap: 5px !important;
    cursor: pointer;
}
.dropdown-trigger:hover { border-color: #444; color: white; }
.dropdown-menu { display: none; position: absolute; top: 110%; right: 0; background: #1a1a1a; border: 1px solid #333; border-radius: 8px; width: 100%; z-index: 100; box-shadow: 0 10px 25px rgba(0,0,0,0.5); overflow: hidden; }
.dropdown-menu.active { display: block; animation: fadeUp 0.15s ease; }
.dropdown-item { padding: 10px 15px; transition: background-color 0.1s, color 0.1s; color: #999; }
.dropdown-item:hover { background: rgba(255,255,255,0.03); color: white; }

/* ========================================= */
/* 7. GAMES GRID & CARDS (APPLE TV STYLE)    */
/* ========================================= */
.games-grid, .recent-grid {
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(180px, 220px)); 
    gap: 24px;
    justify-content: start;
}

.game-card {
    position: relative; border-radius: 12px; overflow: hidden;
    aspect-ratio: 2 / 3; cursor: pointer; border: 1px solid rgba(255,255,255,0.05);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
    background: #111;
    will-change: transform; 
    contain: layout style; 
}

.game-card:hover {
    transform: translateY(-8px) scale(1.03);
    box-shadow: 0 20px 40px rgba(0,0,0,0.8); 
    z-index: 10;
    border-color: rgba(255,255,255,0.15);
}

.actual-img.fallback-hero {
    filter: brightness(0.4) saturate(0.8);
}

.gc-logo-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    max-height: 40%;
    object-fit: contain;
    z-index: 2;
    pointer-events: none;
    filter: drop-shadow(0 4px 10px rgba(0,0,0,0.8));
    animation: fadeUp 0.6s ease;
}

.game-card:hover .actual-img { transform: scale(1.05); filter: brightness(0.6); } 
.game-card:hover .actual-img.fallback-hero { filter: brightness(0.3) saturate(0.6); } 

.gc-grad-bottom {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 40%, transparent 100%);
    z-index: 1; transition: opacity 0.3s ease;
}

/* Gradient من فوق عشان الـ badges تبان أحسن */
.gc-grad-top {
    position: absolute; top: 0; left: 0; right: 0; height: 60px;
    background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, transparent 100%);
    z-index: 2; pointer-events: none;
}

.gc-platform {
    position: absolute; top: 12px; left: 12px;
    font-size: 9px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
    padding: 5px 10px; border-radius: 20px;
    background: rgba(0,0,0,0.6);
    color: white; z-index: 2; border: 1px solid rgba(255,255,255,0.1);
}

/* ========================================= */
/* 🏷️ PLATFORM BADGES ON GAME CARDS          */
/* ========================================= */
.gc-platforms {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    z-index: 3;
    align-items: flex-end;
    /* Hidden by default — fade + slide in on card hover */
    opacity: 0;
    transform: translateY(-5px);
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
}

.game-card:hover .gc-platforms {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
}

.plat-badge {
    --plat-c: #ffffff;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.80);
    border: 1px solid color-mix(in srgb, var(--plat-c) 30%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    /* backdrop-filter removed: was causing paint/composite during scroll */
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.5);
    /* subtle glow من لون المنصة */
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--plat-c) 0%, transparent),
                0 2px 8px rgba(0,0,0,0.5);
}

.game-card:hover .plat-badge {
    border-color: color-mix(in srgb, var(--plat-c) 60%, transparent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--plat-c) 25%, transparent),
                0 2px 8px rgba(0,0,0,0.5);
    transform: scale(1.08);
}

.plat-badge-img {
    width: 14px;
    height: 14px;
    object-fit: contain;
    display: block;
    filter: brightness(0.85);
    transition: filter 0.2s ease;
}

.game-card:hover .plat-badge-img {
    filter: brightness(1);
}

.plat-badge-invert {
    filter: brightness(0) invert(1) !important;
    opacity: 0.75;
}

.game-card:hover .plat-badge-invert {
    opacity: 1;
}

.plat-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: block;
    opacity: 0.8;
}

/* +N overflow badge */
.plat-badge-more {
    font-size: 0.6rem;
    font-weight: 800;
    color: rgba(255,255,255,0.6);
    letter-spacing: 0.5px;
    font-family: var(--font-heading, sans-serif);
    border-color: rgba(255,255,255,0.12);
}

.game-card:hover .plat-badge-more {
    color: rgba(255,255,255,0.9);
    border-color: rgba(255,255,255,0.3);
    box-shadow: none;
}

/* In All Games view, platform badges are slightly smaller to match the compact cards. */
#allGamesGrid .plat-badge {
    width: 22px;
    height: 22px;
    border-radius: 6px;
}

#allGamesGrid .plat-badge-img {
    width: 12px;
    height: 12px;
}

.gc-info {
    position: absolute; bottom: 0; left: 0; width: 100%;
    padding: 18px; display: flex; flex-direction: column; gap: 4px;
    z-index: 2; transition: opacity 0.3s ease, transform 0.3s ease;
}
.game-card:hover .gc-info { opacity: 0; transform: translateY(10px); }

.gc-name {
    font-size: 1.05rem; font-weight: 600; color: #fff;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    text-shadow: 0 2px 10px rgba(0,0,0,0.8);
}
.gc-time {
    display: flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 500; color: var(--text-sec);
}
.gc-time.played { color: #fff; opacity: 0.8; } 

.play-btn-center {
    position: absolute; 
    top: 50%; 
    left: 50%; 
    transform: translate(-50%, -40%); 
    
    background: rgba(255, 255, 255, 0.25); 
    color: white; 
    border: 1px solid rgba(255, 255, 255, 0.3);
    
    padding: 12px 30px; 
    border-radius: 30px; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    gap: 8px; 
    
    opacity: 0; 
    z-index: 3; 
    cursor: pointer; 
    font-weight: 600; 
    font-size: 0.9rem; 
    letter-spacing: 1px;
    
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.game-card:hover .play-btn-center { 
    opacity: 1; 
    transform: translate(-50%, -50%); 
}

.play-btn-center:hover { 
    background: rgba(255, 255, 255, 0.9); 
    color: black; 
    transform: translate(-50%, -50%) scale(1.05); 
}

.play-btn-center svg { width: 16px; height: 16px; fill: currentColor; }

#gamesGrid.density-compact .play-btn-center {
    padding: 6px 10px;
    font-size: 0.62rem;
    letter-spacing: 0.5px;
    border-radius: 20px;
    gap: 4px;
}
#gamesGrid.density-compact .play-btn-center svg {
    width: 10px;
    height: 10px;
}
#gamesGrid.density-large .play-btn-center {
    padding: 14px 36px;
    font-size: 1rem;
    gap: 10px;
}
#gamesGrid.density-large .play-btn-center svg {
    width: 18px;
    height: 18px;
}

/* ========================================= */
/* 8. MODALS & OVERLAYS                      */
/* ========================================= */
.modal-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.7); backdrop-filter: blur(5px);
    z-index: 9999; display: flex; justify-content: center; align-items: center;
    opacity: 0; pointer-events: none; 
    visibility: hidden; 
    transition: opacity 0.3s ease, visibility 0.3s;
}
.modal-overlay.active { 
    opacity: 1; pointer-events: auto; 
    visibility: visible;
}

.modal-box {
    background: #111; width: 420px; border-radius: 12px;
    border: 1px solid #222; padding: 25px;
    transform: translateY(15px); transition: 0.3s ease;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
}
.modal-overlay.active .modal-box { transform: translateY(0); }

.modal-title { font-family: var(--font-heading); font-size: 1.3rem; margin-bottom: 20px; color: white; display: flex; align-items: center; gap: 10px; }

.modal-input {
    width: 100%; background: #050505; border: 1px solid #222; color: white;
    padding: 12px 15px; border-radius: 8px; margin-bottom: 15px;
    font-family: var(--font-main); font-size: 0.9rem; transition: 0.2s;
}
.modal-input:focus { border-color: #444; background: #080808;}

.modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; }

/* Buttons */
.btn-cancel { background: transparent; border: 1px solid #333; color: #888; padding: 9px 18px; border-radius: 8px; cursor: pointer; transition: 0.2s; font-weight: 600; font-size: 0.85rem;}
.btn-cancel:hover { background: #1a1a1a; color: white; border-color: #444; }

.btn-primary { background: var(--accent); border: none; color: black; padding: 9px 18px; border-radius: 8px; font-weight: 700; cursor: pointer; transition: 0.2s; font-size: 0.85rem; }
.btn-primary:hover { background: white; }

.btn-danger { background: rgba(255, 68, 68, 0.1); border: 1px solid rgba(255, 68, 68, 0.2); color: #ff6b6b; padding: 9px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: 0.2s; font-size: 0.85rem; }
.btn-danger:hover { background: #ff4444; color: white; border-color: #ff4444; }

/* Settings overlay — lighter dim so background shows through glass */
.settings-overlay {
    background: rgba(0,0,0,0.80) !important;
    backdrop-filter: blur(16px) !important;
}

.settings-overlay .modal-content {
    background: #111 !important;
    border: 1px solid #222 !important;
    border-radius: 16px !important;
    padding: 28px !important;
    box-shadow: 0 30px 80px rgba(0,0,0,0.9) !important;
}

/* Settings Modal Specific — glassmorphism */
.settings-modal {
    width: 550px;
    background: rgba(12, 12, 14, 0.95) !important;
    backdrop-filter: blur(28px) saturate(160%) !important;
    -webkit-backdrop-filter: blur(28px) saturate(160%) !important;
    border: 1px solid rgba(255,255,255,0.07) !important;
    box-shadow: 0 24px 64px rgba(0,0,0,0.7), inset 0 1px 0 rgba(255,255,255,0.05) !important;
}
.settings-group { margin-bottom: 15px; }
.settings-group label { display: block; color: #666; font-size: 0.8rem; margin-bottom: 6px; font-weight: 600;}

.settings-images { display: flex; gap: 15px; margin-top: 20px; }
.image-edit-block { flex: 1; display: flex; flex-direction: column; gap: 8px; }

.image-click-zone {
    width: 100%; height: 160px; background: #0a0a0a; border-radius: 8px;
    border: 1px solid #222; cursor: pointer; position: relative;
    overflow: hidden; transition: 0.2s;
}
.image-click-zone:hover { border-color: var(--accent); background: #0d0d0d; }

.image-click-zone:hover .setting-img-preview { filter: brightness(0.8); transform: scale(1.03); }

.setting-img-preview { 
    width: 100%; height: 100%; object-fit: cover; transition: 0.3s; 
}

.change-hint-overlay {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.75); display: flex; flex-direction: column;
    justify-content: center; align-items: center; opacity: 0; transition: 0.3s;
    color: white; font-size: 0.85rem; font-weight: 600;
}
.image-click-zone:hover .change-hint-overlay { opacity: 1; }
.image-click-zone:hover .setting-img-preview { transform: scale(1.05); filter: blur(2px); }

.btn-reset-image {
    background: rgba(255,255,255,0.03); border: 1px solid #222;
    color: #888; padding: 8px; border-radius: 6px; cursor: pointer;
    font-size: 0.75rem; font-weight: 600; transition: 0.2s;
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 6px;
}
.btn-reset-image:hover { background: rgba(255, 68, 68, 0.05); color: #ff6b6b; border-color: rgba(255, 68, 68, 0.2); }

/* 🟢 New Reset Button Style */
.btn-reset-image {
    background: rgba(255,255,255,0.03); border: 1px solid #222;
    color: #666; padding: 6px; border-radius: 6px; cursor: pointer;
    font-size: 0.75rem; font-weight: 600; transition: 0.2s;
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 4px;
}
.btn-reset-image:hover { background: rgba(255, 68, 68, 0.05); color: #ff6b6b; border-color: rgba(255, 68, 68, 0.2); }

/* Picker Modal Specific */
.picker-modal { width: 650px; height: 75vh; display: flex; flex-direction: column; }
.picker-header { display: flex; align-items: center; gap: 15px; margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #222;}
.back-btn { padding: 6px 12px; font-size: 0.8rem; flex-shrink: 0;}
.path-text { color: var(--accent); font-size: 0.8rem; font-family: var(--font-code); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-grow: 1;}

.dir-list { flex-grow: 1; overflow-y: auto; background: #0a0a0a; border: 1px solid #222; border-radius: 8px; padding: 8px; }
.dir-item { padding: 9px 12px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; gap: 10px; transition: 0.1s; color: #ccc; font-size: 0.85rem;}
.dir-item:hover { background: rgba(255,255,255,0.03); color: white; }
.item-icon { width: 18px; text-align: center; color: #555;}
.dir-item:hover .item-icon { color: var(--accent); }
.item-icon img { width: 16px; height: 16px; object-fit: contain; }

/* Confirm Modal Specific */
.confirm-box { width: 350px; text-align: center; }
.confirm-msg { color: #888; font-size: 0.9rem; margin-bottom: 25px; line-height: 1.5; }
.centere-actions { justify-content: center; }
.danger-text { color: var(--danger); justify-content: center;}

/* ========================================= */
/* 🗑️ RECYCLE BIN MODAL & CUSTOM CHECKBOX    */
/* ========================================= */
.bin-modal { width: 600px; }

.bin-list { 
    max-height: 380px; 
    overflow-y: auto; 
    margin-bottom: 20px; 
    padding-right: 10px; 
    display: flex;
    flex-direction: column;
    gap: 8px; 
}

.bin-item {
    display: flex;
    align-items: center;
    padding: 10px 15px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    transition: 0.2s;
}
.bin-item:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
}

/* ── إلغاء الشكل الافتراضي للـ checkbox نهائياً ── */
input[type="checkbox"].custom-checkbox-input,
.custom-checkbox input[type="checkbox"] {
    -webkit-appearance: none !important;
    -moz-appearance: none !important;
    appearance: none !important;
    margin: 0; padding: 0;
}

.custom-checkbox {
    position: relative;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    margin-right: 15px;
    width: 20px;
    height: 20px;
}
.custom-checkbox input {
    opacity: 0; width: 0; height: 0; position: absolute;
    pointer-events: none;
}
.checkmark {
    position: absolute; top: 0; left: 0;
    height: 20px; width: 20px;
    background-color: rgba(255,255,255,0.04);
    border: 1.5px solid rgba(255,255,255,0.2);
    border-radius: 6px;
    transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
}
.custom-checkbox:hover .checkmark {
    border-color: var(--accent);
    background-color: rgba(255,255,255,0.07);
}
.custom-checkbox input:checked ~ .checkmark {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
}
.checkmark:after {
    content: "";
    position: absolute; display: none;
    left: 6px; top: 2.5px;
    width: 5px; height: 9px;
    border: solid #000;
    border-width: 0 2px 2px 0;
    border-radius: 1px;
    transform: rotate(45deg);
}
/* ========================================= */
/* Confirm Modal Specific                    */
/* ========================================= */

#confirmModal {
    z-index: 100005 !important; 
}

.custom-checkbox input:checked ~ .checkmark:after { display: block; }

/* ========================================= */
/* ALL GAMES - Installed Only Toggle Button  */
/* ========================================= */
.ag-installed-toggle {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #aaa;
    background: rgba(255,255,255,0.05);
    border: 1.5px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    cursor: pointer;
    /* Only animate paint properties — no layout, no box-shadow composite */
    transition: color 0.12s, background-color 0.12s, border-color 0.12s;
    white-space: nowrap;
    /* Own layer so hover repaints don't touch surrounding content */
    will-change: background-color;
}
.ag-installed-toggle:hover {
    color: #fff;
    background: rgba(255,255,255,0.09);
    border-color: rgba(255,255,255,0.25);
}
.ag-installed-toggle.active {
    color: #000;
    background: var(--accent);
    border-color: var(--accent);
    /* Removed box-shadow — triggers stacking-context repaint on every state change */
}
.ag-installed-toggle.active svg { stroke: #000; }

/* ========================================= */
/* 9. CONTEXT MENU & TOASTS                  */
/* ========================================= */
.context-menu {
    position: fixed; background: #181818; border: 1px solid #282828;
    border-radius: 8px; width: 190px; padding: 5px 0; z-index: 100000;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5); display: none; 
    animation: fadeUp 0.15s ease;
}
.menu-item {
    padding: 10px 15px; font-size: 0.8rem; cursor: pointer; color: #bbb;
    transition: 0.1s; display: flex; justify-content: space-between; align-items: center; gap: 10px;
}
.menu-item:hover { background: #222; color: white; }
.menu-item.delete:hover { background: rgba(255, 68, 68, 0.08); color: #ff6b6b; }
.menu-item hr { border: 0; border-top: 1px solid #282828; margin: 4px 0; }
/* ========================================= */
/* SUBMENU FIX (Add to Collection)           */
/* ========================================= */
.submenu {
    position: absolute; 
    top: 0;
    background: #181818;
    border: 1px solid #282828;
    border-radius: 8px;
    width: 190px;
    padding: 5px 0;
    z-index: 100001;
    box-shadow: 0 10px 30px rgba(0,0,0,0.8);
    display: none; 
}

.menu-item:hover .submenu {
    display: block;
    animation: fadeUp 0.15s ease;
}

.submenu .dropdown-item {
    padding: 10px 15px;
    font-size: 0.8rem;
    cursor: pointer;
    color: #bbb;
    transition: 0.1s;
}

.submenu .dropdown-item:hover {
    background: rgba(255, 255, 255, 0.08);
    color: white;
}
.submenu-icon { font-size: 0.6rem; color: #555; }

/* Toasts */
#toast-wrapper { position: fixed; bottom: 25px; right: 25px; z-index: 99999; display: flex; flex-direction: column; gap: 8px; }
.toast-notification {
    background: #111; border: 1px solid #222; border-left: 3px solid var(--accent);
    color: white; padding: 12px 20px; border-radius: 6px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.3); animation: slideInRight 0.3s ease-out;
    font-weight: 600; font-size: 0.85rem; pointer-events: none;
}
.toast-error { border-left-color: var(--danger); }

/* ========================================= */
/* MAIN APP LOADER (CINEMATIC ENTRY)         */
/* ========================================= */
/* ═══════════════════════════════════════════════════════
   BADDEL SPLASH SCREEN — JS-driven, no CSS auto-play
═══════════════════════════════════════════════════════ */

/* ── Container ─────────────────────────────────────── */
.loader-container {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: #060608;
    z-index: 99999;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s;
    overflow: hidden;
}
.loader-container.active {
    opacity: 1; pointer-events: all;
    visibility: visible;
}

/* ── Particle canvas ────────────────────────────────── */
.splash-canvas {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    opacity: 0;
    transition: opacity 1.6s ease;
    pointer-events: none;
}
.splash-canvas.visible { opacity: 1; }

/* ── Scan line sweep ────────────────────────────────── */
.splash-scan {
    position: absolute;
    left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg,
        transparent 0%,
        rgba(255,255,255,0.0) 10%,
        rgba(255,255,255,0.55) 50%,
        rgba(255,255,255,0.0) 90%,
        transparent 100%
    );
    top: -2px;
    opacity: 0;
    z-index: 10;
    pointer-events: none;
}

/* ── Corner brackets — tech UI ──────────────────────── */
.splash-corner {
    position: absolute;
    width: 26px; height: 26px;
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.7s cubic-bezier(.16,1,.3,1);
    z-index: 8;
    pointer-events: none;
}
.splash-corner::before,
.splash-corner::after {
    content: '';
    position: absolute;
    background: rgba(255,255,255,0.4);
}
.splash-corner::before { width: 100%; height: 1.5px; top: 0; }
.splash-corner::after  { width: 1.5px; height: 100%; top: 0; }

.splash-corner-tl { top: 24px; left: 28px; transform: translate(-6px,-6px); }
.splash-corner-tr { top: 24px; right: 28px; transform: translate(6px,-6px); transform-origin: right top; }
.splash-corner-bl { bottom: 24px; left: 28px; transform: translate(-6px,6px); transform-origin: left bottom; }
.splash-corner-br { bottom: 24px; right: 28px; transform: translate(6px,6px); transform-origin: right bottom; }

.splash-corner-tr::before { right: 0; }
.splash-corner-tr::after  { right: 0; left: auto; }
.splash-corner-bl::before { bottom: 0; top: auto; }
.splash-corner-bl::after  { bottom: 0; top: auto; }
.splash-corner-br::before { bottom: 0; top: auto; right: 0; }
.splash-corner-br::after  { right: 0; left: auto; bottom: 0; top: auto; }

.splash-corner.visible {
    opacity: 1;
    transform: translate(0,0) !important;
}

/* ── Top HUD bar ────────────────────────────────────── */
.splash-hud-top {
    position: absolute;
    top: 24px; left: 58px; right: 58px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 9;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.5s ease 0.2s, transform 0.6s cubic-bezier(.16,1,.3,1) 0.2s;
    pointer-events: none;
}
.splash-hud-top.visible { opacity: 1; transform: translateY(0); }

/* ── Bottom HUD bar ─────────────────────────────────── */
.splash-hud-bot {
    position: absolute;
    bottom: 24px; left: 58px; right: 58px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 9;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease 0.3s, transform 0.6s cubic-bezier(.16,1,.3,1) 0.3s;
    pointer-events: none;
}
.splash-hud-bot.visible { opacity: 1; transform: translateY(0); }

.splash-hud-text {
    font-family: var(--font-code);
    font-size: 8.5px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.18);
}
.splash-hud-dot {
    width: 4px; height: 4px; border-radius: 50%;
    background: rgba(255,255,255,0.5);
    animation: splashHudPulse 2s ease-in-out infinite;
}

/* ── Vignette ───────────────────────────────────────── */
.splash-vignette {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 75% 70% at 50% 50%, transparent 25%, rgba(0,0,0,0.75) 100%);
    pointer-events: none;
    z-index: 5;
}

/* ── Center stage ───────────────────────────────────── */
.splash-center {
    position: relative; z-index: 6;
    display: flex; flex-direction: column; align-items: center;
    gap: 0;
    opacity: 1;
}

/* ── Logo ring system ───────────────────────────────── */
.splash-logo-wrap {
    position: relative;
    width: 96px; height: 96px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 32px;
    opacity: 0;
    transform: scale(0.72);
    transition: opacity 0.7s cubic-bezier(.16,1,.3,1),
                transform 0.9s cubic-bezier(.16,1,.3,1);
}
.splash-logo-wrap.visible {
    opacity: 1; transform: scale(1);
}

/* ── Premium arc loader ─────────────────────────────── */

/* Static orbit baseline */
.splash-ring-outer {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.05);
    opacity: 0;
    transition: opacity 0.5s ease 0.6s;
    pointer-events: none;
}
.splash-logo-wrap.visible .splash-ring-outer { opacity: 1; }

/* SVG arc spinner — sits as a pseudo-element via a wrapper div */
.splash-ring-inner {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.5s ease 0.8s;
    pointer-events: none;
    /* SVG drawn via the ring canvas below */
}
.splash-logo-wrap.visible .splash-ring-inner { opacity: 1; }

/* Arc canvas — the actual animated element */
.splash-arc-svg {
    position: absolute;
    inset: -10px;
    width: calc(100% + 20px);
    height: calc(100% + 20px);
    opacity: 0;
    transition: opacity 0.5s ease 0.7s;
    pointer-events: none;
    overflow: visible;
}
.splash-logo-wrap.visible .splash-arc-svg { opacity: 1; }

/* Outer arc track (static faint circle) */
.splash-arc-track {
    fill: none;
    stroke: rgba(255,255,255,0.06);
    stroke-width: 1.2;
}

/* Primary chasing arc */
.splash-arc-primary {
    fill: none;
    stroke: rgba(255,255,255,0.85);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: 52 136;   /* arc length, gap to complete the circle */
    stroke-dashoffset: 0;
    transform-origin: center;
    animation: splashArcSpin 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    filter: drop-shadow(0 0 4px rgba(255,255,255,0.5));
}

/* Secondary trailing arc, smaller & dimmer */
.splash-arc-secondary {
    fill: none;
    stroke: rgba(255,255,255,0.22);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-dasharray: 28 160;
    stroke-dashoffset: 60;
    transform-origin: center;
    animation: splashArcSpin 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    animation-delay: -0.45s;
}

/* Inner micro-arc (tighter radius, counter-spin) */
.splash-arc-inner {
    fill: none;
    stroke: rgba(255,255,255,0.18);
    stroke-width: 1px;
    stroke-linecap: round;
    stroke-dasharray: 18 94;
    stroke-dashoffset: 0;
    transform-origin: center;
    animation: splashArcSpinReverse 2.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

/* Four static tick marks on the orbit ring */
.splash-arc-tick {
    fill: none;
    stroke: rgba(255,255,255,0.18);
    stroke-width: 2.5;
    stroke-linecap: round;
}

/* Logo image box */
.splash-logo-box {
    position: relative;
    width: 64px; height: 64px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow:
        0 0 0 1px rgba(255,255,255,0.07),
        0 20px 48px rgba(0,0,0,0.7),
        inset 0 1px 0 rgba(255,255,255,0.08);
}
/* Glint sweep */
.splash-logo-box::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
        115deg,
        transparent 0%,
        rgba(255,255,255,0.12) 45%,
        rgba(255,255,255,0.18) 50%,
        transparent 55%
    );
    transform: translateX(-200%);
    animation: splashLogoGlint 3.5s ease-in-out 1.2s infinite;
    z-index: 2;
}
.splash-logo-img {
    width: 100%; height: 100%;
    display: block;
    object-fit: cover;
    filter: brightness(0.92);
}

/* ── Wordmark ───────────────────────────────────────── */
.splash-wordstack {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    overflow: hidden;
    width: 100%;
    text-align: center;
}

.splash-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(20px, 2.2vw, 26px);
    letter-spacing: 0.52em;
    color: rgba(255,255,255,0.92);

    display: block;
    width: max-content;
    margin: 0 auto;
    text-align: center;
    padding-left: 0.52em;
    padding-right: 0;

    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.8s cubic-bezier(.16,1,.3,1);
}
.splash-name.visible { clip-path: inset(0 0% 0 0); }

.splash-sub {
    font-family: var(--font-code);
    font-size: 8.5px; letter-spacing: 0.28em; text-transform: uppercase;
    color: rgba(255,255,255,0.22);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(.16,1,.3,1);
}
.splash-sub.visible { opacity: 1; transform: translateY(0); }

/* ── Status row ─────────────────────────────────────── */
.splash-status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    opacity: 0;
    transition: opacity 0.4s ease;
}
.splash-status.visible { opacity: 1; }

.splash-status-dash {
    width: 18px; height: 1px;
    background: rgba(255,255,255,0.28);
}
.splash-status-text {
    font-family: var(--font-code);
    font-size: 8px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.28);
    transition: opacity 0.18s ease;
}
.splash-status-cursor {
    width: 1px; height: 10px;
    background: rgba(255,255,255,0.4);
    animation: splashCursorBlink 0.9s step-end infinite;
}

/* ── Progress hairline ──────────────────────────────── */
.splash-progress-track {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: rgba(255,255,255,0.04);
    z-index: 3;
    overflow: hidden;
}
.splash-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg,
        rgba(255,255,255,0.0) 0%,
        rgba(255,255,255,0.85) 60%,
        rgba(255,255,255,1.0) 100%
    );
    position: relative;
    will-change: width;
}
.splash-progress-bar::after {
    content: '';
    position: absolute;
    right: 0; top: -3px;
    width: 4px; height: 8px;
    background: #fff;
    border-radius: 2px;
    box-shadow: 0 0 12px 3px rgba(255,255,255,0.65);
}

/* ════════════════════════════════════════════════════
   KEYFRAMES
   ════════════════════════════════════════════════════ */

@keyframes splashArcSpin {
    0%   { transform: rotate(-90deg); }
    100% { transform: rotate(270deg); }
}
@keyframes splashArcSpinReverse {
    0%   { transform: rotate(90deg); }
    100% { transform: rotate(-270deg); }
}
@keyframes splashLogoGlint {
    0%  { transform: translateX(-200%); }
    40% { transform: translateX(200%); }
    100%{ transform: translateX(200%); }
}
@keyframes splashHudPulse {
    0%,100% { opacity: 0.5; transform: scale(1); }
    50%     { opacity: 1;   transform: scale(1.5); }
}
@keyframes splashCursorBlink {
    0%,100% { opacity: 1; }
    50%     { opacity: 0; }
}

/* ========================================= */
/* 🚀 AAA CINEMATIC LAUNCH OVERLAY           */
/* ========================================= */
.launch-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    z-index: 99998; background: #000; display: flex; align-items: center;
    justify-content: center; opacity: 0; pointer-events: none; 
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s;
}

.launch-overlay.active { 
    opacity: 1; pointer-events: all; 
    visibility: visible;
}

.launch-bg-wrapper { position: absolute; inset: 0; z-index: 0; overflow: hidden; }

.launch-bg-img {
    width: 100%; height: 100%; background-size: cover; background-position: center;
    filter: blur(6px) brightness(0.3); transform: scale(1.05);
}
.launch-overlay.active .launch-bg-img {
    animation: cinematicZoom 10s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

.vignette-overlay { position: absolute; inset: 0; background: radial-gradient(circle at center, transparent 15%, #000 95%); }

.launch-content {
    position: relative; z-index: 1; text-align: center; display: flex; flex-direction: column; align-items: center;
    transform: translateY(20px); opacity: 0;
}
.launch-overlay.active .launch-content {
    animation: riseUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s forwards;
}

.launch-game-logo {
    max-width: 320px; max-height: 130px; object-fit: contain; margin-bottom: 35px;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.8));
    animation: floatLogo 4s ease-in-out infinite;
}

.aaa-loader-container { display: flex; flex-direction: column; align-items: center; gap: 12px; width: 280px; }

.aaa-loader-text-row { display: flex; align-items: center; gap: 10px; }
.pulse-dot { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 10px var(--accent); animation: pulseDot 1.5s infinite; }
.aaa-status-text { color: rgba(255,255,255,0.9); font-size: 0.75rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }

.aaa-progress-track { width: 100%; height: 2px; background: rgba(255,255,255,0.08); border-radius: 2px; position: relative; overflow: hidden; }
.aaa-progress-fill {
    position: absolute; top: 0; left: -50%; width: 50%; height: 100%;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: scanline 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.aaa-progress-glow {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    box-shadow: 0 0 15px var(--accent); opacity: 0; animation: pulseGlow 1.8s infinite;
}

/* ========================================= */
/* 10. DRAG & DROP SMOOTHNESS (APPLE TV)     */
/* ========================================= */

.sortable-drag {
    opacity: 1 !important;
    transform: scale(1.08) translateY(-10px) !important;
    box-shadow: 0 30px 60px rgba(0,0,0,0.9) !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    cursor: grabbing !important;
    z-index: 9999 !important;
}

.sortable-ghost {
    opacity: 0.2;
    transform: scale(0.9);
    background: rgba(255, 255, 255, 0.05);
    border: 2px dashed rgba(255, 255, 255, 0.15);
    border-radius: 12px;
}

body.is-dragging, body.is-dragging * {
    cursor: grabbing !important;
}

.highlight-swap {
    border: 2px solid var(--accent) !important;
    transform: scale(1.05) !important;
    box-shadow: 0 10px 30px rgba(255, 255, 255, 0.2) !important;
    filter: brightness(1.2);
}

/* ── Drag handle — shown in top-left on card hover ── */
/* Drag handle: bottom-center, no background, only on hover */
.gc-drag-handle {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    z-index: 4;
    width: 32px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease, color 0.15s ease;
    cursor: grab;
    pointer-events: none;
}

.game-card:hover .gc-drag-handle {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
}

.gc-drag-handle:hover {
    color: rgba(255, 255, 255, 0.9);
}

.gc-drag-handle:active,
body.is-dragging .gc-drag-handle {
    cursor: grabbing;
}

/* ========================================= */
/* 11. SURPRISE ME (ROULETTE) - FULL WIDTH   */
/* ========================================= */
/* ── Surprise Me / Roulette Section — Compact Widget ─────────── */
.surprise-me-section,
.roulette-section {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    margin-top: 40px;
    margin-bottom: 40px;
    margin-inline: 40px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background-image:
        radial-gradient(rgba(255, 255, 255, 0.012) 1px, transparent 1px),
        linear-gradient(145deg, rgba(22, 22, 22, 0.95) 0%, rgba(10, 10, 10, 0.7) 100%);
    background-size: 28px 28px, 100% 100%;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
}

/* Background layers */
.surprise-me-section::before,
.roulette-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(circle at 50% 50%, rgba(255,255,255,.018), transparent 55%);
}

/* Overlay for hero bg state */
.surprise-me-section.has-hero-bg::after,
.roulette-section.has-hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
        linear-gradient(180deg,
            rgba(0,0,0,0.28) 0%,
            rgba(0,0,0,0.08) 40%,
            rgba(0,0,0,0.14) 65%,
            rgba(0,0,0,0.32) 100%
        ),
        radial-gradient(ellipse at center,
            rgba(0,0,0,0) 0%,
            rgba(0,0,0,0) 44%,
            rgba(0,0,0,0.32) 76%,
            rgba(0,0,0,0.62) 100%
        );
    box-shadow: inset 0 0 24px rgba(0,0,0,0.4);
}

/* All content above layers */
.surprise-me-section > *,
.roulette-section > * {
    position: relative;
    z-index: 2;
}
.surprise-me-section.has-hero-bg > *,
.roulette-section.has-hero-bg > * {
    position: relative;
    z-index: 2;
}

/* Hero bg image layer */
.surprise-me-section.has-hero-bg,
.roulette-section.has-hero-bg {
    background-image: none;
    background-color: #060606;
    border-color: rgba(255,255,255,0.055);
}

.surprise-me-section.has-hero-bg::before,
.roulette-section.has-hero-bg::before {
    content: "";
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: var(--roulette-hero-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: inherit;
    transform: scale(1.02);
    filter: brightness(0.92) saturate(1.06);
}

/* ── Shell: inner padding container ───────────────────────────── */
.roulette-shell {
    padding: 28px 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

/* ── Header: title + mode selector side by side ──────────────── */
.surprise-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
}

.surprise-header .section-title::before {
    display: none !important;
}

.surprise-header-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.surprise-header .section-title {
    font-size: 2.2rem;
    margin: 0;
    text-shadow: 0 2px 14px rgba(0,0,0,0.5);
    justify-content: flex-start;
    gap: 0;
}

.surprise-header p {
    font-size: 0.9rem;
    color: #888;
    margin: 0;
    line-height: 1.4;
}

/* ── Mode selector: pill row ──────────────────────────────────── */
.roulette-mode-selector {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.roulette-mode-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #555;
    margin: 0;
    white-space: nowrap;
}

.roulette-mode-btns {
    display: flex;
    gap: 7px;
}

.roulette-mode-btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.09);
    background: rgba(255,255,255,0.05);
    color: #999;
    cursor: pointer;
    transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.15s;
    font-family: inherit;
    white-space: nowrap;
}

.roulette-mode-btn:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.22);
    color: #ddd;
    transform: translateY(-1px);
}

.roulette-mode-btn.active {
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.46);
    color: #fff;
    box-shadow: 0 3px 12px rgba(0,0,0,0.22);
}

.roulette-mode-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    opacity: 0.65;
    transition: opacity 0.18s;
}
.roulette-mode-btn.active .roulette-mode-icon { opacity: 1; }

.roulette-mode-title {
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.02em;
}

.roulette-mode-sub {
    font-size: 0.66rem;
    color: #555;
    transition: color 0.18s;
}
.roulette-mode-btn.active .roulette-mode-sub { color: #888; }

/* has-hero-bg mode selector adjustments */
.surprise-me-section.has-hero-bg .roulette-mode-btn,
.roulette-section.has-hero-bg .roulette-mode-btn {
    background: rgba(0,0,0,0.28);
    border: 1px solid rgba(255,255,255,0.20);
    color: rgba(255,255,255,0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
}

.surprise-me-section.has-hero-bg .roulette-mode-btn.active,
.roulette-section.has-hero-bg .roulette-mode-btn.active {
    background: rgba(255,255,255,0.90);
    color: #000;
    border-color: rgba(255,255,255,0.95);
}

/* has-hero-bg text legibility */
.surprise-me-section.has-hero-bg .section-title,
.surprise-me-section.has-hero-bg .surprise-header p,
.surprise-me-section.has-hero-bg .roulette-mode-label {
    color: rgba(255,255,255,0.95);
    text-shadow: 0 2px 8px rgba(0,0,0,0.8);
}

/* ── Two-column layout ────────────────────────────────────────── */
.roulette-layout {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 36px;
}

.roulette-card-zone {
    flex-shrink: 0;
}

.roulette-action-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
}

/* ── Roulette card ────────────────────────────────────────────── */
.roulette-card {
    width: 200px;
    aspect-ratio: 2 / 3;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 12px 36px rgba(0,0,0,0.65);
    border: 1px solid rgba(255,255,255,0.1);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
    background: #0d0d0d;
}

/* ========================================= */

/* ========================================= */
#rouletteImg,
.roulette-card img#rouletteImg,
.roulette-card img {
    width: 100%; height: 100%; object-fit: cover; object-position: center;
    transition: filter 0.1s ease,
        transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    display: block;
}

.roulette-card.has-poster #rouletteGraphic { display: none !important; }
.roulette-card.has-poster #rouletteImg {
    display: block !important;
    opacity: 1 !important;
    object-fit: cover;
    object-position: center;
}

.roulette-card.spinning.has-poster #rouletteImg {
    display: block !important;
    opacity: 1 !important;
    object-fit: cover;
    object-position: center;
}

.roulette-card:not(.spinning):hover img {
    transform: scale(1.05);
    filter: brightness(0.6);
}

.roulette-card.spinning img {
    filter: blur(5px) brightness(0.7);
    transform: scale(1.05);
}

.roulette-card.winner {
    transform: scale(1.035);
    box-shadow: 0 20px 50px rgba(255,255,255,0.2);
    border-color: rgba(255,255,255,0.5);
}
.roulette-card.winner img { filter: brightness(1.1); }
.roulette-card.winner #rouletteImg.final-poster {
    transform: none !important;
    filter: none;
}

.roulette-overlay {
    position: absolute; inset: 0;
    /* Keep the subtle bottom vignette for card depth — no text inside */
    background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 40%);
    z-index: 5;
    pointer-events: none;
}

/* Caption below the card — clean, no clutter on the image */
.roulette-caption {
    margin-top: 10px;
    min-height: 2.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 8px;
}

.roulette-caption-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
    transition: opacity 0.15s ease;
}

/* Dim the placeholder text */
.roulette-caption-name:empty,
.roulette-card:not(.winner):not(.spinning) ~ .roulette-caption .roulette-caption-name {
    color: rgba(255, 255, 255, 0.35);
}

/* ========================================= */

/* ========================================= */
.roulette-css-graphic {
    position: absolute; inset: 0; width: 100%; height: 100%;
    
    
    background: transparent !important; 
    
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; z-index: 2;
}

.magic-blur {
    position: absolute; width: 150%; height: 150%;
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
    filter: blur(40px); opacity: 0.8;
}

.crystal-orb {
    position: relative; width: 120px; height: 120px;
    border-radius: 50%; 
    
    
    background: rgba(255, 255, 255, 0.005);
    
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.05), 0 10px 40px rgba(0, 0, 0, 0.5);
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px);
    animation: orbFloat 6s ease-in-out infinite; z-index: 3;
}

.inner-glow {
    width: 60px; height: 60px; border-radius: 50%;
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 70%);
    filter: blur(10px); animation: glowPulse 4s ease-in-out infinite;
}

.crystal-orb::after {
    content: '?'; font-family: var(--font-heading); font-size: 3rem; font-weight: 800;
    color: rgba(255, 255, 255, 0.1); position: absolute; text-shadow: 0 0 10px rgba(255, 255, 255, 0.1);
}

/* ========================================= */

/* ========================================= */
.roulette-controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.roulette-spin-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

/* ── Roulette mode selector — no longer used standalone, kept for compat ── */
.roulette-mode-selector-compat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
    position: relative;
    z-index: 1;
}

.roulette-mode-label-compat {
    font-size: 0.72rem;
    display: none;
}

@media (max-width: 600px) {
    .roulette-mode-sub { display: none; }
    .roulette-mode-btn { padding: 6px 11px; }
    .surprise-header { flex-direction: column; align-items: flex-start; gap: 12px; }
}

@media (max-width: 850px) {
    .roulette-layout {
        flex-direction: column;
        align-items: center;
        gap: 24px;
    }
    .roulette-action-panel {
        width: 100%;
        align-items: center;
    }
    .roulette-controls {
        width: 100%;
        align-items: center;
    }
    .roulette-spin-row {
        width: 100%;
        justify-content: center;
    }
    .btn-spin, .btn-play-result {
        width: 100%;
        max-width: 320px;
        justify-content: center;
        height: 46px;
    }
