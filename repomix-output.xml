    padding: 4px;
}
.gd-mp-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 1;
    justify-content: center;
    padding: 8px 10px;
    border-radius: 9px;
    border: none;
    background: transparent;
