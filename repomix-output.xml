const CSS_DIR  = path.join(ROOT, 'src', 'css');
const FONT_DIR = path.join(ROOT, 'assets', 'fonts');

// ── Font files exist in assets/fonts ─────────────────────────────────────────

const REQUIRED_FONTS = [
