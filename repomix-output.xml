/* ══════════════════════════════════════════════════════════════
   DISPLAY SETTINGS DROPDOWN
══════════════════════════════════════════════════════════════ */
.ag-display-dropdown { position: relative; }
.ag-display-trigger {
    display: flex; align-items: center; gap: 6px;
    height: 34px; padding: 0 12px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
