        const markerBefore = fs.readFileSync(markerPath, 'utf8');
        fs.writeFileSync(path.join(queued.task.installPath, 'partial.bin'), 'partial');
        await manager.pause(queued.task.id);
        await manager.resume(queued.task.id);
