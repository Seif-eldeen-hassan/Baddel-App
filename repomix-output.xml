.beta-feedback-banner[hidden] { display: none !important; }

.beta-feedback-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1;
}

.beta-feedback-pill {
    height: 26px;
    padding: 0 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #091009;
    background: linear-gradient(135deg, #12ce18, #78ff7d);
    box-shadow: 0 0 18px rgba(18, 206, 24, 0.25);
    flex: 0 0 auto;
}

.beta-feedback-copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
}

.beta-feedback-copy strong {
    font-size: 13px;
    font-weight: 800;
    line-height: 1.1;
}

.beta-feedback-copy span {
    font-size: 12px;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.62);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.beta-feedback-cta {
    height: 34px;
    padding: 0 13px;
    border-radius: 999px;
    border: 1px solid rgba(18, 206, 24, 0.35);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #071007;
    background: linear-gradient(135deg, #12ce18, #70f774);
    font-family: var(--font-main);
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    flex: 0 0 auto;
    transition: transform 0.16s ease, box-shadow 0.16s ease, filter 0.16s ease;
    -webkit-app-region: no-drag;
}

.beta-feedback-cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
    box-shadow: 0 10px 24px rgba(18, 206, 24, 0.22);
}

.beta-feedback-close {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.62);
    font-size: 16px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex: 0 0 auto;
    -webkit-app-region: no-drag;
}

.beta-feedback-close:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.10);
}

body.has-beta-feedback-banner #mainContentArea {
    padding-bottom: 92px;
}

.sidebar.collapsed ~ * .beta-feedback-banner,
body:has(.sidebar.collapsed) .beta-feedback-banner {
    left: calc(var(--sidebar-collapsed-width) + 12px);
}

@media (max-width: 900px) {
    .beta-feedback-banner {
        left: 14px;
        right: 14px;
        bottom: 14px;
        border-radius: 16px;
    }

    .beta-feedback-copy span {
        white-space: normal;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }
}

@media (max-width: 640px) {
    .beta-feedback-banner {
        align-items: stretch;
        flex-direction: column;
        gap: 10px;
        padding: 12px;
    }

    .beta-feedback-close {
        position: absolute;
        right: 10px;
        top: 10px;
    }

    .beta-feedback-left {
        padding-right: 34px;
    }

    .beta-feedback-cta {
        width: 100%;
        justify-content: center;
    }
}

@media (prefers-reduced-motion: reduce) {
    .beta-feedback-banner:not([hidden]) { animation: none; }
    .beta-feedback-cta { transition: none; }
}
