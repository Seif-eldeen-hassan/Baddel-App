        fullMeta?.heroImage ? 'fullMeta.heroImage' :
        fullMeta?.hero ? 'fullMeta.hero' :
        cachedHero ? 'cache.hero' :
        cachedCover ? 'cache.cover' :
        game?.image ? 'game.image' :
