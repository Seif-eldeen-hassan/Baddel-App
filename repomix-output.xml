    if (platform === 'steam') {
        const steamId = _poExtractSteamId(game);
        if (steamId) {
            const byId = syncedLibrary.find(lg =>
                (lg.appName   && String(lg.appName)   === String(steamId)) ||
                (lg.namespace && String(lg.namespace) === String(steamId))
