}

.consent-list-item:last-child { margin-bottom: 0; }

/* ── What's New / Update Notes Modal ─────────────────────────────────────── */
.update-notes-modal {
    position: fixed; inset: 0; z-index: 200000;
    display: none; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.62); backdrop-filter: blur(12px);
}
.update-notes-modal.active { display: flex; }
.update-notes-dialog {
    width: min(660px, calc(100vw - 32px));
    background: #151515; border: 1px solid rgba(255,255,255,0.12);
    border-radius: 22px; padding: 36px 32px 32px;
    box-shadow: 0 24px 80px rgba(0,0,0,0.58);
    position: relative; color: #fff; text-align: center;
    max-height: calc(100vh - 48px); overflow-y: auto;
}
.update-notes-dialog .modal-close {
    position: absolute; top: 16px; right: 18px;
    background: none; border: none; color: rgba(255,255,255,0.4);
    font-size: 1.1rem; cursor: pointer; line-height: 1;
    transition: color 0.15s;
}
.update-notes-dialog .modal-close:hover { color: #fff; }
.update-notes-icon {
    font-size: 2.4rem; margin-bottom: 14px; display: block;
}
.update-notes-dialog h2 {
    font-size: 1.25rem; font-weight: 700; margin: 0 0 8px; color: #fff;
}
.update-notes-dialog > p:first-of-type {
    font-size: 0.9rem; color: rgba(255,255,255,0.55); margin: 0 0 22px;
}
.update-notes-list {
    text-align: left; display: flex; flex-direction: column; gap: 14px;
    margin-bottom: 22px;
}
.update-notes-item {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09);
    border-radius: 12px; padding: 14px 16px;
}
.update-notes-item-title {
    font-size: 0.875rem; font-weight: 600; color: #fff; margin: 0 0 4px;
}
.update-notes-item-desc {
    font-size: 0.8rem; color: rgba(255,255,255,0.5); margin: 0; line-height: 1.45;
}
.update-notes-footer {
    font-size: 0.78rem; color: rgba(255,255,255,0.35); margin: 0 0 20px;
}
.update-notes-primary-btn {
    background: linear-gradient(135deg, #22c55e, #16a34a);
    box-shadow: 0 0 24px rgba(34, 197, 94, 0.28);
    border: none; border-radius: 10px; color: #fff;
    font-size: 0.9rem; font-weight: 600; padding: 11px 32px;
    cursor: pointer; transition: background 0.2s, box-shadow 0.2s, transform 0.1s;
    display: block; width: 100%;
    outline-offset: 3px;
}
.update-notes-primary-btn:hover {
    background: linear-gradient(135deg, #34d399, #22c55e);
    box-shadow: 0 0 32px rgba(34, 197, 94, 0.38);
}
.update-notes-primary-btn:focus-visible {
    outline: 2px solid #22c55e;
}
.update-notes-primary-btn:active { transform: scale(0.98); }

/* Featured two-card row (primary features) */
.update-notes-featured-row {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
}
/* Smaller feature cards grid (secondary features) */
.update-notes-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
}
/* Large highlighted card — overrides .update-notes-item base */
.update-notes-featured-card {
    border-color: rgba(34, 197, 94, 0.3); background: rgba(34, 197, 94, 0.06); padding: 18px;
}
/* Smaller card — tighter padding than base .update-notes-item */
.update-notes-grid-card {
    padding: 12px 14px;
}
/* Eyebrow label on featured cards — small, muted, uppercase */
.update-notes-featured-card .update-notes-item-title {
    font-size: 0.72rem; font-weight: 600; color: rgba(255,255,255,0.4);
    text-transform: uppercase; letter-spacing: 0.07em; margin: 0 0 5px;
}
/* Feature headline — the main benefit statement */
.update-notes-item-headline {
    font-size: 0.95rem; font-weight: 700; color: #22c55e;
    margin: 0 0 6px; line-height: 1.3;
}
/* Description in featured cards — slightly brighter than base */
.update-notes-featured-card .update-notes-item-desc {
    font-size: 0.82rem; color: rgba(255,255,255,0.6);
}
/* Helper / best-for line */
.update-notes-item-helper {
    font-size: 0.72rem; color: rgba(255,255,255,0.28);
    margin: 8px 0 0; line-height: 1.4; font-style: italic;
}
/* Stack cards on narrow screens */
@media (max-width: 560px) {
    .update-notes-featured-row,
    .update-notes-grid { grid-template-columns: 1fr; }
}

/* ── Feature tour slider (type: feature-tour) ───────────────────────────────── */
.update-notes-dialog.tour-mode {
    width: min(880px, calc(100vw - 32px));
    padding: 0; overflow: hidden; text-align: left;
}
.update-notes-dialog.tour-mode .modal-close {
    z-index: 10; background: rgba(0,0,0,0.4);
    border-radius: 50%; width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
}
.un-tour { display: flex; flex-direction: column; margin: 0; gap: 0; }
.un-tour-slides { position: relative; }
.un-tour-slide {
    display: none; flex-direction: row; min-height: 360px;
}
.un-tour-slide.active { display: flex; }
.un-tour-text {
    flex: 0 0 42%; padding: 36px 36px 32px 36px;
    display: flex; flex-direction: column; justify-content: center;
}
.un-tour-image {
    flex: 0 0 58%; background: #0e0e0e;
    border-left: 1px solid rgba(255,255,255,0.07);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
}
.un-tour-img {
    width: 100%; height: 100%; object-fit: cover; display: block;
}
.un-tour-img-placeholder {
    width: 100%; height: 100%; min-height: 360px;
    background: linear-gradient(135deg, #1c1c1c 0%, #101010 100%);
}
.un-tour-label {
    font-size: 0.68rem; font-weight: 700; color: #22c55e;
    text-transform: uppercase; letter-spacing: 0.1em;
    display: block; margin-bottom: 10px;
}
.un-tour-headline {
    font-size: 1.5rem; font-weight: 800; color: #fff;
    margin: 0 0 12px; line-height: 1.2;
}
.un-tour-desc {
    font-size: 0.875rem; color: rgba(255,255,255,0.62);
    margin: 0 0 16px; line-height: 1.6;
}
.un-tour-badge {
    display: inline-block;
    background: rgba(34,197,94,0.12); border: 1px solid rgba(34,197,94,0.35);
    color: #22c55e; font-size: 0.8rem; font-weight: 600; font-family: monospace;
    padding: 5px 12px; border-radius: 7px; margin-bottom: 16px;
    letter-spacing: 0.03em;
}
.un-tour-helper {
    font-size: 0.78rem; color: rgba(255,255,255,0.32);
    margin: 0; line-height: 1.5; font-style: italic;
}
.un-tour-nav {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 14px 24px 18px;
    background: #0f0f0f; border-radius: 0 0 22px 22px;
    display: flex; flex-direction: column; gap: 10px;
}
.un-tour-dots {
    display: flex; gap: 7px; justify-content: center; align-items: center;
}
.un-tour-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(255,255,255,0.15); cursor: pointer;
    transition: background 0.2s, transform 0.2s; border: none;
    display: inline-block;
}
.un-tour-dot.active { background: #22c55e; transform: scale(1.35); }
.un-tour-controls {
    display: flex; align-items: center; justify-content: space-between;
}
.un-tour-counter {
    font-size: 0.75rem; color: rgba(255,255,255,0.28);
    font-variant-numeric: tabular-nums;
}
.un-tour-btn-group { display: flex; gap: 8px; }
.un-tour-back {
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.55); font-size: 0.85rem; font-weight: 500;
    padding: 8px 22px; border-radius: 9px; cursor: pointer;
    transition: background 0.15s, color 0.15s;
}
.un-tour-back:hover:not(:disabled) { background: rgba(255,255,255,0.1); color: #fff; }
.un-tour-back:disabled { opacity: 0.28; cursor: default; }
.un-tour-next {
    background: linear-gradient(135deg, #22c55e, #16a34a);
    box-shadow: 0 0 18px rgba(34,197,94,0.22);
    border: none; color: #fff; font-size: 0.85rem; font-weight: 600;
    padding: 8px 26px; border-radius: 9px; cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s;
    min-width: 96px;
}
.un-tour-next:hover {
    background: linear-gradient(135deg, #34d399, #22c55e);
    box-shadow: 0 0 26px rgba(34,197,94,0.32);
}
.un-tour-next:active { transform: scale(0.98); }
@media (max-width: 640px) {
    .un-tour-slide { flex-direction: column-reverse; min-height: auto; }
    .un-tour-text { flex: none; padding: 28px 24px 18px; }
    .un-tour-image { flex: none; min-height: 200px; border-left: none;
        border-top: 1px solid rgba(255,255,255,0.07); }
    .un-tour-img-placeholder { min-height: 200px; }
    .un-tour-headline { font-size: 1.2rem; }
}

/* Tour header — icon + title + subtitle above the slide area */
.un-tour-header {
    display: none;
    align-items: center;
    gap: 14px;
    padding: 18px 52px 16px 22px; /* right: 52px clears the X close button */
    border-bottom: 1px solid rgba(255,255,255,0.07);
}
.update-notes-dialog.tour-mode .un-tour-header { display: flex; }
.un-tour-header-icon {
    flex-shrink: 0;
    width: 40px; height: 40px;
    border-radius: 10px;
    background: rgba(34,197,94,0.1);
    border: 1px solid rgba(34,197,94,0.22);
    display: flex; align-items: center; justify-content: center;
}
.un-tour-header-title {
    font-size: 0.95rem; font-weight: 700; color: #fff;
    margin: 0 0 3px; line-height: 1.3;
}
.un-tour-header-subtitle {
    font-size: 0.73rem; color: rgba(255,255,255,0.38);
    margin: 0; line-height: 1.4;
}
/* Hide old card-layout elements in tour mode (belt-and-suspenders alongside JS) */
.update-notes-dialog.tour-mode .update-notes-icon,
.update-notes-dialog.tour-mode #updateNotesTitle,
.update-notes-dialog.tour-mode #updateNotesSubtitle,
.update-notes-dialog.tour-mode #updateNotesFooter,
.update-notes-dialog.tour-mode .update-notes-primary-btn { display: none !important; }

/* ================================================================ */
/* SIDEBAR v2 — Glass panels redesign                               */
/* ================================================================ */

/* Sidebar nav content — no scroll; content must fit without scrolling */
.sidebar-scroll-content {
    flex: 1;
    min-height: 0;
    overflow: hidden;
}

/* ── Status bar ── */
.sidebar-status {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    margin-bottom: 14px;
    font-size: 0.68rem;
    color: rgba(255,255,255,0.35);
    letter-spacing: 0.3px;
    flex-grow: 0;   /* must not expand in the sidebar flex column */
    flex-shrink: 0;
}
.sidebar.collapsed .sidebar-status { display: none; }

.sidebar-status-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
    flex-shrink: 0;
    animation: sbStatusPulse 3s ease-in-out infinite;
}
@keyframes sbStatusPulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.5; }
}

/* ── Section HUD label ── */
.sidebar-section-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.18);
    text-transform: uppercase;
    padding: 0 14px;
    margin: 8px 0 6px;
}
.sidebar.collapsed .sidebar-section-label { display: none; }

/* ── Library badge on section header ── */
.sidebar-nav-badge {
    margin-left: auto;
    font-size: 0.62rem;
    font-weight: 700;
    color: rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.06);
    border-radius: 20px;
    padding: 1px 7px;
    letter-spacing: 0.3px;
}
.sidebar.collapsed .sidebar-nav-badge { display: none; }

/* ── Glass panel base ── */
.sidebar-panel {
    margin: 10px 0 0;
    border-radius: 10px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    padding: 12px;
    overflow: hidden;
}
.sidebar.collapsed .sidebar-panel { display: none !important; }

.sidebar-panel-label {
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.2);
    text-transform: uppercase;
    margin-bottom: 10px;
}

/* ── 01 Jump Back In card ── */
.jump-back-card { padding: 10px; }

.jb-inner {
    border-radius: 8px;
    height: 88px;
    background: #1a1a1a;
    background-size: cover;
    background-position: center;
    position: relative;
    overflow: hidden;
    cursor: pointer;
}
.jb-inner:hover .jb-overlay { background: rgba(0,0,0,0.55); }
.jb-inner:hover .jb-play { opacity: 1; transform: scale(1); }

.jb-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.3) 60%, transparent 100%);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 8px 10px;
    transition: background 0.15s;
}

.jb-info { flex: 1; min-width: 0; }

.jb-platform {
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 2px;
}

.jb-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
}

.jb-meta {
    font-size: 0.62rem;
    color: rgba(255,255,255,0.5);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.jb-play {
    flex-shrink: 0;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--accent);
    border: none;
    color: #000;
    font-size: 0.65rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.15s, transform 0.15s;
    margin-left: 8px;
}
.jb-play:hover { background: #4ade80; }

/* ── 02 Active Accounts card ── */
.active-account-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 4px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.12s;
    font-size: 0.75rem;
}
.active-account-row:hover { background: rgba(255,255,255,0.06); }

.acc-plat-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
}

.acc-plat-name {
    color: rgba(255,255,255,0.75);
    font-weight: 500;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.acc-plat-count {
    font-size: 0.65rem;
    color: rgba(255,255,255,0.3);
    font-weight: 600;
}

.acc-status-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    box-shadow: 0 0 4px var(--accent);
}

/* ── 03 Library Pulse card ── */
.sidebar-pulse-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.sidebar-metric {
    background: rgba(255,255,255,0.04);
    border-radius: 7px;
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.sidebar-metric-value {
    font-size: 1.2rem;
    font-weight: 800;
    color: #fff;
    line-height: 1;
    font-family: var(--font-heading, sans-serif);
}

.sidebar-metric-label {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: rgba(255,255,255,0.3);
    text-transform: uppercase;
}

/* ================================================================ */
/* BADDEL SMART SIDEBAR — v3                                        */
/* ================================================================ */

/* Hide the compatibility layer — IDs exist for JS but never shown */
.baddel-compat-layer {
    display: none !important;
    position: absolute;
    left: -9999px;
    width: 0;
    height: 0;
    overflow: hidden;
}

/* Status row with platform dots */
.baddel-sidebar-status {
    display: flex;
    align-items: center;
    gap: 6px;
}

.baddel-plat-dots {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
}

.baddel-plat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    opacity: 0.85;
}
.sidebar.collapsed .baddel-plat-dots { display: none; }

/* Panel base — override any old display:none */
.baddel-sidebar-panel {
    display: block !important;
    margin-top: 12px;
}

/* Jump Back In empty state */
.jb-empty-msg {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.25);
    text-align: center;
    padding: 12px 0;
    letter-spacing: 0.3px;
}

/* Active accounts placeholder */
.baddel-acc-placeholder {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.25);
    text-align: center;
    padding: 10px 0;
    letter-spacing: 0.3px;
}

/* Active account row */
.baddel-acc-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 4px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.12s;
}
.baddel-acc-row:hover { background: rgba(255,255,255,0.06); }

.baddel-acc-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
}

.baddel-acc-name {
    font-size: 0.74rem;
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.baddel-acc-count {
    font-size: 0.64rem;
    color: rgba(255,255,255,0.3);
    font-weight: 600;
}

.baddel-acc-live {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    box-shadow: 0 0 4px var(--accent);
}

/* Library Pulse — ensure 2x2 grid with 4 tiles */
#sidebarLibraryPulse .sidebar-pulse-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

/* Collections panel */
.baddel-sidebar-collections .add-coll-btn {
    margin-top: 10px;
    width: 100%;
}

/* Collection items inside sidebar panel */
.baddel-sidebar-collections #collectionsList .nav-item {
    height: 36px;
    border-radius: 7px;
    margin-bottom: 2px;
    padding: 0 10px;
    font-size: 0.8rem;
}

/* Sidebar nav badge — green accent when active */
.nav-item.active .sidebar-nav-badge {
    background: rgba(18, 206, 24, 0.15);
    color: var(--accent);
}

/* Collapsed sidebar: hide panels entirely */
.sidebar.collapsed .baddel-sidebar-panel { display: none !important; }

/* ================================================================ */
/* SIDEBAR POLISH — v4                                              */
/* ================================================================ */

/* 1. Sidebar width is controlled by --sidebar-width (280px) in :root.
      The base .sidebar rule already uses the variable with min/max-width locks. */

/* 2. Compact, premium nav items with correct font size */
.nav-item {
    height: 40px;
    font-size: 0.82rem;
    gap: 10px;
    margin-bottom: 2px;
}

/* 3. Active accent bar — green glow only, no white bleed */
.nav-item.active::before {
    box-shadow: 0 0 5px rgba(18,206,24,0.5);
}

/* 4. Status dot — true brand green (#12CE18), not inherited white --accent */
.sidebar-status-dot {
    background: #12CE18;
    box-shadow: 0 0 5px rgba(18,206,24,0.55);
}

/* 5. Nav count badge — slightly more readable, doesn't shrink */
.sidebar-nav-badge {
    color: rgba(255,255,255,0.5);
    background: rgba(255,255,255,0.09);
    flex-shrink: 0;
}

/* 6. Jump Back In — darker gradient so bright artwork doesn't bleed */
.jb-overlay {
    background: linear-gradient(
        to top,
        rgba(0,0,0,0.92) 0%,
        rgba(0,0,0,0.62) 45%,
        rgba(0,0,0,0.28) 100%
    );
}

/* 7. Jump Back In play button — brand green */
.jb-play { background: #12CE18; color: #000; }
.jb-play:hover { background: #0fb316; }

/* 8. Active account live indicator — brand green */
.baddel-acc-live {
    background: #12CE18;
    box-shadow: 0 0 4px rgba(18,206,24,0.55);
}

/* 9. Empty Active Accounts panel — hidden entirely by JS adding this class */
.baddel-sidebar-panel.baddel-hidden { display: none !important; }

/* 10. Library Pulse metric value — slightly more compact */
.sidebar-metric-value { font-size: 1.05rem; }

/* 11. Collections list items — compact */
.baddel-sidebar-collections #collectionsList .nav-item {
    height: 34px;
    font-size: 0.78rem;
    margin-bottom: 1px;
}

/* ================================================================ */
/* SIDEBAR HYBRID — section-based redesign                          */
/* ================================================================ */

/* ── Section headers (LIBRARY / ACCOUNTS / MANAGE) ── */
.sb-section-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    height: 28px;
    margin-top: 14px;
    margin-bottom: 2px;
    cursor: pointer;
    user-select: none;
}
.sb-sec-static { cursor: default; }

.sb-sec-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.22);
    text-transform: uppercase;
    flex: 1;
}

.sb-sec-chevron {
    color: rgba(255,255,255,0.2);
    transition: transform 0.18s ease;
    flex-shrink: 0;
}
.sb-chevron-closed { transform: rotate(-90deg); }

.sb-section-header:hover .sb-sec-label { color: rgba(255,255,255,0.38); }
.sb-section-header:hover .sb-sec-chevron { color: rgba(255,255,255,0.35); }
.sb-sec-static:hover .sb-sec-label,
.sb-sec-static:hover .sb-sec-chevron { color: rgba(255,255,255,0.22); }

.sidebar.collapsed .sb-section-header { display: none; }

/* ── Section body ── */
.sb-section-body {
    margin-bottom: 2px;
}
/* Collapsed mode: show icon-only for EXPANDED sections; keep CLOSED sections hidden */
.sidebar.collapsed .sb-section-body:not(.sb-sec-closed) { display: block; }
.sidebar.collapsed .sb-section-body.sb-sec-closed { display: none !important; }

/* ── Sub-items (indented nav items inside sections) ── */
.nav-item.sb-sub-item {
    height: 36px;
    padding: 0 10px 0 12px;
    font-size: 0.8rem;
    margin-bottom: 1px;
    border-radius: 8px;
}
.nav-item.sb-sub-item .nav-icon {
    width: 18px;
    height: 18px;
}

/* ── Platform count in accounts section ── */
.sb-section-body .platform-count {
    font-size: 0.64rem;
    color: rgba(255,255,255,0.3);
    font-weight: 700;
    margin-left: auto;
    background: rgba(255,255,255,0.06);
    padding: 1px 6px;
    border-radius: 20px;
}
.nav-item.platform-item.active .platform-count {
    color: rgba(255,255,255,0.7);
    background: rgba(255,255,255,0.12);
}

/* ── collectionsList items in LIBRARY section body ── */
#sbBodyLibrary #collectionsList .nav-item {
    height: 34px;
    font-size: 0.78rem;
    padding: 0 10px 0 12px;
    border-radius: 7px;
    margin-bottom: 1px;
}

/* ── Sidebar collection dot icon ── */
.sb-coll-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255,255,255,0.28);
    flex-shrink: 0;
}
.nav-item.sb-coll-item.active .sb-coll-dot { background: #12CE18; }

/* ── Context action button (bottom of sidebar) ── */
.sb-ctx-btn {
    flex-shrink: 0;
    margin: 8px 0 0;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.5);
    padding: 10px 12px;
    border-radius: 9px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: 0.8rem;
    font-weight: 500;
    transition: border-color 0.12s, color 0.12s, background 0.12s;
}
.sb-ctx-btn:hover {
    border-color: rgba(255,255,255,0.25);
    color: #fff;
    background: rgba(255,255,255,0.05);
}
.sidebar.collapsed .sb-ctx-btn { display: none; }

/* ================================================================ */
/* Stable allGamesView header — prevent layout shift on mode switch */
/* ================================================================ */

#allGamesView .library-section { padding-top: 20px; }

#allGamesView .library-header {
    min-height: 44px;
    align-items: center;
    margin-bottom: 18px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
}

#agToolbarSticky { min-height: 72px; }

/* Result count always occupies space so the row never jumps */
.ag-result-count {
    min-width: 72px;
    display: inline-flex;
    justify-content: flex-end;
    white-space: nowrap;
}

/* ── Collections page ── */
.collections-page { padding-bottom: 40px; }

.collections-hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 28px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 22px;
    background:
        radial-gradient(circle at 10% 0%, rgba(18,206,24,0.12), transparent 34%),
        linear-gradient(135deg, rgba(255,255,255,0.055), rgba(255,255,255,0.025));
    margin-bottom: 18px;
}

.collections-eyebrow {
    color: #12ce18;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    margin: 0 0 8px;
    text-transform: uppercase;
}

.collections-hero-title {
    margin: 0;
    font-size: 34px;
    letter-spacing: -0.04em;
    font-weight: 900;
}

.collections-hero-sub {
    margin: 8px 0 0;
    color: rgba(255,255,255,0.55);
    max-width: 520px;
    font-size: 0.88rem;
    line-height: 1.5;
}

.collections-hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.collections-primary-btn,
.collections-secondary-btn {
    border-radius: 12px;
    height: 40px;
    padding: 0 18px;
    font-weight: 800;
    font-size: 0.82rem;
    cursor: pointer;
    border: 1px solid rgba(255,255,255,0.1);
    white-space: nowrap;
    transition: opacity 0.15s, transform 0.15s;
}
.collections-primary-btn:hover,
.collections-secondary-btn:hover { opacity: 0.88; transform: translateY(-1px); }

.collections-primary-btn {
    background: #12ce18;
    color: #061006;
    border-color: transparent;
}

.collections-secondary-btn {
    background: rgba(255,255,255,0.055);
    color: rgba(255,255,255,0.85);
}

.collections-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 20px;
}

.collections-stat-card {
    padding: 14px 18px;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.075);
    background: rgba(255,255,255,0.035);
}

.collections-stat-value {
    font-size: 24px;
    font-weight: 900;
    color: #fff;
    line-height: 1;
}

.collections-stat-label {
    margin-top: 5px;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.38);
    text-transform: uppercase;
}

.collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
}

.collections-grid.is-empty {
    display: grid;
    grid-template-columns: 1fr;
    place-items: center;
    width: 100%;
    min-height: calc(100vh - 360px);
    padding: 24px 0 80px;
}

.collection-card {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.04);
    cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
}
.collection-card:hover {
    transform: translateY(-2px);
    border-color: rgba(18,206,24,0.35);
    background: rgba(255,255,255,0.065);
}

.collection-card-cover {
    height: 128px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    overflow: hidden;
    background:
        radial-gradient(circle at 30% 20%, rgba(18,206,24,0.22), transparent 30%),
        linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
}
.collection-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.82) saturate(0.95);
}
.collection-card-cover img:first-child:last-child {
    grid-column: 1 / -1;
    grid-row: 1 / -1;
}
.collection-card-cover img:nth-child(2):last-child {
    grid-row: 1 / -1;
}
.collection-card-cover--single {
    display: block;
}
.collection-card-cover--single img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.82) saturate(0.95);
}

.collection-cover-placeholder {
    height: 128px;
    display: grid;
    place-items: center;
    color: rgba(255,255,255,0.2);
    background:
        radial-gradient(circle at 50% 10%, rgba(18,206,24,0.18), transparent 40%),
        rgba(255,255,255,0.03);
}

.collection-card-body { padding: 14px 16px 16px; }

.collection-card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
}

.collection-card h3 {
    margin: 0;
    color: #fff;
    font-size: 15px;
    font-weight: 900;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.collection-card p {
    margin: 4px 0 0;
    color: rgba(255,255,255,0.42);
    font-size: 11.5px;
}

.collection-card-actions {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 12px;
}

.collection-card-actions button {
    height: 30px;
    padding: 0 11px;
    border-radius: 9px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.75);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    transition: background 0.12s;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.collection-card-actions button:hover { background: rgba(255,255,255,0.1); }

.collection-more-wrap {
    position: relative;
    margin-left: auto;
}

.collection-more-btn {
    min-width: 30px !important;
    width: 30px;
    padding: 0 !important;
    letter-spacing: 0.06em;
    font-size: 0.82rem !important;
}

.collection-card-menu {
    position: absolute;
    right: 0;
    bottom: 36px;
    min-width: 136px;
    padding: 5px;
    border-radius: 12px;
    background: rgba(18,18,20,0.97);
    border: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 16px 40px rgba(0,0,0,0.5);
    z-index: 40;
}

.collection-card-menu[hidden] { display: none !important; }

.collection-card-menu button {
    width: 100%;
    height: 33px;
    border: 0 !important;
    border-radius: 8px !important;
    background: transparent !important;
    color: rgba(255,255,255,0.82) !important;
    justify-content: flex-start !important;
    padding: 0 10px !important;
    font-size: 0.8rem !important;
}
.collection-card-menu button:hover { background: rgba(255,255,255,0.08) !important; }
.collection-card-menu button.danger { color: #ff6b6b !important; }
.collection-card-menu button.danger:hover { background: rgba(255,59,48,0.12) !important; }

.collections-empty-state {
    margin: 0 auto;
    width: min(820px, calc(100% - 48px));
    min-height: 420px;
    display: grid;
    place-items: center;
    text-align: center;
    border-radius: 24px;
    border: 1px dashed rgba(255,255,255,0.11);
    background:
        radial-gradient(circle at 50% 0%, rgba(18,206,24,0.11), transparent 34%),
        rgba(255,255,255,0.022);
    padding: 48px 24px;
}

.collections-empty-inner { max-width: 540px; }

.collections-empty-art {
    width: 88px;
    height: 88px;
    margin: 0 auto 22px;
    border-radius: 26px;
    display: grid;
    place-items: center;
    background: rgba(18,206,24,0.08);
    border: 1px solid rgba(18,206,24,0.18);
    box-shadow: 0 0 50px rgba(18,206,24,0.07);
}

.collections-empty-state h2 {
    margin: 0;
    font-size: 26px;
    font-weight: 900;
    letter-spacing: -0.035em;
}

.collections-empty-state > .collections-empty-inner > p {
    margin: 10px auto 0;
    color: rgba(255,255,255,0.52);
    line-height: 1.55;
    font-size: 0.88rem;
}

.collections-empty-actions {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
    flex-wrap: wrap;
}

.collections-suggestions {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 20px;
}

.collections-suggestions span {
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.07);
    color: rgba(255,255,255,0.45);
    font-size: 11.5px;
    font-weight: 500;
    cursor: default;
}

@media (max-width: 900px) {
    .collections-hero {
        align-items: flex-start;
        flex-direction: column;
    }
    .collections-stats {
        grid-template-columns: 1fr;
    }
}

/* ── All Games route-lock and layout-shift prevention ── */
body.ag-route-pending #allGamesView {
    overflow-anchor: none;
}

#allGamesView.ag-first-paint-lock {
    overflow-anchor: none;
}

/* Legacy rule — kept for any remaining references */
#allGamesView.ag-layout-loading {
    overflow-anchor: none;
}

#allGamesGrid {
    overflow-anchor: none;
}

.ag-route-skeleton {
    min-height: calc(100vh - 180px);
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-sec, rgba(255,255,255,0.45));
    box-sizing: border-box;
}

.ag-route-skeleton .acc-spinner {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
}

/* Legacy stable loading panel */
.ag-stable-loading-panel {
    min-height: 520px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-sec, rgba(255,255,255,0.45));
}

.ag-stable-loading-panel .acc-spinner {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
}


/* ── Ready to Install mode — hide the Installed filter chip ── */
body.ag-ready-mode .ag-installed-toggle { display: none !important; }

/* ── Ready to Install loading state ─────────────────────────────────────────── */

/* Sibling wrapper inserted next to allGamesGrid inside library-section. */
.ag-rti-loading-wrap {
    width: 100%;
    box-sizing: border-box;
}

/* Full-height centering container. Uses grid/place-items for robust centering
   that works regardless of the parent element's display mode. */
.ag-ready-loading-state {
    width: 100%;
    min-height: calc(100vh - 180px);
    display: grid;
    place-items: center;
    text-align: center;
    box-sizing: border-box;
}

/* Inner column flex layout for spinner + text. */
.ag-ready-loading-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
}

.ag-rls-spinner {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-width: 2.5px;
}

.ag-rls-title {
    display: block;
    color: var(--text-main, rgba(255,255,255,0.85));
    font-size: 0.93rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    opacity: 0.85;
}

.ag-rls-sub {
    display: block;
    color: var(--text-sec, #86868b);
    font-size: 0.78rem;
    margin-top: 4px;
    opacity: 0.7;
}

/* ── Beta Feedback Banner ──────────────────────────────────────────────────── */
@keyframes betaFeedbackIn {
    from { opacity: 0; transform: translateY(14px) scale(0.985); }
    to   { opacity: 1; transform: translateY(0)    scale(1);     }
}

.beta-feedback-banner {
    position: fixed;
    left: calc(var(--sidebar-width) + 12px);
    right: 18px;
    bottom: 18px;
    min-height: 58px;
    padding: 10px 12px 10px 14px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    z-index: 99990;
    color: rgba(255, 255, 255, 0.92);
    background:
        linear-gradient(135deg, rgba(18, 206, 24, 0.16), rgba(18, 18, 18, 0.88) 42%, rgba(0, 0, 0, 0.88)),
        rgba(12, 12, 12, 0.92);
    border: 1px solid rgba(18, 206, 24, 0.26);
    box-shadow:
        0 18px 45px rgba(0, 0, 0, 0.42),
        0 0 0 1px rgba(255, 255, 255, 0.04) inset,
        0 0 28px rgba(18, 206, 24, 0.09);
    backdrop-filter: blur(18px);
    -webkit-app-region: no-drag;
    animation: betaFeedbackIn 220ms ease-out both;
}

.beta-feedback-banner[hidden] { display: none !important; }

.beta-feedback-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1;
}

.beta-feedback-pill {
    height: 26px;
    padding: 0 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #091009;
    background: linear-gradient(135deg, #12ce18, #78ff7d);
    box-shadow: 0 0 18px rgba(18, 206, 24, 0.25);
    flex: 0 0 auto;
}

.beta-feedback-copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
}

.beta-feedback-copy strong {
    font-size: 13px;
    font-weight: 800;
    line-height: 1.1;
}

.beta-feedback-copy span {
    font-size: 12px;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.62);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.beta-feedback-cta {
    height: 34px;
    padding: 0 13px;
    border-radius: 999px;
    border: 1px solid rgba(18, 206, 24, 0.35);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #071007;
    background: linear-gradient(135deg, #12ce18, #70f774);
    font-family: var(--font-main);
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    flex: 0 0 auto;
    transition: transform 0.16s ease, box-shadow 0.16s ease, filter 0.16s ease;
    -webkit-app-region: no-drag;
}

.beta-feedback-cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
    box-shadow: 0 10px 24px rgba(18, 206, 24, 0.22);
}

.beta-feedback-close {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.62);
    font-size: 16px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex: 0 0 auto;
    -webkit-app-region: no-drag;
}

.beta-feedback-close:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.10);
}

body.has-beta-feedback-banner #mainContentArea {
    padding-bottom: 92px;
}

.sidebar.collapsed ~ * .beta-feedback-banner,
body:has(.sidebar.collapsed) .beta-feedback-banner {
    left: calc(var(--sidebar-collapsed-width) + 12px);
}

@media (max-width: 900px) {
    .beta-feedback-banner {
        left: 14px;
        right: 14px;
        bottom: 14px;
        border-radius: 16px;
    }

    .beta-feedback-copy span {
        white-space: normal;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }
}

@media (max-width: 640px) {
    .beta-feedback-banner {
        align-items: stretch;
        flex-direction: column;
        gap: 10px;
        padding: 12px;
    }

    .beta-feedback-close {
        position: absolute;
        right: 10px;
        top: 10px;
    }

    .beta-feedback-left {
        padding-right: 34px;
    }

    .beta-feedback-cta {
        width: 100%;
        justify-content: center;
    }
}

@media (prefers-reduced-motion: reduce) {
    .beta-feedback-banner:not([hidden]) { animation: none; }
    .beta-feedback-cta { transition: none; }
}

/* ============================================================ */
/* BADDEL LAUNCHER — ACCOUNTS CSS (REDESIGN v3)               */
/* Premium quality. No AI slop.                               */
/* ============================================================ */


/* ============================================================ */
/* 1. SIDEBAR SECTION BUTTONS                                   */
/* ============================================================ */

.sidebar-section-btn {
    height: 44px;
    border-radius: 8px;
    padding: 0 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    margin-bottom: 2px;
    margin-top: 6px;
    position: relative;
    transition: all 0.15s ease;
    color: var(--text-sec);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 1px;
}

.sidebar-section-btn:hover {
    background: rgba(255, 255, 255, 0.04);
    color: #666;
}

.sidebar-section-btn.active {
    background: transparent;
    color: #888;
}

.sidebar-section-btn .nav-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    opacity: 0.7;
}

.section-chevron {
    margin-left: auto;
    font-size: 0.55rem;
    opacity: 0.3;
    transition: transform 0.2s ease;
}

.sidebar.collapsed .section-chevron { display: none; }

/* ============================================================ */
/* 2. SIDEBAR SUB ITEMS                                         */
/* ============================================================ */

.sidebar-sub-items {
    padding-left: 6px;
    border-left: 1px solid rgba(255, 255, 255, 0.04);
    margin-left: 8px;
    margin-bottom: 4px;
}

.sidebar-sub-header {
    margin-top: 16px;
    margin-bottom: 6px;
    padding-left: 14px;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: rgba(255, 255, 255, 0.12);
    text-transform: uppercase;
}

.sidebar.collapsed .sidebar-sub-items {
    padding-left: 0;
    border-left: none;
    margin-left: 0;
}

/* ============================================================ */
/* 3. PLATFORM ITEMS IN SIDEBAR                                 */
/* ============================================================ */

.platform-item {
    position: relative;
}

.platform-count {
    font-size: 0.65rem;
    color: #2a2a2a;
    font-weight: 700;
    margin-left: auto;
    padding: 2px 7px;
    background: transparent;
    border-radius: 20px;
    font-family: var(--font-heading, sans-serif);
    transition: all 0.15s;
    letter-spacing: 0.5px;
}

.platform-item.active .platform-count {
    color: rgba(255, 255, 255, 0.5);
}

.sidebar.collapsed .platform-count { display: none; }

.platform-icon { transition: color 0.15s; }
.steam-icon   { color: #66c0f4; }
.epic-icon    { color: #ffffff; }
.ea-icon      { color: #ff6b35; }
.riot-icon    { color: #ff4655; }
.ubisoft-icon { color: #00a8ff; }
.discord-icon { color: #ffffff; }
.platform-item.active .platform-icon { color: #000000 !important; }

/* ============================================================ */
/* 4. ACCOUNTS VIEW WRAPPER                                     */
/* ============================================================ */

#accountsView {
    height: 100%;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #1e1e1e transparent;
}

#accountsView::-webkit-scrollbar { width: 3px; }
#accountsView::-webkit-scrollbar-track { background: transparent; }
#accountsView::-webkit-scrollbar-thumb { background: #1e1e1e; border-radius: 2px; }

.accounts-page {
    display: flex;
    flex-direction: column;
    min-height: 100%;
}

/* ============================================================ */
/* 5. ACCOUNTS HERO — PREMIUM REDESIGN                          */
/* ============================================================ */

.accounts-hero-v2 {
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    /* CSS custom props injected from JS */
    --plat-color: #0f0f0f;
    --plat-accent: #ffffff;
}

/* ── Diagonal background split ── */
.accounts-hero-v2::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(
        108deg,
        color-mix(in srgb, var(--plat-accent) 6%, #0a0a0a) 0%,
        color-mix(in srgb, var(--plat-accent) 6%, #0a0a0a) 40%,
        #080808 40%
    );
    z-index: 0;
}

/* ── Grid overlay fading left to right ── */
.hero-grid-overlay {
    position: absolute; inset: 0;
    background-image:
        linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
    z-index: 0;
    mask-image: linear-gradient(108deg, black 0%, black 35%, transparent 55%);
    -webkit-mask-image: linear-gradient(108deg, black 0%, black 35%, transparent 55%);
}

/* ── Accent glow (soft, not blinding) ── */
.hero-glow-blob {
    position: absolute;
    background: var(--plat-accent);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
}

.blob-1 {
    top: -60px; left: -60px;
    width: 320px; height: 320px;
    filter: blur(120px);
    opacity: 0.08;
}

.blob-2 {
    bottom: -80px; right: 5%;
    width: 400px; height: 400px;
    filter: blur(150px);
    opacity: 0.04;
}

/* ── Giant watermark text ── */
.hero-watermark {
    position: absolute;
    left: -10px; top: -24px;
    font-family: var(--font-heading, sans-serif);
    font-weight: 900;
    font-size: 180px;
    line-height: 1;
    color: var(--plat-accent);
    opacity: 0.025;
    letter-spacing: -6px;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    white-space: nowrap;
}

/* ── Thin accent line at top ── */
.accounts-hero-v2::after {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(
        90deg,
        transparent 0%,
        color-mix(in srgb, var(--plat-accent) 50%, transparent) 30%,
        color-mix(in srgb, var(--plat-accent) 50%, transparent) 55%,
        transparent 100%
    );
    z-index: 3;
}

/* ── Inner layout ── */
.accounts-hero-content-v2 {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 28px;
    padding: 44px 48px 0 48px;
}

/* ── Logo box ── */
.acc-hero-logo-box {
    width: 92px;
    height: 92px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid color-mix(in srgb, var(--plat-accent) 18%, transparent);
    border-bottom: 3px solid var(--plat-accent);
    border-radius: 18px;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 16px 40px rgba(0,0,0,0.5);
}

/* Glass shimmer inside logo box */
.acc-hero-logo-box::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 45%;
    background: linear-gradient(to bottom, rgba(255,255,255,0.05), transparent);
    z-index: 1;
    pointer-events: none;
}

.acc-hero-main-logo {
    width: 54px;
    height: 54px;
    object-fit: contain;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.4));
}

.invert-hero-logo {
    filter: brightness(0) invert(1) drop-shadow(0 4px 12px rgba(0,0,0,0.4));
}

/* ── Text stack ── */
.acc-hero-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 14px;
}

.acc-hero-platform-eyebrow {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--plat-accent);
    text-transform: uppercase;
    opacity: 0.7;
}

.acc-hero-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 2.8rem;
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 1;
    color: #fff;
    margin: 0;
}

.acc-hero-meta-row {
    display: flex;
    align-items: center;
    gap: 16px;
}

.acc-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: color-mix(in srgb, var(--plat-accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--plat-accent) 18%, transparent);
    color: color-mix(in srgb, var(--plat-accent) 65%, #888);
    padding: 5px 12px;
    border-radius: 5px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    width: fit-content;
}

/* Pulsing dot inside badge */
.pulse-dot-mini {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
    animation: pulseDot 2s infinite ease-in-out;
}

@keyframes pulseDot {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.25; }
}

.acc-hero-stat {
    font-size: 0.72rem;
    color: #444;
    font-weight: 600;
}
.acc-hero-stat strong {
    color: #888;
    font-weight: 700;
}

/* ── Actions (right side) ── */
.accounts-hero-actions-v2 {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 0 48px 24px 48px;
    justify-content: flex-end;
    margin-top: auto;
}

/* Full inner row so content + actions sit side by side */
.accounts-hero-inner-row {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
}

/* ── Tab bar under hero ── */
.acc-hero-tabs {
    position: relative;
    z-index: 2;
    display: flex;
    padding: 0 48px;
    margin-top: 20px;
    border-bottom: 1px solid #161616;
}

.acc-hero-tab {
    padding: 11px 0;
    margin-right: 28px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #2a2a2a;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: all 0.15s;
    text-transform: uppercase;
}

.acc-hero-tab:hover { color: #555; }
.acc-hero-tab.active {
    color: var(--plat-accent);
    border-bottom-color: var(--plat-accent);
}

/* ============================================================ */
/* 6. ACCOUNTS BUTTONS                                          */
/* ============================================================ */

.acc-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    font-family: var(--font-main, sans-serif);
    transition: all 0.15s ease;
    white-space: nowrap;
    letter-spacing: 0.3px;
}

.acc-btn-primary {
    background: var(--btn-accent, #ffffff);
    color: #000;
}

.acc-btn-primary:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
}

.acc-btn-primary:active {
    transform: translateY(0);
}

.acc-btn-secondary {
    background: transparent;
    color: #555;
    border: 1px solid #222;
}

.acc-btn-secondary:hover {
    background: #111;
    border-color: #2e2e2e;
    color: #888;
}

/* ============================================================ */
/* 7. ACCOUNTS LIST SECTION                                     */
/* ============================================================ */

.accounts-list-section {
    padding: 28px 48px;
    flex: 1;
    background: #080808;
}

.accounts-list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}

.accounts-list-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: #555;
    text-transform: uppercase;
}

.accounts-list-count {
    font-size: 0.68rem;
    color: #444;
    font-weight: 700;
    letter-spacing: 0.5px;
    font-family: var(--font-heading, sans-serif);
}

/* ============================================================ */
/* 8. ACCOUNT CARDS                                             */
/* ============================================================ */

.accounts-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.account-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 15px 20px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 10px;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    cursor: default;
    position: relative;
    overflow: hidden;
}

/* Accent bar on the left edge (appears on hover) */
.account-card::before {
    content: '';
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--plat-accent, #fff);
    opacity: 0;
    transition: opacity 0.2s ease;
    border-radius: 0 2px 2px 0;
}

.account-card:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.1);
    transform: translateX(3px);
}

.account-card:hover::before {
    opacity: 1;
}

/* Account number */
.acc-card-num {
    font-family: var(--font-heading, sans-serif);
    font-size: 0.68rem;
    font-weight: 800;
    color: #333;
    width: 22px;
    flex-shrink: 0;
    letter-spacing: 0.5px;
}

/* Avatar */
.acc-card-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--acc-color, var(--plat-accent, #fff)) 80%, #fff);
    flex-shrink: 0;
    transition: all 0.2s ease;
    overflow: hidden;
}

.account-card:hover .acc-card-avatar {
    border-color: color-mix(in srgb, var(--plat-accent, #fff) 30%, transparent);
    background: color-mix(in srgb, var(--plat-accent, #fff) 8%, transparent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--plat-accent, #fff) 20%, transparent);
}

/* Discord avatar is round — keep it perfectly round */
.acc-card-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
}

/* Card info */
.acc-card-info {
    flex: 1;
    min-width: 0;
}

.acc-card-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: #ccc;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 3px;
    letter-spacing: 0.2px;
}

.acc-card-platform {
    font-size: 0.7rem;
    color: #444;
    font-weight: 500;
}

/* Card actions */
.acc-card-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

/* Switch button — juicy, platform-themed */
.acc-switch-btn {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: var(--text-main, #ccc);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    font-family: var(--font-main, sans-serif);
    letter-spacing: 0.3px;
    position: relative;
    overflow: hidden;
}

.acc-switch-btn::before {
    content: '';
    position: absolute; inset: 0;
    background: var(--btn-accent, #ffffff);
    opacity: 0;
    transition: opacity 0.2s ease;
}

.acc-switch-btn:hover {
    border-color: var(--btn-accent, #ffffff);
    color: color-mix(in srgb, var(--btn-accent, #ffffff) 100%, #000);
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--btn-accent, #fff) 25%, transparent),
                0 0 0 1px color-mix(in srgb, var(--btn-accent, #fff) 20%, transparent);
    background: color-mix(in srgb, var(--btn-accent, #ffffff) 12%, transparent);
}

.acc-switch-btn:active {
    transform: translateY(0) scale(0.98);
}

.acc-switch-btn svg {
    transition: transform 0.2s ease;
}

.acc-switch-btn:hover svg {
    transform: rotate(180deg);
}

.acc-switch-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: none !important;
    box-shadow: none !important;
}

/* Rename button */
.acc-rename-btn {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #333;
    cursor: pointer;
    transition: all 0.15s ease;
}

.acc-rename-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: #888;
    transform: scale(1.05);
}

/* Delete button */
.acc-delete-btn {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #333;
    cursor: pointer;
    transition: all 0.15s ease;
}

.acc-delete-btn:hover {
    background: rgba(255, 59, 48, 0.08);
    border-color: rgba(255, 59, 48, 0.25);
    color: #ff3b30;
    transform: scale(1.05);
}

/* ============================================================ */
/* 9. EMPTY STATE & LOADING                                     */
/* ============================================================ */

.accounts-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    gap: 12px;
    text-align: center;
}

.accounts-empty p {
    font-size: 0.9rem;
    font-weight: 600;
    color: #2e2e2e;
}

.accounts-empty span {
    font-size: 0.75rem;
    color: #222;
}

.accounts-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 40px;
    color: #2a2a2a;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.5px;
}

/* ============================================================ */
/* 10. SPINNERS                                                  */
/* ============================================================ */

.acc-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    animation: accSpin 0.7s linear infinite;
}

.acc-mini-spinner {
    width: 11px;
    height: 11px;
    border: 2px solid rgba(0, 0, 0, 0.15);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: accSpin 0.7s linear infinite;
    display: inline-block;
}

@keyframes accSpin {
    to { transform: rotate(360deg); }
}

/* ============================================================ */
/* 11. COLLAPSED SIDEBAR FIXES                                  */
/* ============================================================ */

.sidebar.collapsed .sidebar-sub-items .nav-text,
.sidebar.collapsed .sidebar-section-btn .nav-text,
.sidebar.collapsed .sidebar-sub-header {
    opacity: 0;
    pointer-events: none;
    display: none;
}

.sidebar.collapsed .sidebar-section-btn {
    padding: 0;
    justify-content: center;
    width: 48px;
    height: 48px;
}

.sidebar.collapsed .sidebar-sub-items {
    padding-left: 0;
    border-left: none;
    margin-left: 0;
}

/* ============================================================ */
/* 12. PLATFORM ACTIVE STATES IN SIDEBAR                        */
/* ============================================================ */

#nav-steam.active   { background: #66c0f4 !important; color: #000 !important; }
#nav-steam.active .platform-icon { color: #1b2838 !important; }

#nav-epic.active    { background: #f0f0f0 !important; color: #000 !important; }
#nav-epic.active .platform-icon { color: #000 !important; }
#nav-epic.active img { filter: brightness(0) saturate(100%) !important; }

#nav-ea.active      { background: #ff4545 !important; color: #fff !important; }
#nav-ea.active .platform-icon { color: #fff !important; }

#nav-riot.active    { background: #d32f2e !important; color: #fff !important; }
#nav-riot.active .platform-icon { color: #fff !important; }

#nav-ubisoft.active { background: #00a8ff !important; color: #fff !important; }
#nav-ubisoft.active .platform-icon { color: #fff !important; }

#nav-discord.active { background: #5865F2 !important; color: #fff !important; }
#nav-discord.active .platform-icon { color: #fff !important; }

#nav-steam.active   .platform-count,
#nav-epic.active    .platform-count { background: rgba(0,0,0,0.12); color: rgba(0,0,0,0.4); }

#nav-ea.active      .platform-count,
#nav-riot.active    .platform-count,
#nav-ubisoft.active .platform-count,
#nav-discord.active .platform-count { background: rgba(0,0,0,0.15); color: rgba(255,255,255,0.45); }

/* ============================================================ */
/* 13. DISCORD CARD SPECIAL (avatar image)                      */
/* ============================================================ */

.discord-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* ============================================================ */
/* 14. ANIMATIONS                                               */
/* ============================================================ */

@keyframes blobFloat {
    from { transform: translateY(0px) scale(1); }
    to   { transform: translateY(-20px) scale(1.05); }
}


/* أضف هذا داخل قسم: 8. ACCOUNT CARDS في ملف accounts.css */

/* Pin/Send to Home button */
.acc-pin-btn {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #333;
    cursor: pointer;
    transition: all 0.15s ease;
}

.acc-pin-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: var(--plat-accent, #fff); /* ياخد لون المنصة */
    transform: scale(1.05);
}

/* ========================================= */
/* 📌 PINNED STATE FOR ACCOUNT CARDS         */
/* ========================================= */
.acc-pin-btn.is-pinned {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: var(--plat-accent, #fff);
}

.acc-pin-btn.is-pinned svg {
    fill: currentColor; /* ده السر اللي بيخلي البيت مفرغ يتحول لبيت مليان */
}


/* ========================================= */
/* ROCKSTAR GAMES STYLES                     */
/* ========================================= */
.acc-btn-rockstar:hover {
    background: rgba(252, 175, 23, 0.1); 
    color: #fcaf17;
    border-color: rgba(252, 175, 23, 0.4);
    box-shadow: 0 5px 15px rgba(252, 175, 23, 0.2);
}

.acc-btn-rockstar:hover svg {
    color: #fcaf17;
}

/* لو عندك بادج للمنصة في كارت الأكاونت */
.acc-plat-badge.rockstar {
    background: #fcaf17;
    color: #000; /* عشان الكلام يبقى مقروء على الأصفر */
}

/* ========================================= */
/* PLATFORM SYNC — All Games & Link Banner   */
/* ========================================= */

/* ── Toolbar sticky wrapper ─────────────────────────────────── */
.ag-toolbar-sticky {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(8, 8, 8, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    padding: 12px 0 10px;
    margin-bottom: 16px;
    /* padding intentionally excluded from transition — height change causes visible jump */
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.ag-toolbar-sticky.is-stuck {
    border-bottom-color: rgba(255, 255, 255, 0.06);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
    /* padding kept identical to avoid layout height change when is-stuck toggles */
}

/* ── Toolbar (search + filters + sort) ─────────────────────── */
.ag-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: nowrap;
    margin-bottom: 0;
}

/* Filter group — pills + account + installed — takes remaining space */
.ag-filter-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
    /* overflow: hidden removed — it clips position:absolute dropdown children
       (agAccountMenu) even though they are positioned outside the flow.
       Text overflow on pill/trigger labels is handled by min-width:0 +
       text-overflow on those elements directly instead. */
    overflow: visible;
}

/* Controls group — sort / view / display / count — fixed right */
.ag-controls-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

/* Search */
.ag-search-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px;
    padding: 0 10px 0 12px;
    height: 34px;
    flex-shrink: 0;
    width: 200px;
    transition: border-color 0.15s, width 0.2s ease;
}
.ag-search-wrap:focus-within {
    border-color: rgba(255,255,255,0.18);
    width: 240px;
}
.ag-search-wrap svg { color: #444; flex-shrink: 0; }
.ag-search-input {
    background: none; border: none; outline: none;
    color: #ddd; font-size: 0.8rem;
    font-family: var(--font-main, sans-serif);
    width: 100%;
    min-width: 0;
}
.ag-search-input::placeholder { color: #3a3a3a; }

/* Search clear (X) button */
.ag-search-clear {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: #555;
    cursor: pointer;
    padding: 2px;
    border-radius: 3px;
    transition: color 0.12s;
    flex-shrink: 0;
    line-height: 0;
}
.ag-search-clear:hover { color: #aaa; }

/* Platform filter pills */
.ag-filter-pills {
    display: flex;
    align-items: center;
    gap: 5px;
}

/* Account dropdown (theme-styled, non-native select) */
.ag-account-dropdown {
    min-width: 180px;
}

.ag-account-trigger {
    min-width: 180px;
    height: 34px;
    padding: 0 12px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    color: #b9b9b9;
    font-size: 0.75rem;
}

.ag-account-trigger:hover {
    border-color: rgba(255,255,255,0.18);
}

.ag-account-menu {
    width: 100%;
    max-height: 280px;
    overflow-y: auto;
    z-index: 200; /* was 120 — must exceed ag-toolbar-sticky z-index:50 and card z-index:10 */
}

.ag-pill {
    height: 34px;
    padding: 0 13px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.07);
    background: rgba(255,255,255,0.03);
    color: #666;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-main, sans-serif);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    white-space: nowrap;
}
.ag-pill:hover {
    background: rgba(255,255,255,0.07);
    color: #aaa;
    border-color: rgba(255,255,255,0.13);
}
.ag-pill.active {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.2);
    color: #fff;
}
.ag-pill-icon {
    width: 13px; height: 13px;
    object-fit: contain;
    opacity: 0.7;
}
.ag-pill-icon-invert {
    filter: brightness(0) invert(1);
}

/* Sort select */
.ag-sort-wrap {
    display: flex;
    align-items: center;
    gap: 7px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px;
    padding: 0 12px;
    height: 34px;
    transition: border-color 0.15s;
}
.ag-sort-wrap svg { color: #444; flex-shrink: 0; }
.ag-sort-select {
    background: none; border: none; outline: none;
    color: #888; font-size: 0.75rem; font-weight: 600;
    font-family: var(--font-main, sans-serif);
    cursor: pointer;
    appearance: none; -webkit-appearance: none;
    padding-right: 4px;
}
.ag-sort-select option { background: #111; color: #ccc; }
.ag-sort-wrap:focus-within { border-color: rgba(255,255,255,0.15); }

/* Result count */
.ag-result-count {
    font-size: 0.7rem;
    font-weight: 600;
    color: #3a3a3a;
    letter-spacing: 0.5px;
    white-space: nowrap;
}

/* ── Game card wrapper for All Games ────────────────────────── */
.agc-card .game-card-img-wrap {
    position: relative;
    overflow: hidden;
}

/* Multi-platform subtle accent */
.agc-multi .game-card-img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: inherit;
    pointer-events: none;
    z-index: 4;
}

/* Gradient from top so badges always readable */
.agc-top-gradient {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 55px;
    background: linear-gradient(to bottom, rgba(0,0,0,0.52) 0%, transparent 100%);
    pointer-events: none;
    z-index: 2;
}

/* ── Badge strip — top-right corner ─────────────────────────── */
.agc-badges-strip {
    position: absolute;
    top: 7px; 
    right: 7px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 3;
    align-items: flex-end;
    
    /* التعديل هنا */
    opacity: 0;
    transform: translateY(-5px); /* حركة خفيفة من فوق لتحت */
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none; /* عشان ميعطلش الكليك على الكارت وهي مخفية */
}

.agc-card:hover .agc-badges-strip {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
}

/* ── Individual badge ─────────────────────────────────────────── */
.agc-badge {
    --bc: #ffffff;
    width: 24px; height: 24px;
    border-radius: 7px;
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid color-mix(in srgb, var(--bc) 26%, transparent);
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 2px 6px rgba(0,0,0,0.4);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    flex-shrink: 0;
}

.agc-card:hover .agc-badge {
    border-color: color-mix(in srgb, var(--bc) 52%, transparent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--bc) 20%, transparent),
                0 2px 6px rgba(0,0,0,0.4);
    transform: scale(1.06);
}

.agc-badge-img {
    width: 13px; height: 13px;
    object-fit: contain; display: block;
    opacity: 0.8;
    transition: opacity 0.2s;
}
.agc-card:hover .agc-badge-img { opacity: 1; }

.agc-badge-invert {
    filter: brightness(0) invert(1) !important;
    opacity: 0.75;
}
.agc-card:hover .agc-badge-invert { opacity: 1; }

.agc-badge-dot {
    width: 7px; height: 7px;
    border-radius: 50%; opacity: 0.85;
}

.agc-badge-overflow {
    font-size: 0.55rem; font-weight: 800;
    color: rgba(255,255,255,0.5);
    letter-spacing: 0.3px;
    font-family: var(--font-heading, sans-serif);
    border-color: rgba(255,255,255,0.1);
}
.agc-card:hover .agc-badge-overflow {
    color: rgba(255,255,255,0.9);
    border-color: rgba(255,255,255,0.28);
}

.agc-placeholder {
    background: linear-gradient(135deg, #111 0%, #0a0a0a 100%) !important;
    display: flex !important;
    align-items: center; justify-content: center;
}

