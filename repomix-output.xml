    const api = {
        async lookupGame()       { return null; },
        normalizeServerData(h)   { return h; },
        normalizeTransientData(h){ return h; },
        async resolveMetadata()  {
            callCount++;
            const err = new Error('429 rate limited');
            err.status = 429;
            throw err;
