/* ── CSS custom properties ── */
:root {
    --font-brand:   'Lufga', 'Outfit', 'Montserrat', sans-serif;
    --font-main:    'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-heading: 'Outfit', 'Montserrat', sans-serif;
    --font-code:    'JetBrains Mono', 'Courier New', monospace;
    --font-ar:      'Tajawal', 'Montserrat', sans-serif;
    --font-steam:   'Lato', 'Montserrat', sans-serif;
}

/* ── Global base font reset ── */
html,
body,
button,
input,
textarea,
select {
    font-family: var(--font-main);
}

/* ── Utility: Arabic text ── */
[lang="ar"],
.font-ar,
.arabic-text {
    font-family: var(--font-ar);
    direction: rtl;
}

/* ── Utility: technical / path / code text ── */
code,
pre,
.mono,
.path-text,
.exe-path,
.game-path,
.debug-text,
.version-text {
    font-family: var(--font-code);
}

/* ── Utility: Steam / login integration areas ── */
.steam-login,
.steam-auth,
.steam-panel,
.steam-network-login {
    font-family: var(--font-steam);
}

/* ========================================= */
/* 1. CORE VARIABLES & FONTS                 */
/* ========================================= */






:root {
    --sidebar-width: 280px;
    --sidebar-collapsed-width: 72px;
    --bg-color: #000000;
    --surface-color: rgba(255, 255, 255, 0.05);
    --accent: #ffffff;
    --accent-hover: #f5f5f7;
    --danger: #ff3b30;
    --text-main: #f5f5f7;
    --text-sec: #86868b;
    /* --font-* variables are defined in fonts.css */
}

* { box-sizing: border-box; margin: 0; padding: 0; user-select: none; outline: none; }

html,
body,
button,
input,
select,
textarea {
    font-family: var(--font-main);
}

body {
    background-color: var(--bg-color);
    color: var(--text-main);
    font-family: var(--font-main);
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
}

/* ========================================= */
/* 2. CUSTOM SCROLLBAR                       */
/* ========================================= */
::-webkit-scrollbar { width: 4px; } 
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.4); }

/* ========================================= */
/* 2. CUSTOM SCROLLBAR                       */
/* ========================================= */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #222; border-radius: 10px; }
::-webkit-scrollbar-thumb:hover {
    background: #444;
}
/* ========================================= */
/* 3. TITLE BAR (WINDOW CONTROLS)            */
/* ========================================= */
.title-bar {
    width: 100%; height: 35px; background: #0e0e0e;
    display: flex; justify-content: space-between; align-items: center;
    position: fixed; top: 0; left: 0; z-index: 10000;
    pointer-events: none; -webkit-app-region: drag; padding: 0 10px;
    overflow: visible;
}
.app-title {
    font-family: var(--font-heading); font-weight: 800; font-size: 0.8rem;
    color: #444; letter-spacing: 2px; text-transform: uppercase;
}
.window-controls { pointer-events: auto; display: flex; height: 100%; -webkit-app-region: no-drag; }
.control-btn {
    background: transparent; border: none; color: #666; width: 40px; height: 100%;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    font-size: 1rem; transition: 0.2s;
}
.control-btn:hover { background: rgba(255,255,255,0.05); color: white; }
.btn-close:hover { background: var(--danger); }

/* ========================================= */
/* 4. MAIN LAYOUT & SIDEBAR                  */
/* ========================================= */
.main-layout { display: flex; height: 100vh; padding-top: 35px; }

.sidebar {
    width: var(--sidebar-width);
    min-width: var(--sidebar-width);
    max-width: var(--sidebar-width);
    flex-shrink: 0;
    padding: 20px 12px;
    display: flex;
    flex-direction: column;
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    background: #000000;
    border-right: none;
    z-index: 100;
    /* will-change:width triggers full layout on every frame — removed */
    transform: translateZ(0);
}

.sidebar-toggle {
    position: absolute;
    top: 25px; 
    right: -13px; 
    width: 26px;
    height: 26px;
    background: #222;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5); 
    z-index: 1000;
    font-size: 0.7rem;
    transition: 0.3s ease;
}
.sidebar-toggle:hover { transform: scale(1.1); background: #333; color: white; }

.sidebar.collapsed {
    width: var(--sidebar-collapsed-width);
    min-width: var(--sidebar-collapsed-width);
    max-width: var(--sidebar-collapsed-width);
    padding: 25px 10px;
}


.sidebar-logo-area {
    margin-top: 10px;
    margin-bottom: 14px;
    padding: 0 12px;
    height: 48px;
    display: flex;
    align-items: center;
    gap: 13px;
    position: relative;
    cursor: pointer;
    transition: opacity 0.15s ease;
}

.sidebar-logo-area:hover {
    opacity: 0.92;
}

.sidebar-logo-area::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: -18px;
    height: 1px;
    background: linear-gradient(
        90deg,
        rgba(255,255,255,0.13),
        rgba(255,255,255,0.025),
        transparent
    );
}

.brand-mark {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #080808;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.045),
        0 8px 20px rgba(0,0,0,0.45);
    flex-shrink: 0;
}

.main-sidebar-logo {
    width: 22px;
    height: 22px;
    object-fit: contain;
    opacity: 0.92;
}

.brand-lockup {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
}

.brand-name {
    font-family: var(--font-brand);
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: rgba(255,255,255,0.88);
    line-height: 1;
}

.brand-line {
    width: 54px;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(
        90deg,
        rgba(18,206,24,0.85),
        rgba(18,206,24,0.18),
        transparent
    );
}

.sidebar-logo-area:hover .brand-name {
    color: #fff;
}

.sidebar-logo-area:hover .brand-mark {
    border-color: rgba(255,255,255,0.14);
    background: #0b0b0b;
}

.sidebar.collapsed .sidebar-logo-area {
    justify-content: center;
    padding: 0;
    margin-top: 26px;
}

.sidebar.collapsed .sidebar-logo-area::after {
    left: 14px;
    right: 14px;
}

.sidebar.collapsed .brand-lockup {
    display: none;
}

.sidebar.collapsed .brand-mark {
    width: 38px;
    height: 38px;
}

.sidebar.collapsed .main-sidebar-logo {
    width: 23px;
    height: 23px;
}

/* removed old shine/sweep hover effect */



.nav-item {
    height: 48px; border-radius: 10px; padding: 0 15px;
    display: flex; align-items: center; gap: 12px;
    /* transition:all recalculates every property — very slow in a flex sidebar */
    transition: background-color 0.12s, color 0.12s;
    margin-bottom: 6px;
    position: relative;
    cursor: pointer;
}

.nav-text {
    flex-grow: 1; 
    white-space: nowrap; 
    overflow: hidden; 
    text-overflow: ellipsis; 
}

.nav-icon { width: 20px; height: 20px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: var(--text-sec); }

.sidebar-header { margin-top: 25px; margin-bottom: 12px; padding-left: 10px; font-size: 0.65rem; font-weight: 600; letter-spacing: 1px; color: var(--text-sec); }

.sidebar.collapsed .nav-text, .sidebar.collapsed .sidebar-header, .sidebar.collapsed .delete-btn { opacity: 0; pointer-events: none; display: none; }

/* removed duplicate .sidebar.collapsed .sidebar-logo-area (was overriding correct block above) */
/* removed dead .sidebar.collapsed .logo-brand and .logo-box — old classes no longer in HTML */
#collectionsList .nav-item { background: transparent; }
.nav-item:hover { background: rgba(255, 255, 255, 0.08); }

.nav-item.active {
    background: rgba(255, 255, 255, 0.07) !important;
    color: #ffffff !important;
    font-weight: 600;
}

.nav-item.active::before {
    content: '';
    position: absolute;
    left: 0; top: 50%;
    transform: translateY(-50%);
    width: 3px; height: 18px;
    background: var(--accent);
    border-radius: 0 3px 3px 0;
    box-shadow: 0 0 8px var(--accent);
}

.nav-item.active .nav-icon,
.nav-item.active .fav-heart,
.nav-item.active .delete-btn {
    color: #ffffff !important;
}

.nav-item.active .delete-btn:hover {
    color: var(--danger) !important;
    background: rgba(255, 59, 48, 0.1);
    border-radius: 50%;
}

.delete-btn {
    opacity: 0; color: var(--text-sec);
    font-size: 0.8rem; transition: opacity 0.12s, color 0.12s;
    flex-shrink: 0; 
}
.nav-item:hover .delete-btn { opacity: 1; }
.delete-btn:hover { color: var(--danger); }

.add-coll-btn {
    margin-top: auto; background: transparent; border: 1px solid rgba(255,255,255,0.1);
    color: var(--text-sec); padding: 12px; border-radius: 10px; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 8px; font-weight: 500; font-size: 0.85rem; transition: border-color 0.12s, color 0.12s, background-color 0.12s;
}
.add-coll-btn:hover { border-color: rgba(255,255,255,0.3); color: white; background: rgba(255,255,255,0.05); }
/* ========================================= */
/* 5. CONTENT AREA & CINEMATIC HERO          */
/* ========================================= */
.content-area { 
    flex-grow: 1; 
    overflow-y: auto; 
    /* overflow-x:hidden removed — it clips position:absolute dropdown menus
       (agAccountMenu, agSortMenu, igPlatformMenu, etc.) that extend beyond
       the toolbar row. The sidebar already prevents horizontal bleed. */
    position: relative; 
    -webkit-overflow-scrolling: touch;
}

.library-section, .recently-played-section, .surprise-me-section, .system-stats-section {
    /* content-visibility removed: was causing scroll jank / 2-frame lag */
}

.cinematic-hero {
    position: relative; width: 100%; height: 480px;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 50px; overflow: hidden; border-bottom: 1px solid rgba(255,255,255,0.03);
}

.hero-bg-parallax {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover; background-position: center 20%;
    z-index: 0; transition: background-image 0.5s ease;
    animation: slowZoom 20s infinite alternate linear;
    will-change: transform; 
    transform: translateZ(0);
    /* Isolate this animation to its own layer so it doesn't invalidate scroll compositing */
    isolation: isolate;
    contain: strict;
}
@keyframes slowZoom { from { transform: scale(1) translateZ(0); } to { transform: scale(1.05) translateZ(0); } }

.hero-vignette {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;
    background: linear-gradient(to top, var(--bg-color) 0%, rgba(8,8,8,0.6) 40%, rgba(8,8,8,0) 100%),
                linear-gradient(to right, var(--bg-color) 0%, transparent 60%);
}

.hero-content { position: relative; z-index: 2; max-width: 800px; animation: fadeUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1); }

.hero-game-logo { max-width: 350px; max-height: 120px; object-fit: contain; margin-bottom: 15px; filter: drop-shadow(0 5px 15px rgba(0,0,0,0.5)); }
.hero-game-title { font-family: var(--font-brand); font-size: 3.2rem; font-weight: 900; text-transform: uppercase; line-height: 1; margin-bottom: 10px; text-shadow: 0 2px 10px rgba(0,0,0,0.5); }

.hero-stats { display: flex; gap: 10px; margin-bottom: 25px; }
.stat-badge {
    background: rgba(255,255,255,0.07); 
    padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; color: #aaa;
    border: 1px solid rgba(255,255,255,0.06); display: flex; align-items: center; gap: 6px;
}
.stat-badge .icon { font-size: 0.9rem; color: #666; }
.playtime-stat { color: var(--accent); border-color: rgba(0,255,136,0.1); background: rgba(0,255,136,0.03); }
.playtime-stat .icon { color: var(--accent); opacity: 0.7; }

.hero-actions { display: flex; gap: 12px; align-items: center; }
.btn-play-hero {
    background: var(--accent); color: black; border: none;
    padding: 14px 35px; border-radius: 10px; font-size: 1rem; font-weight: 800;
    cursor: pointer; transition: all 0.3s ease; box-shadow: 0 5px 20px rgba(0,255,136,0.2);
}
.btn-play-hero:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(255,255,255,0.15); }

.btn-secondary-hero {
    background: rgba(255,255,255,0.08); color: #aaa; border: 1px solid rgba(255,255,255,0.08);
    width: 48px; height: 48px; border-radius: 10px; font-size: 1.2rem;
    cursor: pointer; transition: 0.2s; display: flex; align-items: center; justify-content: center;
}
.btn-secondary-hero:hover { background: rgba(255,255,255,0.1); color: white; border-color: rgba(255,255,255,0.2); }

/* ========================================= */
/* 6. RECENTLY PLAYED & LIBRARY HEADER       */
/* ========================================= */
.recently-played-section, .library-section { padding: 30px 40px; }

.section-title {
    font-family: var(--font-heading); font-size: 1.3rem; font-weight: 800;
    margin-bottom: 20px; color: white; display: flex; align-items: center; gap: 10px;
}
.section-title::before { content: ''; display: block; width: 3px; height: 16px; background: var(--accent); border-radius: 3px; }

.library-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; gap: 20px; flex-wrap: wrap;}
.header-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap;}

.add-game-btn { background: #1a1a1a; color: #ccc; border: 1px solid #333; padding: 9px 18px; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer; transition: 0.2s; }
.add-game-btn:hover { background: #222; color: white; border-color: #444; }

.icon-btn {
    background: #1a1a1a; color: #666; border: 1px solid #333;
    width: 36px; height: 36px; border-radius: 8px; cursor: pointer;
    transition: 0.2s; display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
}
.icon-btn:hover { border-color: #444; color: var(--accent); background: #222;}

.search-container input {
    background: #111; border: 1px solid #222; color: white;
    padding: 9px 15px; border-radius: 8px; width: 220px; font-size: 0.85rem; transition: 0.3s;
}
.search-container input:focus {
    border-color: #333; 
    background: #151515; 
    width: 260px; 
}
/* Platform Dropdown */
.custom-dropdown { position: relative; display: inline-block; cursor: pointer; font-size: 0.85rem;}
.dropdown-trigger { background: #1a1a1a; border: 1px solid #333; color: #ccc; padding: 9px 15px; border-radius: 8px; min-width: 140px; display: flex; justify-content: space-between; align-items: center; transition: border-color 0.12s, color 0.12s; }

/* All Accounts pill — override dropdown-trigger min-width */
.ag-account-trigger.dropdown-trigger {
    min-width: unset !important;
    width: auto !important;
    padding: 5px 12px !important;
    border-radius: 20px !important;
    background: rgba(255,255,255,0.05) !important;
    border: 1.5px solid rgba(255,255,255,0.1) !important;
    color: #aaa !important;
    font-size: 0.75rem !important;
    gap: 5px !important;
    cursor: pointer;
}
.dropdown-trigger:hover { border-color: #444; color: white; }
.dropdown-menu { display: none; position: absolute; top: 110%; right: 0; background: #1a1a1a; border: 1px solid #333; border-radius: 8px; width: 100%; z-index: 100; box-shadow: 0 10px 25px rgba(0,0,0,0.5); overflow: hidden; }
.dropdown-menu.active { display: block; animation: fadeUp 0.15s ease; }
.dropdown-item { padding: 10px 15px; transition: background-color 0.1s, color 0.1s; color: #999; }
.dropdown-item:hover { background: rgba(255,255,255,0.03); color: white; }

/* ========================================= */
/* 7. GAMES GRID & CARDS (APPLE TV STYLE)    */
/* ========================================= */
.games-grid, .recent-grid {
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(180px, 220px)); 
    gap: 24px;
    justify-content: start;
}

.game-card {
    position: relative; border-radius: 12px; overflow: hidden;
    aspect-ratio: 2 / 3; cursor: pointer; border: 1px solid rgba(255,255,255,0.05);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
    background: #111;
    will-change: transform; 
    contain: layout style; 
}

.game-card:hover {
    transform: translateY(-8px) scale(1.03);
    box-shadow: 0 20px 40px rgba(0,0,0,0.8); 
    z-index: 10;
    border-color: rgba(255,255,255,0.15);
}

.actual-img.fallback-hero {
    filter: brightness(0.4) saturate(0.8);
}

.gc-logo-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    max-height: 40%;
    object-fit: contain;
    z-index: 2;
    pointer-events: none;
    filter: drop-shadow(0 4px 10px rgba(0,0,0,0.8));
    animation: fadeUp 0.6s ease;
}

.game-card:hover .actual-img { transform: scale(1.05); filter: brightness(0.6); } 
.game-card:hover .actual-img.fallback-hero { filter: brightness(0.3) saturate(0.6); } 

.gc-grad-bottom {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 40%, transparent 100%);
    z-index: 1; transition: opacity 0.3s ease;
}

/* Gradient من فوق عشان الـ badges تبان أحسن */
.gc-grad-top {
    position: absolute; top: 0; left: 0; right: 0; height: 60px;
    background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, transparent 100%);
    z-index: 2; pointer-events: none;
}

.gc-platform {
    position: absolute; top: 12px; left: 12px;
    font-size: 9px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
    padding: 5px 10px; border-radius: 20px;
    background: rgba(0,0,0,0.6);
    color: white; z-index: 2; border: 1px solid rgba(255,255,255,0.1);
}

/* ========================================= */
/* 🏷️ PLATFORM BADGES ON GAME CARDS          */
/* ========================================= */
.gc-platforms {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    z-index: 3;
    align-items: flex-end;
    /* Hidden by default — fade + slide in on card hover */
    opacity: 0;
    transform: translateY(-5px);
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
}

.game-card:hover .gc-platforms {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
}

.plat-badge {
    --plat-c: #ffffff;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.80);
    border: 1px solid color-mix(in srgb, var(--plat-c) 30%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    /* backdrop-filter removed: was causing paint/composite during scroll */
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.5);
    /* subtle glow من لون المنصة */
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--plat-c) 0%, transparent),
                0 2px 8px rgba(0,0,0,0.5);
}

.game-card:hover .plat-badge {
    border-color: color-mix(in srgb, var(--plat-c) 60%, transparent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--plat-c) 25%, transparent),
                0 2px 8px rgba(0,0,0,0.5);
    transform: scale(1.08);
}

.plat-badge-img {
    width: 14px;
    height: 14px;
    object-fit: contain;
    display: block;
    filter: brightness(0.85);
    transition: filter 0.2s ease;
}

.game-card:hover .plat-badge-img {
    filter: brightness(1);
}

.plat-badge-invert {
    filter: brightness(0) invert(1) !important;
    opacity: 0.75;
}

.game-card:hover .plat-badge-invert {
    opacity: 1;
}

.plat-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: block;
    opacity: 0.8;
}

/* +N overflow badge */
.plat-badge-more {
    font-size: 0.6rem;
    font-weight: 800;
    color: rgba(255,255,255,0.6);
    letter-spacing: 0.5px;
    font-family: var(--font-heading, sans-serif);
    border-color: rgba(255,255,255,0.12);
}

.game-card:hover .plat-badge-more {
    color: rgba(255,255,255,0.9);
    border-color: rgba(255,255,255,0.3);
    box-shadow: none;
}

/* In All Games view, platform badges are slightly smaller to match the compact cards. */
#allGamesGrid .plat-badge {
    width: 22px;
    height: 22px;
    border-radius: 6px;
}

#allGamesGrid .plat-badge-img {
    width: 12px;
    height: 12px;
}

.gc-info {
    position: absolute; bottom: 0; left: 0; width: 100%;
    padding: 18px; display: flex; flex-direction: column; gap: 4px;
    z-index: 2; transition: opacity 0.3s ease, transform 0.3s ease;
}
.game-card:hover .gc-info { opacity: 0; transform: translateY(10px); }

.gc-name {
    font-size: 1.05rem; font-weight: 600; color: #fff;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    text-shadow: 0 2px 10px rgba(0,0,0,0.8);
}
.gc-time {
    display: flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 500; color: var(--text-sec);
}
.gc-time.played { color: #fff; opacity: 0.8; } 

.play-btn-center {
    position: absolute; 
    top: 50%; 
    left: 50%; 
    transform: translate(-50%, -40%); 
    
    background: rgba(255, 255, 255, 0.25); 
    color: white; 
    border: 1px solid rgba(255, 255, 255, 0.3);
    
    padding: 12px 30px; 
    border-radius: 30px; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    gap: 8px; 
    
    opacity: 0; 
    z-index: 3; 
    cursor: pointer; 
    font-weight: 600; 
    font-size: 0.9rem; 
    letter-spacing: 1px;
    
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.game-card:hover .play-btn-center { 
    opacity: 1; 
    transform: translate(-50%, -50%); 
}

.play-btn-center:hover { 
    background: rgba(255, 255, 255, 0.9); 
    color: black; 
    transform: translate(-50%, -50%) scale(1.05); 
}

.play-btn-center svg { width: 16px; height: 16px; fill: currentColor; }

#gamesGrid.density-compact .play-btn-center {
    padding: 6px 10px;
    font-size: 0.62rem;
    letter-spacing: 0.5px;
    border-radius: 20px;
    gap: 4px;
}
#gamesGrid.density-compact .play-btn-center svg {
    width: 10px;
    height: 10px;
}
#gamesGrid.density-large .play-btn-center {
    padding: 14px 36px;
    font-size: 1rem;
    gap: 10px;
}
#gamesGrid.density-large .play-btn-center svg {
    width: 18px;
    height: 18px;
}

/* ========================================= */
/* 8. MODALS & OVERLAYS                      */
/* ========================================= */
.modal-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.7); backdrop-filter: blur(5px);
    z-index: 9999; display: flex; justify-content: center; align-items: center;
    opacity: 0; pointer-events: none; 
    visibility: hidden; 
    transition: opacity 0.3s ease, visibility 0.3s;
}
.modal-overlay.active { 
    opacity: 1; pointer-events: auto; 
    visibility: visible;
}

.modal-box {
    background: #111; width: 420px; border-radius: 12px;
    border: 1px solid #222; padding: 25px;
    transform: translateY(15px); transition: 0.3s ease;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
}
.modal-overlay.active .modal-box { transform: translateY(0); }

.modal-title { font-family: var(--font-heading); font-size: 1.3rem; margin-bottom: 20px; color: white; display: flex; align-items: center; gap: 10px; }

.modal-input {
    width: 100%; background: #050505; border: 1px solid #222; color: white;
    padding: 12px 15px; border-radius: 8px; margin-bottom: 15px;
    font-family: var(--font-main); font-size: 0.9rem; transition: 0.2s;
}
.modal-input:focus { border-color: #444; background: #080808;}

.modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; }

/* Buttons */
.btn-cancel { background: transparent; border: 1px solid #333; color: #888; padding: 9px 18px; border-radius: 8px; cursor: pointer; transition: 0.2s; font-weight: 600; font-size: 0.85rem;}
.btn-cancel:hover { background: #1a1a1a; color: white; border-color: #444; }

.btn-primary { background: var(--accent); border: none; color: black; padding: 9px 18px; border-radius: 8px; font-weight: 700; cursor: pointer; transition: 0.2s; font-size: 0.85rem; }
.btn-primary:hover { background: white; }

.btn-danger { background: rgba(255, 68, 68, 0.1); border: 1px solid rgba(255, 68, 68, 0.2); color: #ff6b6b; padding: 9px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: 0.2s; font-size: 0.85rem; }
.btn-danger:hover { background: #ff4444; color: white; border-color: #ff4444; }

/* Settings overlay — lighter dim so background shows through glass */
.settings-overlay {
    background: rgba(0,0,0,0.80) !important;
    backdrop-filter: blur(16px) !important;
}

.settings-overlay .modal-content {
    background: #111 !important;
    border: 1px solid #222 !important;
    border-radius: 16px !important;
    padding: 28px !important;
    box-shadow: 0 30px 80px rgba(0,0,0,0.9) !important;
}

/* Settings Modal Specific — glassmorphism */
.settings-modal {
    width: 550px;
    background: rgba(12, 12, 14, 0.95) !important;
    backdrop-filter: blur(28px) saturate(160%) !important;
    -webkit-backdrop-filter: blur(28px) saturate(160%) !important;
    border: 1px solid rgba(255,255,255,0.07) !important;
    box-shadow: 0 24px 64px rgba(0,0,0,0.7), inset 0 1px 0 rgba(255,255,255,0.05) !important;
}
.settings-group { margin-bottom: 15px; }
.settings-group label { display: block; color: #666; font-size: 0.8rem; margin-bottom: 6px; font-weight: 600;}

.settings-images { display: flex; gap: 15px; margin-top: 20px; }
.image-edit-block { flex: 1; display: flex; flex-direction: column; gap: 8px; }

.image-click-zone {
    width: 100%; height: 160px; background: #0a0a0a; border-radius: 8px;
    border: 1px solid #222; cursor: pointer; position: relative;
    overflow: hidden; transition: 0.2s;
}
.image-click-zone:hover { border-color: var(--accent); background: #0d0d0d; }

.image-click-zone:hover .setting-img-preview { filter: brightness(0.8); transform: scale(1.03); }

.setting-img-preview { 
    width: 100%; height: 100%; object-fit: cover; transition: 0.3s; 
}

.change-hint-overlay {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.75); display: flex; flex-direction: column;
    justify-content: center; align-items: center; opacity: 0; transition: 0.3s;
    color: white; font-size: 0.85rem; font-weight: 600;
}
.image-click-zone:hover .change-hint-overlay { opacity: 1; }
.image-click-zone:hover .setting-img-preview { transform: scale(1.05); filter: blur(2px); }

.btn-reset-image {
    background: rgba(255,255,255,0.03); border: 1px solid #222;
    color: #888; padding: 8px; border-radius: 6px; cursor: pointer;
    font-size: 0.75rem; font-weight: 600; transition: 0.2s;
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 6px;
}
.btn-reset-image:hover { background: rgba(255, 68, 68, 0.05); color: #ff6b6b; border-color: rgba(255, 68, 68, 0.2); }

/* 🟢 New Reset Button Style */
.btn-reset-image {
    background: rgba(255,255,255,0.03); border: 1px solid #222;
    color: #666; padding: 6px; border-radius: 6px; cursor: pointer;
    font-size: 0.75rem; font-weight: 600; transition: 0.2s;
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 4px;
}
.btn-reset-image:hover { background: rgba(255, 68, 68, 0.05); color: #ff6b6b; border-color: rgba(255, 68, 68, 0.2); }

/* Picker Modal Specific */
.picker-modal { width: 650px; height: 75vh; display: flex; flex-direction: column; }
.picker-header { display: flex; align-items: center; gap: 15px; margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #222;}
.back-btn { padding: 6px 12px; font-size: 0.8rem; flex-shrink: 0;}
.path-text { color: var(--accent); font-size: 0.8rem; font-family: var(--font-code); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-grow: 1;}

.dir-list { flex-grow: 1; overflow-y: auto; background: #0a0a0a; border: 1px solid #222; border-radius: 8px; padding: 8px; }
.dir-item { padding: 9px 12px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; gap: 10px; transition: 0.1s; color: #ccc; font-size: 0.85rem;}
.dir-item:hover { background: rgba(255,255,255,0.03); color: white; }
.item-icon { width: 18px; text-align: center; color: #555;}
.dir-item:hover .item-icon { color: var(--accent); }
.item-icon img { width: 16px; height: 16px; object-fit: contain; }

/* Confirm Modal Specific */
.confirm-box { width: 350px; text-align: center; }
.confirm-msg { color: #888; font-size: 0.9rem; margin-bottom: 25px; line-height: 1.5; }
.centere-actions { justify-content: center; }
.danger-text { color: var(--danger); justify-content: center;}

/* ========================================= */
/* 🗑️ RECYCLE BIN MODAL & CUSTOM CHECKBOX    */
/* ========================================= */
.bin-modal { width: 600px; }

.bin-list { 
    max-height: 380px; 
    overflow-y: auto; 
    margin-bottom: 20px; 
    padding-right: 10px; 
    display: flex;
    flex-direction: column;
    gap: 8px; 
}

.bin-item {
    display: flex;
    align-items: center;
    padding: 10px 15px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    transition: 0.2s;
}
.bin-item:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
}

/* ── إلغاء الشكل الافتراضي للـ checkbox نهائياً ── */
input[type="checkbox"].custom-checkbox-input,
.custom-checkbox input[type="checkbox"] {
    -webkit-appearance: none !important;
    -moz-appearance: none !important;
    appearance: none !important;
    margin: 0; padding: 0;
}

.custom-checkbox {
    position: relative;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    margin-right: 15px;
    width: 20px;
    height: 20px;
}
.custom-checkbox input {
    opacity: 0; width: 0; height: 0; position: absolute;
    pointer-events: none;
}
.checkmark {
    position: absolute; top: 0; left: 0;
    height: 20px; width: 20px;
    background-color: rgba(255,255,255,0.04);
    border: 1.5px solid rgba(255,255,255,0.2);
    border-radius: 6px;
    transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
}
.custom-checkbox:hover .checkmark {
    border-color: var(--accent);
    background-color: rgba(255,255,255,0.07);
}
.custom-checkbox input:checked ~ .checkmark {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
}
.checkmark:after {
    content: "";
    position: absolute; display: none;
    left: 6px; top: 2.5px;
    width: 5px; height: 9px;
    border: solid #000;
    border-width: 0 2px 2px 0;
    border-radius: 1px;
    transform: rotate(45deg);
}
/* ========================================= */
/* Confirm Modal Specific                    */
/* ========================================= */

#confirmModal {
    z-index: 100005 !important; 
}

.custom-checkbox input:checked ~ .checkmark:after { display: block; }

/* ========================================= */
/* ALL GAMES - Installed Only Toggle Button  */
/* ========================================= */
.ag-installed-toggle {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #aaa;
    background: rgba(255,255,255,0.05);
    border: 1.5px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    cursor: pointer;
    /* Only animate paint properties — no layout, no box-shadow composite */
    transition: color 0.12s, background-color 0.12s, border-color 0.12s;
    white-space: nowrap;
    /* Own layer so hover repaints don't touch surrounding content */
    will-change: background-color;
}
.ag-installed-toggle:hover {
    color: #fff;
    background: rgba(255,255,255,0.09);
    border-color: rgba(255,255,255,0.25);
}
.ag-installed-toggle.active {
    color: #000;
    background: var(--accent);
    border-color: var(--accent);
    /* Removed box-shadow — triggers stacking-context repaint on every state change */
}
.ag-installed-toggle.active svg { stroke: #000; }

