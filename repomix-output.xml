<style>
  :root{
    /* Brand */
    --brand-black: #1a1a1a;
    --brand-green: #12ce18;
    --brand-green-ink: #061a07;
    --brand-green-soft: rgba(18,206,24,.14);
    --brand-green-line: rgba(18,206,24,.28);

    /* Surfaces */
    --bg: #0e0e0e;
    --bg-1: #141414;
    --bg-2: #1a1a1a;
    --bg-3: #1f1f1f;
    --line: rgba(255,255,255,0.06);
    --line-2: rgba(255,255,255,0.10);

    /* Text */
    --text: #f1f1f1;
    --text-2: #a5a5a5;
    --text-3: #6c6c6c;

    /* Type */
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --sans: 'Inter', system-ui, sans-serif;
    --display: 'Outfit', 'Inter', sans-serif;
  }
  *{box-sizing:border-box; margin:0; padding:0}
  html,body{background:var(--bg); color:var(--text); font-family:var(--sans); -webkit-font-smoothing:antialiased}
  body{overflow:hidden; height:100vh}
  button{font:inherit; color:inherit; background:transparent; border:0; cursor:pointer}
  img{display:block}
  ::-webkit-scrollbar{width:8px; height:8px}
  ::-webkit-scrollbar-thumb{background:rgba(255,255,255,.08); border-radius:8px}
  ::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.16)}
  :focus-visible{outline:2px solid var(--brand-green); outline-offset:2px; border-radius:6px}

  /* -------- Title bar -------- */
  .title-bar{
    position:fixed; top:0; left:0; right:0; height:34px; z-index:100;
    background:#0a0a0a;
    display:flex; align-items:center; padding:0 14px;
    border-bottom:1px solid var(--line);
  }
  .tb-left{display:flex; gap:16px; color:var(--text-3); font-size:12px}
  .tb-left span{display:flex; align-items:center; gap:6px}
  .tb-drag{flex:1}
  .tb-right{display:flex; gap:2px}
  .tb-right button{width:40px; height:34px; color:#7a7a7a}
  .tb-right button:hover{background:rgba(255,255,255,.06); color:#fff}
  .tb-right .close:hover{background:#c0392b; color:#fff}

  /* -------- Layout -------- */
  .shell{display:flex; height:100vh; padding-top:34px}

  /* Sidebar */
  .sidebar{
    width:240px; flex-shrink:0; background:#0a0a0a; border-right:1px solid var(--line);
    display:flex; flex-direction:column; padding:22px 14px 16px;
  }
  .brand{display:flex; align-items:center; padding:2px 6px 0; margin-bottom:28px; margin-top:2px}
  .brand img{height:26px; width:auto; object-fit:contain}
  .side-label{font-family:var(--mono); font-size:10px; letter-spacing:2px; color:var(--text-3); font-weight:500; padding:0 12px; margin:22px 0 8px; text-transform:uppercase}
  .nav{display:flex; flex-direction:column; gap:2px}
  .nav-item{
    height:38px; padding:0 12px; border-radius:8px;
    display:flex; align-items:center; gap:12px; font-size:13px; color:var(--text-2);
    transition:background .15s, color .15s;
    position:relative;
  }
  .nav-item:hover{background:rgba(255,255,255,.04); color:var(--text)}
  .nav-item.active{
    background:var(--brand-green-soft);
    color:var(--text);
  }
  .nav-item.active::before{
    content:''; position:absolute; left:-14px; top:10px; bottom:10px; width:3px;
    background:var(--brand-green); border-radius:0 2px 2px 0;
    box-shadow:0 0 10px rgba(18,206,24,.4);
  }
  .nav-item.active .nav-ico{color:var(--brand-green)}
  .nav-ico{width:16px; height:16px; display:grid; place-items:center; color:currentColor; opacity:.9}
  .nav-count{margin-left:auto; font-family:var(--mono); font-size:10px; color:var(--text-3)}
  .nav-item.active .nav-count{color:var(--brand-green)}
  .side-foot{
    margin-top:auto; padding:12px 10px 4px; border-top:1px solid var(--line);
    display:flex; gap:10px; align-items:center
  }
  .side-foot .dot{width:6px; height:6px; border-radius:50%; background:var(--brand-green); box-shadow:0 0 8px rgba(18,206,24,.6)}
  .side-foot .txt{font-size:11px; color:var(--text-3)}

  /* Content scroll area */
  .main{flex:1; overflow-y:auto; scroll-behavior:smooth; background:var(--bg)}

  /* ---------- HERO ---------- */
  .hero{
    position:relative; height:560px; overflow:hidden;
    border-bottom:1px solid var(--line);
    background:var(--brand-black);
  }
  .hero-art{
    position:absolute; inset:0;
    background:
      radial-gradient(ellipse at 75% 40%, rgba(18,206,24,.18) 0%, transparent 55%),
      radial-gradient(ellipse at 25% 75%, rgba(18,206,24,.08) 0%, transparent 55%),
      linear-gradient(135deg, #1a1a1a 0%, #0f0f0f 60%, #0a0a0a 100%);
  }
  .hero-art::before{
    content:''; position:absolute; inset:0;
    background-image:
      repeating-linear-gradient(115deg, rgba(255,255,255,.025) 0 2px, transparent 2px 9px),
      repeating-linear-gradient(25deg, rgba(0,0,0,.25) 0 1px, transparent 1px 6px);
    mix-blend-mode:overlay;
  }
  .hero-art::after{
    content:'// HERO ART · 2560×1080 · CINEMATIC KEY'; position:absolute; top:20px; right:24px;
    font-family:var(--mono); font-size:10px; letter-spacing:1.5px; color:rgba(255,255,255,.22);
  }
  .hero-vignette{
    position:absolute; inset:0;
    background:
      linear-gradient(to top, var(--bg) 0%, rgba(14,14,14,.5) 35%, rgba(14,14,14,0) 70%),
      linear-gradient(to right, rgba(14,14,14,.85) 0%, rgba(14,14,14,.2) 45%, transparent 70%);
  }
  .hero-meta{
    position:absolute; top:28px; left:48px; display:flex; gap:10px;
    font-family:var(--mono); font-size:10px; letter-spacing:1.5px; color:var(--text-3); text-transform:uppercase;
    align-items:center;
  }
  .hero-meta .pip{width:6px; height:6px; background:var(--brand-green); border-radius:50%; box-shadow:0 0 10px rgba(18,206,24,.6)}
  .hero-body{
    position:absolute; left:48px; right:48px; bottom:54px; max-width:700px;
    display:flex; flex-direction:column; gap:18px;
  }
  .hero-kicker{
    font-family:var(--mono); font-size:11px; letter-spacing:3px; text-transform:uppercase;
    color:var(--brand-green);
  }
  .hero-title{
    font-family:var(--display); font-weight:900; font-size:92px; line-height:.88;
    letter-spacing:-2px; text-shadow:0 8px 40px rgba(0,0,0,.6);
    color:#fff;
  }
  .hero-sub{color:var(--text-2); font-size:15px; max-width:520px; line-height:1.55}
  .hero-stats{display:flex; gap:22px; margin-top:4px}
  .hero-stat{display:flex; flex-direction:column; gap:3px}
  .hero-stat .k{font-family:var(--mono); font-size:10px; color:var(--text-3); letter-spacing:1.5px; text-transform:uppercase}
  .hero-stat .v{font-family:var(--display); font-size:22px; font-weight:700; color:var(--text); font-variant-numeric:tabular-nums}
  .hero-actions{display:flex; gap:12px; margin-top:14px; align-items:center}
  .btn-play{
    display:inline-flex; align-items:center; gap:12px;
    background:var(--brand-green); color:var(--brand-green-ink);
    padding:16px 32px; border-radius:10px; font-weight:800; font-size:14px; letter-spacing:1.5px; text-transform:uppercase;
    box-shadow:0 10px 36px rgba(18,206,24,.25), inset 0 1px 0 rgba(255,255,255,.25);
    transition:transform .2s, box-shadow .2s, background .2s;
  }
  .btn-play:hover{transform:translateY(-2px); background:#19e020; box-shadow:0 16px 44px rgba(18,206,24,.35)}
  .btn-play .arrow{width:0; height:0; border-left:9px solid var(--brand-green-ink); border-top:6px solid transparent; border-bottom:6px solid transparent}
  .btn-ghost{
    display:inline-flex; align-items:center; gap:8px;
    padding:16px 22px; border-radius:10px; font-weight:600; font-size:13px;
    border:1px solid var(--line-2); color:var(--text); background:rgba(255,255,255,.03);
    transition:background .2s, border-color .2s;
  }
  .btn-ghost:hover{background:rgba(255,255,255,.06); border-color:rgba(255,255,255,.2)}
  .btn-icon{
    width:52px; height:52px; border-radius:10px;
    border:1px solid var(--line-2); background:rgba(255,255,255,.03);
    display:grid; place-items:center; color:var(--text-2);
    transition:all .2s;
  }
  .btn-icon:hover{background:rgba(255,255,255,.06); color:#fff}
  .hero-side{
    position:absolute; right:48px; bottom:54px; display:flex; flex-direction:column; gap:8px; align-items:flex-end;
  }
  .hero-side .chip{
    font-family:var(--mono); font-size:10px; letter-spacing:1.5px; text-transform:uppercase; color:var(--text-3);
    padding:6px 10px; border:1px solid var(--line); border-radius:4px; background:rgba(0,0,0,.35); backdrop-filter:blur(8px);
  }
  .hero-side .chip.active{color:var(--brand-green); border-color:var(--brand-green-line); background:rgba(18,206,24,.06)}

  /* ---------- Section scaffolding ---------- */
  .section{padding:56px 48px 0}
  .s-head{display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:28px; gap:24px}
  .s-titles{display:flex; flex-direction:column; gap:6px}
  .s-eyebrow{font-family:var(--mono); font-size:10px; letter-spacing:2.5px; text-transform:uppercase; color:var(--text-3)}
  .s-eyebrow .num{color:var(--brand-green); margin-right:10px; font-weight:500}
  .s-title{font-family:var(--display); font-weight:700; font-size:32px; letter-spacing:-.5px; line-height:1}
  .s-title em{font-style:normal; color:var(--text-3); font-weight:500}
  .s-sub{font-size:13px; color:var(--text-2); margin-top:6px; max-width:560px; line-height:1.5}
  .s-actions{display:flex; gap:8px; align-items:center}
  .pill{
    padding:8px 14px; border-radius:999px; font-size:12px; font-weight:500; color:var(--text-2);
    border:1px solid var(--line); background:rgba(255,255,255,.02);
    transition:all .15s;
  }
  .pill:hover{border-color:var(--line-2); color:var(--text)}
  .pill.active{
    color:var(--brand-green); border-color:var(--brand-green-line); background:var(--brand-green-soft)
  }
  .nav-arrows{display:flex; gap:6px}
  .nav-arrow{width:36px; height:36px; border-radius:8px; border:1px solid var(--line); color:var(--text-2); display:grid; place-items:center; transition:all .15s}
  .nav-arrow:hover{border-color:var(--line-2); color:var(--text); background:rgba(255,255,255,.04)}

  /* ---------- 2. CONTINUE PLAYING ---------- */
  .continue-grid{display:grid; grid-template-columns: 1.4fr 1fr 1fr; gap:20px}
  .cont-card{
    position:relative; border-radius:14px; overflow:hidden; border:1px solid var(--line);
    aspect-ratio: 16 / 9; cursor:pointer; transition:transform .3s, border-color .3s;
    background:var(--brand-black);
  }
  .cont-card:hover{transform:translateY(-3px); border-color:rgba(255,255,255,.18)}
  .cont-card .cover{position:absolute; inset:0}
  .cont-card .cover::after{
    content:''; position:absolute; inset:0;
    background:linear-gradient(to top, rgba(0,0,0,.95) 0%, rgba(0,0,0,.5) 40%, rgba(0,0,0,.1) 70%, transparent 100%);
  }
  .cont-card .cover-label{
    position:absolute; top:14px; left:14px; font-family:var(--mono); font-size:9px;
    color:rgba(255,255,255,.28); letter-spacing:1.5px; z-index:1;
  }
  .cont-card .meta{
    position:absolute; left:20px; right:20px; bottom:18px; z-index:2;
    display:flex; flex-direction:column; gap:8px;
  }
  .cont-card .tag{font-family:var(--mono); font-size:10px; letter-spacing:1.5px; color:var(--brand-green); text-transform:uppercase}
  .cont-card .t{font-family:var(--display); font-weight:800; font-size:22px; letter-spacing:-.3px}
  .cont-card.feature .t{font-size:34px}
  .cont-card .sub{font-size:12px; color:var(--text-2); display:flex; gap:12px; align-items:center}
  .cont-card .sub .sep{width:3px; height:3px; border-radius:50%; background:var(--text-3)}
  .cont-card .progress{height:3px; background:rgba(255,255,255,.08); border-radius:2px; overflow:hidden; margin-top:4px}
  .cont-card .progress > i{display:block; height:100%; background:var(--brand-green); box-shadow:0 0 10px rgba(18,206,24,.5)}
  .cont-card .resume{
    position:absolute; right:18px; bottom:18px; z-index:3;
    width:48px; height:48px; border-radius:50%; background:rgba(255,255,255,.92); color:#000;
    display:grid; place-items:center; box-shadow:0 10px 30px rgba(0,0,0,.5);
    transition:transform .2s, background .2s;
  }
  .cont-card:hover .resume{transform:scale(1.08); background:var(--brand-green); color:var(--brand-green-ink)}
  .cont-card.feature .resume{width:58px; height:58px}
  .cont-card .resume::after{
    content:''; width:0; height:0; border-left:14px solid currentColor; border-top:9px solid transparent; border-bottom:9px solid transparent; margin-left:4px;
  }

  /* Placeholder cover styles */
  .cover.c1{background:linear-gradient(135deg,#252525 0%, #383838 50%, #161616 100%)}
  .cover.c2{background:linear-gradient(135deg,#0d1a25 0%, #1a3450 50%, #060a10 100%)}
  .cover.c3{background:linear-gradient(135deg,#1a0f20 0%, #3a1e48 50%, #0a060f 100%)}
  .cover.c4{background:linear-gradient(135deg,#0f1f17 0%, #15382a 50%, #060c0a 100%)}
  .cover.c5{background:linear-gradient(135deg,#241408 0%, #4a250f 50%, #0a0604 100%)}
  .cover.c6{background:linear-gradient(135deg,#1a1814 0%, #333129 50%, #08070a 100%)}
  .cover.c7{background:linear-gradient(135deg,#25121c 0%, #4a1f35 50%, #0c060a 100%)}
  .cover.c8{background:linear-gradient(135deg,#0a1a1e 0%, #1c3a42 50%, #05090b 100%)}
  .cover::before{
    content:''; position:absolute; inset:0;
    background-image:repeating-linear-gradient(115deg, rgba(255,255,255,.025) 0 2px, transparent 2px 10px);
  }

  /* ---------- 3. SYNCED LIBRARIES ---------- */
  .synced-wrap{
    position:relative;
    border:1px solid var(--line);
    border-radius:20px; overflow:hidden;
    background:
      radial-gradient(ellipse at 92% 0%, rgba(18,206,24,.07) 0%, transparent 55%),
      radial-gradient(ellipse at 0% 100%, rgba(18,206,24,.03) 0%, transparent 55%),
      linear-gradient(180deg, #171717 0%, #101010 100%);
  }
  .synced-head{
    padding:28px 32px 0; display:flex; justify-content:space-between; align-items:flex-start; gap:20px;
  }
  .synced-head .left{display:flex; flex-direction:column; gap:8px}
  .synced-eye{font-family:var(--mono); font-size:10px; letter-spacing:2.5px; text-transform:uppercase; color:var(--brand-green); display:flex; align-items:center; gap:10px}
  .synced-eye .pulse{width:6px; height:6px; border-radius:50%; background:var(--brand-green); box-shadow:0 0 10px var(--brand-green); animation:pulse 2s infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .synced-title{font-family:var(--display); font-weight:800; font-size:36px; letter-spacing:-.5px; line-height:1.05}
  .synced-title em{font-style:normal; color:var(--text-3); font-weight:500}
  .synced-sub{color:var(--text-2); font-size:13px; max-width:560px; margin-top:4px; line-height:1.55}
  .synced-counts{display:flex; gap:22px; padding:10px 16px; border:1px solid var(--line); border-radius:10px; background:rgba(0,0,0,.3)}
  .sc{display:flex; flex-direction:column; gap:2px}
  .sc .k{font-family:var(--mono); font-size:9px; letter-spacing:1.5px; color:var(--text-3); text-transform:uppercase}
  .sc .v{font-family:var(--display); font-weight:700; font-size:18px; font-variant-numeric:tabular-nums}

  .synced-filters{
    padding:22px 32px 20px; display:flex; gap:8px; flex-wrap:wrap; align-items:center; border-bottom:1px solid var(--line);
  }
  .synced-filters .sep{flex:1}
  .synced-filters .storage{font-family:var(--mono); font-size:11px; color:var(--text-3)}
  .synced-filters .storage b{color:var(--text); font-weight:500}

  .synced-body{display:grid; grid-template-columns: 1.1fr 1fr; gap:0}
  @media (max-width:1300px){.synced-body{grid-template-columns:1fr}}

  .synced-feature{
    padding:32px; border-right:1px solid var(--line); position:relative; min-height:420px;
    display:flex; flex-direction:column; justify-content:space-between; gap:24px;
  }
  .synced-feature .cover-block{
    position:relative; border-radius:12px; overflow:hidden; aspect-ratio:16/10; border:1px solid var(--line);
  }
  .synced-feature .cover-block .cover{position:absolute; inset:0}
  .synced-feature .cover-block::after{
    content:''; position:absolute; inset:0;
    background:linear-gradient(180deg, transparent 50%, rgba(0,0,0,.8) 100%);
  }
  .synced-feature .feat-title{font-family:var(--display); font-size:42px; font-weight:800; line-height:1; letter-spacing:-.8px; margin-bottom:6px}
  .synced-feature .feat-kicker{font-family:var(--mono); font-size:10px; letter-spacing:2px; color:var(--brand-green); text-transform:uppercase; margin-bottom:12px; display:flex; gap:10px; align-items:center}
  .synced-feature .feat-kicker .dot{width:5px; height:5px; border-radius:50%; background:var(--brand-green); box-shadow:0 0 6px var(--brand-green)}
  .synced-feature .feat-desc{color:var(--text-2); font-size:13px; line-height:1.55; max-width:460px}
  .feat-meta-row{display:flex; gap:28px; margin-top:18px; flex-wrap:wrap}
  .feat-meta{display:flex; flex-direction:column; gap:4px}
  .feat-meta .k{font-family:var(--mono); font-size:10px; color:var(--text-3); letter-spacing:1.5px; text-transform:uppercase}
  .feat-meta .v{font-family:var(--display); font-weight:700; font-size:17px; font-variant-numeric:tabular-nums; display:flex; align-items:center; gap:8px}
  .feat-meta .plat-mark{width:18px; height:18px; border-radius:4px; background:#1b1b1d; border:1px solid var(--line-2); font-family:var(--mono); font-size:9px; display:grid; place-items:center; font-weight:700}
  .feat-cta-row{display:flex; gap:10px; align-items:center; margin-top:8px}
  .btn-install{
    display:inline-flex; align-items:center; gap:10px; padding:14px 26px; border-radius:10px;
    background:var(--brand-green); color:var(--brand-green-ink); font-weight:800; font-size:13px; letter-spacing:1.5px; text-transform:uppercase;
    box-shadow:0 8px 28px rgba(18,206,24,.22), inset 0 1px 0 rgba(255,255,255,.25);
    transition:transform .2s, background .2s;
  }
  .btn-install:hover{transform:translateY(-2px); background:#19e020}
  .btn-install svg{width:14px; height:14px}
  .feat-cta-row .small{font-family:var(--mono); font-size:11px; color:var(--text-3)}
  .feat-cta-row .small b{color:var(--brand-green); font-weight:600}

  .synced-rail{padding:24px 32px; display:flex; flex-direction:column; gap:10px}
  .rail-row{
    display:grid; grid-template-columns: 72px 1fr auto auto; gap:18px; align-items:center;
    padding:12px; border-radius:12px;
    border:1px solid transparent;
    transition:background .18s, border-color .18s;
    cursor:pointer;
  }
  .rail-row:hover{background:rgba(255,255,255,.03); border-color:var(--line)}
  .rail-cover{position:relative; width:72px; aspect-ratio:3/4; border-radius:8px; overflow:hidden; border:1px solid var(--line)}
  .rail-cover .cover{position:absolute; inset:0}
  .rail-info{display:flex; flex-direction:column; gap:6px; min-width:0}
  .rail-top{display:flex; gap:10px; align-items:center}
  .rail-top .tag{font-family:var(--mono); font-size:9px; letter-spacing:1.5px; color:var(--text-3); text-transform:uppercase}
  .rail-top .tag.rec{color:var(--brand-green)}
  .rail-top .sep{width:3px; height:3px; border-radius:50%; background:var(--text-3)}
  .rail-title{font-family:var(--display); font-weight:700; font-size:16px; letter-spacing:-.2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
  .rail-meta{display:flex; gap:14px; font-size:11px; color:var(--text-2); font-family:var(--mono)}
  .rail-meta span{display:flex; align-items:center; gap:5px}
  .rail-plat{
    display:flex; align-items:center; gap:8px; padding:6px 10px; border-radius:8px; border:1px solid var(--line);
    font-family:var(--mono); font-size:10px; letter-spacing:1px; color:var(--text-2); text-transform:uppercase;
  }
  .rail-plat .pm{width:16px; height:16px; border-radius:3px; background:#1b1b1d; font-size:8px; display:grid; place-items:center; font-weight:800; color:var(--text)}
  .rail-cta{
    padding:9px 16px; border-radius:8px; font-size:11px; font-weight:700; letter-spacing:1px; text-transform:uppercase;
    border:1px solid var(--line-2); background:rgba(255,255,255,.04); color:var(--text);
    transition:all .15s;
  }
  .rail-cta:hover{background:rgba(255,255,255,.08); border-color:rgba(255,255,255,.25)}
  .rail-cta.primary{
    background:var(--brand-green); color:var(--brand-green-ink); border-color:var(--brand-green);
    box-shadow:0 4px 14px rgba(18,206,24,.2);
  }
  .rail-cta.primary:hover{background:#19e020; border-color:#19e020}

  .pm.steam{background:#0f1b24; color:#6ba7d6}
  .pm.epic{background:#141414; color:#dcdcdc}
  .pm.riot{background:#1a0f11; color:#d34047}
  .pm.ubi{background:#0c0e12; color:#b8c5d2}
  .pm.ea{background:#101010; color:#d6d6d6}
  .pm.rock{background:#1a1209; color:#e8b74a}

  .rail-view-all{
    align-self:flex-end; margin-top:6px; padding:10px 16px;
    font-family:var(--mono); font-size:11px; letter-spacing:1px; color:var(--brand-green);
    border:1px solid var(--brand-green-line); border-radius:8px; background:var(--brand-green-soft);
    transition:background .15s;
  }
  .rail-view-all:hover{background:rgba(18,206,24,.2)}

  /* ---------- 4. DISCOVERY ---------- */
  .discover-grid{display:grid; grid-template-columns: repeat(5, 1fr); gap:16px}
  .disc-card{
    position:relative; border-radius:12px; overflow:hidden; border:1px solid var(--line);
    aspect-ratio:2/3; cursor:pointer; transition:transform .3s, border-color .3s;
    background:var(--brand-black);
  }
  .disc-card:hover{transform:translateY(-4px); border-color:var(--line-2)}
  .disc-card .cover{position:absolute; inset:0}
  .disc-card .cover::after{
    content:''; position:absolute; inset:0;
    background:linear-gradient(to top, rgba(0,0,0,.95) 0%, rgba(0,0,0,.2) 45%, transparent 70%);
  }
  .disc-top{position:absolute; top:12px; left:12px; right:12px; display:flex; justify-content:space-between; z-index:2}
  .disc-reason{
    font-family:var(--mono); font-size:9px; letter-spacing:1.5px; color:var(--brand-green); text-transform:uppercase;
    padding:4px 8px; border-radius:4px; background:rgba(0,0,0,.55); backdrop-filter:blur(8px);
    border:1px solid var(--brand-green-line);
  }
  .disc-reason.mono{color:var(--text-2); border-color:var(--line-2)}
  .disc-body{position:absolute; bottom:0; left:0; right:0; padding:16px; z-index:2; display:flex; flex-direction:column; gap:4px}
  .disc-title{font-family:var(--display); font-weight:700; font-size:15px; letter-spacing:-.2px}
  .disc-meta{font-family:var(--mono); font-size:10px; color:var(--text-3); letter-spacing:1px; display:flex; gap:8px}

  /* ---------- 5. ACCOUNT HUB ---------- */
  .hub{display:grid; grid-template-columns: 1.1fr 2fr; gap:20px}
  .hub-card{
    border:1px solid var(--line); border-radius:14px; padding:24px;
    background:linear-gradient(180deg, #161616 0%, #111111 100%);
  }
  .hub-card h3{font-family:var(--display); font-size:15px; font-weight:700; letter-spacing:.5px; text-transform:uppercase; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center}
  .hub-card h3 .tool{font-family:var(--mono); font-size:10px; color:var(--text-3); letter-spacing:1.5px; text-transform:none; font-weight:500}
  .acct-list{display:flex; flex-direction:column; gap:10px}
  .acct-row{
    display:flex; align-items:center; gap:12px; padding:10px;
    border:1px solid var(--line); border-radius:10px; background:rgba(0,0,0,.25);
    transition:border-color .15s, background .15s;
  }
  .acct-row:hover{border-color:var(--line-2); background:rgba(255,255,255,.02)}
  .acct-ava{
    width:36px; height:36px; border-radius:9px; display:grid; place-items:center;
    font-family:var(--mono); font-weight:700; font-size:11px; letter-spacing:.5px;
  }
  .acct-ava.a1{background:linear-gradient(135deg,#2a1a30, #4a2a5a); color:#e4c9f2}
  .acct-ava.a2{background:linear-gradient(135deg,#1e2a1e, #2f4a2f); color:var(--brand-green)}
  .acct-ava.a3{background:linear-gradient(135deg,#0f1b24, #2a4058); color:#6ba7d6}
  .acct-info{flex:1; min-width:0; display:flex; flex-direction:column; gap:2px}
  .acct-name{font-weight:600; font-size:13px}
  .acct-plat{font-family:var(--mono); font-size:10px; color:var(--text-3); letter-spacing:1px; text-transform:uppercase}
  .acct-state{font-family:var(--mono); font-size:10px; color:var(--brand-green); letter-spacing:1px}
  .acct-state.warn{color:#f59e0b}
  .acct-swap{width:28px; height:28px; border-radius:6px; color:var(--text-3); display:grid; place-items:center; border:1px solid var(--line); transition:all .15s}
  .acct-swap:hover{color:var(--brand-green); border-color:var(--brand-green-line); background:var(--brand-green-soft)}

  .summary{display:grid; grid-template-columns: repeat(4, 1fr); gap:14px}
  .sum-tile{
    padding:18px; border:1px solid var(--line); border-radius:10px; background:rgba(0,0,0,.25);
    display:flex; flex-direction:column; gap:6px;
  }
  .sum-tile .k{font-family:var(--mono); font-size:10px; letter-spacing:1.5px; color:var(--text-3); text-transform:uppercase}
  .sum-tile .v{font-family:var(--display); font-weight:700; font-size:28px; letter-spacing:-.5px; font-variant-numeric:tabular-nums}
  .sum-tile .v em{font-style:normal; font-size:13px; color:var(--text-3); font-weight:500; margin-left:4px}
  .sum-tile .delta{font-family:var(--mono); font-size:10px; color:var(--text-2); display:flex; gap:6px}
  .sum-tile .delta .up{color:var(--brand-green)}
  .sum-tile .delta .down{color:var(--text-3)}

  .act-rows{display:flex; flex-direction:column; gap:6px; margin-top:14px}
  .act{
    display:grid; grid-template-columns: auto 1fr auto; gap:14px; align-items:center;
    padding:9px 12px; border-radius:8px; font-size:12px;
  }
  .act:hover{background:rgba(255,255,255,.03)}
  .act .when{font-family:var(--mono); font-size:10px; color:var(--text-3); letter-spacing:1px; width:64px}
  .act .what{color:var(--text-2)}
  .act .what b{color:var(--text); font-weight:600}
  .act .plat{font-family:var(--mono); font-size:10px; color:var(--text-3); letter-spacing:1px; text-transform:uppercase}

  /* ---------- 6. STATUS STRIP ---------- */
  .status-strip{
    display:flex; gap:32px; padding:18px 48px; border-top:1px solid var(--line); margin-top:40px;
    font-family:var(--mono); font-size:11px; color:var(--text-3); letter-spacing:1px; text-transform:uppercase;
    align-items:center;
  }
  .status-strip .item{display:flex; align-items:center; gap:8px}
  .status-strip .item b{color:var(--text); font-weight:500}
  .status-strip .ok{width:6px; height:6px; border-radius:50%; background:var(--brand-green); box-shadow:0 0 8px rgba(18,206,24,.6)}
  .status-strip .spacer{flex:1}
  .status-strip .baddel-mark{height:14px; width:auto; opacity:.8}

  .ic{width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2; stroke-linecap:round; stroke-linejoin:round}

  .main::after{content:''; display:block; height:12px}

  .section{opacity:0; transform:translateY(16px); animation:rise .7s cubic-bezier(.2,.8,.2,1) forwards}
  .section.s2{animation-delay:.05s}
  .section.s3{animation-delay:.1s}
  .section.s4{animation-delay:.15s}
  .section.s5{animation-delay:.2s}
  @keyframes rise{to{opacity:1; transform:translateY(0)}}
</style>
</head>
