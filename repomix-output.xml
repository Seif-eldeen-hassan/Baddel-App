    transition: 0.2s ease;
}

.playtime-trigger:hover { 
    color: white; 
    border-color: #555; 
    background-color: #1a1a1a; 
}

.playtime-menu {
    bottom: 110%; 
    top: auto;
    min-width: 150px;
    background: #151515;
    transform-origin: bottom center;
}

.playtime-menu .dropdown-item {
