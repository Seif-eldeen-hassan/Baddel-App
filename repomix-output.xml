        errorCount: 0,
        dedupCount: 0,
    };
    if (status === 'already_exists') counts.alreadyExistsCount = 1;
    if (status === 'created_and_queued') counts.queuedCount = 1;
    if (status === 'error') counts.errorCount = 1;
    return {
        ...counts,
        results: [{ id, status }],
