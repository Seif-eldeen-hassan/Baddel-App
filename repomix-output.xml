if (typeof module !== 'undefined' && module.exports) {
    module.exports = ArtworkOwnershipPolicy;
}

if (_artworkPolicyRoot) {
    _artworkPolicyRoot.BaddelArtworkOwnershipPolicy = ArtworkOwnershipPolicy;
}
}());
