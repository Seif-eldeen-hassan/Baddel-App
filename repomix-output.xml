    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    margin-bottom: 2px;
    margin-top: 6px;
    position: relative;
    transition: all 0.15s ease;
    color: var(--text-sec);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 1px;
}

.sidebar-section-btn:hover {
