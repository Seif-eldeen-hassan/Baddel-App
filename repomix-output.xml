    GameScannerCore,

    // Utility functions re-exported so gameScanner.js can use them without
    // duplicating definitions, and the __scannerTest surface stays intact.
    parseShortcutArgs,
    _cacheBaseName,
    _mapPlatformHint,
    SCANNER_PLATFORMS,
    PLATFORM_LABEL_TO_KEY,
    _cleanPathInput,
    normalizePath,
    pathExists,
    fileExists,
    dirExists,
    isLauncherOrHelperExe,
    dirHasUsefulFiles,
    findFirstExisting,
    findLikelyGameExe,
    safeJsonParse,
    normalizeDisplayName,
    normalizeScannerPlatform,
    makeInstalledGameKey,
    isGameInstallValid,
    withTimeout,
    _hashShort,

    // Scan prep standalone helpers (Phase 21.3)
    scannerPlatformForGame,
