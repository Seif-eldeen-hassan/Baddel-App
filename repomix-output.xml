    padding: 6px 8px;
    border-radius: 8px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.04);
    transition: background 0.15s;
}

.epic-lib-row:hover {
    background: rgba(255,255,255,0.05);
}

.epic-lib-thumb {
    width: 36px;
    height: 48px;
    border-radius: 4px;
    object-fit: cover;
    flex-shrink: 0;
}

.epic-lib-thumb-placeholder {
    background: rgba(255,255,255,0.06);
}

.epic-lib-title {
    flex: 1;
    color: #ccc;
    font-size: 0.84rem;
    white-space: nowrap;
    overflow: hidden;
