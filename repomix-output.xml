}

.main-header__container {
    display: flex;
    align-items: center;
}

.main-footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 76px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 21px 30px;
