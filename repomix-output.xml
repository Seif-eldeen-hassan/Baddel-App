    return names.map(name => {
        let platformAccountId = null;
        try {
            const raw = fsSync.readFileSync(path.join(savedDir, name, 'sync_link.json'), 'utf8');
            platformAccountId = JSON.parse(raw).platformAccountId || null;
        } catch { /* no sync_link yet */ }
