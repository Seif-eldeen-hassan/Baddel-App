    flex: 1;
}

/* ── CTA button — dark pill, subtle green border ─────────────────── */
.ag-pc-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(0, 210, 100, 0.90);
    background: rgba(0, 210, 100, 0.07);
    border: 1px solid rgba(0, 210, 100, 0.28);
    border-radius: 20px;
    cursor: pointer;
    transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease;
    font-family: var(--font-main);
    white-space: nowrap;
    margin-top: 4px;
}

.ag-pc-btn:hover {
    background: rgba(0, 210, 100, 0.13);
    border-color: rgba(0, 210, 100, 0.5);
    color: rgb(0, 220, 108);
}

.ag-pc-btn svg {
    flex-shrink: 0;
}

/* ── Secondary "Manage Accounts" link ────────────────────────────── */
.ag-empty-manage {
    margin-top: 28px;
    font-size: 0.78rem;
    color: #444;
    display: flex;
    align-items: center;
    gap: 6px;
    position: relative;
}

.ag-empty-manage button {
    background: none;
    border: none;
