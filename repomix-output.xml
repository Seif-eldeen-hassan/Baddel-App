   CREATOR LOGO CONTROLS (inline segmented control)
   ============================================================ */
.gd-creator-logo-ctrl {
    display: none;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
}
#gameDetailsView.gd-creator-active:not(.gd-creator-preview) .gd-creator-logo-ctrl {
    display: flex;
}
.gd-lc-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.16);
    background: rgba(255,255,255,0.07);
    color: rgba(255,255,255,0.82);
    font: 700 0.72rem var(--font-main);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
}
.gd-lc-btn:hover { background: rgba(255,255,255,0.13); border-color: rgba(255,255,255,0.3); color: #fff; }
.gd-lc-btn-danger { color: #ffb4ad; border-color: rgba(255,69,58,0.28); background: rgba(255,69,58,0.06); }
.gd-lc-btn-danger:hover { background: rgba(255,69,58,0.14); border-color: rgba(255,69,58,0.5); color: #ffb4ad; }

/* ============================================================
   CREATOR MEDIA PICKER MODAL (File | Link tabs)
   ============================================================ */
.gd-media-picker-box { gap: 14px; }
.gd-media-picker-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.gd-media-picker-close {
    width: 28px; height: 28px;
    display: grid; place-items: center;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.12);
    background: transparent;
    color: rgba(255,255,255,0.6);
    cursor: pointer;
    transition: background 0.15s;
}
.gd-media-picker-close:hover { background: rgba(255,255,255,0.1); color: #fff; }
.gd-media-picker-tabs {
    display: flex;
    gap: 4px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 4px;
}
.gd-mp-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 1;
    justify-content: center;
    padding: 8px 10px;
    border-radius: 9px;
    border: none;
    background: transparent;
    color: rgba(255,255,255,0.55);
    font: 700 0.78rem var(--font-main);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
}
.gd-mp-tab.active { background: rgba(255,255,255,0.12); color: #fff; }
.gd-mp-tab:hover:not(.active) { background: rgba(255,255,255,0.07); color: rgba(255,255,255,0.8); }
.gd-mp-panel { display: flex; flex-direction: column; gap: 10px; }
.gd-mp-hint {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.48);
    line-height: 1.45;
    margin: 0;
}
.gd-mp-ext {
    color: rgba(255,255,255,0.7);
    font-weight: 700;
    font-family: var(--font-heading);
}
.gd-mp-selected {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.55);
    word-break: break-all;
    padding: 6px 8px;
    background: rgba(255,255,255,0.05);
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.08);
}
.gd-mp-link-err {
    font-size: 0.78rem;
    color: #ffb4ad;
    margin: 0;
}

/* ============================================================
   RATINGS MODAL
   ============================================================ */
.gd-ratings-modal-box { gap: 14px; min-width: min(440px, 92vw); }
.gd-ratings-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 260px;
    overflow-y: auto;
    scrollbar-width: thin;
}
.gd-rating-entry {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
}
.gd-rating-entry-src {
    font: 700 0.82rem var(--font-heading);
    color: #fff;
    flex: 1;
    min-width: 0;
}
.gd-rating-entry-score {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.6);
    white-space: nowrap;
    margin-right: 4px;
}
.gd-ratings-add-row {
    display: flex;
    align-items: center;
    gap: 8px;
}
.gd-creator-modal-date {
    color-scheme: dark;
}

/* ============================================================
   HIDE TRAILER EXT BUTTON in Creator Mode and custom pages
   ============================================================ */
#gameDetailsView.gd-creator-active #gdTrailerExtBtn,
#gameDetailsView.gd-creator-preview #gdTrailerExtBtn,
#gameDetailsView.gd-has-custom-page #gdTrailerExtBtn { display: none !important; }

/* ============================================================
   CUSTOM DATE PICKER MODAL
   ============================================================ */
.gd-dp-box { width: min(360px, 94vw); gap: 16px; }
.gd-dp-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
}
.gd-dp-month-year { display: flex; align-items: center; gap: 8px; }
.gd-dp-nav-btn {
    width: 32px; height: 32px;
    display: grid; place-items: center;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px;
    color: rgba(255,255,255,0.8);
    cursor: pointer;
    transition: background 0.15s;
    flex-shrink: 0;
}
.gd-dp-nav-btn:hover { background: rgba(255,255,255,0.12); color: #fff; }
.gd-dp-nav-month, .gd-dp-nav-year {
    background: none; border: none;
    color: #fff;
    font-weight: 700;
    font-family: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    padding: 4px 6px;
    border-radius: 6px;
    transition: background 0.15s;
}
.gd-dp-nav-year { color: rgba(255,255,255,0.65); }
.gd-dp-nav-month:hover, .gd-dp-nav-year:hover { background: rgba(255,255,255,0.08); }
.gd-dp-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
}
.gd-dp-weekday {
    text-align: center;
    font-size: 0.68rem;
    font-weight: 700;
    color: rgba(255,255,255,0.35);
    padding: 4px 0 6px;
    letter-spacing: 0.04em;
}
.gd-dp-day {
    aspect-ratio: 1;
    display: grid; place-items: center;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.75);
    background: none;
    border: none;
    border-radius: 7px;
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
    font-family: inherit;
}
.gd-dp-day:hover { background: rgba(255,255,255,0.1); color: #fff; }
.gd-dp-today { border: 1px solid rgba(255,255,255,0.28); font-weight: 700; }
.gd-dp-selected { background: #fff !important; color: #000 !important; font-weight: 700; }
.gd-dp-selected-label { font-size: 0.78rem; color: rgba(255,255,255,0.55); text-align: center; }
.gd-dp-no-sel { color: rgba(255,255,255,0.3); }
.gd-dp-selected-label strong { color: rgba(255,255,255,0.9); }

/* ============================================================
   RATING SOURCE CARDS (replaces native select)
   ============================================================ */
.gd-ratings-src-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 4px;
}
.gd-rating-src-cards { display: flex; flex-wrap: wrap; gap: 7px; }
.gd-rating-src-card {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    color: rgba(255,255,255,0.8);
    font-family: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    text-align: left;
}
.gd-rating-src-card:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.28);
    color: #fff;
}
.gd-rsc-icon-wrap { width: 20px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.gd-rsc-icon { width: 18px; height: 18px; object-fit: contain; display: block; }
.gd-rsc-icon-invert { filter: invert(1); }
.gd-rsc-name { font-weight: 700; white-space: nowrap; }
.gd-rsc-constraint { color: rgba(255,255,255,0.38); font-size: 0.7rem; white-space: nowrap; }

/* Fix rating entry row layout */
.gd-rating-entry { flex-wrap: nowrap; align-items: flex-start; gap: 10px; }
.gd-re-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
    overflow: hidden;
}
.gd-rating-entry-src {
    font-weight: 700;
    font-size: 0.82rem;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.gd-rating-entry-score { font-size: 0.8rem; color: rgba(255,255,255,0.75); white-space: nowrap; }
.gd-rating-entry-sub  { font-size: 0.7rem;  color: rgba(255,255,255,0.42); white-space: nowrap; }
.gd-re-actions { display: flex; align-items: center; gap: 5px; flex-shrink: 0; }

/* ============================================================
   PAGE PACK / EMPTY STATE BUTTONS
   ============================================================ */
.gd-empty-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
.gd-empty-creator-btn, .gd-empty-import-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    border-radius: 10px;
    font: 700 0.84rem var(--font-main, inherit);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
}
.gd-empty-creator-btn {
    background: rgba(255,255,255,0.9);
    color: #000;
    border: 1px solid rgba(255,255,255,0.9);
}
.gd-empty-creator-btn:hover { background: #fff; }
.gd-empty-import-btn {
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.8);
    border: 1px solid rgba(255,255,255,0.16);
}
.gd-empty-import-btn:hover { background: rgba(255,255,255,0.11); color: #fff; border-color: rgba(255,255,255,0.28); }
.gd-empty-text h3 { margin: 0 0 6px; font-size: 1rem; color: rgba(255,255,255,0.9); }
.gd-empty-text p  { margin: 0; font-size: 0.84rem; color: rgba(255,255,255,0.5); line-height: 1.5; max-width: 340px; }
.gd-empty-icon { margin-bottom: 12px; color: rgba(255,255,255,0.22); }

/* ============================================================
   CREATOR TOUR — driver.js popover overrides
   ============================================================ */
.gd-tour-popover {
    background: #16161e !important;
    border: 1px solid rgba(255,255,255,0.15) !important;
    border-radius: 14px !important;
    box-shadow: 0 16px 48px rgba(0,0,0,0.7) !important;
    z-index: 999999 !important;
}
.gd-tour-popover .driver-popover-title {
    color: #fff !important;
    font-weight: 800;
}
.gd-tour-popover .driver-popover-description {
    color: rgba(255,255,255,0.72) !important;
    font-size: 0.88rem;
}
.gd-tour-popover .driver-popover-footer button {
    background: rgba(255,255,255,0.09);
    border: 1px solid rgba(255,255,255,0.18);
    color: #fff;
    border-radius: 8px;
    font-weight: 700;
    transition: background 0.15s;
}
.gd-tour-popover .driver-popover-footer button:hover { background: rgba(255,255,255,0.16); }
.gd-tour-popover .driver-popover-footer .driver-popover-next-btn {
    background: rgba(255,255,255,0.9) !important;
    color: #000 !important;
    border-color: rgba(255,255,255,0.9) !important;
}
.gd-tour-popover .driver-popover-footer .driver-popover-next-btn:hover { background: #fff !important; }

/* ============================================================
   CREATOR MODE POLISH PASS
   ============================================================ */
.gd-creator-modal-backdrop,
.gd-creator-modal-overlay {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background:
        radial-gradient(circle at 30% 10%, rgba(255,255,255,0.08), transparent 34%),
        rgba(0,0,0,0.74);
    backdrop-filter: blur(18px) saturate(120%);
    z-index: 10000;
}
.gd-creator-modal,
.gd-creator-modal-box {
    width: min(560px, 94vw);
    max-height: min(84vh, 760px);
    overflow: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: linear-gradient(145deg, rgba(24,24,32,0.98), rgba(12,12,17,0.98));
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 22px;
    box-shadow: 0 26px 90px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.08);
    padding: 20px;
    color: #fff;
}
.gd-creator-modal-header,
.gd-creator-modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
}
.gd-creator-modal-title {
    display: block;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    color: #fff;
}
.gd-creator-modal-subtitle {
    margin: 4px 0 0;
    color: rgba(255,255,255,0.56);
    font-size: 0.8rem;
}
.gd-creator-modal-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 0;
}
.gd-creator-input,
.gd-creator-modal-input {
    width: 100%;
    background: rgba(255,255,255,0.075);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 13px;
    color: #fff;
    padding: 11px 12px;
    outline: none;
}
.gd-creator-input:focus,
.gd-creator-modal-input:focus {
    border-color: rgba(255,255,255,0.42);
    box-shadow: 0 0 0 3px rgba(255,255,255,0.08);
}
.gd-creator-action,
.gd-creator-modal-btn {
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 12px;
    padding: 10px 16px;
    background: rgba(255,255,255,0.08);
    color: #fff;
    font-weight: 800;
    cursor: pointer;
}
.gd-creator-primary,
.gd-creator-modal-btn.primary {
    background: #fff;
    border-color: #fff;
    color: #000;
}
.gd-creator-danger,
.gd-creator-modal-btn.danger {
    background: rgba(255,80,80,0.16);
    border-color: rgba(255,120,120,0.36);
    color: #ffb6b6;
}
.gd-creator-secondary:hover,
.gd-creator-action:hover,
.gd-creator-modal-btn:hover {
    background: rgba(255,255,255,0.14);
}

.gd-creator-toolbar {
    max-width: min(940px, calc(100% - 36px));
    margin-inline: auto;
    border-radius: 18px;
}
.gd-creator-toolbar-actions {
    position: relative;
    align-items: center;
}
.gd-creator-more-wrap { position: relative; }
.gd-creator-more-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: none;
    min-width: 210px;
    padding: 8px;
    background: rgba(18,18,24,0.98);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 15px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.48);
    z-index: 10;
}
.gd-creator-more-wrap.open .gd-creator-more-menu { display: grid; gap: 4px; }
.gd-creator-more-menu button {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 10px 11px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: rgba(255,255,255,0.84);
    text-align: left;
    cursor: pointer;
}
.gd-creator-more-menu button:hover { background: rgba(255,255,255,0.09); color: #fff; }
.gd-creator-more-menu button.danger { color: #ffb6b6; }

.gd-trailer-wrap {
    overflow: visible !important;
    height: auto !important;
    min-height: 0 !important;
    aspect-ratio: auto !important;
    background: transparent !important;
}
.gd-trailer-add-header {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 999px;
    background: rgba(255,255,255,0.08);
    color: #fff;
    cursor: pointer;
}
.gd-creator-trailer-layout {
    display: grid;
    gap: 14px;
    overflow: visible;
}
.gd-creator-trailer-feature .gd-creator-trailer-row {
    min-height: 260px;
}
.gd-creator-trailer-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 10px;
}
.gd-creator-trailer-row {
    min-height: 92px;
    overflow: visible;
}
#gameDetailsView.gd-creator-preview .gd-trailer-add-header,
#gameDetailsView.gd-creator-preview .gd-creator-media-actions,
#gameDetailsView.gd-creator-preview .gd-creator-add-card { display: none !important; }

.gd-about-wrapper,
.gd-full-desc,
.gd-full-desc-text {
    max-height: none !important;
    overflow: visible !important;
}
.gd-full-desc-text {
    display: block !important;
    -webkit-line-clamp: unset !important;
    padding-bottom: 14px;
}
.gd-about-fade { display: none !important; }
.gd-short-desc-section,
#gdShortDescSection {
    overflow: visible;
}

.gd-rating-empty-card {
    width: 100%;
    border: 1px dashed rgba(255,255,255,0.18);
    background: rgba(255,255,255,0.06);
}
.gd-rating-block .gd-rating-label:empty,
.gd-rating-block .gd-stars:empty { display: none !important; }
.gd-rating-entry {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
}
.gd-re-info { min-width: 0; }
.gd-rating-entry-sub {
    white-space: normal !important;
    line-height: 1.35;
}
.gd-rating-form-grid {
    display: grid;
    gap: 12px;
}
.gd-rating-form-grid label {
    display: grid;
    gap: 7px;
    color: rgba(255,255,255,0.72);
    font-size: 0.78rem;
    font-weight: 800;
}
.gd-rating-step-head {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px;
    border-radius: 14px;
    background: rgba(255,255,255,0.06);
}
.gd-rating-step-head div { display: grid; gap: 3px; }
.gd-rating-step-head span,
.gd-rating-live-calc {
    color: rgba(255,255,255,0.58);
    font-size: 0.78rem;
}

.gd-dob-box { width: min(680px, 94vw); }
.gd-dob-picker {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
}
.gd-dob-column {
    min-width: 0;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
    background: rgba(255,255,255,0.055);
    overflow: hidden;
}
.gd-dob-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    color: rgba(255,255,255,0.62);
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .08em;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}
.gd-dob-list {
    max-height: 235px;
    overflow-y: auto;
    padding: 8px;
}
.gd-dob-option {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 10px;
    border: 0;
    border-radius: 11px;
    background: transparent;
    color: rgba(255,255,255,0.76);
    cursor: pointer;
}
.gd-dob-option small { color: rgba(255,255,255,0.42); }
.gd-dob-option:hover { background: rgba(255,255,255,0.08); color: #fff; }
.gd-dob-option.selected {
    background: rgba(255,255,255,0.92);
    color: #000;
}
.gd-dob-option.selected small { color: rgba(0,0,0,0.55); }
.gd-dp-selected-label {
    color: rgba(255,255,255,0.7);
    font-size: 0.82rem;
}

.driver-popover.gd-tour-popover,
.gd-tour-popover {
    background: rgba(18,18,20,0.96) !important;
    border: 1px solid rgba(255,255,255,0.14) !important;
    border-radius: 18px !important;
    color: #fff !important;
    box-shadow: 0 24px 80px rgba(0,0,0,0.55) !important;
    z-index: 999999 !important;
}

@media (max-width: 760px) {
    .gd-creator-toolbar { max-width: calc(100% - 22px); }
    .gd-creator-toolbar-actions #gdCreatorPreviewBtn { display: none; }
    .gd-dob-picker { grid-template-columns: 1fr; }
}

/* ============================================================
   CREATOR YT THUMB (non-link version)
   ============================================================ */
.gd-creator-yt-thumb {
    position: relative;
    display: block;
    flex: 1;
    min-width: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
    cursor: default;
}
.gd-creator-yt-thumb img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
    opacity: 0.75;
}

/* Custom thumbnail (overrides YouTube) */
.gd-creator-custom-thumb {
    position: relative;
    display: block;
    flex: 1;
    min-width: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
    cursor: default;
}
.gd-creator-custom-thumb img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
    opacity: 0.9;
}

/* Clean fallback — no large logo */
.gd-creator-trailer-fallback {
    width: 100%;
    aspect-ratio: 16/9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #0d0d12;
    border-radius: 8px;
    color: rgba(255,255,255,0.25);
    overflow: hidden;
}
.gd-creator-trailer-fallback-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.2);
}
.gd-ct-fallback-url {
    font-size: 0.68rem;
    color: rgba(255,255,255,0.2);
    max-width: 90%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
    padding: 0 8px;
}
.gd-creator-yt-play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 42px; height: 30px;
    background: rgba(20,20,20,0.82);
    border-radius: 8px;
    display: grid; place-items: center;
    color: rgba(255,255,255,0.65);
    pointer-events: none;
}

/* ============================================================
   PREVIEW MODE — hide ALL Creator edit affordances
   ============================================================ */
#gameDetailsView.gd-creator-preview .gd-creator-logo-ctrl { display: none !important; }
#gameDetailsView.gd-creator-preview .gd-creator-add-card  { display: none !important; }
#gameDetailsView.gd-creator-preview .gd-creator-media-actions { display: none !important; }
#gameDetailsView.gd-creator-preview .gd-edit-image-btn    { display: none !important; }
#gameDetailsView.gd-creator-preview [data-gd-creator-action] { pointer-events: none; outline: none !important; cursor: default; }
#gameDetailsView.gd-creator-preview .gd-editable { outline: none !important; cursor: default !important; }
#gameDetailsView.gd-creator-preview .gd-editable-chip { outline: none !important; }

/* ============================================================
   CREATOR TRAILER STRIP — featured + thumbnail strip
   ============================================================ */
.gd-creator-trailer-featured {
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
}
.gd-creator-trailer-featured .gd-creator-trailer-row {
    min-height: 260px;
}

/* Featured trailer: column layout with meta (title + thumbnail) below preview */
.gd-creator-trailer-featured-row {
    flex-direction: column !important;
    align-items: stretch !important;
    min-height: auto !important;
    padding: 0 !important;
}
.gd-ct-featured-preview {
    min-height: 200px;
    width: 100%;
}
.gd-ct-featured-preview .gd-creator-yt-thumb,
.gd-ct-featured-preview .gd-creator-custom-thumb,
.gd-ct-featured-preview .gd-creator-trailer-fallback,
.gd-ct-featured-preview .gd-creator-video-preview,
.gd-ct-featured-preview .gd-creator-trailer-url {
    width: 100%;
    display: block;
}
.gd-ct-featured-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px 10px 6px;
    background: rgba(255,255,255,0.04);
    border-top: 1px solid rgba(255,255,255,0.07);
}
.gd-ct-title-input {
    width: 100%;
    box-sizing: border-box;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 6px;
    color: #e8e8e8;
    font-size: 0.78rem;
    padding: 5px 8px;
    outline: none;
}
.gd-ct-title-input:focus {
    border-color: rgba(99,179,237,0.5);
    background: rgba(255,255,255,0.09);
}
.gd-ct-thumb-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
}
.gd-ct-thumb-preview {
    width: 64px;
    height: 36px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid rgba(255,255,255,0.15);
    flex-shrink: 0;
}
.gd-ct-thumb-btn {
    font-size: 0.72rem;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.16);
    background: rgba(255,255,255,0.07);
    color: #c8d0dc;
    cursor: pointer;
}
.gd-ct-thumb-btn:hover { background: rgba(255,255,255,0.14); color: #fff; }
.gd-ct-thumb-clear {
    font-size: 0.72rem;
    padding: 4px 7px;
    border-radius: 6px;
    border: 1px solid rgba(255,100,100,0.25);
    background: transparent;
    color: #ffb6b6;
    cursor: pointer;
}
.gd-ct-thumb-clear:hover { background: rgba(255,60,60,0.15); }
.gd-ct-featured-actions {
    position: static !important;
    flex-shrink: 0;
    justify-content: flex-start;
    padding: 6px 10px;
    border-top: 1px solid rgba(255,255,255,0.07);
}

/* Strip card thumbnail overlay edit button */
.gd-ct-strip-thumb-edit {
    position: absolute;
    bottom: 4px;
    right: 4px;
    width: 22px;
    height: 22px;
    border-radius: 5px;
    border: 1px solid rgba(255,255,255,0.2);
    background: rgba(0,0,0,0.6);
    color: #c8d0dc;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.15s;
    padding: 0;
}
.gd-ct-strip-card:hover .gd-ct-strip-thumb-edit { opacity: 1; }
.gd-ct-strip-thumb-edit:hover { background: rgba(0,0,0,0.85); color: #fff; }

/* Strip card inline title input */
.gd-ct-strip-title-input {
    width: calc(100% - 12px);
    box-sizing: border-box;
    margin: 4px 6px 0;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.11);
    border-radius: 4px;
    color: #e0e8f0;
    font-size: 0.68rem;
    padding: 3px 5px;
    outline: none;
}
.gd-ct-strip-title-input:focus { border-color: rgba(99,179,237,0.4); background: rgba(255,255,255,0.08); }

/* Hide creator-only meta in preview mode */
#gameDetailsView.gd-creator-preview .gd-ct-featured-meta,
#gameDetailsView.gd-creator-preview .gd-ct-strip-title-input,
#gameDetailsView.gd-creator-preview .gd-ct-strip-thumb-edit { display: none !important; }

/* Thumbnail strip below the featured trailer */
.gd-ct-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 4px;
}

.gd-creator-add-trailer-card {
    flex: 0 0 auto;
    width: 180px;
    aspect-ratio: 16/9;
    border: 1px dashed rgba(255,255,255,0.18);
    border-radius: 12px;
    background: rgba(255,255,255,0.03);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.4);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
    padding: 0 12px;
    text-align: center;
}
.gd-creator-add-trailer-card:hover {
    border-color: rgba(255,255,255,0.4);
    background: rgba(255,255,255,0.07);
    color: #fff;
}
#gameDetailsView.gd-creator-preview .gd-creator-add-trailer-card {
    display: none !important;
}
.gd-ct-strip-card {
    flex: 0 0 auto;
    width: 180px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255,255,255,0.05);
    display: flex;
    flex-direction: column;
}
.gd-ct-strip-thumb {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #0a0a0e;
    position: relative;
}
.gd-ct-strip-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.8;
}
.gd-ct-strip-ph {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.3);
    font-size: 0.72rem;
    text-align: center;
    padding: 6px;
}
.gd-ct-strip-url {
    display: block;
    font-size: 0.66rem;
    color: rgba(255,255,255,0.38);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 4px 8px;
    pointer-events: none;
}
.gd-ct-strip-actions {
    display: flex;
    gap: 4px;
    padding: 6px 8px;
    border-top: 1px solid rgba(255,255,255,0.08);
}
.gd-ct-strip-actions button {
    flex: 1;
    padding: 5px 0;
    border: 1px solid rgba(255,255,255,0.13);
    border-radius: 8px;
    background: rgba(255,255,255,0.07);
    color: rgba(255,255,255,0.76);
    font-size: 0.7rem;
    cursor: pointer;
}
.gd-ct-strip-actions button:hover { background: rgba(255,255,255,0.14); color: #fff; }
.gd-ct-strip-actions button.danger { color: #ffb6b6; border-color: rgba(255,100,100,0.25); }

/* Strip cards hidden in preview mode */
#gameDetailsView.gd-creator-preview .gd-ct-strip-actions { display: none !important; }

/* ── Time Tracking Mini Control ────────────────────────────────────────────── */
#gdTimeTrackingRow {
    margin-top: 6px;
}

.gd-tracking-row {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 0;
    margin: 0;

    background: transparent;
    border: 0;
    border-radius: 0;
    backdrop-filter: none;
}

.gd-tracking-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    color: rgba(255,255,255,0.38);
    flex-shrink: 0;
}

.gd-tracking-copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 0 1 auto;
    min-width: 0;
}

.gd-tracking-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;

    font-size: 11px;
    font-weight: 600;
    color: rgba(255,255,255,0.58);
    line-height: 1;
}

/* اخفي الوصف الطويل */
.gd-tracking-subtitle {
    display: none;
}

.gd-tracking-pill {
    display: inline-flex;
    align-items: center;

    padding: 1px 6px;
    border-radius: 999px;

    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.45;
}

.gd-tracking-pill.is-on {
    background: rgba(48, 209, 88, 0.13);
    color: #30d158;
    border: 1px solid rgba(48, 209, 88, 0.24);
}

.gd-tracking-pill.is-off {
    background: rgba(255, 69, 58, 0.11);
    color: #ff6b6b;
    border: 1px solid rgba(255, 69, 58, 0.22);
}

/* الزرار يبقى text action صغير مش button ضخم */
.gd-tracking-toggle {
    padding: 0;
    margin-left: 2px;

    border: 0;
    background: transparent;

    color: rgba(255,255,255,0.42);
    font-size: 10px;
    font-weight: 600;

    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s ease, opacity 0.15s ease;
}

.gd-tracking-toggle:hover {
    color: rgba(255,255,255,0.78);
    background: transparent;
    border: 0;
}

.gd-tracking-toggle.is-destructive {
    color: rgba(255,255,255,0.42);
    border: 0;
}

.gd-tracking-toggle.is-destructive:hover {
    color: #ff6b6b;
    background: transparent;
    border: 0;
}

/* ── Floating Mini Player ─────────────────────────────────────── */
#gd-mini-player {
    background: #000;
    border-radius: 10px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.gd-mp-video-slot {
    position: absolute;
    inset: 0;
    border-radius: 10px;
    overflow: hidden;
}

.gd-mp-overlay {
    position: absolute;
    inset: 0;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.55) 0%,
        transparent 28%,
        transparent 68%,
        rgba(0, 0, 0, 0.6) 100%
    );
    opacity: 0;
    transition: opacity 0.18s ease;
    pointer-events: none;
    z-index: 2;
}

#gd-mini-player:hover .gd-mp-overlay {
    opacity: 1;
    pointer-events: auto;
}

.gd-mp-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 10px 4px;
}

.gd-mp-center-play {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
}

.gd-mp-prog-area {
    padding: 0 0 0;
}

.gd-mp-progress {
    height: 3px;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 0 0 10px 10px;
    cursor: pointer;
    transition: height 0.15s;
}

#gd-mini-player:hover .gd-mp-progress {
    height: 4px;
}

.gd-mp-prog-fill {
    height: 100%;
    width: 0%;
    background: #fff;
    border-radius: inherit;
    pointer-events: none;
}

.gd-mp-btn {
    background: rgba(0, 0, 0, 0.4);
    border: none;
    color: #fff;
    cursor: pointer;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
    flex-shrink: 0;
    padding: 0;
}

.gd-mp-btn:hover {
    background: rgba(0, 0, 0, 0.7);
}

.gd-mp-play-btn {
    width: 42px;
    height: 42px;
}

.gd-mp-resize-handle {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 18px;
    height: 18px;
    cursor: se-resize;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 3px;
    color: rgba(255, 255, 255, 0.3);
    pointer-events: all;
}

.gd-ach-item.gd-ach-locked {
    opacity: 0.48;
    filter: grayscale(1);
}

.gd-ach-item.gd-ach-locked .gd-ach-icon-wrapper {
    opacity: 0.7;
}

.gd-ach-item.gd-ach-locked .gd-ach-icon {
    filter: grayscale(1);
}

.gd-ach-item.gd-ach-locked .gd-ach-item-name {
    color: rgba(255,255,255,0.62);
}

.gd-ach-item.gd-ach-locked .gd-ach-item-desc {
    color: rgba(255,255,255,0.36);
}

.gd-ach-item-locked-time {
    color: rgba(255,255,255,0.35);
}

.gd-ach-icon-wrapper {
    width: 44px;
    height: 44px;
    min-width: 44px;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    display: flex;
    align-items: center;
    justify-content: center;
}

.gd-ach-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.gd-ach-icon-wrapper.gd-ach-icon-missing::before {
    content: "";
    opacity: 0.35;
    font-size: 18px;
}

.pl-platforms-list {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.pl-platform-option {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.045);
    color: rgba(255,255,255,0.78);
    cursor: pointer;
    font-weight: 700;
}

.pl-platform-option.selected {
    border-color: rgba(255,255,255,0.35);
    background: rgba(255,255,255,0.12);
    color: #fff;
}

.pl-platform-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.75;
}
/* ── YouTube <webview> player ─────────────────────────────────────────────── */
.gd-youtube-shell {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 4px 15px rgba(0,0,0,0.5);
}

.gd-youtube-thumb {
    position: relative;
    width: 100%;
    height: 100%;
    cursor: pointer;
    background: #000;
}

.gd-youtube-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.gd-youtube-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    transition: opacity 0.15s;
}

.gd-youtube-thumb:hover .gd-youtube-play { opacity: 0.85; }

.gd-youtube-webview {
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
}

.gd-yt-open-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 10;
    background: rgba(0,0,0,0.55);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 6px;
    color: rgba(255,255,255,0.7);
    font-size: 14px;
    line-height: 1;
    padding: 4px 7px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
}

.gd-yt-open-btn:hover {
    background: rgba(0,0,0,0.8);
    color: #fff;
}

.gd-youtube-error {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: rgba(0,0,0,0.75);
    color: rgba(255,255,255,0.7);
    font-size: 13px;
    text-align: center;
    padding: 16px;
}

.gd-yt-open-btn--inline {
    position: static;
    font-size: 12px;
    padding: 6px 14px;
    border-radius: 8px;
}

/* ── DASH quality selector overlay ───────────────────────────────────────── */
.gd-trailer-quality {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: rgba(10, 10, 10, 0.72);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.75);
    pointer-events: auto;
    transition: opacity 0.2s;
}

.gd-trailer-quality label {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.03em;
    white-space: nowrap;
    user-select: none;
}

.gd-trailer-quality select {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.85);
    font-size: 11px;
    font-family: inherit;
    cursor: pointer;
    outline: none;
    padding: 0 2px;
    -webkit-appearance: none;
    appearance: none;
}

.gd-trailer-quality select option {
    background: #1a1a1a;
    color: #fff;
}

/* ============================================================
   BADDEL LAUNCHER - PLAY LAUNCHER MODAL (play-launcher.css)
   Aesthetic: Premium Dark, Cinematic, Glassmorphism
   ============================================================ */


/* ── Backdrop ── */
.pl-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease, backdrop-filter 0.3s ease;
}
.pl-backdrop.visible {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(20px) saturate(180%);
}

/* ── Modal Container ── */
.pl-modal {
    width: 560px;
    max-width: calc(100vw - 40px);
    max-height: 88vh;
    background: #111114;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow:
        0 0 0 1px rgba(255,255,255,0.04),
        0 40px 80px rgba(0, 0, 0, 0.7),
        0 0 120px rgba(0, 0, 0, 0.5);
    transform: scale(0.92) translateY(20px);
    opacity: 0;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease;
    will-change: transform, opacity;
}
.pl-modal.visible {
    transform: scale(1) translateY(0);
    opacity: 1;
}

/* ── Hero ── */
.pl-hero {
    position: relative;
    height: 130px;
    background-size: cover;
    background-position: center top;
    flex-shrink: 0;
}
.pl-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(0,0,0,0.35) 0%,
        rgba(17,17,20,0.9) 70%,
        #111114 100%
    );
}
.pl-hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 16px;
    padding: 0 24px 20px;
    height: 100%;
}
.pl-game-cover {
    width: 52px;
    height: 68px;
    object-fit: cover;
    object-position: center bottom;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    flex-shrink: 0;
}
.pl-game-cover-placeholder {
    width: 52px;
    height: 68px;
    border-radius: 10px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 700;
    color: rgba(255,255,255,0.4);
    flex-shrink: 0;
}
.pl-game-info {
    flex: 1;
    min-width: 0;
}
.pl-game-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 4px;
}
.pl-game-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #f5f5f7;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-brand);
}

/* ── Close Button ── */
.pl-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 10;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.7);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, transform 0.2s;
}
.pl-close-btn:hover {
    background: rgba(255,255,255,0.15);
    color: #fff;
    transform: scale(1.1) rotate(90deg);
}

/* ── Body ── */
.pl-body {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.1) transparent;
    padding: 4px 0 8px;
}
.pl-body::-webkit-scrollbar { width: 4px; }
.pl-body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }

/* ── Section ── */
.pl-section {
    padding: 18px 24px;
}
.pl-section-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
}
.pl-step-badge {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    font-size: 0.7rem;
    font-weight: 700;
    color: rgba(255,255,255,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.pl-section-title {
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    text-transform: uppercase;
    letter-spacing: 0.08em;
}
.pl-section-sub {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.3);
    margin-left: auto;
}

/* ── Divider ── */
.pl-divider {
    height: 1px;
    background: rgba(255,255,255,0.05);
    margin: 0 24px;
}

/* ── Platform Cards ── */
.pl-platforms-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}
.pl-platform-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 14px 16px 12px;
    background: rgba(255,255,255,0.03);
    border: 1.5px solid rgba(255,255,255,0.07);
    border-radius: 14px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    min-width: 88px;
    user-select: none;
}
.pl-platform-card:hover {
    background: rgba(255,255,255,0.07);
    border-color: rgba(255,255,255,0.15);
    transform: translateY(-2px);
}
.pl-platform-card.selected {
    background: color-mix(in srgb, var(--plat-accent, #fff) 12%, transparent);
    border-color: var(--plat-accent, #fff);
    box-shadow: 0 0 16px color-mix(in srgb, var(--plat-accent, #fff) 20%, transparent);
}
.pl-platform-icon-wrap {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.pl-platform-icon-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}
.pl-platform-name {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    text-align: center;
    white-space: nowrap;
}
.pl-platform-card.selected .pl-platform-name {
    color: #fff;
}
.pl-primary-star {
    position: absolute;
    top: 6px;
    right: 8px;
    font-size: 0.75rem;
    color: #ffd700;
    line-height: 1;
}

/* Set Primary hint */
.pl-platform-card .pl-set-primary-btn {
    display: none;
    position: absolute;
    top: -10px;
    right: -10px;
    background: #1c1c1e;
    border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.5);
    font-size: 0.6rem;
    padding: 2px 6px;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    z-index: 5;
    transition: 0.2s;
}
.pl-platform-card:hover .pl-set-primary-btn {
    display: block;
}
.pl-set-primary-btn:hover {
    color: #ffd700;
    border-color: rgba(255,215,0,0.3);
}

/* Primary hint line */
.pl-primary-hint {
    margin-top: 10px;
    font-size: 0.72rem;
    color: #ffd700;
    opacity: 0;
    transition: opacity 0.4s ease;
    height: 16px;
}

/* ── Accounts List ── */
.pl-accounts-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 215px; /* 🟢 الارتفاع ثابت دايماً عشان نمنع حركة الفتح والقفل */
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.08) transparent;
    padding-right: 4px;
    transition: opacity 0.15s ease-in-out;
}
.pl-accounts-list::-webkit-scrollbar { width: 4px; }
.pl-accounts-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 4px; }

/* ── Loading State ── */
.pl-accounts-loading {
    display: flex;
    align-items: center;
    justify-content: center; /* 🟢 توسيط اللودنج في النص بالظبط */
    height: 100%; /* 🟢 بياخد مساحة الصندوق كله */
    gap: 10px;
    margin: 0;
    color: rgba(255,255,255,0.4);
    font-size: 0.85rem;
}

.pl-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255,255,255,0.1);
    border-top-color: rgba(255,255,255,0.5);
    border-radius: 50%;
    animation: plSpin 0.8s linear infinite;
}
@keyframes plSpin { to { transform: rotate(360deg); } }

.pl-no-accounts {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center; /* 🟢 توسيط في النص بالظبط */
    height: 100%; /* 🟢 بياخد مساحة الصندوق كله */
    gap: 8px;
    margin: 0;
    color: rgba(255,255,255,0.3);
    font-size: 0.82rem;
    text-align: center;
}
.pl-no-accounts svg { opacity: 0.3; }
.pl-no-accounts-sub {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.2);
    max-width: 260px;
    line-height: 1.5;
}
.pl-btn-no-account-play {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.7);
    padding: 8px 18px;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
}
.pl-btn-no-account-play:hover {
    background: rgba(255,255,255,0.14);
    color: #fff;
}

/* ── Account Row ── */
.pl-account-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    background: rgba(255,255,255,0.03);
    border: 1.5px solid rgba(255,255,255,0.05);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
    position: relative;
}
.pl-account-row:hover {
    background: rgba(255,255,255,0.07);
    border-color: rgba(255,255,255,0.1);
}
.pl-account-row.selected {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.25);
}
.pl-account-row.selected .pl-account-check::after {
    opacity: 1;
    transform: scale(1);
}
.pl-account-row.no-switch {
    border-style: dashed;
    border-color: rgba(255,255,255,0.08);
}
.pl-account-row.no-switch:hover {
    border-color: rgba(255,255,255,0.15);
}

.pl-account-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    border: 1.5px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: rgba(255,255,255,0.6);
    flex-shrink: 0;
    overflow: hidden;
}
.pl-account-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%; 
}
.no-switch-icon {
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.35);
}

.pl-account-info {
    flex: 1;
    min-width: 0;
}
.pl-account-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: #f5f5f7;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.pl-account-sub {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.35);
    margin-top: 2px;
}

.pl-owned-badge {
    font-size: 0.65rem;
    font-weight: 600;
    color: #30d158;
    background: rgba(48, 209, 88, 0.12);
    border: 1px solid rgba(48, 209, 88, 0.25);
    padding: 3px 8px;
    border-radius: 6px;
    white-space: nowrap;
}

.pl-account-check {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.15);
    flex-shrink: 0;
    position: relative;
    transition: border-color 0.2s;
}
.pl-account-row.selected .pl-account-check {
    border-color: #fff;
    background: #fff;
}
.pl-account-check::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 5px;
    height: 8px;
    border: 2px solid #111;
    border-top: none;
    border-left: none;
    transform: translate(-50%, -60%) rotate(45deg) scale(0);
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
}
.pl-account-row.selected .pl-account-check::after {
    opacity: 1;
    transform: translate(-50%, -60%) rotate(45deg) scale(1);
}

.pl-link-btn {
    background: none;
    border: none;
    color: rgba(255,255,255,0.5);
    text-decoration: underline;
    cursor: pointer;
    font-size: 0.8rem;
    padding: 0;
}
.pl-link-btn:hover { color: #fff; }

/* ── Footer ── */
.pl-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    padding: 16px 24px;
    border-top: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.01);
    flex-shrink: 0;
}
.pl-btn-cancel {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.5);
    padding: 9px 20px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
}
.pl-btn-cancel:hover {
    background: rgba(255,255,255,0.1);
    color: #fff;
}
.pl-btn-launch {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    color: #000;
    border: none;
    padding: 10px 26px;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    letter-spacing: 0.02em;
}
.pl-btn-launch:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(255,255,255,0.2);
}
.pl-btn-launch:active {
    transform: scale(0.97);
}

/* ── Ownership Badges ── */
.pl-badge-unknown {
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.45);
    border: 1px solid rgba(255,255,255,0.12);
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 10px;
    white-space: nowrap;
    cursor: help;
}
.pl-badge-missing {
    color: #ffb020;
    background: rgba(255, 176, 32, 0.10);
    border-color: rgba(255, 176, 32, 0.30);
}
.po-row-disabled {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
}
.pl-badge-owned {
    color: #30d158;
    background: rgba(48, 209, 88, 0.12);
    border-color: rgba(48, 209, 88, 0.25);
}
.pl-badge-not-owned {
    color: rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.08);
}
.pl-badge-install-only {
    color: #ffb020;
    background: rgba(255, 176, 32, 0.12);
    border-color: rgba(255, 176, 32, 0.35);
}
.pl-badge-synced {
    color: #66c0f4;
    background: rgba(102, 192, 244, 0.1);
    border-color: rgba(102, 192, 244, 0.2);
}

/* ── Ghost Account Row (owned but not in switcher) ── */
.pl-account-row-ghost {
    opacity: 0.6;
    cursor: default !important;
    pointer-events: none;
    border-style: dashed !important;
    border-color: rgba(48, 209, 88, 0.2) !important;
    background: rgba(48, 209, 88, 0.03) !important;
    position: relative;
}

/* نخلي الـ tooltip wrapper يقدر ياخد الـ hover */
.pl-ghost-wrapper {
    position: relative;
    pointer-events: auto;
    border-radius: 12px;
}
/* جسر وهمي يسد الـ gap بين الـ row والـ tooltip عشان الـ hover ميتكسرش */
.pl-ghost-wrapper::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    height: 14px;
    z-index: 99;
}
.pl-ghost-wrapper:hover .pl-ghost-tooltip,
.pl-ghost-tooltip:hover {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
}

/* ── Ghost Custom Tooltip ── */
.pl-ghost-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    background: #1c1c20;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    padding: 10px 13px 13px;
    width: 240px;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
    box-shadow: 0 8px 32px rgba(0,0,0,0.6);
}
.pl-ghost-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: rgba(255,255,255,0.12);
}
.pl-ghost-tooltip-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: #f5f5f7;
    margin-bottom: 4px;
}
.pl-ghost-tooltip-body {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.5;
    margin-bottom: 9px;
}
.pl-ghost-go-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
    color: rgba(255,255,255,0.85);
    padding: 6px 12px;
    border-radius: 7px;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.18s, color 0.18s;
    letter-spacing: 0.02em;
}
.pl-ghost-go-btn:hover {
    background: rgba(255,255,255,0.15);
    color: #fff;
}




.pl-selected-platform-icon img {
    width: 20px;
    height: 20px;
    object-fit: contain;
}

.pl-selected-platform-hint {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    width: fit-content;
    max-width: 100%;

    margin: 6px 0 10px 0;
    padding: 5px 9px;

    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);

    background: rgba(255, 255, 255, 0.035);
    box-shadow: none;
}

.pl-selected-platform-icon {
    width: 20px;
    height: 20px;
    border-radius: 999px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: color-mix(in srgb, var(--plat-accent, #fff) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--plat-accent, #fff) 28%, transparent);

    flex: 0 0 auto;
}

.pl-selected-platform-icon img {
    width: 12px;
    height: 12px;
    object-fit: contain;
}

.pl-selected-platform-text {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
}

.pl-selected-platform-kicker {
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
    font-weight: 700;
    line-height: 1;
}

.pl-selected-platform-name {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.82);
    font-weight: 800;
    line-height: 1;
}
