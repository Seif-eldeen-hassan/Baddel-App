}

.sensor-indicator {
    width: 6px;
    height: 6px;
    background: #30d158;
    border-radius: 50%;
    box-shadow: 0 0 8px #30d158;
    animation: blink 1.5s infinite;
}

.sensor-toggle-btn.off {
    background: rgba(255, 69, 58, 0.1);
    border-color: rgba(255, 69, 58, 0.3);
