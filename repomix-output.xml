    border: 0;
    margin-left: 15px;
    font-size: 16px;
    transition: background-color .2s ease;
}

.main-footer__button--primary:hover {
    background-color: rgb(176, 146, 216);
    transition: background-color .2s ease;
}

.main-footer__button--secondary:hover {
    border: 1px solid rgba(242, 242, 242, .6);
    transition: border .2s ease;
}

.steam-help {
