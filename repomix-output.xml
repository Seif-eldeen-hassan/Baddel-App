                throw new Error('should not fetch');
            },
        },
    });
    const stored = cache.storeBuffer({
        sourceUrl: 'https://cdn.example/cover.png',
        canonicalGameId: 'game-a',
        type: 'cover',
        buffer: PNG_1X1,
        mime: 'image/png',
    });

