                            onErrorOccurred() {},
                        },
                    }),
                },
                net: { request: () => ({ on() {}, end() {} }) },
                shell: { openExternal: async () => {} },
            };
        }
        if (request === 'child_process') return { execFile };
        if (request === './steamBridge') return steamBridge;
        if (request === './services/baddelApi') return baddelApi;
        if (request === './analytics') return analytics;
