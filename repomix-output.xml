    await safeWriteFile(activeDiscordProfilePath, name.trim());
    discordLog(`Account (${name}) saved.`, 'SUCCESS');
    analytics.logAccountAdded('discord').catch(() => {});
    return { status: 'success', name: name.trim(), avatarUrl: userData?.avatarUrl };
