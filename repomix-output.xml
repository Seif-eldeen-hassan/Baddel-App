.ag-view-btn + .ag-view-btn { border-left: 1px solid rgba(255,255,255,0.07); }

/* ══════════════════════════════════════════════════════════════
   DISPLAY SETTINGS DROPDOWN
══════════════════════════════════════════════════════════════ */
.ag-display-dropdown { position: relative; }
.ag-display-trigger {
    display: flex; align-items: center; gap: 6px;
    height: 34px; padding: 0 12px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px;
    color: #777; font-size: 0.75rem; font-weight: 600;
    font-family: var(--font-main, sans-serif);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    white-space: nowrap;
}
.ag-display-trigger:hover { border-color: rgba(255,255,255,0.18); color: #ccc; }
.ag-display-trigger.active { border-color: rgba(255,255,255,0.2); color: #fff; }

.ag-display-panel {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: 220px;
    background: #141414;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    z-index: 200;
    box-shadow: 0 16px 40px rgba(0,0,0,0.6);
    overflow: hidden;
    animation: fadeUp 0.15s ease;
}
.ag-display-panel.active { display: block; }

.adp-section {
    padding: 12px 14px 10px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}
.adp-section:last-child { border-bottom: none; }
.adp-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #444;
    margin-bottom: 10px;
}
.adp-seg {
    display: flex;
    gap: 4px;
}
.adp-seg-btn {
    flex: 1; height: 28px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 6px;
    color: #555; font-size: 0.7rem; font-weight: 600;
    font-family: var(--font-main, sans-serif);
    cursor: pointer;
    transition: background 0.13s, border-color 0.13s, color 0.13s;
}
.adp-seg-btn:hover { background: rgba(255,255,255,0.07); color: #aaa; }
.adp-seg-btn.active { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.2); color: #fff; }

.adp-fields {
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.adp-field-toggle {
    display: flex; align-items: center; gap: 9px;
    padding: 5px 4px;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.12s;
}
.adp-field-toggle:hover { background: rgba(255,255,255,0.04); }
.adp-field-toggle input[type="checkbox"] {
    appearance: none; -webkit-appearance: none;
    width: 14px; height: 14px;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 4px;
    background: rgba(255,255,255,0.03);
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
    transition: background 0.12s, border-color 0.12s;
}
.adp-field-toggle input[type="checkbox"]:checked {
    background: rgba(255,255,255,0.8);
    border-color: rgba(255,255,255,0.8);
}
.adp-field-toggle input[type="checkbox"]:checked::after {
    content: '';
    position: absolute;
    top: 1px; left: 3px;
    width: 5px; height: 8px;
    border: 2px solid #111;
    border-top: none; border-left: none;
    transform: rotate(45deg);
}
.adp-field-toggle span {
    font-size: 0.78rem;
    color: #999;
}
.adp-field-toggle:has(input:checked) span { color: #ddd; }

/* ══════════════════════════════════════════════════════════════
   GRID DENSITY MODIFIERS
══════════════════════════════════════════════════════════════ */
#allGamesGrid.density-compact { --ag-min-card-w: 120px; }
#allGamesGrid.density-normal  { --ag-min-card-w: 160px; }
#allGamesGrid.density-large   { --ag-min-card-w: 210px; }

/* ── Field visibility on cards ─────────────────────── */
#allGamesGrid.hide-title .game-card-title { display: none; }
#allGamesGrid.hide-platforms .agc-badges-strip { display: none !important; }
#allGamesGrid.show-playtime .game-card-meta-playtime,
#allGamesGrid.show-lastPlayed .game-card-meta-lastplayed,
#allGamesGrid.show-installed .game-card-meta-installed,
#allGamesGrid.show-rating .game-card-meta-rating { display: flex; }

/* Extra metadata line under title */
.game-card-meta {
    display: flex; flex-wrap: wrap; gap: 4px;
    padding: 0 0 4px;
}
.game-card-meta-item {
    display: none;
    align-items: center; gap: 3px;
    font-size: 0.65rem; color: #555; font-weight: 600;
}
.game-card-meta-item svg { opacity: 0.5; }

/* ══════════════════════════════════════════════════════════════
   LIST VIEW
══════════════════════════════════════════════════════════════ */
.ag-list-view {
    width: 100%;
    font-size: 0.82rem;
}

.ag-list-header {
    display: grid;
    grid-template-columns: 48px 1fr 140px 100px 120px 36px;
    align-items: center;
    padding: 0 8px;
    height: 30px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    margin-bottom: 4px;
}
.ag-list-header .ag-list-col {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.7px;
    text-transform: uppercase;
    color: #333;
}

.ag-list-row {
    display: grid;
    grid-template-columns: 48px 1fr 140px 100px 120px 36px;
    align-items: center;
    padding: 5px 8px;
    border-radius: 8px;
    cursor: pointer;
    gap: 0;
    position: relative;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
}
.ag-list-row:last-child { border-bottom: none; }
.ag-list-row:hover {
    background: rgba(255,255,255,0.06);
    transform: scale(1.008);
    box-shadow: 0 2px 16px rgba(0,0,0,0.35);
    z-index: 1;
    border-bottom-color: transparent;
}
.ag-list-row:hover .ag-col-title-text { color: #fff; }

.ag-list-col { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 12px; }
.ag-col-thumb { padding-right: 10px; flex-shrink: 0; }
.ag-list-thumb {
    width: 38px; height: 38px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    display: block;
    flex-shrink: 0;
}
.ag-list-thumb-placeholder {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.06);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.ag-col-title-text {
    font-size: 0.84rem;
    font-weight: 600;
    color: #ccc;
    transition: color 0.13s;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.ag-col-meta {
    font-size: 0.72rem;
    color: #444;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.ag-list-badges {
    display: flex; gap: 4px; align-items: center;
    flex-wrap: wrap;
}
.ag-list-badge-img {
    width: 13px; height: 13px;
    object-fit: contain;
    opacity: 0.6;
}
.ag-list-badge-img-invert { filter: brightness(0) invert(1); }

/* Installed icon in list view — same icon for all rows, styling differs by state */
.ag-list-installed-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
}
.ag-list-installed-icon svg {
    color: rgba(255, 255, 255, 0.1);
    transition: color 0.15s;
}
.ag-list-installed-icon.is-installed svg {
    color: rgba(80, 210, 110, 0.85);
    filter: drop-shadow(0 0 4px rgba(80, 210, 110, 0.3));
}

/* List density modifiers */
.ag-list-view.density-compact .ag-list-row { padding: 3px 8px; }
.ag-list-view.density-compact .ag-list-thumb,
.ag-list-view.density-compact .ag-list-thumb-placeholder { width: 28px; height: 28px; border-radius: 50%; }
.ag-list-view.density-compact .ag-list-header,
.ag-list-view.density-compact .ag-list-row {
    grid-template-columns: 38px 1fr 140px 100px 120px 36px;
}
.ag-list-view.density-comfortable .ag-list-row { padding: 9px 8px; }
.ag-list-view.density-comfortable .ag-list-thumb,
.ag-list-view.density-comfortable .ag-list-thumb-placeholder { width: 48px; height: 48px; border-radius: 50%; }
.ag-list-view.density-comfortable .ag-list-header,
.ag-list-view.density-comfortable .ag-list-row {
    grid-template-columns: 58px 1fr 140px 100px 120px 36px;
}

/* Play button column */
