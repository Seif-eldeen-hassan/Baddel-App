    // steam:// does not match /^eadesktop:\/\/mobilehome/
    const regexStr = block.match(/\/\^eadesktop.+?\//i)?.[0] || '';
    if (regexStr) {
        const rx = new RegExp(regexStr.slice(1, -1), 'i');
