const {
    escapeHtml,
    safeText,
    safeImageUrl,
    safeMediaUrl,
    safeEmbedUrl,
    safeExternalUrl,
    setSafeImageCacheDir,
    addTrustedFileDir,
} = require('../src/js/domUtils');

