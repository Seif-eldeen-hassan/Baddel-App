#allGamesGrid .ag-card-display-title {
    display: block;
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.15;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;

    text-shadow: 0 2px 8px rgba(0,0,0,0.8);
}

#allGamesGrid .ag-card-display-fields {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
}

#allGamesGrid .ag-card-field {
    display: none;
    align-items: center;
    gap: 4px;

    max-width: 100%;
    padding: 3px 6px;
    border-radius: 999px;

    font-size: 10px;
    font-weight: 700;
    line-height: 1;

    color: rgba(255,255,255,0.86);
    background: rgba(0,0,0,0.55);
    border: 1px solid rgba(255,255,255,0.12);
    backdrop-filter: blur(8px);
}

#allGamesGrid .ag-card-field-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255,255,255,0.55);
    flex: 0 0 auto;
}

#allGamesGrid .ag-card-field-installed.is-installed .ag-card-field-dot {
    background: #30d158;
}

#allGamesGrid .ag-card-field-installed.is-not-installed .ag-card-field-dot {
    background: #ff9f0a;
}

/* Toggle behavior */
#allGamesGrid.hide-title .ag-card-display-title {
    display: none !important;
}

#allGamesGrid.show-playtime .ag-card-field-playtime {
    display: inline-flex;
}

#allGamesGrid.show-lastPlayed .ag-card-field-lastPlayed {
    display: inline-flex;
}

#allGamesGrid.show-installed .ag-card-field-installed {
    display: inline-flex;
}

#allGamesGrid:not(.show-playtime):not(.show-lastPlayed):not(.show-installed).hide-title .ag-card-display-overlay {
    display: none;
}

/* Platforms toggle: hide the existing platform badge strip */
#allGamesGrid.hide-platforms .agc-badges-strip {
    display: none !important;
}

/* Compact cards: keep overlay smaller */
#allGamesGrid.density-compact .ag-card-display-overlay {
    padding: 22px 7px 7px;
    gap: 4px;
}

#allGamesGrid.density-compact .ag-card-display-title {
    font-size: 11px;
}

#allGamesGrid.density-compact .ag-card-field {
    font-size: 9px;
    padding: 3px 5px;
}

/* In All Games tab, the new overlay (.ag-card-display-overlay) is the
   single source of truth for title/playtime/lastPlayed/installed.
   Hide the legacy .gc-info to avoid duplicated title text. */
#allGamesGrid .gc-info {
    display: none !important;
}
/* =================================================================== */
/* ALL GAMES — EMPTY ONBOARDING STATE                                  */
/* =================================================================== */

/* ── Toolbar hidden when no accounts linked ──────────────────────── */
.ag-toolbar-hidden {
    display: none !important;
}

/* ================================================================= */
/* ALL GAMES — EMPTY ONBOARDING: scoped to #allGamesGrid.ag-empty-mode */
/* ================================================================= */

/* Disable scroll on the main scroll container when in empty onboarding */
#mainContentArea.ag-no-scroll-empty {
    overflow-y: hidden !important;
}

/* All Games view: fill available height, no overflow */
#allGamesView.ag-empty-page {
    height: 100%;
    min-height: 0;
    overflow: hidden;
    flex-direction: column;
}

/* Hide toolbar in empty onboarding */
#allGamesView.ag-empty-page #agToolbarSticky {
    display: none !important;
}

/* Grid container in empty-mode: flex-fill, centred, no scroll */
#allGamesGrid.ag-empty-mode {
    flex: 1 1 auto;
    min-height: 0 !important;
    height: auto !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    width: 100% !important;
    max-width: none !important;
    grid-template-columns: none !important;
    gap: 0 !important;

    padding: 16px 32px 48px !important;
    overflow: visible !important;
    position: static !important;
    box-sizing: border-box !important;
}

/* Panel itself: no transform, no clipping */
#allGamesGrid.ag-empty-mode .ag-empty-onboarding {
    width: min(760px, 100%);
    max-width: 760px;
    max-height: none !important;
    margin: 0 auto;
    transform: none !important;
    box-sizing: border-box;
    overflow: visible !important;
}

/* ── Onboarding panel internals ───────────────────────────────────── */
.ag-empty-onboarding {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 32px 40px;
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    /* Very subtle green glow — not neon */
    background: radial-gradient(
        ellipse 65% 50% at 50% 52%,
        rgba(0, 200, 90, 0.045) 0%,
        transparent 70%
    );
}

/* ── Heading & sub-text ───────────────────────────────────────────── */
.ag-empty-heading {
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.01em;
    margin-bottom: 10px;
    text-align: center;
    position: relative;
}

.ag-empty-sub {
    font-family: var(--font-main);
    font-size: 0.88rem;
    color: var(--text-sec);
    text-align: center;
    max-width: 380px;
    line-height: 1.55;
    margin-bottom: 36px;
    position: relative;
}

/* ── Platform cards row ───────────────────────────────────────────── */
.ag-platform-cards {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
}

.ag-platform-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    width: 230px;
    padding: 22px 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    transition:
        background-color 0.18s ease,
        border-color 0.18s ease,
        transform 0.18s ease;
    cursor: default;
}

.ag-platform-card:hover {
    background: rgba(255, 255, 255, 0.065);
    border-color: rgba(0, 210, 100, 0.22);
    transform: translateY(-2px);
}

/* ── Card logo row ────────────────────────────────────────────────── */
.ag-pc-logo {
    display: flex;
    align-items: center;
    gap: 9px;
}

.ag-pc-logo img {
    width: 26px;
    height: 26px;
    object-fit: contain;
    flex-shrink: 0;
}

.ag-pc-logo img.ag-pc-invert {
    filter: brightness(0) invert(1);
    opacity: 0.85;
}

.ag-pc-platform-name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
}

/* ── Card description ─────────────────────────────────────────────── */
.ag-pc-desc {
    font-size: 0.78rem;
    color: var(--text-sec);
    line-height: 1.5;
    flex: 1;
}

/* ── CTA button — dark pill, subtle green border ─────────────────── */
.ag-pc-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(0, 210, 100, 0.90);
    background: rgba(0, 210, 100, 0.07);
    border: 1px solid rgba(0, 210, 100, 0.28);
    border-radius: 20px;
    cursor: pointer;
    transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease;
    font-family: var(--font-main);
    white-space: nowrap;
    margin-top: 4px;
}

.ag-pc-btn:hover {
    background: rgba(0, 210, 100, 0.13);
    border-color: rgba(0, 210, 100, 0.5);
    color: rgb(0, 220, 108);
}

.ag-pc-btn svg {
    flex-shrink: 0;
}

/* ── Secondary "Manage Accounts" link ────────────────────────────── */
.ag-empty-manage {
    margin-top: 28px;
    font-size: 0.78rem;
    color: #444;
    display: flex;
    align-items: center;
    gap: 6px;
    position: relative;
}

.ag-empty-manage button {
    background: none;
    border: none;
    cursor: pointer;
    color: #666;
    font-size: 0.78rem;
    font-family: var(--font-main);
    padding: 0;
    text-decoration: underline;
    text-decoration-color: rgba(255,255,255,0.15);
    transition: color 0.15s;
}

.ag-empty-manage button:hover {
    color: #aaa;
}

/* ============================================================
   ALL GAMES TOOLBAR — TWO-ROW RESPONSIVE LAYOUT
   Overrides accounts.css where needed with !important
   ============================================================ */

/* Toolbar: stack as column of rows, full width */
#agToolbarSticky .ag-toolbar {
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
    padding: 8px 0 6px !important;
    flex-wrap: nowrap !important;
    align-items: stretch !important;
    width: 100% !important;
}

/* Each row is a horizontal flex line */
.ag-toolbar-row {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    min-width: 0;
}

/* ROW 1: Search fills remaining space, controls stay right */
.ag-toolbar-row--top {
    flex-wrap: nowrap;
}

.ag-toolbar-row--top .ag-search-wrap {
    flex: 1 1 0;
    min-width: 80px;
    max-width: 260px;
}

.ag-toolbar-row--top .ag-controls-group {
    flex-shrink: 0;
    display: flex !important;
    align-items: center;
    gap: 5px;
    flex-wrap: nowrap;
    margin-left: auto;
}

/* ROW 2: Filters row — pills may wrap but account+installed stay together */
.ag-toolbar-row--filters {
    flex-wrap: wrap;
}

.ag-toolbar-row--filters .ag-filter-group {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 5px 6px;
    min-width: 0;
    flex: 1 1 auto;
}

.ag-filter-pills {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    flex-wrap: nowrap;
}

/* Search box */
#agToolbarSticky .ag-search-wrap {
    display: flex !important;
    align-items: center;
    gap: 5px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 7px;
    padding: 0 10px;
    height: 32px;
    min-width: 0;
    overflow: hidden;
}

#agToolbarSticky .ag-search-wrap svg { flex-shrink: 0; opacity: 0.4; }

#agToolbarSticky .ag-search-input {
    flex: 1 1 0;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    color: var(--text-primary, #eee);
    font-size: 0.8rem;
}

/* Account dropdown: constrained width + ellipsis */
.ag-toolbar-row--filters .ag-account-dropdown {
    min-width: 90px;
    max-width: 150px;
    flex-shrink: 1;
}

.ag-account-trigger {
    display: flex !important;
    align-items: center;
    gap: 5px;
    overflow: hidden;
    white-space: nowrap;
    min-width: 0;
    padding: 5px 12px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #aaa;
    background: rgba(255,255,255,0.05);
    border: 1.5px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    cursor: pointer;
    transition: color 0.12s, background-color 0.12s, border-color 0.12s;
}

.ag-account-trigger:hover {
    color: #fff;
    background: rgba(255,255,255,0.09);
    border-color: rgba(255,255,255,0.25);
}

.ag-account-trigger > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
}

/* Display panel: opens UPWARD so it's never clipped */
#agToolbarSticky .ag-display-dropdown {
    position: relative;
}

#agToolbarSticky .ag-display-panel {
    position: absolute !important;
    right: 0 !important;
    top: calc(100% + 6px) !important;
    bottom: auto !important;
    z-index: 300;
}

/* Result count: don't wrap */
#agToolbarSticky .ag-result-count {
    white-space: nowrap;
    font-size: 0.75rem;
    color: #555;
    flex-shrink: 0;
}

/* Header: All Games title + actions — never overlap */
#allGamesView .library-header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    flex-wrap: wrap !important;
    gap: 8px 14px !important;
    min-width: 0 !important;
}

#allGamesView .library-header .section-title {
    white-space: nowrap;
    flex-shrink: 0;
    min-width: 0;
}

#allGamesView .library-header .header-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-left: auto;
}
/* ============================================================
   All Games toolbar – responsive fix for account + installed
   ============================================================ */
#allGamesView .ag-toolbar-row--filters .ag-filter-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    width: 100%;
    min-width: 0;
}
#allGamesView .ag-filter-pills {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1 1 auto;
    min-width: 0;
    flex-wrap: wrap;
}
#allGamesView .ag-filter-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 0 0 auto;
    margin-left: auto;
    min-width: 0;
}
#allGamesView .ag-filter-actions .ag-account-dropdown {
    flex: 0 1 150px;
    min-width: 90px;
    max-width: 150px;
}
#allGamesView .ag-filter-actions .ag-account-trigger {
    height: 30px;
    min-width: 0;
}
#allGamesView .ag-filter-actions .ag-installed-toggle {
    flex: 0 0 auto;
    height: 30px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
/* When there is not enough horizontal space, put account+installed together on a clean second row */
@media (max-width: 720px) {
    #allGamesView .ag-filter-actions {
        width: 100%;
        margin-left: 0;
        justify-content: flex-start;
    }
    #allGamesView .ag-filter-actions .ag-account-dropdown {
        flex: 1 1 auto;
        max-width: none;
    }
}
/* Very small launcher width: keep the Installed button visible but compact */
@media (max-width: 520px) {
    #allGamesView .ag-filter-actions {
        flex-wrap: nowrap;
    }
    #allGamesView .ag-filter-actions .ag-account-dropdown {
        min-width: 0;
    }
    #allGamesView .ag-filter-actions .ag-installed-toggle {
        width: 32px;
        min-width: 32px;
        padding: 0;
        font-size: 0;
        gap: 0;
    }
    #allGamesView .ag-filter-actions .ag-installed-toggle svg {
        width: 13px;
        height: 13px;
    }
}

/* ============================================================
   Installed Games List - Comfortable spacing fix
   Fix image/title collision in #igListView
============================================================ */

/* Base installed list row/header columns */
#igListView .ag-list-header,
#igListView .ag-list-row {
    grid-template-columns: 58px minmax(0, 1fr) 140px 100px 120px 36px !important;
}

/* Make thumb column centered and non-overflowing */
#igListView .ag-col-thumb {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    padding-right: 12px !important;
    overflow: visible !important;
}

/* Keep title safely away from image */
#igListView .ag-col-title {
    min-width: 0 !important;
    padding-left: 8px !important;
}

#igListView .ag-col-title-text {
    display: block !important;
    min-width: 0 !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
}

/* Compact */
#igListView.density-compact .ag-list-header,
#igListView.density-compact .ag-list-row {
    grid-template-columns: 32px minmax(0, 1fr) 140px 100px 120px 36px !important;
}

#igListView.density-compact .ag-col-title {
    padding-left: 6px !important;
}

/* Normal */
#igListView.density-normal .ag-list-header,
#igListView.density-normal .ag-list-row {
    grid-template-columns: 46px minmax(0, 1fr) 110px 100px 120px 36px !important;
}

#igListView.density-comfortable .ag-list-header,
#igListView.density-comfortable .ag-list-row {
    grid-template-columns: 58px minmax(0, 1fr) 110px 100px 120px 36px !important;
}

#igListView.density-comfortable .ag-col-thumb {
    padding-right: 8px !important;
}

#igListView.density-comfortable .ag-col-title {
    padding-left: 2px !important;
}

/* ── Update badge pulse animation ── */
@keyframes badgePulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

/* ── Analytics consent overlay ── */
@keyframes consentSlideIn {
    from { opacity: 0; transform: translateY(20px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
}

.consent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    margin-bottom: 30px;
}

.consent-list-item {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
}

/* ========================================= */
/* COMMUNITY HUB                             */
/* ========================================= */

/* Help & Feedback dropdown — must opt out of title-bar drag region */
.help-dropdown-wrap,
.help-dropdown-wrap *,
.help-dropdown-menu,
.help-dropdown-menu *,
.help-dropdown-item {
    -webkit-app-region: no-drag;
}

.help-dropdown-wrap {
    position: relative;
    z-index: 100200;
    pointer-events: auto;
}

.help-dropdown-chevron {
    margin-left: 2px;
    opacity: 0.6;
    transition: transform 0.2s;
}

.help-dropdown-menu {
    display: none;
    position: fixed;
    min-width: 190px;
    background: #181818;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.55);
    z-index: 100250;
    padding: 5px;
    pointer-events: auto;
    -webkit-app-region: no-drag;
}
.help-dropdown-menu.active {
    display: block;
    pointer-events: auto;
    animation: helpDropdownIn 0.15s ease;
}

@keyframes helpDropdownIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
}

.help-dropdown-item {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.7);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 9px 11px;
    border-radius: 7px;
    cursor: pointer;
    text-align: left;
    transition: background 0.12s, color 0.12s;
    white-space: nowrap;
    pointer-events: auto;
    -webkit-app-region: no-drag;
    position: relative;
    z-index: 100260;
}
.help-dropdown-item:hover {
    background: rgba(255,255,255,0.07);
    color: #fff;
}
.help-dropdown-item--community {
    color: rgba(160,180,255,0.85);
}
.help-dropdown-item--community:hover {
    color: #c4cdff;
    background: rgba(88,101,242,0.12);
}

/* Modal overlay — same base as .settings-overlay */
.community-overlay {
    z-index: 10000;
}

.community-modal-box {
    background: #111;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 32px 32px 28px;
    max-width: 680px;
    width: 90%;
    max-height: 88vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 24px 60px rgba(0,0,0,0.7);
    animation: communitySlideIn 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes communitySlideIn {
    from { opacity: 0; transform: translateY(16px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0)    scale(1);    }
}

.community-close-btn {
    position: absolute;
    top: 16px; right: 16px;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.4);
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    transition: color 0.15s, background 0.15s;
}
.community-close-btn:hover { color: #fff; background: rgba(255,255,255,0.08); }

.community-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 28px;
}

.community-icon-wrap {
    width: 52px; height: 52px;
    border-radius: 14px;
    background: rgba(18, 206, 24, 0.08);
    border: 1px solid rgba(18, 206, 24, 0.18);
    display: flex; align-items: center; justify-content: center;
    color: #12ce18;
    margin-bottom: 14px;
}

.community-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 8px;
}

.community-subtitle {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.6;
    max-width: 460px;
    margin: 0;
}

/* Cards grid — 2 col desktop, 1 col narrow */
.community-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    align-items: stretch;
}

/* Last card is odd (5th) — span full width to avoid an awkward half-row */
.community-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
}

@media (max-width: 720px) {
    .community-cards-grid { grid-template-columns: 1fr; }
    .community-card:last-child:nth-child(odd) { grid-column: auto; }
}
@media (max-width: 520px) {
    .community-modal-box { padding: 22px 18px 20px; }
}

.community-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 140px;
    transition: border-color 0.18s, background 0.18s;
}
.community-card:hover {
    border-color: rgba(255,255,255,0.14);
    background: rgba(255,255,255,0.055);
}
.community-card--primary {
    border-color: rgba(88, 101, 242, 0.35);
    background: rgba(88, 101, 242, 0.06);
}
.community-card--primary:hover {
    border-color: rgba(88, 101, 242, 0.55);
    background: rgba(88, 101, 242, 0.1);
}

.community-card-header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    flex: 1;
    margin-bottom: 14px;
}

.community-card-icon {
    width: 38px; height: 38px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.community-card-icon--discord  { background: rgba(88,101,242,0.15); color: #7289da; }
.community-card-icon--instagram { background: rgba(225,48,108,0.12); color: #e1306c; }
.community-card-icon--x        { background: rgba(255,255,255,0.07); color: #fff; }
.community-card-icon--linkedin  { background: rgba(10,102,194,0.15); color: #0a66c2; }
.community-card-icon--tiktok   { background: rgba(255,0,80,0.1);    color: #ff0050; }

.community-card-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: #fff;
    margin: 0 0 4px;
    line-height: 1.3;
}
.community-card-desc {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.45);
    margin: 0;
    line-height: 1.45;
}

.community-card-btn {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    color: rgba(255,255,255,0.8);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 8px 12px;
    cursor: pointer;
    width: 100%;
    text-align: center;
    margin-top: auto;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
}
.community-card-btn:hover {
    background: rgba(255,255,255,0.11);
    border-color: rgba(255,255,255,0.2);
    color: #fff;
}
.community-card-btn--discord {
    background: rgba(88,101,242,0.18);
    border-color: rgba(88,101,242,0.35);
    color: #a5abf7;
}
.community-card-btn--discord:hover {
    background: rgba(88,101,242,0.3);
    border-color: rgba(88,101,242,0.55);
    color: #fff;
}

/* Settings social icon row */
.community-social-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}
.community-social-icon-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    color: rgba(255,255,255,0.55);
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    padding: 0;
}
.community-social-icon-btn:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.22);
    color: #fff;
}

.consent-list-item:last-child { margin-bottom: 0; }

/* ── What's New / Update Notes Modal ─────────────────────────────────────── */
.update-notes-modal {
    position: fixed; inset: 0; z-index: 200000;
    display: none; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.62); backdrop-filter: blur(12px);
}
.update-notes-modal.active { display: flex; }
.update-notes-dialog {
    width: min(660px, calc(100vw - 32px));
    background: #151515; border: 1px solid rgba(255,255,255,0.12);
    border-radius: 22px; padding: 36px 32px 32px;
    box-shadow: 0 24px 80px rgba(0,0,0,0.58);
    position: relative; color: #fff; text-align: center;
    max-height: calc(100vh - 48px); overflow-y: auto;
}
.update-notes-dialog .modal-close {
    position: absolute; top: 16px; right: 18px;
    background: none; border: none; color: rgba(255,255,255,0.4);
    font-size: 1.1rem; cursor: pointer; line-height: 1;
    transition: color 0.15s;
}
.update-notes-dialog .modal-close:hover { color: #fff; }
.update-notes-icon {
    font-size: 2.4rem; margin-bottom: 14px; display: block;
}
.update-notes-dialog h2 {
    font-size: 1.25rem; font-weight: 700; margin: 0 0 8px; color: #fff;
}
.update-notes-dialog > p:first-of-type {
    font-size: 0.9rem; color: rgba(255,255,255,0.55); margin: 0 0 22px;
}
.update-notes-list {
    text-align: left; display: flex; flex-direction: column; gap: 14px;
    margin-bottom: 22px;
}
.update-notes-item {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09);
    border-radius: 12px; padding: 14px 16px;
}
.update-notes-item-title {
    font-size: 0.875rem; font-weight: 600; color: #fff; margin: 0 0 4px;
}
.update-notes-item-desc {
    font-size: 0.8rem; color: rgba(255,255,255,0.5); margin: 0; line-height: 1.45;
}
.update-notes-footer {
    font-size: 0.78rem; color: rgba(255,255,255,0.35); margin: 0 0 20px;
}
.update-notes-primary-btn {
    background: linear-gradient(135deg, #22c55e, #16a34a);
    box-shadow: 0 0 24px rgba(34, 197, 94, 0.28);
    border: none; border-radius: 10px; color: #fff;
    font-size: 0.9rem; font-weight: 600; padding: 11px 32px;
    cursor: pointer; transition: background 0.2s, box-shadow 0.2s, transform 0.1s;
    display: block; width: 100%;
    outline-offset: 3px;
}
.update-notes-primary-btn:hover {
    background: linear-gradient(135deg, #34d399, #22c55e);
    box-shadow: 0 0 32px rgba(34, 197, 94, 0.38);
}
.update-notes-primary-btn:focus-visible {
    outline: 2px solid #22c55e;
}
.update-notes-primary-btn:active { transform: scale(0.98); }

/* Featured two-card row (primary features) */
.update-notes-featured-row {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
}
/* Smaller feature cards grid (secondary features) */
.update-notes-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
}
/* Large highlighted card — overrides .update-notes-item base */
.update-notes-featured-card {
    border-color: rgba(34, 197, 94, 0.3); background: rgba(34, 197, 94, 0.06); padding: 18px;
}
/* Smaller card — tighter padding than base .update-notes-item */
.update-notes-grid-card {
    padding: 12px 14px;
}
/* Eyebrow label on featured cards — small, muted, uppercase */
.update-notes-featured-card .update-notes-item-title {
    font-size: 0.72rem; font-weight: 600; color: rgba(255,255,255,0.4);
    text-transform: uppercase; letter-spacing: 0.07em; margin: 0 0 5px;
}
/* Feature headline — the main benefit statement */
.update-notes-item-headline {
    font-size: 0.95rem; font-weight: 700; color: #22c55e;
    margin: 0 0 6px; line-height: 1.3;
}
/* Description in featured cards — slightly brighter than base */
.update-notes-featured-card .update-notes-item-desc {
    font-size: 0.82rem; color: rgba(255,255,255,0.6);
}
/* Helper / best-for line */
.update-notes-item-helper {
    font-size: 0.72rem; color: rgba(255,255,255,0.28);
    margin: 8px 0 0; line-height: 1.4; font-style: italic;
}
/* Stack cards on narrow screens */
@media (max-width: 560px) {
    .update-notes-featured-row,
    .update-notes-grid { grid-template-columns: 1fr; }
}

/* ── Feature tour slider (type: feature-tour) ───────────────────────────────── */
.update-notes-dialog.tour-mode {
    width: min(880px, calc(100vw - 32px));
    padding: 0; overflow: hidden; text-align: left;
}
.update-notes-dialog.tour-mode .modal-close {
    z-index: 10; background: rgba(0,0,0,0.4);
    border-radius: 50%; width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
}
.un-tour { display: flex; flex-direction: column; margin: 0; gap: 0; }
.un-tour-slides { position: relative; }
.un-tour-slide {
    display: none; flex-direction: row; min-height: 360px;
}
.un-tour-slide.active { display: flex; }
.un-tour-text {
    flex: 0 0 42%; padding: 36px 36px 32px 36px;
    display: flex; flex-direction: column; justify-content: center;
}
.un-tour-image {
    flex: 0 0 58%; background: #0e0e0e;
    border-left: 1px solid rgba(255,255,255,0.07);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
}
.un-tour-img {
    width: 100%; height: 100%; object-fit: cover; display: block;
}
.un-tour-img-placeholder {
    width: 100%; height: 100%; min-height: 360px;
    background: linear-gradient(135deg, #1c1c1c 0%, #101010 100%);
}
.un-tour-label {
    font-size: 0.68rem; font-weight: 700; color: #22c55e;
    text-transform: uppercase; letter-spacing: 0.1em;
    display: block; margin-bottom: 10px;
}
.un-tour-headline {
    font-size: 1.5rem; font-weight: 800; color: #fff;
    margin: 0 0 12px; line-height: 1.2;
}
.un-tour-desc {
    font-size: 0.875rem; color: rgba(255,255,255,0.62);
    margin: 0 0 16px; line-height: 1.6;
}
.un-tour-badge {
    display: inline-block;
    background: rgba(34,197,94,0.12); border: 1px solid rgba(34,197,94,0.35);
    color: #22c55e; font-size: 0.8rem; font-weight: 600; font-family: monospace;
    padding: 5px 12px; border-radius: 7px; margin-bottom: 16px;
    letter-spacing: 0.03em;
}
.un-tour-helper {
    font-size: 0.78rem; color: rgba(255,255,255,0.32);
    margin: 0; line-height: 1.5; font-style: italic;
}
.un-tour-nav {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 14px 24px 18px;
    background: #0f0f0f; border-radius: 0 0 22px 22px;
    display: flex; flex-direction: column; gap: 10px;
}
.un-tour-dots {
    display: flex; gap: 7px; justify-content: center; align-items: center;
}
.un-tour-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(255,255,255,0.15); cursor: pointer;
    transition: background 0.2s, transform 0.2s; border: none;
    display: inline-block;
}
.un-tour-dot.active { background: #22c55e; transform: scale(1.35); }
.un-tour-controls {
    display: flex; align-items: center; justify-content: space-between;
}
.un-tour-counter {
    font-size: 0.75rem; color: rgba(255,255,255,0.28);
    font-variant-numeric: tabular-nums;
}
.un-tour-btn-group { display: flex; gap: 8px; }
.un-tour-back {
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.55); font-size: 0.85rem; font-weight: 500;
    padding: 8px 22px; border-radius: 9px; cursor: pointer;
    transition: background 0.15s, color 0.15s;
}
.un-tour-back:hover:not(:disabled) { background: rgba(255,255,255,0.1); color: #fff; }
.un-tour-back:disabled { opacity: 0.28; cursor: default; }
.un-tour-next {
    background: linear-gradient(135deg, #22c55e, #16a34a);
    box-shadow: 0 0 18px rgba(34,197,94,0.22);
    border: none; color: #fff; font-size: 0.85rem; font-weight: 600;
    padding: 8px 26px; border-radius: 9px; cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s;
    min-width: 96px;
}
.un-tour-next:hover {
    background: linear-gradient(135deg, #34d399, #22c55e);
    box-shadow: 0 0 26px rgba(34,197,94,0.32);
}
.un-tour-next:active { transform: scale(0.98); }
@media (max-width: 640px) {
    .un-tour-slide { flex-direction: column-reverse; min-height: auto; }
    .un-tour-text { flex: none; padding: 28px 24px 18px; }
    .un-tour-image { flex: none; min-height: 200px; border-left: none;
        border-top: 1px solid rgba(255,255,255,0.07); }
    .un-tour-img-placeholder { min-height: 200px; }
    .un-tour-headline { font-size: 1.2rem; }
}

/* Tour header — icon + title + subtitle above the slide area */
.un-tour-header {
    display: none;
    align-items: center;
    gap: 14px;
    padding: 18px 52px 16px 22px; /* right: 52px clears the X close button */
    border-bottom: 1px solid rgba(255,255,255,0.07);
}
.update-notes-dialog.tour-mode .un-tour-header { display: flex; }
.un-tour-header-icon {
    flex-shrink: 0;
    width: 40px; height: 40px;
    border-radius: 10px;
    background: rgba(34,197,94,0.1);
    border: 1px solid rgba(34,197,94,0.22);
    display: flex; align-items: center; justify-content: center;
}
.un-tour-header-title {
    font-size: 0.95rem; font-weight: 700; color: #fff;
    margin: 0 0 3px; line-height: 1.3;
}
.un-tour-header-subtitle {
    font-size: 0.73rem; color: rgba(255,255,255,0.38);
    margin: 0; line-height: 1.4;
}
/* Hide old card-layout elements in tour mode (belt-and-suspenders alongside JS) */
.update-notes-dialog.tour-mode .update-notes-icon,
.update-notes-dialog.tour-mode #updateNotesTitle,
.update-notes-dialog.tour-mode #updateNotesSubtitle,
.update-notes-dialog.tour-mode #updateNotesFooter,
.update-notes-dialog.tour-mode .update-notes-primary-btn { display: none !important; }

/* ================================================================ */
/* SIDEBAR v2 — Glass panels redesign                               */
/* ================================================================ */

/* Sidebar nav content — no scroll; content must fit without scrolling */
.sidebar-scroll-content {
    flex: 1;
    min-height: 0;
    overflow: hidden;
}

/* ── Status bar ── */
.sidebar-status {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    margin-bottom: 14px;
    font-size: 0.68rem;
    color: rgba(255,255,255,0.35);
    letter-spacing: 0.3px;
    flex-grow: 0;   /* must not expand in the sidebar flex column */
    flex-shrink: 0;
}
.sidebar.collapsed .sidebar-status { display: none; }

.sidebar-status-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
    flex-shrink: 0;
    animation: sbStatusPulse 3s ease-in-out infinite;
}
@keyframes sbStatusPulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.5; }
}

/* ── Section HUD label ── */
.sidebar-section-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.18);
    text-transform: uppercase;
    padding: 0 14px;
    margin: 8px 0 6px;
}
.sidebar.collapsed .sidebar-section-label { display: none; }

/* ── Library badge on section header ── */
.sidebar-nav-badge {
    margin-left: auto;
    font-size: 0.62rem;
    font-weight: 700;
    color: rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.06);
    border-radius: 20px;
    padding: 1px 7px;
    letter-spacing: 0.3px;
}
.sidebar.collapsed .sidebar-nav-badge { display: none; }

/* ── Glass panel base ── */
.sidebar-panel {
    margin: 10px 0 0;
    border-radius: 10px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    padding: 12px;
    overflow: hidden;
}
.sidebar.collapsed .sidebar-panel { display: none !important; }

.sidebar-panel-label {
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.2);
    text-transform: uppercase;
    margin-bottom: 10px;
}

/* ── 01 Jump Back In card ── */
.jump-back-card { padding: 10px; }

.jb-inner {
    border-radius: 8px;
    height: 88px;
    background: #1a1a1a;
    background-size: cover;
    background-position: center;
    position: relative;
    overflow: hidden;
    cursor: pointer;
}
.jb-inner:hover .jb-overlay { background: rgba(0,0,0,0.55); }
.jb-inner:hover .jb-play { opacity: 1; transform: scale(1); }

.jb-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.3) 60%, transparent 100%);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 8px 10px;
    transition: background 0.15s;
}

.jb-info { flex: 1; min-width: 0; }

.jb-platform {
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 2px;
}

.jb-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
}

.jb-meta {
    font-size: 0.62rem;
    color: rgba(255,255,255,0.5);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.jb-play {
    flex-shrink: 0;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--accent);
    border: none;
    color: #000;
    font-size: 0.65rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.15s, transform 0.15s;
    margin-left: 8px;
}
.jb-play:hover { background: #4ade80; }

/* ── 02 Active Accounts card ── */
.active-account-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 4px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.12s;
    font-size: 0.75rem;
}
.active-account-row:hover { background: rgba(255,255,255,0.06); }

.acc-plat-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
}

.acc-plat-name {
    color: rgba(255,255,255,0.75);
    font-weight: 500;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.acc-plat-count {
    font-size: 0.65rem;
    color: rgba(255,255,255,0.3);
    font-weight: 600;
}

.acc-status-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    box-shadow: 0 0 4px var(--accent);
}

/* ── 03 Library Pulse card ── */
.sidebar-pulse-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.sidebar-metric {
    background: rgba(255,255,255,0.04);
    border-radius: 7px;
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.sidebar-metric-value {
    font-size: 1.2rem;
    font-weight: 800;
    color: #fff;
    line-height: 1;
    font-family: var(--font-heading, sans-serif);
}

.sidebar-metric-label {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: rgba(255,255,255,0.3);
    text-transform: uppercase;
}

/* ================================================================ */
/* BADDEL SMART SIDEBAR — v3                                        */
/* ================================================================ */

/* Hide the compatibility layer — IDs exist for JS but never shown */
.baddel-compat-layer {
    display: none !important;
    position: absolute;
    left: -9999px;
    width: 0;
    height: 0;
    overflow: hidden;
}

/* Status row with platform dots */
.baddel-sidebar-status {
    display: flex;
    align-items: center;
    gap: 6px;
}

.baddel-plat-dots {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
}

.baddel-plat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    opacity: 0.85;
}
.sidebar.collapsed .baddel-plat-dots { display: none; }

/* Panel base — override any old display:none */
.baddel-sidebar-panel {
    display: block !important;
    margin-top: 12px;
}

/* Jump Back In empty state */
.jb-empty-msg {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.25);
    text-align: center;
    padding: 12px 0;
    letter-spacing: 0.3px;
}

/* Active accounts placeholder */
.baddel-acc-placeholder {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.25);
    text-align: center;
    padding: 10px 0;
    letter-spacing: 0.3px;
}

/* Active account row */
.baddel-acc-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 4px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.12s;
}
.baddel-acc-row:hover { background: rgba(255,255,255,0.06); }

.baddel-acc-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
}

.baddel-acc-name {
    font-size: 0.74rem;
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.baddel-acc-count {
    font-size: 0.64rem;
    color: rgba(255,255,255,0.3);
    font-weight: 600;
}

.baddel-acc-live {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    box-shadow: 0 0 4px var(--accent);
}

/* Library Pulse — ensure 2x2 grid with 4 tiles */
#sidebarLibraryPulse .sidebar-pulse-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

/* Collections panel */
.baddel-sidebar-collections .add-coll-btn {
    margin-top: 10px;
    width: 100%;
}

/* Collection items inside sidebar panel */
.baddel-sidebar-collections #collectionsList .nav-item {
    height: 36px;
    border-radius: 7px;
    margin-bottom: 2px;
    padding: 0 10px;
    font-size: 0.8rem;
}

/* Sidebar nav badge — green accent when active */
.nav-item.active .sidebar-nav-badge {
    background: rgba(18, 206, 24, 0.15);
    color: var(--accent);
}

/* Collapsed sidebar: hide panels entirely */
.sidebar.collapsed .baddel-sidebar-panel { display: none !important; }

/* ================================================================ */
/* SIDEBAR POLISH — v4                                              */
/* ================================================================ */

/* 1. Sidebar width is controlled by --sidebar-width (280px) in :root.
      The base .sidebar rule already uses the variable with min/max-width locks. */

/* 2. Compact, premium nav items with correct font size */
.nav-item {
    height: 40px;
    font-size: 0.82rem;
    gap: 10px;
    margin-bottom: 2px;
}

/* 3. Active accent bar — green glow only, no white bleed */
.nav-item.active::before {
    box-shadow: 0 0 5px rgba(18,206,24,0.5);
}

/* 4. Status dot — true brand green (#12CE18), not inherited white --accent */
.sidebar-status-dot {
    background: #12CE18;
    box-shadow: 0 0 5px rgba(18,206,24,0.55);
}

/* 5. Nav count badge — slightly more readable, doesn't shrink */
.sidebar-nav-badge {
    color: rgba(255,255,255,0.5);
    background: rgba(255,255,255,0.09);
    flex-shrink: 0;
}

/* 6. Jump Back In — darker gradient so bright artwork doesn't bleed */
.jb-overlay {
    background: linear-gradient(
        to top,
        rgba(0,0,0,0.92) 0%,
        rgba(0,0,0,0.62) 45%,
        rgba(0,0,0,0.28) 100%
    );
}

/* 7. Jump Back In play button — brand green */
.jb-play { background: #12CE18; color: #000; }
.jb-play:hover { background: #0fb316; }

/* 8. Active account live indicator — brand green */
.baddel-acc-live {
    background: #12CE18;
    box-shadow: 0 0 4px rgba(18,206,24,0.55);
}

/* 9. Empty Active Accounts panel — hidden entirely by JS adding this class */
.baddel-sidebar-panel.baddel-hidden { display: none !important; }

/* 10. Library Pulse metric value — slightly more compact */
.sidebar-metric-value { font-size: 1.05rem; }

/* 11. Collections list items — compact */
.baddel-sidebar-collections #collectionsList .nav-item {
    height: 34px;
    font-size: 0.78rem;
    margin-bottom: 1px;
}

/* ================================================================ */
/* SIDEBAR HYBRID — section-based redesign                          */
/* ================================================================ */

/* ── Section headers (LIBRARY / ACCOUNTS / MANAGE) ── */
.sb-section-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    height: 28px;
    margin-top: 14px;
    margin-bottom: 2px;
    cursor: pointer;
    user-select: none;
}
.sb-sec-static { cursor: default; }

.sb-sec-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.22);
    text-transform: uppercase;
    flex: 1;
}

.sb-sec-chevron {
    color: rgba(255,255,255,0.2);
    transition: transform 0.18s ease;
    flex-shrink: 0;
}
.sb-chevron-closed { transform: rotate(-90deg); }

.sb-section-header:hover .sb-sec-label { color: rgba(255,255,255,0.38); }
.sb-section-header:hover .sb-sec-chevron { color: rgba(255,255,255,0.35); }
.sb-sec-static:hover .sb-sec-label,
.sb-sec-static:hover .sb-sec-chevron { color: rgba(255,255,255,0.22); }

.sidebar.collapsed .sb-section-header { display: none; }

/* ── Section body ── */
.sb-section-body {
    margin-bottom: 2px;
}
/* Collapsed mode: show icon-only for EXPANDED sections; keep CLOSED sections hidden */
.sidebar.collapsed .sb-section-body:not(.sb-sec-closed) { display: block; }
.sidebar.collapsed .sb-section-body.sb-sec-closed { display: none !important; }

/* ── Sub-items (indented nav items inside sections) ── */
.nav-item.sb-sub-item {
    height: 36px;
    padding: 0 10px 0 12px;
    font-size: 0.8rem;
    margin-bottom: 1px;
    border-radius: 8px;
}
.nav-item.sb-sub-item .nav-icon {
    width: 18px;
    height: 18px;
}

/* ── Platform count in accounts section ── */
.sb-section-body .platform-count {
    font-size: 0.64rem;
    color: rgba(255,255,255,0.3);
    font-weight: 700;
    margin-left: auto;
    background: rgba(255,255,255,0.06);
    padding: 1px 6px;
    border-radius: 20px;
}
.nav-item.platform-item.active .platform-count {
    color: rgba(255,255,255,0.7);
    background: rgba(255,255,255,0.12);
}

/* ── collectionsList items in LIBRARY section body ── */
#sbBodyLibrary #collectionsList .nav-item {
    height: 34px;
    font-size: 0.78rem;
    padding: 0 10px 0 12px;
    border-radius: 7px;
    margin-bottom: 1px;
}

/* ── Sidebar collection dot icon ── */
.sb-coll-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255,255,255,0.28);
    flex-shrink: 0;
}
.nav-item.sb-coll-item.active .sb-coll-dot { background: #12CE18; }

/* ── Context action button (bottom of sidebar) ── */
.sb-ctx-btn {
    flex-shrink: 0;
    margin: 8px 0 0;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.5);
    padding: 10px 12px;
    border-radius: 9px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: 0.8rem;
    font-weight: 500;
    transition: border-color 0.12s, color 0.12s, background 0.12s;
}
.sb-ctx-btn:hover {
    border-color: rgba(255,255,255,0.25);
    color: #fff;
    background: rgba(255,255,255,0.05);
}
.sidebar.collapsed .sb-ctx-btn { display: none; }

/* ================================================================ */
/* Stable allGamesView header — prevent layout shift on mode switch */
/* ================================================================ */

#allGamesView .library-section { padding-top: 20px; }

#allGamesView .library-header {
    min-height: 44px;
    align-items: center;
    margin-bottom: 18px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
}

#agToolbarSticky { min-height: 72px; }

/* Result count always occupies space so the row never jumps */
.ag-result-count {
    min-width: 72px;
    display: inline-flex;
    justify-content: flex-end;
    white-space: nowrap;
}

/* ── Collections page ── */
.collections-page { padding-bottom: 40px; }

.collections-hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 28px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 22px;
    background:
        radial-gradient(circle at 10% 0%, rgba(18,206,24,0.12), transparent 34%),
        linear-gradient(135deg, rgba(255,255,255,0.055), rgba(255,255,255,0.025));
    margin-bottom: 18px;
}

.collections-eyebrow {
    color: #12ce18;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    margin: 0 0 8px;
    text-transform: uppercase;
}

.collections-hero-title {
    margin: 0;
    font-size: 34px;
    letter-spacing: -0.04em;
    font-weight: 900;
}

.collections-hero-sub {
    margin: 8px 0 0;
    color: rgba(255,255,255,0.55);
    max-width: 520px;
    font-size: 0.88rem;
    line-height: 1.5;
}

.collections-hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.collections-primary-btn,
.collections-secondary-btn {
    border-radius: 12px;
    height: 40px;
    padding: 0 18px;
    font-weight: 800;
    font-size: 0.82rem;
    cursor: pointer;
    border: 1px solid rgba(255,255,255,0.1);
    white-space: nowrap;
    transition: opacity 0.15s, transform 0.15s;
}
.collections-primary-btn:hover,
.collections-secondary-btn:hover { opacity: 0.88; transform: translateY(-1px); }

.collections-primary-btn {
    background: #12ce18;
    color: #061006;
    border-color: transparent;
}

.collections-secondary-btn {
    background: rgba(255,255,255,0.055);
    color: rgba(255,255,255,0.85);
}

.collections-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 20px;
}

.collections-stat-card {
    padding: 14px 18px;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.075);
    background: rgba(255,255,255,0.035);
}

.collections-stat-value {
    font-size: 24px;
    font-weight: 900;
    color: #fff;
    line-height: 1;
}

.collections-stat-label {
    margin-top: 5px;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.38);
    text-transform: uppercase;
}

.collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
}

.collections-grid.is-empty {
    display: grid;
    grid-template-columns: 1fr;
    place-items: center;
    width: 100%;
    min-height: calc(100vh - 360px);
    padding: 24px 0 80px;
}

.collection-card {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.04);
    cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
}
.collection-card:hover {
    transform: translateY(-2px);
    border-color: rgba(18,206,24,0.35);
    background: rgba(255,255,255,0.065);
}

.collection-card-cover {
    height: 128px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    overflow: hidden;
    background:
        radial-gradient(circle at 30% 20%, rgba(18,206,24,0.22), transparent 30%),
        linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
}
.collection-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.82) saturate(0.95);
}
.collection-card-cover img:first-child:last-child {
    grid-column: 1 / -1;
    grid-row: 1 / -1;
}
.collection-card-cover img:nth-child(2):last-child {
    grid-row: 1 / -1;
}
.collection-card-cover--single {
    display: block;
}
.collection-card-cover--single img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.82) saturate(0.95);
}

.collection-cover-placeholder {
    height: 128px;
    display: grid;
    place-items: center;
    color: rgba(255,255,255,0.2);
    background:
        radial-gradient(circle at 50% 10%, rgba(18,206,24,0.18), transparent 40%),
        rgba(255,255,255,0.03);
}

.collection-card-body { padding: 14px 16px 16px; }

.collection-card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
}

.collection-card h3 {
    margin: 0;
    color: #fff;
    font-size: 15px;
    font-weight: 900;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.collection-card p {
    margin: 4px 0 0;
    color: rgba(255,255,255,0.42);
    font-size: 11.5px;
}

.collection-card-actions {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 12px;
}

.collection-card-actions button {
    height: 30px;
    padding: 0 11px;
    border-radius: 9px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.75);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    transition: background 0.12s;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.collection-card-actions button:hover { background: rgba(255,255,255,0.1); }

.collection-more-wrap {
    position: relative;
    margin-left: auto;
}

.collection-more-btn {
    min-width: 30px !important;
    width: 30px;
    padding: 0 !important;
    letter-spacing: 0.06em;
    font-size: 0.82rem !important;
}

.collection-card-menu {
    position: absolute;
    right: 0;
    bottom: 36px;
    min-width: 136px;
    padding: 5px;
    border-radius: 12px;
    background: rgba(18,18,20,0.97);
    border: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 16px 40px rgba(0,0,0,0.5);
    z-index: 40;
}

.collection-card-menu[hidden] { display: none !important; }

.collection-card-menu button {
    width: 100%;
    height: 33px;
    border: 0 !important;
    border-radius: 8px !important;
    background: transparent !important;
    color: rgba(255,255,255,0.82) !important;
    justify-content: flex-start !important;
    padding: 0 10px !important;
    font-size: 0.8rem !important;
}
.collection-card-menu button:hover { background: rgba(255,255,255,0.08) !important; }
.collection-card-menu button.danger { color: #ff6b6b !important; }
.collection-card-menu button.danger:hover { background: rgba(255,59,48,0.12) !important; }

.collections-empty-state {
    margin: 0 auto;
    width: min(820px, calc(100% - 48px));
    min-height: 420px;
    display: grid;
    place-items: center;
    text-align: center;
    border-radius: 24px;
    border: 1px dashed rgba(255,255,255,0.11);
    background:
        radial-gradient(circle at 50% 0%, rgba(18,206,24,0.11), transparent 34%),
        rgba(255,255,255,0.022);
    padding: 48px 24px;
}

.collections-empty-inner { max-width: 540px; }

.collections-empty-art {
    width: 88px;
    height: 88px;
    margin: 0 auto 22px;
    border-radius: 26px;
    display: grid;
    place-items: center;
    background: rgba(18,206,24,0.08);
    border: 1px solid rgba(18,206,24,0.18);
    box-shadow: 0 0 50px rgba(18,206,24,0.07);
}

.collections-empty-state h2 {
    margin: 0;
    font-size: 26px;
    font-weight: 900;
    letter-spacing: -0.035em;
}

.collections-empty-state > .collections-empty-inner > p {
    margin: 10px auto 0;
    color: rgba(255,255,255,0.52);
    line-height: 1.55;
    font-size: 0.88rem;
}

.collections-empty-actions {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
    flex-wrap: wrap;
}

.collections-suggestions {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 20px;
}

.collections-suggestions span {
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.07);
    color: rgba(255,255,255,0.45);
    font-size: 11.5px;
    font-weight: 500;
    cursor: default;
}

@media (max-width: 900px) {
    .collections-hero {
        align-items: flex-start;
        flex-direction: column;
    }
    .collections-stats {
        grid-template-columns: 1fr;
    }
}

/* ── All Games route-lock and layout-shift prevention ── */
body.ag-route-pending #allGamesView {
    overflow-anchor: none;
}

#allGamesView.ag-first-paint-lock {
    overflow-anchor: none;
}

/* Legacy rule — kept for any remaining references */
#allGamesView.ag-layout-loading {
    overflow-anchor: none;
}

#allGamesGrid {
    overflow-anchor: none;
}

.ag-route-skeleton {
    min-height: calc(100vh - 180px);
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-sec, rgba(255,255,255,0.45));
    box-sizing: border-box;
}

.ag-route-skeleton .acc-spinner {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
}

/* Legacy stable loading panel */
.ag-stable-loading-panel {
    min-height: 520px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-sec, rgba(255,255,255,0.45));
}

.ag-stable-loading-panel .acc-spinner {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
}


/* ── Ready to Install mode — hide the Installed filter chip ── */
body.ag-ready-mode .ag-installed-toggle { display: none !important; }

/* ── Ready to Install loading state ─────────────────────────────────────────── */

/* Sibling wrapper inserted next to allGamesGrid inside library-section. */
.ag-rti-loading-wrap {
    width: 100%;
    box-sizing: border-box;
}

/* Full-height centering container. Uses grid/place-items for robust centering
   that works regardless of the parent element's display mode. */
.ag-ready-loading-state {
    width: 100%;
    min-height: calc(100vh - 180px);
    display: grid;
    place-items: center;
    text-align: center;
    box-sizing: border-box;
}

/* Inner column flex layout for spinner + text. */
.ag-ready-loading-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
}

.ag-rls-spinner {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-width: 2.5px;
}

.ag-rls-title {
    display: block;
    color: var(--text-main, rgba(255,255,255,0.85));
    font-size: 0.93rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    opacity: 0.85;
}

.ag-rls-sub {
    display: block;
    color: var(--text-sec, #86868b);
    font-size: 0.78rem;
    margin-top: 4px;
    opacity: 0.7;
}

/* ── Beta Feedback Banner ──────────────────────────────────────────────────── */
@keyframes betaFeedbackIn {
    from { opacity: 0; transform: translateY(14px) scale(0.985); }
    to   { opacity: 1; transform: translateY(0)    scale(1);     }
}

.beta-feedback-banner {
    position: fixed;
    left: calc(var(--sidebar-width) + 12px);
    right: 18px;
    bottom: 18px;
    min-height: 58px;
    padding: 10px 12px 10px 14px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    z-index: 99990;
    color: rgba(255, 255, 255, 0.92);
    background:
        linear-gradient(135deg, rgba(18, 206, 24, 0.16), rgba(18, 18, 18, 0.88) 42%, rgba(0, 0, 0, 0.88)),
        rgba(12, 12, 12, 0.92);
    border: 1px solid rgba(18, 206, 24, 0.26);
    box-shadow:
        0 18px 45px rgba(0, 0, 0, 0.42),
        0 0 0 1px rgba(255, 255, 255, 0.04) inset,
        0 0 28px rgba(18, 206, 24, 0.09);
    backdrop-filter: blur(18px);
    -webkit-app-region: no-drag;
    animation: betaFeedbackIn 220ms ease-out both;
}

.beta-feedback-banner[hidden] { display: none !important; }

.beta-feedback-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1;
}

.beta-feedback-pill {
    height: 26px;
    padding: 0 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #091009;
    background: linear-gradient(135deg, #12ce18, #78ff7d);
    box-shadow: 0 0 18px rgba(18, 206, 24, 0.25);
    flex: 0 0 auto;
}

.beta-feedback-copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
}

.beta-feedback-copy strong {
    font-size: 13px;
    font-weight: 800;
    line-height: 1.1;
}

.beta-feedback-copy span {
    font-size: 12px;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.62);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.beta-feedback-cta {
    height: 34px;
    padding: 0 13px;
    border-radius: 999px;
    border: 1px solid rgba(18, 206, 24, 0.35);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #071007;
    background: linear-gradient(135deg, #12ce18, #70f774);
    font-family: var(--font-main);
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    flex: 0 0 auto;
    transition: transform 0.16s ease, box-shadow 0.16s ease, filter 0.16s ease;
    -webkit-app-region: no-drag;
}

.beta-feedback-cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
    box-shadow: 0 10px 24px rgba(18, 206, 24, 0.22);
}

.beta-feedback-close {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.62);
    font-size: 16px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex: 0 0 auto;
    -webkit-app-region: no-drag;
}

.beta-feedback-close:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.10);
}

body.has-beta-feedback-banner #mainContentArea {
    padding-bottom: 92px;
}

.sidebar.collapsed ~ * .beta-feedback-banner,
body:has(.sidebar.collapsed) .beta-feedback-banner {
    left: calc(var(--sidebar-collapsed-width) + 12px);
}

@media (max-width: 900px) {
    .beta-feedback-banner {
        left: 14px;
        right: 14px;
        bottom: 14px;
        border-radius: 16px;
    }

    .beta-feedback-copy span {
        white-space: normal;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }
}

@media (max-width: 640px) {
    .beta-feedback-banner {
        align-items: stretch;
        flex-direction: column;
        gap: 10px;
        padding: 12px;
    }

    .beta-feedback-close {
        position: absolute;
        right: 10px;
        top: 10px;
    }

    .beta-feedback-left {
        padding-right: 34px;
    }

    .beta-feedback-cta {
        width: 100%;
        justify-content: center;
    }
}

@media (prefers-reduced-motion: reduce) {
    .beta-feedback-banner:not([hidden]) { animation: none; }
    .beta-feedback-cta { transition: none; }
}
