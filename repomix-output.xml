    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: all 0.3s ease;
}

/* حالة الـ Expanded */
.gd-full-desc-text.expanded {
    -webkit-line-clamp: unset;
    max-height: none;
}


/* الحاوية الأساسية للوصف */
.gd-about-wrapper {
    position: relative;
    margin-bottom: 10px;
}

/* النص مع تحديد 3 سطور */
.gd-full-desc-text {
    display: -webkit-box;
    -webkit-line-clamp: 3; /* أول 3 سطور فقط */
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    transition: all 0.4s ease;
}

/* الـ Fade Overlay (التدرج اللي بيغطي الكلام) */
.gd-about-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50px; /* طول التدرج */
    background: linear-gradient(to bottom, transparent, var(--gd-bg)); /* التدرج من شفاف للون الخلفية الأسود */
    pointer-events: none; /* عشان ميعطلش الكليك على الكلام */
    transition: opacity 0.3s ease;
}
/* الحاوية الأساسية للوصف */
.gd-about-wrapper {
    position: relative;
    margin-bottom: 20px;
}

/* النص مع تحديد 4 سطور عشان يدي مساحة حلوة للـ Fade */
.gd-full-desc-text {
    display: -webkit-box;
    -webkit-line-clamp: 4; 
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    transition: all 0.4s ease;
}

/* الـ Fade Overlay (التدرج اللي بيغطي آخر سطرين) */
.gd-about-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px; /* مساحة التدرج مريحة للعين */
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, var(--gd-bg) 90%);
    display: flex;
    align-items: flex-end; /* بنزق الزرار لآخر التدرج تحت */
    justify-content: center; /* بنسنتر الزرار في النص */
    pointer-events: none; /* عشان التدرج ميعطلش لو اليوزر بيعمل Select للكلام */
    transition: opacity 0.3s ease;
}

/* ستايل زرار الـ Show More */
.gd-show-more-btn {
    pointer-events: auto; /* مهم جداً عشان الزرار يبقى شغال جوه الـ fade */
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--gd-text);
    padding: 6px 24px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.4);
    margin-bottom: 5px; /* رافعينه سنة عن الأرضية */
    transition: all 0.2s ease;
}

.gd-show-more-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.6);
}

/* لما نفتح الوصف: نخفي التدرج ونظهر كل الكلام */
.gd-about-wrapper.expanded .gd-full-desc-text {
    -webkit-line-clamp: unset;
}

.gd-about-wrapper.expanded .gd-about-fade {
    position: relative; /* بنفكه من الـ absolute عشان ينزل طبيعي تحت الكلام */
    height: auto;
    background: none; /* بنشيل التدرج الأسود */
