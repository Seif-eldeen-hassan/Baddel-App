        // setTimeout(() => autoSyncOnStartup(), 12_000) form
        const timeoutMatch = readyBlock.match(/setTimeout\([^,]+,\s*(\d[\d_]*)\)/);
        if (timeoutMatch) {
            const ms = parseInt(timeoutMatch[1].replace(/_/g, ''), 10);
