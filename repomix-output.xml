.placeholder-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    background: linear-gradient(135deg, #1c1c1c 0%, #0a0a0a 100%);
    display: flex; align-items: center; justify-content: center;
    z-index: 0; border-radius: 12px;
    overflow: hidden;
}

/* shimmer animation on placeholder while poster loads */
.placeholder-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
        105deg,
        transparent 30%,
        rgba(255,255,255,0.04) 50%,
        transparent 70%
    );
    background-size: 200% 100%;
    animation: shimmerSlide 1.8s infinite linear;
}

@keyframes shimmerSlide {
    from { background-position: -200% 0; }
    to   { background-position:  200% 0; }
}

.placeholder-text {
    font-family: var(--font-heading); 
    font-size: 3.5rem; 
    font-weight: 900;
    color: rgba(255, 255, 255, 0.06); 
    text-transform: uppercase;
    letter-spacing: 2px;
    position: relative;
    z-index: 1;
}

.actual-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover;
    object-position: center bottom;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.4s ease, opacity 0.4s ease;
    z-index: 1;
    opacity: 0;
    color: transparent;
}

/* Image revealed once loaded */
.actual-img.img-loaded {
    opacity: 1;
}

/* Stop shimmer once the card has an image */
.game-card:has(.actual-img.img-loaded) .placeholder-bg::after {
    animation: none;
}

