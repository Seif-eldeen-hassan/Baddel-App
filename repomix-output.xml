/* ══════════════════════════════════════════════════════════════
   LIST VIEW
══════════════════════════════════════════════════════════════ */
.ag-list-view {
    width: 100%;
    font-size: 0.82rem;
}

.ag-list-header {
    display: grid;
    grid-template-columns: 48px 1fr 140px 100px 120px 36px;
    align-items: center;
    padding: 0 8px;
    height: 30px;
