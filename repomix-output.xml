const engine = new BaddelEngine();
async function refetchMissingImages(notifyCallback) {
    const fsSync = require('fs');
    let updated = false;

    for (let game of engine.dbCache) {
        if (!game.isHidden && !game.customArtworkLocked) {
            let isMissing = false;

            if (game.image && game.image.startsWith('file://')) {
                try {
                    const cleanPath = decodeURI(game.image.replace('file://', ''));
                    if (!fsSync.existsSync(cleanPath)) isMissing = true;
                } catch (e) { isMissing = true; }
            } else if (!game.image) {
                isMissing = true;
            }

            if (isMissing) {
                try {
                    // Try to fetch from Baddel metadata server by title
                    const meta = await baddelApi.lookupGame({ title: game.name });
                    if (meta && meta.images) {
                        const coverImg = meta.images.find(i => i.image_type === 'cover');
                        if (coverImg) {
                            const coverUrl = coverImg.cdn_url || coverImg.url;
                            if (coverUrl) {
                                await engine.backgroundDownload({ cover: coverUrl }, game.id, notifyCallback, { source: 'pipeline' });
                                updated = true;
                            }
                        }
                    }
                } catch (e) { /* skip */ }
            }
        }
    }
    if (updated) engine.saveDatabase();
}

// ============================================================
// METADATA CACHE STORE
// Full structured metadata fallback cache — separate from games-db.json
// Keyed by game.id; stores rich fields (description, screenshots, etc.)
// ============================================================
// ============================================================
// METADATA CACHE STORE
// Full structured metadata fallback cache — separate from games-db.json
// Canonicalizes Steam ids so steam-860510 and steam_860510 share one entry.
// ============================================================

function normalizeMetadataCacheKey(gameId) {
    const raw = String(gameId || '').trim();

    // Steam installed sometimes uses steam-APPID,
    // All Games sometimes uses steam_APPID.
    // Force both to one canonical cache key.
    const steam = raw.match(/^steam[-_](\d+)$/i);
    if (steam) return `steam_${steam[1]}`;

    return raw;
}

function metadataCacheAliases(gameId) {
    const raw = String(gameId || '').trim();
    const keys = new Set();

    if (raw) keys.add(raw);

    const canonical = normalizeMetadataCacheKey(raw);
    if (canonical) keys.add(canonical);

    const steam = raw.match(/^steam[-_](\d+)$/i);
    if (steam) {
        keys.add(`steam-${steam[1]}`);
        keys.add(`steam_${steam[1]}`);
    }

    return [...keys].filter(Boolean);
}

function isHollowMetadata(meta) {
    if (!meta || typeof meta !== 'object') return true;

    const info = meta.info || {};
    const screenshots = Array.isArray(info.screenshots) ? info.screenshots : [];
    const trailers = Array.isArray(info.allTrailers) ? info.allTrailers : [];
    const genres = Array.isArray(info.genres) ? info.genres : [];
    const ratingSources = Array.isArray(meta?.quality?.sources?.ratings)
        ? meta.quality.sources.ratings
        : Array.isArray(meta?.ratings?.sources)
            ? meta.ratings.sources
            : [];

    return !(
        info.description ||
        meta.description ||
        info.short_description ||
        meta.short_description ||
        meta.quality?.sources?.text ||
        screenshots.length ||
        trailers.length ||
        genres.length ||
        ratingSources.length
    );
}

class MetadataCacheStore {
    constructor(dbFolder) {
        this.cachePath = path.join(dbFolder, 'metadata-cache.json');
        this._cache = null; // loaded lazily
    }

    async _load() {
        if (this._cache !== null) return;
        try {
            const raw = await fs.readFile(this.cachePath, 'utf8');
            this._cache = JSON.parse(raw);
        } catch {
            this._cache = {};
        }
    }

    async _flush() {
        try {
            await fs.writeFile(this.cachePath, JSON.stringify(this._cache, null, 2), 'utf8');
        } catch (err) {
            console.warn('[MetadataCacheStore] flush error:', err.message);
        }
    }

    async save(gameId, title, platform, meta) {
        await this._load();

        const key = normalizeMetadataCacheKey(gameId);

        this._cache[key] = {
            gameId: key,
            originalGameId: String(gameId || ''),
            title: title || null,
            platform: platform || null,
            fetchedAt: Date.now(),
            source: 'fallback-getMetadata',
            meta,
        };

        // Remove old duplicate aliases like steam-860510
        // so the app cannot read the wrong/hollow cache later.
        for (const alias of metadataCacheAliases(gameId)) {
            if (alias !== key && this._cache[alias]) {
                delete this._cache[alias];
                console.log(`[MetadataCacheStore] Removed duplicate alias cache key=${alias}; canonical=${key}`);
            }
        }

        await this._flush();

        console.log(`[MetadataCacheStore] Persisted fallback metadata for gameId=${key} ("${title}")`);
        return { status: 'success' };
    }

    async load(gameId) {
        await this._load();

        const canonicalKey = normalizeMetadataCacheKey(gameId);
        const aliases = metadataCacheAliases(gameId);

        for (const key of [canonicalKey, ...aliases.filter(k => k !== canonicalKey)]) {
            const entry = this._cache[key] || null;
            if (!entry) continue;

            const meta = entry.meta || null;

            // If the found entry is hollow/empty, delete it and keep searching aliases.
            if (isHollowMetadata(meta)) {
                console.warn(`[MetadataCacheStore] Ignoring hollow cached metadata for gameId=${key} ("${entry.title || ''}")`);
                delete this._cache[key];
                await this._flush();
                continue;
            }

            // If found under old key steam-xxxx, migrate it to steam_xxxx.
            if (key !== canonicalKey) {
                this._cache[canonicalKey] = {
                    ...entry,
                    gameId: canonicalKey,
                    originalGameId: entry.originalGameId || String(gameId || ''),
                };

                delete this._cache[key];
                await this._flush();

                console.log(`[MetadataCacheStore] Migrated metadata cache ${key} -> ${canonicalKey}`);
            }

            console.log(
                `[MetadataCacheStore] Loaded cached fallback metadata for gameId=${canonicalKey} ` +
                `("${entry.title}") fetchedAt=${new Date(entry.fetchedAt || Date.now()).toISOString()}`
            );

            return meta;
        }

        return null;
    }

    // Returns the full entry with title, fetchedAt, etc. — used by main.js
    async getEntry(gameId) {
        await this._load();

        const canonicalKey = normalizeMetadataCacheKey(gameId);
        const aliases = metadataCacheAliases(gameId);

        for (const key of [canonicalKey, ...aliases.filter(k => k !== canonicalKey)]) {
            const entry = this._cache[key] || null;
            if (!entry) continue;

            if (isHollowMetadata(entry.meta)) {
                delete this._cache[key];
                await this._flush();
                continue;
            }

            if (key !== canonicalKey) {
                this._cache[canonicalKey] = {
                    ...entry,
                    gameId: canonicalKey,
                    originalGameId: entry.originalGameId || String(gameId || ''),
                };

                delete this._cache[key];
                await this._flush();
            }

            return this._cache[canonicalKey];
        }

        return null;
    }

    // Check if we already have a non-stale entry.
    async hasEntry(gameId, maxAgeMs = 7 * 24 * 60 * 60 * 1000) {
        const entry = await this.getEntry(gameId);
        if (!entry) return false;
        return (Date.now() - (entry.fetchedAt || 0)) < maxAgeMs;
    }

    // Remove stale/incomplete entry and all aliases.
    async deleteEntry(gameId) {
        await this._load();

        let changed = false;

        for (const key of metadataCacheAliases(gameId)) {
            if (this._cache[key]) {
                delete this._cache[key];
                changed = true;
                console.log(`[MetadataCacheStore] Deleted metadata cache key=${key}`);
            }
        }

        if (changed) await this._flush();
    }
}

const metadataCacheStore = new MetadataCacheStore(app.getPath('userData'));

// Single coordinator for all non-Steam/Epic metadata resolution.
// Replaces the old _resolveThrottleMap + scattered cooldown checks.
const mrm = new MetadataResolutionManager(app.getPath('userData'));
mrm.setApi(baddelApi);

// ============================================================
// BACKGROUND METADATA PIPELINE
// ============================================================
// Runs after every scan for non-Steam/Epic games.
// For each such game:
//   1. Try server lookup by slug
//   2. Try server lookup by title
//   3. If server hits → cache assets + persist full metadata
//   4. If server misses → call local resolver (getMetadataLocal) + persist
//
// `getMetadataLocal` is injected from main.js at startup to avoid circular
// dependency. Call `registerLocalMetadataResolver(fn)` once during app init.
// ============================================================

/** @type {((gameName: string, hints: object) => Promise<object|null>) | null} */
let _localMetadataResolver = null;

/**
 * Register the local metadata resolver (the same logic powering get-game-metadata IPC).
 * Called once from main.js after the IPC handlers are set up.
 * @param {(gameName: string, hints: object) => Promise<object|null>} fn
 */
function registerLocalMetadataResolver(fn) {
    _localMetadataResolver = fn;
    console.log('[BackgroundMetaPipeline] Local metadata resolver registered.');
}

/**
 * Derive a clean slug from a game title (same logic as game-details.js).
 * @param {string} name
 * @returns {{ slug: string|null, title: string }}
 */
function _resolveGenericLookup(name) {
    if (!name) return { slug: null, title: name };
    const slug = name
        .toLowerCase()
        .trim()
        .replace(/[''`™®©]/g, '')
        .replace(/[^a-z0-9\s\-]/g, ' ')
        .replace(/\s+/g, '-')
        .replace(/-{2,}/g, '-')
        .replace(/^-+|-+$/g, '');
    const validSlug = (slug && slug.length >= 3 && !/^\d+$/.test(slug)) ? slug : null;
    return { slug: validSlug, title: name };
}

/** Platforms that use the Steam/Epic server enrich flow — skip from this pipeline. */
const _SERVER_ENRICH_PLATFORMS = new Set(['steam', 'Steam', 'epic', 'Epic Games', 'epic games']);

// ── Background pipeline path helpers ─────────────────────────────────────────
// Prefer executablePath (the real binary) over game.path (install dir) or
// the potentially-quoted command string, so .lnk shortcuts never pollute the
// metadata candidate generator with a Desktop folder path.
function _metadataPathForGame(game) {
    return (
        game.executablePath ||
        game.launchCommand  ||
        (game.command || '').replace(/^"|"$/g, '').trim() ||
        game.path ||
        ''
    );
}

function _metadataFolderForGame(game) {
    if (game.folderName) return game.folderName;
    const p = _metadataPathForGame(game);
    if (!p) return undefined;
    try {
        const ext = path.extname(p).toLowerCase();
        // If p has an extension it's a file — use its parent dir name.
        // If no extension it's a directory — use the directory's own name.
        return ext ? path.basename(path.dirname(p)) : path.basename(p);
    } catch { return undefined; }
}

/**
 * Run the background metadata pipeline for all installed non-Steam/Epic games.
 * Safe to call multiple times — skips games that already have persisted metadata
 * less than 7 days old and skips games that are already covered by the server
 * enrich pipeline.
 *
 * @param {object[]} games       - array of installed game records from the DB
 * @param {object}   imageCache  - the IPC-layer image cache helper (optional)
 */
async function runBackgroundMetadataPipeline(games) {
    const TAG = '[BackgroundMetaPipeline]';

    // Filter: only non-Steam/Epic installed games
    const targets = games.filter(g => {
        const plat = (g.platform || '').trim();
        return !_SERVER_ENRICH_PLATFORMS.has(plat) && !g.isHidden;
    });

    if (targets.length === 0) {
        console.log(`${TAG} No non-Steam/Epic games to process. Pipeline skipped.`);
        return;
    }

    console.log(`${TAG} ══════ Pipeline START — ${targets.length} game(s) to process ══════`);

    let resolved = 0, mrmSkipped = 0, skipped = 0, missed = 0, recovered = 0;

    for (const game of targets) {
        const gameTag = `${TAG}[${game.name}]`;

        // ── Art presence helpers ──────────────────────────────────────────────
        const hasDiskCover = !!engine.findInCache(game.id, 'cover');
        const hasDiskHero  = !!engine.findInCache(game.id, 'hero');
        const hasDiskLogo  = !!engine.findInCache(game.id, 'logo');
        const hasDbArt     = !!(game.image || game.heroImage || game.logo);
        const hasDiskArt   = hasDiskCover || hasDiskHero;
        const hasAnyArt    = hasDbArt || hasDiskArt;
        const hasDbHero    = !!game.heroImage;
        const hasHero      = hasDbHero || hasDiskHero;
        const hasDbLogo    = !!(game.logo || game.defaultLogo);
        const hasLogo      = hasDbLogo || hasDiskLogo;

        // ── RECOVERY: MRM says RESOLVED but game has no usable art ────────────
        // This happens when a prior pipeline run resolved metadata but the image
        // download or DB write then failed.  Without this reset the game is stuck
        // behind the 7-day RESOLVED lock even though its card is blank.
        const mrmStatus = mrm.getStatus(game.id);
        if (mrmStatus === MRM_STATUS.RESOLVED && !hasAnyArt) {
            console.log(`${gameTag} ⚠ MRM RESOLVED but no usable art in DB/cache — resetting to IDLE`);
            mrm.resetToIdle(game.id);
            await metadataCacheStore.deleteEntry(game.id).catch(() => {});
            recovered++;
        }

        // ── Skip only when cover + hero + logo are all present + metadata cached ─
        // Any missing visual asset must NOT trigger a skip — backfill runs instead.
        try {
            if (hasAnyArt && hasHero && hasLogo && await metadataCacheStore.hasEntry(game.id)) {
                console.log(`${gameTag} ↷ Has cached metadata + cover + hero + logo — skipping.`);
                skipped++;
                continue;
            }
        } catch { /* continue */ }

        // ── Hero backfill: cover/logo present but hero still missing ──────────
        // If cached metadata already has a hero URL we can download it directly
        // without triggering a full re-resolve.  If the cached metadata has no
        // hero URL the server had no hero data at that time — honour it and skip
        // until the 7-day metadata TTL expires and triggers a fresh resolve.
        if (hasAnyArt && !hasHero) {
            let heroHandled = false;
            try {
                const hasMeta = await metadataCacheStore.hasEntry(game.id);
                if (hasMeta) {
                    console.log(`${gameTag} [HeroBackfill] missing hero but cover/logo present — retrying`);
                    const cachedMeta   = await metadataCacheStore.load(game.id);
                    const cachedHeroUrl = cachedMeta?.heroImage || cachedMeta?.hero || null;
                    if (cachedHeroUrl) {
                        let finalHero = cachedHeroUrl;
                        if (_imageDownloadFn) {
                            try {
                                const dl = await _imageDownloadFn({ hero: cachedHeroUrl }, game.id);
                                if (dl?.hero) finalHero = dl.hero;
                                console.log(`${gameTag} [HeroBackfill] hero cached successfully (${finalHero})`);
                            } catch (e) {
                                console.warn(`${gameTag} [HeroBackfill] download failed, using remote URL:`, e.message);
                            }
                        }
                        try {
                            await engine.updateGameMetadata(game.id, { hero: finalHero }, { source: 'pipeline' });
                            engine.saveDatabase();
                            console.log(`${gameTag} [HeroBackfill] reused cached metadata hero — DB updated`);
                            if (_gameImageUpdatedFn) {
                                const updatedGame = engine.dbCache.find(g => g.id === game.id);
                                if (updatedGame) _gameImageUpdatedFn(updatedGame);
                            }
                        } catch (e) {
                            console.warn(`${gameTag} [HeroBackfill] DB update failed:`, e.message);
                        }
                        heroHandled = true;
                    } else {
                        // Cache entry exists but has no hero — treat as stale/incomplete.
                        // Delete it and reset MRM so the full pipeline re-resolves fresh data.
                        console.log(`${gameTag} [IncompleteArtRecovery] cache has no hero/logo -> force refresh`);
                        await metadataCacheStore.deleteEntry(game.id).catch(() => {});
                        mrm.resetToIdle(game.id);
                        // heroHandled stays false → falls through to full resolve below
                    }
                }
                // No metadata cache entry → fall through to full pipeline
            } catch (e) {
                console.warn(`${gameTag} [HeroBackfill] error:`, e.message);
            }
            if (heroHandled) {
                await new Promise(r => setTimeout(r, 300));
                continue;
            }
        }

        // ── Logo backfill: hero present but logo still missing ────────────────
        // Runs only when hero is already resolved so we avoid a full re-resolve
        // just for a logo.  Reads from the cached metadata without network traffic.
        if (hasAnyArt && hasHero && !hasLogo) {
            try {
                const hasMeta = await metadataCacheStore.hasEntry(game.id);
                if (hasMeta) {
                    const cachedMeta    = await metadataCacheStore.load(game.id);
                    const cachedLogoUrl = cachedMeta?.logo || cachedMeta?.defaultLogo || null;
                    if (cachedLogoUrl && _imageDownloadFn) {
                        const dl = await _imageDownloadFn({ logo: cachedLogoUrl }, game.id);
                        const finalLogo = dl?.logo || cachedLogoUrl;
                        await engine.updateGameMetadata(game.id, { logo: finalLogo }, { source: 'pipeline' });
                        engine.saveDatabase();
                        console.log(`${gameTag} [IncompleteArtRecovery] backfilled logo (${finalLogo})`);
                        if (_gameImageUpdatedFn) {
                            const upd = engine.dbCache.find(g => g.id === game.id);
                            if (upd) _gameImageUpdatedFn(upd);
                        }
                    }
                    await new Promise(r => setTimeout(r, 300));
                    continue;
                }
            } catch (e) {
                console.warn(`${gameTag} [IncompleteArtRecovery] logo backfill error:`, e.message);
            }
        }

        // ── Skip games only on active cooldown MRM state ──────────────────────
        const effectiveMrmStatus = mrm.getStatus(game.id); // re-read after potential reset
        if (effectiveMrmStatus === MRM_STATUS.COOLDOWN) {
            const job = mrm.getJob(game.id);
            console.log(`${gameTag} ↷ MRM cooldown until ${new Date(job?.cooldownUntil).toISOString()} — skipping.`);
            mrmSkipped++;
            continue;
        }

        // ── Route ALL resolution through MRM (Stage 1 DB + Stage 2 transient) ─
        // Use the centralized candidate generator so compact names like "ACMirage"
        // get camelCase-split + franchise-alias expansion.
        const metadataPath = _metadataPathForGame(game);
        const candidates = generateMetadataCandidates({
            name:       game.name,
            folderName: _metadataFolderForGame(game),
            exeName:    game.exeName || (metadataPath ? path.parse(metadataPath).name : undefined),
            pathHint:   metadataPath || undefined,
        });

        console.log(`${gameTag} MRM candidates: ${candidates.map(c => c.title || c.slug).join(', ')}`);

        // primary title = game.name (or first candidate's displayName)
        const primaryTitle = game.name || (candidates[0]?.title) || '';
        const { slug: _primarySlug } = (candidates[0] ? { slug: candidates[0].slug } : {});

        const resolveResult = await mrm.resolve(game.id, {
            candidates,
            title:        primaryTitle,
            slug:         _primarySlug || undefined,
            platformHint: _mapPlatformHint(game.platform) || undefined,
        });

        const meta = resolveResult ? Object.assign({}, resolveResult.meta, { _resolveSource: resolveResult._resolveSource }) : null;

        // ── STEP 4: Persist metadata + cache assets + backfill DB ────────────
        if (meta) {
            // Use normalizeAssets to canonicalise cover/hero/logo regardless of
            // which alias the normalise functions returned (heroImage vs hero).
            const { cover: remoteCover, hero: remoteHero, logo: remoteLogo } =
                baddelApi.normalizeAssets(meta);

            try {
                await metadataCacheStore.save(game.id, game.name, game.platform, meta);
                console.log(`${gameTag} ✓ Full metadata persisted to local cache`);
                resolved++;
            } catch (err) {
                console.warn(`${gameTag} Failed to persist metadata:`, err.message);
            }

            // ── Backfill cover/hero/logo into the game DB entry ──────────────
            let finalCover = remoteCover;
            let finalHero  = remoteHero;
            let finalLogo  = remoteLogo;

            if (_imageDownloadFn) {
                try {
                    const assets = { cover: remoteCover, hero: remoteHero, logo: remoteLogo };
                    const cached = await _imageDownloadFn(assets, game.id);
                    if (cached?.cover) finalCover = cached.cover;
                    if (cached?.hero)  finalHero  = cached.hero;
                    if (cached?.logo)  finalLogo  = cached.logo;
                    console.log(`${gameTag} ✓ Assets cached locally (cover=${!!finalCover} hero=${!!finalHero} logo=${!!finalLogo})`);
                } catch (err) {
                    console.warn(`${gameTag} Asset caching error (non-fatal) — using remote URLs:`, err.message);
                }
            }

            if (finalCover || finalHero || finalLogo) {
                try {
                    await engine.updateGameMetadata(game.id, {
                        cover: finalCover,
                        hero:  finalHero,
                        logo:  finalLogo,
                    }, { source: 'pipeline' });
                    engine.saveDatabase();
                    console.log(`${gameTag} ✓ DB entry backfilled (cover=${!!finalCover} hero=${!!finalHero} logo=${!!finalLogo})`);

                    if (_gameImageUpdatedFn) {
                        const updatedGame = engine.dbCache.find(g => g.id === game.id);
                        if (updatedGame) {
                            _gameImageUpdatedFn(updatedGame);
                            console.log(`${gameTag} ✓ Renderer notified (game-image-updated)`);
                        }
                    }
                } catch (err) {
                    console.warn(`${gameTag} DB backfill error:`, err.message);
                }
            } else {
                // Metadata resolved (text / ratings) but no images at all.
                // Reset MRM so the next pipeline pass retries image fetching;
                // this keeps exception_keep_pending_art games in the retry loop.
                mrm.resetToIdle(game.id);
                console.log(`${gameTag} ⚠ Resolved metadata has no images — MRM reset to IDLE for retry`);
            }
        } else {
            missed++;
            console.log(`${gameTag} ✗ No metadata found from any source`);
        }

        // Throttle: 300 ms between games to avoid hammering the server
        await new Promise(r => setTimeout(r, 300));
    }

    console.log(
        `${TAG} ══════ Pipeline END — resolved=${resolved} mrmSkipped=${mrmSkipped} ` +
        `cached=${skipped} missed=${missed} recovered=${recovered} ══════`
    );
}

/** Simple completeness check (mirrors _gdIsMetadataTooIncomplete in game-details.js) */
function _isMetaTooIncomplete(meta) {
    if (!meta) return true;
    const hasDescription = !!(meta.info?.description || meta.description);
    const hasCover       = !!(meta.cover);
    const hasHero        = !!(meta.heroImage || meta.hero);
    const hasScreenshots = (meta.info?.screenshots || []).length > 0;
    const missingVisuals = [hasCover, hasHero, hasScreenshots].filter(Boolean).length < 2;
    return !hasDescription && missingVisuals;
}

/** Image downloader injected from main.js (caches remote URLs to local disk as WebP). */
let _imageDownloadFn = null;
function registerImageDownloader(fn) {
    _imageDownloadFn = fn;
}

/**
 * Optional live-update notifier injected from main.js.
 * When registered, the background pipeline calls this after writing new
 * cover/hero/logo into the DB so the renderer can refresh the card immediately
 * without waiting for a full rescan.
 *
 * Expected signature: (game: object) => void
 * Typical implementation in main.js:
 *   registerGameImageUpdatedNotifier(game => mainWindow.webContents.send('game-image-updated', game));
 */
let _gameImageUpdatedFn = null;
function registerGameImageUpdatedNotifier(fn) {
    _gameImageUpdatedFn = fn;
    console.log('[BackgroundMetaPipeline] game-image-updated notifier registered.');
}

module.exports = {
    scanAllGames:          () => engine.startGlobalScan(),
    addManualGame:         (launchPath, customName, cb, opts) => engine.addManualGame(launchPath, customName, cb, opts),
    getSavedGames:         () => engine.getStoredGames(),
    getMissingInstalledGames: () => engine.getMissingInstalledGames(),
    renameGame:            (id, name) => engine.renameGame(id, name),
    removeGame:            (id) => engine.removeGame(id),
    unhideAllGames:        () => engine.unhideAllGames(),
    getHiddenGames:        () => engine.getHiddenGames(),
    restoreSpecificGames:  (ids) => engine.restoreSpecificGames(ids),
    deleteGamePermanently: (id) => engine.deleteGamePermanently(id),
    updateGameImage:       (id, imgPath, type) => engine.updateGameImage(id, imgPath, type),
    resetGameImage:        (id, type) => engine.resetGameImage(id, type),
    updateGameMetadata:    (id, meta, opts) => engine.updateGameMetadata(id, meta, opts),
    reorderLibrary:        (ids) => engine.reorderLibrary(ids),
    updatePlaytime:        (id, minutes) => engine.updatePlaytime(id, minutes),
    saveQualifiedSession:  (id, sessionData) => engine.saveQualifiedSession(id, sessionData),
    setTimeTrackingEnabled: (id, enabled) => engine.setTimeTrackingEnabled(id, enabled),
    getTimeTrackingEnabled: (id)          => engine.getTimeTrackingEnabled(id),
    refetchMissingImages:  (cb) => refetchMissingImages(cb),
    getLocalSteamGames:    () => engine.getLocalSteamGames(),
    saveFullMetadata: (gameId, title, platform, meta) => metadataCacheStore.save(gameId, title, platform, meta),
    loadFullMetadata: (gameId)                         => metadataCacheStore.load(gameId),

    // ── Background pipeline ──────────────────────────────────────────────────
    runBackgroundMetadataPipeline,
    registerLocalMetadataResolver,
    registerImageDownloader,
    registerGameImageUpdatedNotifier,

    // ── Epic cleanup ─────────────────────────────────────────────────────────
    removeEpicNonGameEntries: (entries) => engine.removeEpicNonGameEntries(entries),

    // ── Unified resolution manager ───────────────────────────────────────────
    resolutionManager: mrm,
    BaddelEngine,
    __scannerTest: {
        normalizePath,
        pathExists,
        fileExists,
        dirExists,
        dirHasUsefulFiles,
        findFirstExisting,
        findLikelyGameExe,
        isLauncherOrHelperExe,
        makeInstalledGameKey,
        isGameInstallValid,
        withTimeout,
        safeJsonParse,
        normalizeDisplayName,
        normalizeScannerPlatform,
    },
};
</file>

<file path="src/css/game-details.css">
/* ============================================================
   BADDEL LAUNCHER - GAME DETAILS PAGE (APPLE TV / PREMIUM EDITION)
   Aesthetic: Ultra-Modern, Minimalist, Cinematic Dark
   ============================================================ */
@import url('./fonts.css');

/* ── CSS Variables ── */
:root {
    --gd-bg: #000000;
    --gd-surface: rgba(255, 255, 255, 0.03);
    --gd-surface-hover: rgba(255, 255, 255, 0.08);
    --gd-border: rgba(255, 255, 255, 0.06);
    --gd-text: #f5f5f7;
    --gd-text-muted: #86868b;
    --gd-accent: #ffffff;
    --gd-green: #30d158;
    --gd-hero-height: 55vh;
    --gd-min-hero-height: 450px;
    --gd-sidebar-width: 280px;
    --gd-radius: 16px;
    --gd-radius-sm: 10px;
    --gd-bezier: cubic-bezier(0.2, 0.8, 0.2, 1);
    /* --font-* variables are defined in fonts.css */
}

/* ============================================================
   ROOT VIEW
   ============================================================ */
#gameDetailsView {
    position: absolute;
    inset: 0;
    background: var(--gd-bg);
    overflow-y: auto;
    overflow-x: hidden;
    font-family: var(--font-main);
    color: var(--gd-text);
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.2) transparent;
}

#gameDetailsView::-webkit-scrollbar { width: 6px; }
#gameDetailsView::-webkit-scrollbar-track { background: transparent; }
#gameDetailsView::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }
#gameDetailsView::-webkit-scrollbar-thumb:hover { background: #555; }

/* ============================================================
   BACK BAR (FROSTED GLASS)
   ============================================================ */
.gd-back-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 40px;
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(25px) saturate(180%);
    -webkit-backdrop-filter: blur(25px) saturate(180%);
    border-bottom: 1px solid var(--gd-border);
}

.gd-back-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--gd-surface);
    border: 1px solid var(--gd-border);
    color: var(--gd-text);
    padding: 8px 16px;
    border-radius: 20px;
    font-family: var(--font-main);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s var(--gd-bezier);
}
.gd-back-btn:hover {
    background: rgba(255,255,255,0.1);
    transform: scale(1.05);
}

.gd-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    font-weight: 500;
}
.gd-breadcrumb-library { color: var(--gd-text-muted); }
.gd-breadcrumb-sep { color: #444; }
.gd-breadcrumb-name { color: var(--gd-text); }

/* ============================================================
   HERO SECTION (CINEMATIC)
   ============================================================ */
.gd-hero {
    position: relative;
    height: var(--gd-hero-height);
    min-height: var(--gd-min-hero-height);
    overflow: hidden;
    flex-shrink: 0;
}

.gd-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 20%;
    transform: scale(1.02);
    transition: background-image 0.8s ease;
    /* Softer than before — heavy darken + saturate read as muddy blue on some Steam assets */
    filter: brightness(0.78) saturate(1.05) contrast(1.02);
    animation: slowHeroZoom 20s infinite alternate linear;
}

/* Procedural “dead game” hero — no photo URL; gradient only */
.gd-hero-bg.gd-procedural-art {
    filter: none;
    animation: gdProceduralHeroDrift 22s ease-in-out infinite alternate;
    background-size: 200% 200%;
    background-position: 50% 50%;
}

@keyframes gdProceduralHeroDrift {
    0% { background-position: 0% 40%; }
    100% { background-position: 100% 60%; }
}

@keyframes slowHeroZoom {
    from { transform: scale(1); }
    to { transform: scale(1.05); }
}

.gd-hero-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #000000 0%, rgba(0,0,0,0.4) 40%, transparent 100%),
                linear-gradient(to right, rgba(0,0,0,0.7) 0%, transparent 50%);
    pointer-events: none;
}

/* ❌ Remove generic gamer lines */
.gd-hero-scanlines { display: none; }

.gd-hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column; /* هنرص العناصر فوق بعض */
    justify-content: flex-end; /* نزقهم لتحت */
    align-items: flex-start; /* نجيبهم كلهم عالشمال */
    padding: 50px 40px;
    /* السطر ده بيمنع أي كلام يروح ناحية اليمين ويستخبى تحت الكارت */
    padding-right: calc(var(--gd-sidebar-width) + 80px); 
}

.gd-title-block {
    flex: none;
    width: 100%;
    margin-bottom: 24px; /* مسافة بين العنوان والزراير */
}

.gd-logo {
    width: 100% !important;
    max-width: 400px !important;
    height: 130px !important; /* بوكس ثابت إجباري */
    object-fit: contain !important;
    object-position: left bottom !important; /* السر هنا: بيلزق الصورة في أرضية البوكس على الشمال */
    margin-bottom: 16px !important; /* قللنا المسافة شوية عشان يقرب من الزراير */
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.5));
    display: block;
}


.gd-title {
    font-family: var(--font-brand);
    font-size: 3.5rem;
    font-weight: 900;
    color: #fff;
    line-height: 1.1;
    margin: 0 0 15px 0;
    letter-spacing: -0.5px;
    text-shadow: 0 4px 20px rgba(0,0,0,0.6);
}

.gd-platforms-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
}

.gd-plat-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
}
.gd-plat-badge img { width: 14px; height: 14px; filter: brightness(0) invert(1); }

/* ── Hero Actions ── */
.gd-action-block {
    display: flex;
    flex-direction: row; /* هنخلي زرار اللعب والـ Stats جنب بعض */
    align-items: center;
    gap: 24px;
    padding-bottom: 0;
    width: 100%;
    flex-wrap: wrap; /* عشان لو الشاشة صغرت ينزلوا سطر جديد شيك */
}
.gd-play-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 40px;
    background: var(--gd-accent);
    color: #000;
    border: none;
    border-radius: 14px;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.3s var(--gd-bezier);
    box-shadow: 0 10px 30px rgba(255,255,255,0.2);
    flex-shrink: 0;
}
.gd-play-btn:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 15px 40px rgba(255,255,255,0.3);
    background: #fff;
}

.gd-play-btn:active { transform: scale(0.98); }

.gd-play-btn.install-mode {
    background: rgba(255,255,255,0.1);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.2);
    box-shadow: none;
}
.gd-play-btn.install-mode:hover { background: rgba(255,255,255,0.2); transform: translateY(-2px); }

/* Download Block iOS Style */
.gd-download-block {
    background: rgba(20, 20, 20, 0.7);
    backdrop-filter: blur(20px);
    border: 1px solid var(--gd-border);
    border-radius: 14px;
    padding: 16px;
    width: 280px;
}
.gd-dl-header { display: flex; justify-content: space-between; margin-bottom: 10px; }
.gd-dl-status { font-size: 0.8rem; font-weight: 600; }
.gd-dl-speed { font-size: 0.75rem; color: var(--gd-text-muted); }
.gd-dl-bar-wrap { height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden; margin-bottom: 8px; }
.gd-dl-bar { height: 100%; background: var(--gd-accent); width: 0%; transition: width 0.3s ease; }
.gd-dl-footer { display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--gd-text-muted); }

.gd-quick-stats { 
    display: flex; 
    gap: 20px; 
    align-items: center;
}
.gd-qs-item { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--gd-text-muted); font-weight: 600; }

/* ============================================================
   BODY LAYOUT
   ============================================================ */
.gd-body {
    display: flex;
    min-height: 50vh;
    padding: 0 40px 60px 40px;
    gap: 40px;
    max-width: 1600px;
    margin: 0 auto;
}
.gd-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
.gd-sidebar { width: var(--gd-sidebar-width); flex-shrink: 0; display: flex; flex-direction: column; gap: 24px; margin-top: -120px; z-index: 10; }

/* ============================================================
   APPLE STYLE TABS (Segmented Control)
   ============================================================ */
.gd-tabs {
    display: inline-flex;
    background: rgba(255,255,255,0.03);
    padding: 5px;
    border-radius: 12px;
    border: 1px solid var(--gd-border);
    margin-bottom: 30px;
    gap: 5px;
    align-self: flex-start;
}

.gd-tab {
    padding: 10px 20px;
    background: transparent;
    border: none;
    color: var(--gd-text-muted);
    font-family: var(--font-main);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.3s var(--gd-bezier);
}
.gd-tab:hover { color: var(--gd-text); background: rgba(255,255,255,0.05); }
.gd-tab.active {
    background: rgba(255,255,255,0.15);
    color: #fff;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
}

.gd-tab-content { animation: gdFadeIn 0.4s var(--gd-bezier); }
@keyframes gdFadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

/* ============================================================
   MAIN CONTENT SECTIONS
   ============================================================ */
.gd-section { margin-bottom: 40px; }

.gd-section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 16px 0;
    padding-bottom: 0;
    border-bottom: none;
}
.gd-section-title svg { color: var(--gd-text-muted); width: 20px; height: 20px; }

.gd-desc {
    font-size: 0.95rem;
    line-height: 1.8;
    color: #aaa;
    font-weight: 500;
}

/* ── Trailer ── */
.gd-trailer-wrap {
    border-radius: var(--gd-radius);
    overflow: hidden;
    background: #000;
    aspect-ratio: 16/9;
    border: 1px solid var(--gd-border);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    position: relative;
}
.gd-trailer { width: 100%; height: 100%; border: none; display: block; }
.gd-trailer-ext-btn {
    position: absolute; top: 15px; right: 15px;
    padding: 8px 14px; background: rgba(0,0,0,0.5); backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1); color: #fff; font-size: 0.8rem;
    border-radius: 8px; cursor: pointer; transition: 0.3s; display: flex; gap: 6px; align-items: center;
}
.gd-trailer-ext-btn:hover { background: rgba(255,255,255,0.1); transform: scale(1.05); }

/* ── Clean Info Grid ── */
.gd-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
}
.gd-info-item {
    background: var(--gd-surface);
    border: 1px solid var(--gd-border);
    border-radius: var(--gd-radius-sm);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: 0.3s ease;
}
.gd-info-item:hover { background: var(--gd-surface-hover); border-color: rgba(255,255,255,0.15); }
.gd-info-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: var(--gd-text-muted); font-weight: 700; }
.gd-info-value { font-size: 0.95rem; color: #fff; font-weight: 600; }

/* ── Tags ── */
.gd-tags { display: flex; flex-wrap: wrap; gap: 10px; }
.gd-tag {
    padding: 8px 16px;
    background: var(--gd-surface);
    border: 1px solid var(--gd-border);
    border-radius: 30px;
    font-size: 0.8rem;
    color: #ccc;
    font-weight: 600;
    transition: all 0.2s ease;
}
.gd-tag:hover { background: rgba(255,255,255,0.1); color: #fff; transform: translateY(-2px); }

/* ── Screenshots ── */
.gd-screenshots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 16px;
}
.gd-screenshot {
    aspect-ratio: 16/9;
    border-radius: var(--gd-radius-sm);
    overflow: hidden;
    cursor: pointer;
    border: 1px solid var(--gd-border);
    transition: all 0.4s var(--gd-bezier);
    position: relative;
}
.gd-screenshot:hover {
    transform: scale(1.03) translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.6);
    border-color: rgba(255,255,255,0.2);
    z-index: 2;
}
.gd-screenshot img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
.gd-screenshot:hover img { transform: scale(1.05); }

/* ============================================================
   SIDEBAR (RIGHT)
   ============================================================ */
.gd-cover-wrap {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    /* 2/3 matches Steam/library vertical art; 3/4 was wider → side letterboxing with contain */
    aspect-ratio: 2 / 3;
    background: #111;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 20px 50px rgba(0,0,0,0.7);
    transition: transform 0.5s var(--gd-bezier), box-shadow 0.5s ease;
}
.gd-cover-wrap:hover {
    transform: scale(1.03) translateY(-10px);
    box-shadow: 0 30px 60px rgba(0,0,0,0.9);
    border-color: rgba(255,255,255,0.2);
}
.gd-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    image-rendering: auto;
    /* يطابق .actual-img على كروت المكتبة: zoom + تعتيم عند hover الغلاف */
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.4s ease;
}

.gd-cover-wrap:hover .gd-cover {
    transform: scale(1.05);
    filter: brightness(0.6);
}

.gd-cover-wrap:hover .gd-cover.fallback-hero {
    filter: brightness(0.3) saturate(0.6);
}

.gd-cover-wrap.gd-procedural-card .gd-cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.gd-cover-wrap.gd-procedural-card #gdCoverInitials {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 8vw, 3.4rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.35) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
    filter: drop-shadow(0 4px 24px rgba(0,0,0,0.45));
}

.gd-cover.fallback-hero {
    filter: brightness(0.4) saturate(0.8);
}

.gd-logo-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 85%;
    max-height: 45%;
    object-fit: contain;
    z-index: 2;
    pointer-events: none;
    filter: drop-shadow(0 4px 10px rgba(0,0,0,0.9));
    animation: gdFadeIn 0.6s var(--gd-bezier);
}

/* ══════════════════════════════════════════════════════════════
   SIDEBAR RATING BLOCK — Redesigned (Compact Score Card)
   ══════════════════════════════════════════════════════════════ */

.gd-rating-block {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    text-align: left !important;
    backdrop-filter: none !important;
}

/* ── Ratings Container (sidebar) ── */
.gd-ratings-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    margin-top: 4px;
}

/* ── New Sidebar Score Chip ── */
.gd-rating-group {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 12px 14px;
    min-width: 0;
    flex: unset !important;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s ease, background 0.2s ease;
}

.gd-rating-group::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--pill-color, #fff);
    border-radius: 0 3px 3px 0;
    opacity: 0.7;
}

.gd-rating-group:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.14);
}

.gd-rating-group-label {
    display: none;
}

.gd-rating-group-pills {
    display: flex;
    gap: 8px;
}

/* ── Sidebar Pill (score chip inside the group) ── */
.gd-rating-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
}

.gd-pill-source-icon {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.gd-pill-source-icon img {
    width: 16px;
    height: 16px;
    object-fit: contain;
}

.gd-pill-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
}

.gd-pill-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.gd-pill-sub {
    font-size: 0.62rem;
    color: var(--gd-text-muted);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.gd-pill-score {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 900;
    line-height: 1;
    color: var(--pill-color, #fff);
    display: flex;
    align-items: baseline;
    gap: 1px;
    flex-shrink: 0;
}

.gd-pill-max {
    font-size: 0.65rem;
    opacity: 0.35;
    font-weight: 500;
}

.gd-pill-stars {
    display: flex;
    gap: 2px;
    margin-top: 2px;
}

/* ── More Ratings Button ── */
.gd-more-ratings-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    color: rgba(255,255,255,0.45);
    border-radius: 12px;
    padding: 9px 14px;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    width: 100%;
    transition: all 0.25s ease;
    letter-spacing: 0.3px;
}

.gd-more-ratings-btn:hover {
    background: rgba(255, 255, 255, 0.09);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.2);
    border-style: solid;
    transform: none;
}

/* Sidebar Clean Details */
.gd-detail-list {
    display: flex;
    flex-direction: column;
    background: var(--gd-surface);
    border: 1px solid var(--gd-border);
    border-radius: var(--gd-radius-sm);
    padding: 5px;
}
.gd-detail-row {
    padding: 12px 16px;
    border-bottom: 1px solid var(--gd-border);
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.gd-detail-row:last-child { border-bottom: none; }
.gd-detail-label { font-size: 0.7rem; color: var(--gd-text-muted); font-weight: 600; text-transform: uppercase; }
.gd-detail-value { font-size: 0.85rem; color: #fff; font-weight: 500; }

/* ============================================================
   REQUIREMENTS TAB (CLEAN CARDS)
   ============================================================ */
.gd-req-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
@media (max-width: 800px) { .gd-req-grid { grid-template-columns: 1fr; } }

.gd-req-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--gd-border);
    border-radius: var(--gd-radius);
    padding: 24px;
    backdrop-filter: blur(10px);
}
.gd-req-badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 20px;
    background: rgba(255,255,255,0.05);
    color: #fff;
}
.gd-req-list { display: flex; flex-direction: column; gap: 12px; }
.gd-req-row { display: flex; flex-direction: column; gap: 4px; padding-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.03); }
.gd-req-row:last-child { border-bottom: none; padding-bottom: 0; }
.gd-req-label { font-size: 0.7rem; color: var(--gd-text-muted); font-weight: 700; text-transform: uppercase; }
.gd-req-val { font-size: 0.85rem; color: #ccc; font-weight: 500; line-height: 1.5; }

/* ============================================================
   ACCOUNTS TAB
   ============================================================ */
.gd-accounts-list { display: flex; flex-direction: column; gap: 12px; }
.gd-account-item {
    display: flex; align-items: center; gap: 16px;
    padding: 16px 20px; background: var(--gd-surface);
    border: 1px solid var(--gd-border); border-radius: 14px;
    transition: all 0.3s ease;
}
.gd-account-item:hover { background: var(--gd-surface-hover); border-color: rgba(255, 255, 255, 0.15); transform: translateY(-2px); }
.gd-account-plat-icon { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: #fff; border-radius: 8px; }
.gd-account-plat-icon img { width: 20px; height: 20px; object-fit: contain; }
.gd-account-info { flex: 1; }
.gd-account-name { font-size: 0.95rem; font-weight: 600; color: #fff; }
.gd-account-plat { font-size: 0.75rem; color: var(--gd-text-muted); }
.gd-account-status { padding: 6px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; }
.gd-account-status.owned { background: rgba(48, 209, 88, 0.15); color: var(--gd-green); }

/* ============================================================
   ACHIEVEMENTS TAB
   ============================================================ */
.gd-achievements-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}
.gd-ach-card {
    background: linear-gradient(180deg, rgba(255,255,255,0.035) 0%, rgba(255,255,255,0.02) 100%);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 16px 18px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.25);
}
.gd-ach-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
}
.gd-ach-name { font-size: 0.95rem; font-weight: 800; color: #fff; letter-spacing: 0.2px; }
.gd-ach-meta { font-size: 0.78rem; color: var(--gd-text-muted); font-weight: 600; }
.gd-ach-bar {
    width: 100%;
    height: 9px;
    border-radius: 999px;
    background: rgba(255,255,255,0.09);
    overflow: hidden;
}
.gd-ach-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #30d158, #8ef5b0);
    transition: width 0.35s ease;
}
.gd-ach-sub {
    margin-top: 9px;
    font-size: 0.76rem;
    color: #9a9aa1;
    font-weight: 600;
}
.gd-ach-items {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 340px;
    overflow-y: auto;
    padding-right: 6px;
    border-top: 1px solid rgba(255,255,255,0.05);
    padding-top: 10px;
}
/* Scrollbar styling for achievements */
.gd-ach-items::-webkit-scrollbar {
    width: 4px;
}
.gd-ach-items::-webkit-scrollbar-track {
    background: transparent;
}
.gd-ach-items::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
}
.gd-ach-items::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
}
/* ============================================================
   STEAM REVIEWS STYLING
   ============================================================ */
.gd-review-summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
}
.gd-review-title {
    font-size: 1.6rem;
    font-weight: 900;
    color: #fff;
    line-height: 1.2;
    text-align: center;
}
.gd-review-count {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    opacity: 0.9;
    margin-bottom: 8px;
}
.gd-review-stats {
    display: flex;
    gap: 16px;
    font-size: 0.95rem;
    font-weight: 700;
}
.gd-review-pos {
    color: #30d158; /* Steam Green */
    display: flex;
    align-items: center;
    gap: 6px;
}
.gd-review-neg {
    color: #ff453a; /* Steam Red */
    display: flex;
    align-items: center;
    gap: 6px;
}
.gd-rating-label {
    margin-top: 10px;
    font-size: 0.7rem;
    color: var(--gd-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    opacity: 0.6;
}

.gd-ach-item {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 11px 12px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.07);
    margin-bottom: 0;
}
.gd-ach-icon-wrapper {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 0 10px rgba(255, 170, 0, 0.2);
    background: rgba(0,0,0,0.3);
}
.gd-ach-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.gd-ach-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}
.gd-ach-dot {
    color: #30d158;
    font-size: 1.1rem;
    font-weight: 700;
    width: 44px;
    text-align: center;
}
.gd-ach-item-name {
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.gd-ach-item-desc {
    color: var(--gd-text-muted);
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.2;
}
.gd-ach-item-time {
    color: var(--gd-text-muted);
    font-size: 0.72rem;
    font-weight: 500;
    white-space: nowrap;
    text-align: right;
    min-width: 128px;
}

/* ============================================================
   LIGHTBOX (GALLERY POPUP)
   ============================================================ */
.gd-lightbox {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: rgba(0,0,0,0.95) !important;
    backdrop-filter: blur(25px) !important;
    z-index: 999999 !important; /* عشان يغطي على أي حاجة في اللانشر */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
}
.gd-lightbox.active {
    opacity: 1;
    pointer-events: all;
}
/* ============================================================
   LIGHTBOX IMAGE (SCALING FIXED)
   ============================================================ */
.gd-lightbox-img {
    /* بنستخدم الـ Viewport Units عشان نفرض مساحة 90% من عرض وطول الشاشة كحد أقصى */
    max-width: 90vw; 
    max-height: 90vh;
    
    /* دي أهم خاصية: بتخلي الصورة "تحتوي" نفسها جوة الـ max-width/height من غير ما تتمط */
    object-fit: contain; 
    
    /* عشان نحافظ على شياكة الحواف المدورة والضلال */
    border-radius: 12px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.9);
    
    /* منع أي تداخل مع الأسهم في حالات نادرة */
    display: block; 
}.gd-lightbox-close {
    position: absolute; top: 30px; right: 40px; font-size: 2rem; color: #fff;
    background: rgba(255,255,255,0.1); border: none; width: 44px; height: 44px;
    border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s;
}
.gd-lightbox-close:hover { background: rgba(255,255,255,0.2); transform: scale(1.1); }

.gd-metadata-sources {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--gd-border);
    border-radius: var(--gd-radius);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.gd-ms-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.gd-ms-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--gd-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.gd-ms-trace {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.gd-ms-step {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 8px;
    border-left: 3px solid transparent;
}

.gd-ms-step.success { border-left-color: var(--gd-green); background: rgba(48, 209, 88, 0.05); }
.gd-ms-step.failed { border-left-color: #ff453a; background: rgba(255, 69, 58, 0.05); opacity: 0.7; }
.gd-ms-step.skipped { border-left-color: #8e8e93; opacity: 0.5; }

.gd-ms-step-source {
    font-weight: 600;
    min-width: 120px;
    color: #fff;
}

.gd-ms-step-status {
    font-size: 0.7rem;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(255,255,255,0.1);
    text-transform: uppercase;
}

.gd-ms-step-url {
    color: var(--gd-text-muted);
    font-family: var(--font-code);
    font-size: 0.75rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
}

.gd-ms-step.success .gd-ms-step-status { color: var(--gd-green); background: rgba(48, 209, 88, 0.15); }
.gd-ms-step.failed .gd-ms-step-status { color: #ff453a; background: rgba(255, 69, 58, 0.15); }

/* ============================================================
   PAGE LOAD ANIMATION
   ============================================================ */
#gameDetailsView .gd-body { animation: gdSlideUp 0.6s var(--gd-bezier) both; }
@keyframes gdSlideUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}


/* ============================================================
   LIGHTBOX NAVIGATION ARROWS
   ============================================================ */
.gd-lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s var(--gd-bezier);
    z-index: 2;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
}
.gd-lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-50%) scale(1.1);
}
.gd-lightbox-nav.prev { left: 40px; }
.gd-lightbox-nav.next { right: 40px; }


/* Short Description */
.gd-short-desc {
    color: rgba(255,255,255,0.75);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 12px;
    font-style: italic;
}

/* Long Description with collapse */
.gd-long-desc {
    color: rgba(255,255,255,0.65);
    font-size: 0.88rem;
    line-height: 1.7;
}

.gd-long-desc.collapsed {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* ستايل زرار الـ Show More الجديد - Minimalist & Cinematic */
.gd-show-more-btn {
    pointer-events: auto;
    background: transparent;
    border: none;
    color: var(--gd-text);
    padding: 8px 16px;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 0;
    transition: color 0.3s ease, transform 0.3s ease;
    text-shadow: 0 4px 15px rgba(0,0,0,0.9); /* بيحافظ على قرايته بوضوح فوق التدرج */
}

/* السهم الصغير اللي جنب الكلمة (بدون الحاجة لـ SVG في الـ JS) */
.gd-show-more-btn::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.3s var(--gd-bezier);
}

/* التأثير لما الماوس ييجي عليه */
.gd-show-more-btn:hover {
    color: #fff;
    transform: translateY(2px); /* حركة ناعمة لتحت بتشجع على الكليك */
}

/* شكل الزرار لما الوصف يفتح (Expanded) */
.gd-about-wrapper.expanded .gd-show-more-btn {
    color: var(--gd-text-muted); /* لونه بيطفي شوية عشان التركيز يروح للكلام */
    margin-top: 10px;
}

.gd-about-wrapper.expanded .gd-show-more-btn:hover {
    color: #fff;
}

/* عكس اتجاه السهم لفوق لما يفتح */
.gd-about-wrapper.expanded .gd-show-more-btn::after {
    transform: rotate(-135deg) translateY(-2px); 
}
/* ── Full Markdown Description (About section) ── */
.gd-full-desc {
    color: rgba(255,255,255,0.72);
    font-size: 0.875rem;
    line-height: 1.75;
}

.gd-md-h1, .gd-md-h2 {
    font-size: 1.1rem;
    font-weight: 700;
    color: rgba(255,255,255,0.92);
    margin: 16px 0 6px;
    letter-spacing: 0.01em;
}
.gd-md-h3, .gd-md-h4 {
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    margin: 12px 0 4px;
}
.gd-md-h5, .gd-md-h6 {
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    margin: 8px 0 4px;
}
.gd-md-p {
    margin: 0 0 10px;
}
.gd-md-p:last-child { margin-bottom: 0; }

.gd-md-ul {
    margin: 6px 0 10px 0;
    padding-left: 18px;
    list-style: none;
}
.gd-md-ul li {
    position: relative;
    padding-left: 14px;
    margin-bottom: 4px;
    color: rgba(255,255,255,0.72);
}
.gd-md-ul li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--accent, #7c6cf0);
    font-weight: 700;
}
.gd-md-hr {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.08);
    margin: 14px 0;
}
.gd-md-link {
    color: var(--accent, #7c6cf0);
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.15);
}
.gd-md-link:hover { opacity: 0.8; }


/* تحديد عدد السطور بـ 3 فقط */
.gd-full-desc-text {
    display: -webkit-box;
    -webkit-line-clamp: 3; /* يظهر أول 3 سطور فقط */
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: all 0.3s ease;
}

/* حالة الـ Expanded */
.gd-full-desc-text.expanded {
    -webkit-line-clamp: unset;
    max-height: none;
}


/* الحاوية الأساسية للوصف */
.gd-about-wrapper {
    position: relative;
    margin-bottom: 10px;
}

/* النص مع تحديد 3 سطور */
.gd-full-desc-text {
    display: -webkit-box;
    -webkit-line-clamp: 3; /* أول 3 سطور فقط */
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    transition: all 0.4s ease;
}

/* الـ Fade Overlay (التدرج اللي بيغطي الكلام) */
.gd-about-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50px; /* طول التدرج */
    background: linear-gradient(to bottom, transparent, var(--gd-bg)); /* التدرج من شفاف للون الخلفية الأسود */
    pointer-events: none; /* عشان ميعطلش الكليك على الكلام */
    transition: opacity 0.3s ease;
}
/* الحاوية الأساسية للوصف */
.gd-about-wrapper {
    position: relative;
    margin-bottom: 20px;
}

/* النص مع تحديد 4 سطور عشان يدي مساحة حلوة للـ Fade */
.gd-full-desc-text {
    display: -webkit-box;
    -webkit-line-clamp: 4; 
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    transition: all 0.4s ease;
}

/* الـ Fade Overlay (التدرج اللي بيغطي آخر سطرين) */
.gd-about-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px; /* مساحة التدرج مريحة للعين */
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, var(--gd-bg) 90%);
    display: flex;
    align-items: flex-end; /* بنزق الزرار لآخر التدرج تحت */
    justify-content: center; /* بنسنتر الزرار في النص */
    pointer-events: none; /* عشان التدرج ميعطلش لو اليوزر بيعمل Select للكلام */
    transition: opacity 0.3s ease;
}

/* ستايل زرار الـ Show More */
.gd-show-more-btn {
    pointer-events: auto; /* مهم جداً عشان الزرار يبقى شغال جوه الـ fade */
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--gd-text);
    padding: 6px 24px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.4);
    margin-bottom: 5px; /* رافعينه سنة عن الأرضية */
    transition: all 0.2s ease;
}

.gd-show-more-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.6);
}

/* لما نفتح الوصف: نخفي التدرج ونظهر كل الكلام */
.gd-about-wrapper.expanded .gd-full-desc-text {
    -webkit-line-clamp: unset;
}

.gd-about-wrapper.expanded .gd-about-fade {
    position: relative; /* بنفكه من الـ absolute عشان ينزل طبيعي تحت الكلام */
    height: auto;
    background: none; /* بنشيل التدرج الأسود */
    margin-top: 15px;
}

/* ── More Ratings Button ── */
.gd-more-ratings-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--gd-text-muted);
    border-radius: 20px;
    padding: 6px 12px;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    transition: all 0.3s ease;
    white-space: nowrap;
}

.gd-more-ratings-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateX(3px);
}


/* ══════════════════════════════════════════════════════════════
   RATINGS TAB — Full Redesign (Premium Card Grid)
   ══════════════════════════════════════════════════════════════ */

.gd-detailed-ratings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
    padding: 4px 0;
}

/* ── Base Rating Card ── */
.gd-rating-detailed-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 18px;
    padding: 20px 22px;
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
}

.gd-rating-detailed-card:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.055);
    border-color: rgba(255, 255, 255, 0.13);
}

/* Ambient glow from brand color */
.gd-rating-detailed-card::after {
    content: '';
    position: absolute;
    bottom: -30px;
    right: -20px;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--brand-color, rgba(255,255,255,0.15)) 0%, transparent 70%);
    opacity: 0.12;
    pointer-events: none;
}

/* ── Card Header ── */
.gd-rd-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.gd-rd-source {
    display: flex;
    align-items: center;
    gap: 8px;
}

.gd-rd-source-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 5px 10px;
}

.gd-rd-source-name {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.9px;
    color: rgba(255,255,255,0.55);
    text-transform: uppercase;
}

.gd-rd-icon {
    width: 15px;
    height: 15px;
    object-fit: contain;
}

.gd-rd-icon-rect {
    height: 10px;
    width: auto;
    object-fit: contain;
}

.gd-rd-label {
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--brand-color, #fff);
    background: color-mix(in srgb, var(--brand-color, #fff) 12%, transparent);
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid color-mix(in srgb, var(--brand-color, #fff) 25%, transparent);
    white-space: nowrap;
}

/* ── Score Display ── */
.gd-rd-main {
    display: flex;
    align-items: center;
    gap: 16px;
}

.gd-rd-score-wrap {
    display: flex;
    flex-direction: column;
}

.gd-rd-score-large {
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: -2px;
    line-height: 1;
    color: #fff;
    margin: 0;
}

.gd-rd-max {
    font-size: 1rem;
    opacity: 0.18;
    font-weight: 500;
    letter-spacing: 0;
}

.gd-rd-score-arc {
    position: relative;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
}

.gd-rd-score-arc svg {
    transform: rotate(-90deg);
    width: 64px;
    height: 64px;
}

.gd-rd-arc-track {
    fill: none;
    stroke: rgba(255,255,255,0.07);
    stroke-width: 5;
}

.gd-rd-arc-fill {
    fill: none;
    stroke: var(--brand-color, #fff);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 163;
    stroke-dashoffset: 163;
    transition: stroke-dashoffset 1s cubic-bezier(0.4, 0, 0.2, 1);
}

.gd-rd-arc-text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 900;
    color: #fff;
}

.gd-rd-side-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.gd-rd-score-label {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--brand-color, #fff);
    line-height: 1.2;
}

.gd-rd-score-sub {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.35);
    font-weight: 500;
}

.gd-rd-subtext { display: none; }

/* ── Footer ── */
.gd-rd-footer {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.25);
    padding-top: 10px;
    border-top: 1px solid rgba(255,255,255,0.05);
}

.gd-rd-footer strong {
    color: rgba(255, 255, 255, 0.45);
    font-weight: 700;
}

/* ══════════════════════════════════════════════════════════════
   STEAM CARD — Full-width special layout
   ══════════════════════════════════════════════════════════════ */

.steam-card {
    grid-column: 1 / -1;
}

.gd-rd-sentiment-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

/* Segmented approval bar */
.gd-rd-bar-track {
    height: 8px;
    background: rgba(255, 69, 58, 0.2);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
}

.gd-rd-bar-fill.pos {
    height: 100%;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--brand-color, #30d158), color-mix(in srgb, var(--brand-color, #30d158) 70%, #fff));
    position: relative;
}

.gd-rd-bar-fill.pos::after {
    content: '';
    position: absolute;
    right: 0; top: 0; bottom: 0;
    width: 2px;
    background: rgba(255,255,255,0.4);
}

.gd-rd-counts {
    display: flex;
    justify-content: space-between;
    font-size: 0.73rem;
    font-weight: 800; /* خليها أتقل شوية عشان تبان مع الأيقونة */
    color: rgba(255,255,255,0.5);
    margin-top: 4px;
}

.gd-rd-counts span svg {
    opacity: 0.8; /* عشان متبقاش فاقعة زيادة عن الأرقام */
}

/* Steam big score */
.gd-rd-score-large.steam-pct {
    font-size: 2.8rem;
    color: var(--brand-color, #30d158);
}

/* ============================================================
   CREATOR MODE
   ============================================================ */
.gd-back-bar { justify-content: flex-start; }
.gd-creator-entry-btn {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.055);
    color: rgba(255,255,255,0.88);
    font: 700 0.82rem var(--font-main);
    cursor: pointer;
    transition: transform .2s var(--gd-bezier), background .2s ease, border-color .2s ease;
}
.gd-creator-entry-btn:hover,
.gd-creator-entry-btn.active {
    transform: translateY(-1px);
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.28);
}
.gd-creator-entry-btn:focus-visible,
.gd-creator-tool-btn:focus-visible,
.gd-empty-creator-btn:focus-visible,
.gd-editable:focus {
    outline: 2px solid rgba(255,255,255,0.75);
    outline-offset: 3px;
}
.gd-creator-toolbar {
    position: sticky;
    top: 65px;
    z-index: 49;
    margin: 0 40px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 18px;
    background: rgba(12,12,14,0.82);
    backdrop-filter: blur(22px) saturate(160%);
    box-shadow: 0 18px 50px rgba(0,0,0,0.35);
}
.gd-creator-toolbar-copy { display: flex; flex-direction: column; gap: 2px; }
.gd-creator-toolbar-copy strong { font-family: var(--font-heading); letter-spacing: .02em; }
.gd-creator-toolbar-copy span { color: var(--gd-text-muted); font-size: .78rem; }
.gd-creator-toolbar-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.gd-creator-tool-btn,
.gd-empty-creator-btn,
.gd-inline-link-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 12px;
    background: rgba(255,255,255,0.07);
    color: #fff;
    padding: 9px 13px;
    font: 800 .78rem var(--font-main);
    cursor: pointer;
}
.gd-creator-tool-btn.primary,
.gd-empty-creator-btn { background: #fff; color: #000; border-color: #fff; }
.gd-creator-tool-btn.danger {
    color: #ffb4ad;
    border-color: rgba(255,69,58,0.35);
    background: rgba(255,69,58,0.08);
}
.gd-empty-state {
    grid-column: 1 / -1;
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding: 24px;
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,0.1);
    background:
        radial-gradient(circle at 18% 0%, rgba(255,255,255,0.1), transparent 34%),
        rgba(255,255,255,0.045);
}
.gd-empty-icon {
    width: 54px;
    height: 54px;
    border-radius: 18px;
    display: grid;
    place-items: center;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.1);
    flex: 0 0 auto;
}
.gd-empty-state h3 { margin: 0 0 8px; font-family: var(--font-heading); font-size: 1.2rem; }
.gd-empty-state p {
    margin: 0 0 16px;
    max-width: 620px;
    color: rgba(255,255,255,0.62);
    line-height: 1.55;
}
/* ── Clean hover affordance (no oval borders) ─────────────────────────────── */
#gameDetailsView.gd-creator-active:not(.gd-creator-preview) .gd-editable,
#gameDetailsView.gd-creator-active:not(.gd-creator-preview) [data-gd-edit-field] {
    cursor: pointer;
    position: relative;
    transition: background 0.18s ease, outline-color 0.18s ease;
    border-radius: 8px;
    outline: 1.5px dashed transparent;
    outline-offset: 4px;
}
#gameDetailsView.gd-creator-active:not(.gd-creator-preview) .gd-editable:hover,
#gameDetailsView.gd-creator-active:not(.gd-creator-preview) [data-gd-edit-field]:hover {
    background: rgba(255,255,255,0.045);
    outline-color: rgba(255,255,255,0.28);
}
#gameDetailsView.gd-creator-active:not(.gd-creator-preview) .gd-editable-chip {
    cursor: pointer;
    transition: opacity 0.15s;
}
#gameDetailsView.gd-creator-active:not(.gd-creator-preview) .gd-editable-chip:hover {
    opacity: 0.75;
}
.gd-edit-image-host { position: relative; }
.gd-edit-image-btn {
    position: absolute;
    right: 14px;
    top: 14px;
    z-index: 8;
    display: none;
    align-items: center;
    gap: 7px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 999px;
    padding: 8px 12px;
    background: rgba(0,0,0,0.72);
    color: #fff;
    font: 800 .72rem var(--font-main);
    backdrop-filter: blur(12px);
    cursor: pointer;
}
#gameDetailsView.gd-creator-active:not(.gd-creator-preview) .gd-edit-image-host:hover .gd-edit-image-btn,
#gameDetailsView.gd-creator-active:not(.gd-creator-preview) .gd-edit-image-btn:focus { display: inline-flex; }
.gd-creator-placeholder-card,
.gd-creator-add-card {
    width: 100%;
    min-height: 92px;
    display: grid;
    place-items: center;
    border: 1px dashed rgba(255,255,255,0.24);
    border-radius: 16px;
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.68);
    font-weight: 800;
}
.gd-creator-add-card { cursor: pointer; }
.gd-creator-media-card {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.04);
}
.gd-creator-media-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
.gd-creator-media-card.broken::after {
    content: "Image unavailable";
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(0,0,0,0.78);
    color: rgba(255,255,255,0.7);
}
.gd-creator-media-actions {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 8px;
    display: flex;
    gap: 6px;
    justify-content: center;
}
.gd-creator-media-actions button,
.gd-creator-trailer-row button {
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 9px;
    background: rgba(0,0,0,0.72);
    color: #fff;
    padding: 5px 8px;
    font-size: .7rem;
    cursor: pointer;
}
.gd-creator-trailer-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    background: rgba(255,255,255,0.045);
    margin-bottom: 8px;
}
.gd-creator-trailer-row span {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgba(255,255,255,0.72);
}
#gameDetailsView.gd-creator-preview .gd-edit-image-btn,
#gameDetailsView.gd-creator-preview .gd-creator-add-card,
#gameDetailsView.gd-creator-preview .gd-creator-media-actions,
#gameDetailsView.gd-creator-preview .gd-creator-trailer-row button { display: none !important; }
@media (max-width: 760px) {
    .gd-creator-toolbar { margin: 0 14px; align-items: stretch; flex-direction: column; }
    .gd-creator-entry-btn span { display: none; }
    .gd-empty-state { flex-direction: column; }
}

/* ============================================================
   CREATOR MODAL
   ============================================================ */
.gd-creator-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.72);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    backdrop-filter: blur(6px) saturate(120%);
}
.gd-creator-modal-box {
    background: #16161e;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 18px;
    padding: 28px 24px 22px;
    width: min(420px, 92vw);
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-shadow: 0 24px 72px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255,255,255,0.05) inset;
}
.gd-creator-modal-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.4;
    letter-spacing: 0.01em;
}
.gd-creator-modal-input {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    padding: 10px 13px;
    color: #fff;
    font-size: 0.9rem;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
    resize: vertical;
    outline: none;
    transition: border-color 0.15s ease, background 0.15s ease;
}
.gd-creator-modal-input:focus {
    border-color: rgba(255, 255, 255, 0.38);
    background: rgba(255, 255, 255, 0.1);
}
.gd-creator-modal-number {
    width: 72px;
    text-align: center;
    resize: none;
}
.gd-creator-rating-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
}
.gd-creator-modal-range {
    flex: 1;
    accent-color: #fff;
    cursor: pointer;
}
.gd-creator-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}
.gd-creator-modal-btn {
    padding: 9px 20px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 700;
    font-family: inherit;
    transition: all 0.15s ease;
}
.gd-creator-modal-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.28);
}
.gd-creator-modal-btn.primary {
    background: #fff;
    color: #000;
    border-color: #fff;
}
.gd-creator-modal-btn.primary:hover {
    background: rgba(255, 255, 255, 0.88);
}
.gd-creator-modal-btn:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.7);
    outline-offset: 3px;
}

/* ============================================================
   CREATOR LOGO CONTROLS (inline segmented control)
   ============================================================ */
.gd-creator-logo-ctrl {
    display: none;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
}
#gameDetailsView.gd-creator-active:not(.gd-creator-preview) .gd-creator-logo-ctrl {
    display: flex;
}
.gd-lc-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.16);
    background: rgba(255,255,255,0.07);
    color: rgba(255,255,255,0.82);
    font: 700 0.72rem var(--font-main);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
}
.gd-lc-btn:hover { background: rgba(255,255,255,0.13); border-color: rgba(255,255,255,0.3); color: #fff; }
.gd-lc-btn-danger { color: #ffb4ad; border-color: rgba(255,69,58,0.28); background: rgba(255,69,58,0.06); }
.gd-lc-btn-danger:hover { background: rgba(255,69,58,0.14); border-color: rgba(255,69,58,0.5); color: #ffb4ad; }

/* ============================================================
   CREATOR MEDIA PICKER MODAL (File | Link tabs)
   ============================================================ */
.gd-media-picker-box { gap: 14px; }
.gd-media-picker-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.gd-media-picker-close {
    width: 28px; height: 28px;
    display: grid; place-items: center;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.12);
    background: transparent;
    color: rgba(255,255,255,0.6);
    cursor: pointer;
    transition: background 0.15s;
}
.gd-media-picker-close:hover { background: rgba(255,255,255,0.1); color: #fff; }
.gd-media-picker-tabs {
    display: flex;
    gap: 4px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 4px;
}
.gd-mp-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 1;
    justify-content: center;
    padding: 8px 10px;
    border-radius: 9px;
    border: none;
    background: transparent;
    color: rgba(255,255,255,0.55);
    font: 700 0.78rem var(--font-main);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
}
.gd-mp-tab.active { background: rgba(255,255,255,0.12); color: #fff; }
.gd-mp-tab:hover:not(.active) { background: rgba(255,255,255,0.07); color: rgba(255,255,255,0.8); }
.gd-mp-panel { display: flex; flex-direction: column; gap: 10px; }
.gd-mp-hint {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.48);
    line-height: 1.45;
    margin: 0;
}
.gd-mp-ext {
    color: rgba(255,255,255,0.7);
    font-weight: 700;
    font-family: var(--font-heading);
}
.gd-mp-selected {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.55);
    word-break: break-all;
    padding: 6px 8px;
    background: rgba(255,255,255,0.05);
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.08);
}
.gd-mp-link-err {
    font-size: 0.78rem;
    color: #ffb4ad;
    margin: 0;
}

/* ============================================================
   RATINGS MODAL
   ============================================================ */
.gd-ratings-modal-box { gap: 14px; min-width: min(440px, 92vw); }
.gd-ratings-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 260px;
    overflow-y: auto;
    scrollbar-width: thin;
}
.gd-rating-entry {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
}
.gd-rating-entry-src {
    font: 700 0.82rem var(--font-heading);
    color: #fff;
    flex: 1;
    min-width: 0;
}
.gd-rating-entry-score {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.6);
    white-space: nowrap;
    margin-right: 4px;
}
.gd-ratings-add-row {
    display: flex;
    align-items: center;
    gap: 8px;
}
.gd-creator-modal-date {
    color-scheme: dark;
}

/* ============================================================
   HIDE TRAILER EXT BUTTON in Creator Mode and custom pages
   ============================================================ */
#gameDetailsView.gd-creator-active #gdTrailerExtBtn,
#gameDetailsView.gd-creator-preview #gdTrailerExtBtn,
#gameDetailsView.gd-has-custom-page #gdTrailerExtBtn { display: none !important; }

/* ============================================================
   CUSTOM DATE PICKER MODAL
   ============================================================ */
.gd-dp-box { width: min(360px, 94vw); gap: 16px; }
.gd-dp-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
}
.gd-dp-month-year { display: flex; align-items: center; gap: 8px; }
.gd-dp-nav-btn {
    width: 32px; height: 32px;
    display: grid; place-items: center;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px;
    color: rgba(255,255,255,0.8);
    cursor: pointer;
    transition: background 0.15s;
    flex-shrink: 0;
}
.gd-dp-nav-btn:hover { background: rgba(255,255,255,0.12); color: #fff; }
.gd-dp-nav-month, .gd-dp-nav-year {
    background: none; border: none;
    color: #fff;
    font-weight: 700;
    font-family: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    padding: 4px 6px;
    border-radius: 6px;
    transition: background 0.15s;
}
.gd-dp-nav-year { color: rgba(255,255,255,0.65); }
.gd-dp-nav-month:hover, .gd-dp-nav-year:hover { background: rgba(255,255,255,0.08); }
.gd-dp-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
}
.gd-dp-weekday {
    text-align: center;
    font-size: 0.68rem;
    font-weight: 700;
    color: rgba(255,255,255,0.35);
    padding: 4px 0 6px;
    letter-spacing: 0.04em;
}
.gd-dp-day {
    aspect-ratio: 1;
    display: grid; place-items: center;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.75);
    background: none;
    border: none;
    border-radius: 7px;
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
    font-family: inherit;
}
.gd-dp-day:hover { background: rgba(255,255,255,0.1); color: #fff; }
.gd-dp-today { border: 1px solid rgba(255,255,255,0.28); font-weight: 700; }
.gd-dp-selected { background: #fff !important; color: #000 !important; font-weight: 700; }
.gd-dp-selected-label { font-size: 0.78rem; color: rgba(255,255,255,0.55); text-align: center; }
.gd-dp-no-sel { color: rgba(255,255,255,0.3); }
.gd-dp-selected-label strong { color: rgba(255,255,255,0.9); }

/* ============================================================
   RATING SOURCE CARDS (replaces native select)
   ============================================================ */
.gd-ratings-src-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 4px;
}
.gd-rating-src-cards { display: flex; flex-wrap: wrap; gap: 7px; }
.gd-rating-src-card {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    color: rgba(255,255,255,0.8);
    font-family: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    text-align: left;
}
.gd-rating-src-card:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.28);
    color: #fff;
}
.gd-rsc-icon-wrap { width: 20px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.gd-rsc-icon { width: 18px; height: 18px; object-fit: contain; display: block; }
.gd-rsc-icon-invert { filter: invert(1); }
.gd-rsc-name { font-weight: 700; white-space: nowrap; }
.gd-rsc-constraint { color: rgba(255,255,255,0.38); font-size: 0.7rem; white-space: nowrap; }

/* Fix rating entry row layout */
.gd-rating-entry { flex-wrap: nowrap; align-items: flex-start; gap: 10px; }
.gd-re-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
    overflow: hidden;
}
.gd-rating-entry-src {
    font-weight: 700;
    font-size: 0.82rem;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.gd-rating-entry-score { font-size: 0.8rem; color: rgba(255,255,255,0.75); white-space: nowrap; }
.gd-rating-entry-sub  { font-size: 0.7rem;  color: rgba(255,255,255,0.42); white-space: nowrap; }
.gd-re-actions { display: flex; align-items: center; gap: 5px; flex-shrink: 0; }

/* ============================================================
   PAGE PACK / EMPTY STATE BUTTONS
   ============================================================ */
.gd-empty-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
.gd-empty-creator-btn, .gd-empty-import-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    border-radius: 10px;
    font: 700 0.84rem var(--font-main, inherit);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
}
.gd-empty-creator-btn {
    background: rgba(255,255,255,0.9);
    color: #000;
    border: 1px solid rgba(255,255,255,0.9);
}
.gd-empty-creator-btn:hover { background: #fff; }
.gd-empty-import-btn {
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.8);
    border: 1px solid rgba(255,255,255,0.16);
}
.gd-empty-import-btn:hover { background: rgba(255,255,255,0.11); color: #fff; border-color: rgba(255,255,255,0.28); }
.gd-empty-text h3 { margin: 0 0 6px; font-size: 1rem; color: rgba(255,255,255,0.9); }
.gd-empty-text p  { margin: 0; font-size: 0.84rem; color: rgba(255,255,255,0.5); line-height: 1.5; max-width: 340px; }
.gd-empty-icon { margin-bottom: 12px; color: rgba(255,255,255,0.22); }

/* ============================================================
   CREATOR TOUR — driver.js popover overrides
   ============================================================ */
.gd-tour-popover {
    background: #16161e !important;
    border: 1px solid rgba(255,255,255,0.15) !important;
    border-radius: 14px !important;
    box-shadow: 0 16px 48px rgba(0,0,0,0.7) !important;
    z-index: 999999 !important;
}
.gd-tour-popover .driver-popover-title {
    color: #fff !important;
    font-weight: 800;
}
.gd-tour-popover .driver-popover-description {
    color: rgba(255,255,255,0.72) !important;
    font-size: 0.88rem;
}
.gd-tour-popover .driver-popover-footer button {
    background: rgba(255,255,255,0.09);
    border: 1px solid rgba(255,255,255,0.18);
    color: #fff;
    border-radius: 8px;
    font-weight: 700;
    transition: background 0.15s;
}
.gd-tour-popover .driver-popover-footer button:hover { background: rgba(255,255,255,0.16); }
.gd-tour-popover .driver-popover-footer .driver-popover-next-btn {
    background: rgba(255,255,255,0.9) !important;
    color: #000 !important;
    border-color: rgba(255,255,255,0.9) !important;
}
.gd-tour-popover .driver-popover-footer .driver-popover-next-btn:hover { background: #fff !important; }

/* ============================================================
   CREATOR MODE POLISH PASS
   ============================================================ */
.gd-creator-modal-backdrop,
.gd-creator-modal-overlay {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background:
        radial-gradient(circle at 30% 10%, rgba(255,255,255,0.08), transparent 34%),
        rgba(0,0,0,0.74);
    backdrop-filter: blur(18px) saturate(120%);
    z-index: 10000;
}
.gd-creator-modal,
.gd-creator-modal-box {
    width: min(560px, 94vw);
    max-height: min(84vh, 760px);
    overflow: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: linear-gradient(145deg, rgba(24,24,32,0.98), rgba(12,12,17,0.98));
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 22px;
    box-shadow: 0 26px 90px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.08);
    padding: 20px;
    color: #fff;
}
.gd-creator-modal-header,
.gd-creator-modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
}
.gd-creator-modal-title {
    display: block;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    color: #fff;
}
.gd-creator-modal-subtitle {
    margin: 4px 0 0;
    color: rgba(255,255,255,0.56);
    font-size: 0.8rem;
}
.gd-creator-modal-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 0;
}
.gd-creator-input,
.gd-creator-modal-input {
    width: 100%;
    background: rgba(255,255,255,0.075);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 13px;
    color: #fff;
    padding: 11px 12px;
    outline: none;
}
.gd-creator-input:focus,
.gd-creator-modal-input:focus {
    border-color: rgba(255,255,255,0.42);
    box-shadow: 0 0 0 3px rgba(255,255,255,0.08);
}
.gd-creator-action,
.gd-creator-modal-btn {
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 12px;
    padding: 10px 16px;
    background: rgba(255,255,255,0.08);
    color: #fff;
    font-weight: 800;
    cursor: pointer;
}
.gd-creator-primary,
.gd-creator-modal-btn.primary {
    background: #fff;
    border-color: #fff;
    color: #000;
}
.gd-creator-danger,
.gd-creator-modal-btn.danger {
    background: rgba(255,80,80,0.16);
    border-color: rgba(255,120,120,0.36);
    color: #ffb6b6;
}
.gd-creator-secondary:hover,
.gd-creator-action:hover,
.gd-creator-modal-btn:hover {
    background: rgba(255,255,255,0.14);
}

.gd-creator-toolbar {
    max-width: min(940px, calc(100% - 36px));
    margin-inline: auto;
    border-radius: 18px;
}
.gd-creator-toolbar-actions {
    position: relative;
    align-items: center;
}
.gd-creator-more-wrap { position: relative; }
.gd-creator-more-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: none;
    min-width: 210px;
    padding: 8px;
    background: rgba(18,18,24,0.98);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 15px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.48);
    z-index: 10;
}
.gd-creator-more-wrap.open .gd-creator-more-menu { display: grid; gap: 4px; }
.gd-creator-more-menu button {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 10px 11px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: rgba(255,255,255,0.84);
    text-align: left;
    cursor: pointer;
}
.gd-creator-more-menu button:hover { background: rgba(255,255,255,0.09); color: #fff; }
.gd-creator-more-menu button.danger { color: #ffb6b6; }

.gd-trailer-wrap {
    overflow: visible !important;
    height: auto !important;
    min-height: 0 !important;
    aspect-ratio: auto !important;
    background: transparent !important;
}
.gd-trailer-add-header {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 999px;
    background: rgba(255,255,255,0.08);
    color: #fff;
    cursor: pointer;
}
.gd-creator-trailer-layout {
    display: grid;
    gap: 14px;
    overflow: visible;
}
.gd-creator-trailer-feature .gd-creator-trailer-row {
    min-height: 260px;
}
.gd-creator-trailer-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 10px;
}
.gd-creator-trailer-row {
    min-height: 92px;
    overflow: visible;
}
#gameDetailsView.gd-creator-preview .gd-trailer-add-header,
#gameDetailsView.gd-creator-preview .gd-creator-media-actions,
#gameDetailsView.gd-creator-preview .gd-creator-add-card { display: none !important; }

.gd-about-wrapper,
.gd-full-desc,
.gd-full-desc-text {
    max-height: none !important;
    overflow: visible !important;
}
.gd-full-desc-text {
    display: block !important;
    -webkit-line-clamp: unset !important;
    padding-bottom: 14px;
}
.gd-about-fade { display: none !important; }
.gd-short-desc-section,
#gdShortDescSection {
    overflow: visible;
}

.gd-rating-empty-card {
    width: 100%;
    border: 1px dashed rgba(255,255,255,0.18);
    background: rgba(255,255,255,0.06);
}
.gd-rating-block .gd-rating-label:empty,
.gd-rating-block .gd-stars:empty { display: none !important; }
.gd-rating-entry {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
}
.gd-re-info { min-width: 0; }
.gd-rating-entry-sub {
    white-space: normal !important;
    line-height: 1.35;
}
.gd-rating-form-grid {
    display: grid;
    gap: 12px;
}
.gd-rating-form-grid label {
    display: grid;
    gap: 7px;
    color: rgba(255,255,255,0.72);
    font-size: 0.78rem;
    font-weight: 800;
}
.gd-rating-step-head {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px;
    border-radius: 14px;
    background: rgba(255,255,255,0.06);
}
.gd-rating-step-head div { display: grid; gap: 3px; }
.gd-rating-step-head span,
.gd-rating-live-calc {
    color: rgba(255,255,255,0.58);
    font-size: 0.78rem;
}

.gd-dob-box { width: min(680px, 94vw); }
.gd-dob-picker {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
}
.gd-dob-column {
    min-width: 0;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
    background: rgba(255,255,255,0.055);
    overflow: hidden;
}
.gd-dob-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    color: rgba(255,255,255,0.62);
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .08em;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}
.gd-dob-list {
    max-height: 235px;
    overflow-y: auto;
    padding: 8px;
}
.gd-dob-option {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 10px;
    border: 0;
    border-radius: 11px;
    background: transparent;
    color: rgba(255,255,255,0.76);
    cursor: pointer;
}
.gd-dob-option small { color: rgba(255,255,255,0.42); }
.gd-dob-option:hover { background: rgba(255,255,255,0.08); color: #fff; }
.gd-dob-option.selected {
    background: rgba(255,255,255,0.92);
    color: #000;
}
.gd-dob-option.selected small { color: rgba(0,0,0,0.55); }
.gd-dp-selected-label {
    color: rgba(255,255,255,0.7);
    font-size: 0.82rem;
}

.driver-popover.gd-tour-popover,
.gd-tour-popover {
    background: rgba(18,18,20,0.96) !important;
    border: 1px solid rgba(255,255,255,0.14) !important;
    border-radius: 18px !important;
    color: #fff !important;
    box-shadow: 0 24px 80px rgba(0,0,0,0.55) !important;
    z-index: 999999 !important;
}

@media (max-width: 760px) {
    .gd-creator-toolbar { max-width: calc(100% - 22px); }
    .gd-creator-toolbar-actions #gdCreatorPreviewBtn { display: none; }
    .gd-dob-picker { grid-template-columns: 1fr; }
}

/* ============================================================
   CREATOR YT THUMB (non-link version)
   ============================================================ */
.gd-creator-yt-thumb {
    position: relative;
    display: block;
    flex: 1;
    min-width: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
    cursor: default;
}
.gd-creator-yt-thumb img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
    opacity: 0.75;
}

/* Custom thumbnail (overrides YouTube) */
.gd-creator-custom-thumb {
    position: relative;
    display: block;
    flex: 1;
    min-width: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
    cursor: default;
}
.gd-creator-custom-thumb img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
    opacity: 0.9;
}

/* Clean fallback — no large logo */
.gd-creator-trailer-fallback {
    width: 100%;
    aspect-ratio: 16/9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #0d0d12;
    border-radius: 8px;
    color: rgba(255,255,255,0.25);
    overflow: hidden;
}
.gd-creator-trailer-fallback-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.2);
}
.gd-ct-fallback-url {
    font-size: 0.68rem;
    color: rgba(255,255,255,0.2);
    max-width: 90%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
    padding: 0 8px;
}
.gd-creator-yt-play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 42px; height: 30px;
