/* ستايل زرار الـ Show More الجديد - Minimalist & Cinematic */
.gd-show-more-btn {
    pointer-events: auto;
    background: transparent;
    border: none;
    color: var(--gd-text);
    padding: 8px 16px;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 0;
    transition: color 0.3s ease, transform 0.3s ease;
    text-shadow: 0 4px 15px rgba(0,0,0,0.9); /* بيحافظ على قرايته بوضوح فوق التدرج */
}

/* السهم الصغير اللي جنب الكلمة (بدون الحاجة لـ SVG في الـ JS) */
.gd-show-more-btn::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.3s var(--gd-bezier);
}

/* التأثير لما الماوس ييجي عليه */
