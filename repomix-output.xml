#allGamesGrid.density-compact .ag-card-field {
    font-size: 9px;
    padding: 3px 5px;
}

/* In All Games tab, the new overlay (.ag-card-display-overlay) is the
   single source of truth for title/playtime/lastPlayed/installed.
   Hide the legacy .gc-info to avoid duplicated title text. */
#allGamesGrid .gc-info {
    display: none !important;
}
/* =================================================================== */
/* ALL GAMES — EMPTY ONBOARDING STATE                                  */
/* =================================================================== */

/* ── Toolbar hidden when no accounts linked ──────────────────────── */
.ag-toolbar-hidden {
    display: none !important;
}

/* ================================================================= */
/* ALL GAMES — EMPTY ONBOARDING: scoped to #allGamesGrid.ag-empty-mode */
/* ================================================================= */

/* Disable scroll on the main scroll container when in empty onboarding */
#mainContentArea.ag-no-scroll-empty {
    overflow-y: hidden !important;
}

/* All Games view: fill available height, no overflow */
#allGamesView.ag-empty-page {
    height: 100%;
    min-height: 0;
    overflow: hidden;
    flex-direction: column;
}

/* Hide toolbar in empty onboarding */
#allGamesView.ag-empty-page #agToolbarSticky {
    display: none !important;
}

/* Grid container in empty-mode: flex-fill, centred, no scroll */
#allGamesGrid.ag-empty-mode {
    flex: 1 1 auto;
    min-height: 0 !important;
    height: auto !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    width: 100% !important;
    max-width: none !important;
    grid-template-columns: none !important;
    gap: 0 !important;

    padding: 16px 32px 48px !important;
    overflow: visible !important;
    position: static !important;
    box-sizing: border-box !important;
}

/* Panel itself: no transform, no clipping */
#allGamesGrid.ag-empty-mode .ag-empty-onboarding {
    width: min(760px, 100%);
    max-width: 760px;
    max-height: none !important;
    margin: 0 auto;
    transform: none !important;
    box-sizing: border-box;
    overflow: visible !important;
}

/* ── Onboarding panel internals ───────────────────────────────────── */
.ag-empty-onboarding {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 32px 40px;
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    /* Very subtle green glow — not neon */
    background: radial-gradient(
        ellipse 65% 50% at 50% 52%,
        rgba(0, 200, 90, 0.045) 0%,
        transparent 70%
    );
}

/* ── Heading & sub-text ───────────────────────────────────────────── */
.ag-empty-heading {
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.01em;
    margin-bottom: 10px;
    text-align: center;
    position: relative;
}

.ag-empty-sub {
    font-family: var(--font-main);
    font-size: 0.88rem;
    color: var(--text-sec);
    text-align: center;
    max-width: 380px;
    line-height: 1.55;
    margin-bottom: 36px;
    position: relative;
}

/* ── Platform cards row ───────────────────────────────────────────── */
.ag-platform-cards {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
}

.ag-platform-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    width: 230px;
    padding: 22px 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    transition:
        background-color 0.18s ease,
        border-color 0.18s ease,
        transform 0.18s ease;
    cursor: default;
}

.ag-platform-card:hover {
    background: rgba(255, 255, 255, 0.065);
    border-color: rgba(0, 210, 100, 0.22);
    transform: translateY(-2px);
}

/* ── Card logo row ────────────────────────────────────────────────── */
.ag-pc-logo {
    display: flex;
    align-items: center;
    gap: 9px;
}

.ag-pc-logo img {
    width: 26px;
    height: 26px;
    object-fit: contain;
    flex-shrink: 0;
}

.ag-pc-logo img.ag-pc-invert {
    filter: brightness(0) invert(1);
    opacity: 0.85;
}

.ag-pc-platform-name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
}

/* ── Card description ─────────────────────────────────────────────── */
.ag-pc-desc {
    font-size: 0.78rem;
    color: var(--text-sec);
    line-height: 1.5;
    flex: 1;
}

/* ── CTA button — dark pill, subtle green border ─────────────────── */
.ag-pc-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(0, 210, 100, 0.90);
    background: rgba(0, 210, 100, 0.07);
    border: 1px solid rgba(0, 210, 100, 0.28);
    border-radius: 20px;
    cursor: pointer;
    transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease;
    font-family: var(--font-main);
    white-space: nowrap;
    margin-top: 4px;
}

.ag-pc-btn:hover {
    background: rgba(0, 210, 100, 0.13);
    border-color: rgba(0, 210, 100, 0.5);
    color: rgb(0, 220, 108);
}

.ag-pc-btn svg {
    flex-shrink: 0;
}

/* ── Secondary "Manage Accounts" link ────────────────────────────── */
.ag-empty-manage {
    margin-top: 28px;
    font-size: 0.78rem;
    color: #444;
    display: flex;
    align-items: center;
    gap: 6px;
    position: relative;
}

.ag-empty-manage button {
    background: none;
    border: none;
    cursor: pointer;
    color: #666;
    font-size: 0.78rem;
    font-family: var(--font-main);
    padding: 0;
    text-decoration: underline;
    text-decoration-color: rgba(255,255,255,0.15);
    transition: color 0.15s;
}

.ag-empty-manage button:hover {
    color: #aaa;
}

/* ============================================================
   ALL GAMES TOOLBAR — TWO-ROW RESPONSIVE LAYOUT
   Overrides accounts.css where needed with !important
   ============================================================ */

/* Toolbar: stack as column of rows, full width */
#agToolbarSticky .ag-toolbar {
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
    padding: 8px 0 6px !important;
    flex-wrap: nowrap !important;
    align-items: stretch !important;
    width: 100% !important;
}

/* Each row is a horizontal flex line */
.ag-toolbar-row {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    min-width: 0;
}

/* ROW 1: Search fills remaining space, controls stay right */
.ag-toolbar-row--top {
    flex-wrap: nowrap;
}

.ag-toolbar-row--top .ag-search-wrap {
    flex: 1 1 0;
    min-width: 80px;
    max-width: 260px;
}

.ag-toolbar-row--top .ag-controls-group {
    flex-shrink: 0;
    display: flex !important;
    align-items: center;
    gap: 5px;
    flex-wrap: nowrap;
    margin-left: auto;
}

/* ROW 2: Filters row — pills may wrap but account+installed stay together */
.ag-toolbar-row--filters {
    flex-wrap: wrap;
}

.ag-toolbar-row--filters .ag-filter-group {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 5px 6px;
    min-width: 0;
    flex: 1 1 auto;
}

.ag-filter-pills {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    flex-wrap: nowrap;
}

/* Search box */
#agToolbarSticky .ag-search-wrap {
    display: flex !important;
    align-items: center;
    gap: 5px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 7px;
    padding: 0 10px;
    height: 32px;
    min-width: 0;
    overflow: hidden;
}

#agToolbarSticky .ag-search-wrap svg { flex-shrink: 0; opacity: 0.4; }

#agToolbarSticky .ag-search-input {
    flex: 1 1 0;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    color: var(--text-primary, #eee);
    font-size: 0.8rem;
}

/* Account dropdown: constrained width + ellipsis */
.ag-toolbar-row--filters .ag-account-dropdown {
    min-width: 90px;
    max-width: 150px;
    flex-shrink: 1;
}

.ag-account-trigger {
    display: flex !important;
    align-items: center;
    gap: 5px;
    overflow: hidden;
    white-space: nowrap;
    min-width: 0;
    padding: 5px 12px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #aaa;
    background: rgba(255,255,255,0.05);
    border: 1.5px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    cursor: pointer;
    transition: color 0.12s, background-color 0.12s, border-color 0.12s;
}

.ag-account-trigger:hover {
    color: #fff;
    background: rgba(255,255,255,0.09);
    border-color: rgba(255,255,255,0.25);
}

.ag-account-trigger > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
}

/* Display panel: opens UPWARD so it's never clipped */
#agToolbarSticky .ag-display-dropdown {
    position: relative;
}

#agToolbarSticky .ag-display-panel {
    position: absolute !important;
    right: 0 !important;
    top: calc(100% + 6px) !important;
    bottom: auto !important;
    z-index: 300;
}

/* Result count: don't wrap */
#agToolbarSticky .ag-result-count {
    white-space: nowrap;
    font-size: 0.75rem;
    color: #555;
    flex-shrink: 0;
}

/* Header: All Games title + actions — never overlap */
#allGamesView .library-header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    flex-wrap: wrap !important;
    gap: 8px 14px !important;
    min-width: 0 !important;
}

#allGamesView .library-header .section-title {
    white-space: nowrap;
    flex-shrink: 0;
    min-width: 0;
}

#allGamesView .library-header .header-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-left: auto;
}
/* ============================================================
   All Games toolbar – responsive fix for account + installed
   ============================================================ */
#allGamesView .ag-toolbar-row--filters .ag-filter-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    width: 100%;
    min-width: 0;
}
#allGamesView .ag-filter-pills {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1 1 auto;
    min-width: 0;
    flex-wrap: wrap;
}
#allGamesView .ag-filter-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 0 0 auto;
    margin-left: auto;
    min-width: 0;
}
#allGamesView .ag-filter-actions .ag-account-dropdown {
    flex: 0 1 150px;
    min-width: 90px;
    max-width: 150px;
}
#allGamesView .ag-filter-actions .ag-account-trigger {
    height: 30px;
    min-width: 0;
}
#allGamesView .ag-filter-actions .ag-installed-toggle {
    flex: 0 0 auto;
    height: 30px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
/* When there is not enough horizontal space, put account+installed together on a clean second row */
@media (max-width: 720px) {
    #allGamesView .ag-filter-actions {
        width: 100%;
        margin-left: 0;
        justify-content: flex-start;
    }
    #allGamesView .ag-filter-actions .ag-account-dropdown {
        flex: 1 1 auto;
        max-width: none;
    }
}
/* Very small launcher width: keep the Installed button visible but compact */
@media (max-width: 520px) {
    #allGamesView .ag-filter-actions {
        flex-wrap: nowrap;
    }
    #allGamesView .ag-filter-actions .ag-account-dropdown {
        min-width: 0;
    }
    #allGamesView .ag-filter-actions .ag-installed-toggle {
        width: 32px;
        min-width: 32px;
        padding: 0;
        font-size: 0;
        gap: 0;
    }
    #allGamesView .ag-filter-actions .ag-installed-toggle svg {
        width: 13px;
        height: 13px;
    }
}

/* ============================================================
   Installed Games List - Comfortable spacing fix
   Fix image/title collision in #igListView
============================================================ */

/* Base installed list row/header columns */
#igListView .ag-list-header,
#igListView .ag-list-row {
    grid-template-columns: 58px minmax(0, 1fr) 140px 100px 120px 36px !important;
}

/* Make thumb column centered and non-overflowing */
#igListView .ag-col-thumb {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    padding-right: 12px !important;
    overflow: visible !important;
}

/* Keep title safely away from image */
#igListView .ag-col-title {
    min-width: 0 !important;
    padding-left: 8px !important;
}

#igListView .ag-col-title-text {
    display: block !important;
    min-width: 0 !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
}

/* Compact */
#igListView.density-compact .ag-list-header,
#igListView.density-compact .ag-list-row {
    grid-template-columns: 32px minmax(0, 1fr) 140px 100px 120px 36px !important;
}

#igListView.density-compact .ag-col-title {
    padding-left: 6px !important;
}

/* Normal */
#igListView.density-normal .ag-list-header,
#igListView.density-normal .ag-list-row {
    grid-template-columns: 46px minmax(0, 1fr) 110px 100px 120px 36px !important;
}

#igListView.density-comfortable .ag-list-header,
#igListView.density-comfortable .ag-list-row {
    grid-template-columns: 58px minmax(0, 1fr) 110px 100px 120px 36px !important;
}

#igListView.density-comfortable .ag-col-thumb {
    padding-right: 8px !important;
}

#igListView.density-comfortable .ag-col-title {
    padding-left: 2px !important;
}

/* ── Update badge pulse animation ── */
@keyframes badgePulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

/* ── Analytics consent overlay ── */
@keyframes consentSlideIn {
    from { opacity: 0; transform: translateY(20px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
}

.consent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    margin-bottom: 30px;
}

.consent-list-item {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
}

/* ========================================= */
/* COMMUNITY HUB                             */
/* ========================================= */

/* Help & Feedback dropdown — must opt out of title-bar drag region */
.help-dropdown-wrap,
.help-dropdown-wrap *,
.help-dropdown-menu,
.help-dropdown-menu *,
.help-dropdown-item {
    -webkit-app-region: no-drag;
}

.help-dropdown-wrap {
    position: relative;
    z-index: 100200;
    pointer-events: auto;
}

.help-dropdown-chevron {
    margin-left: 2px;
    opacity: 0.6;
    transition: transform 0.2s;
}

.help-dropdown-menu {
    display: none;
    position: fixed;
    min-width: 190px;
    background: #181818;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.55);
    z-index: 100250;
    padding: 5px;
    pointer-events: auto;
    -webkit-app-region: no-drag;
}
.help-dropdown-menu.active {
    display: block;
    pointer-events: auto;
    animation: helpDropdownIn 0.15s ease;
}

@keyframes helpDropdownIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
}

.help-dropdown-item {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.7);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 9px 11px;
    border-radius: 7px;
    cursor: pointer;
    text-align: left;
    transition: background 0.12s, color 0.12s;
    white-space: nowrap;
    pointer-events: auto;
    -webkit-app-region: no-drag;
    position: relative;
    z-index: 100260;
}
.help-dropdown-item:hover {
    background: rgba(255,255,255,0.07);
    color: #fff;
}
.help-dropdown-item--community {
    color: rgba(160,180,255,0.85);
}
.help-dropdown-item--community:hover {
    color: #c4cdff;
    background: rgba(88,101,242,0.12);
}

/* Modal overlay — same base as .settings-overlay */
.community-overlay {
    z-index: 10000;
}

.community-modal-box {
    background: #111;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 32px 32px 28px;
    max-width: 680px;
    width: 90%;
    max-height: 88vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 24px 60px rgba(0,0,0,0.7);
    animation: communitySlideIn 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes communitySlideIn {
    from { opacity: 0; transform: translateY(16px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0)    scale(1);    }
}

.community-close-btn {
    position: absolute;
    top: 16px; right: 16px;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.4);
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    transition: color 0.15s, background 0.15s;
}
.community-close-btn:hover { color: #fff; background: rgba(255,255,255,0.08); }

.community-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 28px;
}

.community-icon-wrap {
    width: 52px; height: 52px;
    border-radius: 14px;
    background: rgba(18, 206, 24, 0.08);
    border: 1px solid rgba(18, 206, 24, 0.18);
    display: flex; align-items: center; justify-content: center;
    color: #12ce18;
    margin-bottom: 14px;
}

.community-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 8px;
}

.community-subtitle {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.6;
    max-width: 460px;
    margin: 0;
}

/* Cards grid — 2 col desktop, 1 col narrow */
.community-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    align-items: stretch;
}

/* Last card is odd (5th) — span full width to avoid an awkward half-row */
.community-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
}

@media (max-width: 720px) {
    .community-cards-grid { grid-template-columns: 1fr; }
    .community-card:last-child:nth-child(odd) { grid-column: auto; }
}
@media (max-width: 520px) {
    .community-modal-box { padding: 22px 18px 20px; }
}

