test('rtia_awaitHydration: resolves when all games are hydrated', async () => {
    const games = [makeGame(), makeGame({ id: 'g2' })];
    setTimeout(() => { games[0]._heroHydrated = true; games[1]._heroHydrated = true; }, 50);
