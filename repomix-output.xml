    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #444;
    margin-bottom: 10px;
}
.adp-seg {
    display: flex;
    gap: 4px;
}
.adp-seg-btn {
    flex: 1; height: 28px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 6px;
    color: #555; font-size: 0.7rem; font-weight: 600;
    font-family: var(--font-main, sans-serif);
    cursor: pointer;
    transition: background 0.13s, border-color 0.13s, color 0.13s;
}
.adp-seg-btn:hover { background: rgba(255,255,255,0.07); color: #aaa; }
.adp-seg-btn.active { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.2); color: #fff; }

.adp-fields {
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.adp-field-toggle {
    display: flex; align-items: center; gap: 9px;
    padding: 5px 4px;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.12s;
}
.adp-field-toggle:hover { background: rgba(255,255,255,0.04); }
.adp-field-toggle input[type="checkbox"] {
    appearance: none; -webkit-appearance: none;
    width: 14px; height: 14px;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 4px;
    background: rgba(255,255,255,0.03);
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
    transition: background 0.12s, border-color 0.12s;
}
.adp-field-toggle input[type="checkbox"]:checked {
    background: rgba(255,255,255,0.8);
    border-color: rgba(255,255,255,0.8);
}
.adp-field-toggle input[type="checkbox"]:checked::after {
    content: '';
    position: absolute;
    top: 1px; left: 3px;
    width: 5px; height: 8px;
    border: 2px solid #111;
    border-top: none; border-left: none;
    transform: rotate(45deg);
}
.adp-field-toggle span {
    font-size: 0.78rem;
    color: #999;
}
.adp-field-toggle:has(input:checked) span { color: #ddd; }

/* ══════════════════════════════════════════════════════════════
   GRID DENSITY MODIFIERS
══════════════════════════════════════════════════════════════ */
#allGamesGrid.density-compact { --ag-min-card-w: 120px; }
#allGamesGrid.density-normal  { --ag-min-card-w: 160px; }
#allGamesGrid.density-large   { --ag-min-card-w: 210px; }

/* ── Field visibility on cards ─────────────────────── */
#allGamesGrid.hide-title .game-card-title { display: none; }
#allGamesGrid.hide-platforms .agc-badges-strip { display: none !important; }
#allGamesGrid.show-playtime .game-card-meta-playtime,
#allGamesGrid.show-lastPlayed .game-card-meta-lastplayed,
#allGamesGrid.show-installed .game-card-meta-installed,
#allGamesGrid.show-rating .game-card-meta-rating { display: flex; }

/* Extra metadata line under title */
.game-card-meta {
    display: flex; flex-wrap: wrap; gap: 4px;
    padding: 0 0 4px;
}
.game-card-meta-item {
    display: none;
    align-items: center; gap: 3px;
    font-size: 0.65rem; color: #555; font-weight: 600;
}
.game-card-meta-item svg { opacity: 0.5; }

/* ══════════════════════════════════════════════════════════════
   LIST VIEW
══════════════════════════════════════════════════════════════ */
.ag-list-view {
    width: 100%;
    font-size: 0.82rem;
}

.ag-list-header {
    display: grid;
    grid-template-columns: 48px 1fr 140px 100px 120px 36px;
    align-items: center;
    padding: 0 8px;
    height: 30px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    margin-bottom: 4px;
}
.ag-list-header .ag-list-col {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.7px;
    text-transform: uppercase;
    color: #333;
}

.ag-list-row {
    display: grid;
    grid-template-columns: 48px 1fr 140px 100px 120px 36px;
    align-items: center;
    padding: 5px 8px;
    border-radius: 8px;
    cursor: pointer;
    gap: 0;
    position: relative;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
}
.ag-list-row:last-child { border-bottom: none; }
.ag-list-row:hover {
    background: rgba(255,255,255,0.06);
    transform: scale(1.008);
    box-shadow: 0 2px 16px rgba(0,0,0,0.35);
    z-index: 1;
    border-bottom-color: transparent;
}
.ag-list-row:hover .ag-col-title-text { color: #fff; }

.ag-list-col { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 12px; }
.ag-col-thumb { padding-right: 10px; flex-shrink: 0; }
.ag-list-thumb {
    width: 38px; height: 38px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    display: block;
    flex-shrink: 0;
}
.ag-list-thumb-placeholder {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.06);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.ag-col-title-text {
    font-size: 0.84rem;
    font-weight: 600;
    color: #ccc;
    transition: color 0.13s;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.ag-col-meta {
    font-size: 0.72rem;
    color: #444;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.ag-list-badges {
    display: flex; gap: 4px; align-items: center;
    flex-wrap: wrap;
}
.ag-list-badge-img {
    width: 13px; height: 13px;
    object-fit: contain;
    opacity: 0.6;
}
.ag-list-badge-img-invert { filter: brightness(0) invert(1); }

/* Installed icon in list view — same icon for all rows, styling differs by state */
.ag-list-installed-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
}
.ag-list-installed-icon svg {
    color: rgba(255, 255, 255, 0.1);
    transition: color 0.15s;
}
.ag-list-installed-icon.is-installed svg {
    color: rgba(80, 210, 110, 0.85);
    filter: drop-shadow(0 0 4px rgba(80, 210, 110, 0.3));
}

/* List density modifiers */
.ag-list-view.density-compact .ag-list-row { padding: 3px 8px; }
.ag-list-view.density-compact .ag-list-thumb,
.ag-list-view.density-compact .ag-list-thumb-placeholder { width: 28px; height: 28px; border-radius: 50%; }
.ag-list-view.density-compact .ag-list-header,
.ag-list-view.density-compact .ag-list-row {
    grid-template-columns: 38px 1fr 140px 100px 120px 36px;
}
.ag-list-view.density-comfortable .ag-list-row { padding: 9px 8px; }
.ag-list-view.density-comfortable .ag-list-thumb,
.ag-list-view.density-comfortable .ag-list-thumb-placeholder { width: 48px; height: 48px; border-radius: 50%; }
.ag-list-view.density-comfortable .ag-list-header,
.ag-list-view.density-comfortable .ag-list-row {
    grid-template-columns: 58px 1fr 140px 100px 120px 36px;
}

/* Play button column */
.ag-col-play {
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; width: 36px;
}
.ag-list-play-btn {
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.04);
    color: #666;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    opacity: 0;
    padding: 0;
    transition: opacity 0.15s ease, background 0.15s ease, color 0.15s ease;
}
.ag-list-row:hover .ag-list-play-btn { opacity: 1; }
.ag-list-play-btn:hover {
    background: rgba(255,255,255,0.9);
    color: #000;
    border-color: transparent;
}

/* Hide list columns by field setting */
.ag-list-view.hide-platforms .ag-list-field-platforms,
.ag-list-view.hide-platforms .ag-col-platforms { display: none; }
.ag-list-view.hide-playtime .ag-list-field-playtime,
.ag-list-view.hide-playtime .ag-col-playtime { display: none; }
.ag-list-view.hide-lastPlayed .ag-list-field-lastPlayed,
.ag-list-view.hide-lastPlayed .ag-col-lastplayed { display: none; }
.ag-list-view.hide-installed .ag-list-field-installed,
.ag-list-view.hide-installed .ag-col-installed { display: none; }
.ag-list-view.hide-title .ag-col-title-text { opacity: 0.3; }

/* ── Post-Add Account Guide Card ─────────────────────────────────────────── */
@keyframes pagSlideIn {
    from { opacity: 0; transform: translateY(-10px); }
    to   { opacity: 1; transform: translateY(0); }
}

.post-add-guide {
    animation: pagSlideIn 0.25s ease forwards;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.08);
    background: #1c1c1c;
    padding: 16px 18px;
    margin: 0 0 14px 0;
}

.pag-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.pag-title {
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.01em;
}

.pag-dismiss {
    background: none;
    border: none;
    color: #777;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    padding: 0 0 0 8px;
    transition: color 0.15s;
}
.pag-dismiss:hover { color: #bbb; }

.pag-subtitle {
    font-size: 11.5px;
    color: #999;
    margin-bottom: 12px;
}

.pag-steps {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 12px;
}

.pag-step {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 12px;
    color: #ccc;
    line-height: 1.4;
}

.pag-step-num {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    color: #000;
    margin-top: 1px;
}

.pag-warning {
    font-size: 11px;
    color: #e8a000;
    background: rgba(232,160,0,0.08);
    border-left: 3px solid #e8a000;
    border-radius: 0 4px 4px 0;
    padding: 6px 8px;
    margin-bottom: 12px;
}

.pag-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.pag-btn-primary {
    flex: 1;
    min-width: 0;
    padding: 8px 12px;
    border: none;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: filter 0.15s, transform 0.1s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.pag-btn-primary:hover { filter: brightness(1.12); transform: translateY(-1px); }
.pag-btn-primary:active { transform: translateY(0); filter: brightness(0.95); }

.pag-btn-secondary {
    padding: 8px 12px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 7px;
    background: transparent;
    color: #999;
    font-size: 12px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
}
.pag-btn-secondary:hover { color: #ccc; border-color: rgba(255,255,255,0.25); }

/* ── Save Current button pulse ───────────────────────────────────────────── */
@keyframes accBtnPulse {
    0%   { box-shadow: 0 0 0 0 var(--pulse-color, rgba(255,255,255,0.4)); }
    60%  { box-shadow: 0 0 0 6px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
}

.acc-btn-pulse {
    animation: accBtnPulse 1.4s ease infinite;
}

/* ── Empty-state wrap — direct child of .accounts-page (column-flex) ────── */
/* Sits outside .accounts-list-section so no parent padding interferes.     */
.accounts-onboard-wrap {
    flex: 1;
    width: 100%;
    min-height: clamp(360px, 52vh, 620px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 80px 48px 56px;
    box-sizing: border-box;
    background: #080808;
}

/* ── Onboarding card ─────────────────────────────────────────────────────── */
.acc-onboard-card {
    max-width: 860px;
    width: 100%;
    margin: 0 auto;
    background: linear-gradient(160deg, #111214 0%, #0d0d0f 100%);
    border-radius: 20px;
    padding: 40px 44px;
    display: flex;
    flex-direction: column;
    gap: 28px;
}

.acc-onboard-top {
    display: flex;
    align-items: center;
    gap: 20px;
}

.acc-onboard-logo {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
}

.acc-onboard-logo img {
    width: 34px;
    height: 34px;
    object-fit: contain;
}

.acc-onboard-title {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
    margin: 0 0 4px;
}

.acc-onboard-sub {
    font-size: 13.5px;
    color: #888;
    margin: 0;
    line-height: 1.5;
}

.acc-onboard-steps {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.acc-onboard-step {
    display: flex;
    align-items: flex-start;
    gap: 14px;
}

.acc-onboard-step-num {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    margin-top: 2px;
}

.acc-onboard-step-text {
    font-size: 14px;
    color: #ccc;
    line-height: 1.5;
    padding-top: 4px;
}

.acc-onboard-step-text strong {
    color: #fff;
}

.acc-onboard-warning {
    font-size: 12.5px;
    color: #e8a000;
    background: rgba(232,160,0,0.07);
    border-left: 3px solid #e8a000;
    border-radius: 0 6px 6px 0;
    padding: 9px 12px;
    line-height: 1.5;
}

.acc-onboard-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 4px;
}

.acc-onboard-btn-primary {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 22px;
    border: none;
    border-radius: 10px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: filter 0.15s, transform 0.1s;
    white-space: nowrap;
}
.acc-onboard-btn-primary:hover  { filter: brightness(1.12); transform: translateY(-1px); }
.acc-onboard-btn-primary:active { transform: translateY(0);  filter: brightness(0.92); }

.acc-onboard-btn-secondary {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 18px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    background: transparent;
    color: #aaa;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
}
.acc-onboard-btn-secondary:hover { color: #ddd; border-color: rgba(255,255,255,0.28); }

@media (max-width: 640px) {
    .acc-onboard-card { padding: 28px 22px; }
    .acc-onboard-title { font-size: 17px; }
    .acc-onboard-actions { flex-direction: column; }
    .acc-onboard-btn-primary, .acc-onboard-btn-secondary { width: 100%; justify-content: center; }
}
/* ============================================================ */
/* ACCOUNT SHORTCUTS — Shortcut button, pill, capture modal     */
/* ============================================================ */

.acc-shortcut-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    min-width: 28px;
    padding: 0 6px;
    border-radius: 6px;
    border: 1px solid transparent;
    background: transparent;
    color: #555;
    cursor: pointer;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
    flex-shrink: 0;
}
.acc-shortcut-btn:hover {
    color: #aaa;
    background: rgba(255,255,255,0.06);
    border-color: rgba(255,255,255,0.1);
}
.acc-shortcut-btn.has-shortcut {
    color: #c8f0c8;
    border-color: rgba(100,220,100,0.22);
    background: rgba(40,200,60,0.08);
}
.acc-shortcut-btn.has-shortcut:hover {
    background: rgba(40,200,60,0.14);
    border-color: rgba(100,220,100,0.35);
}

.acc-shortcut-pill {
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.3px;
    white-space: nowrap;
    color: inherit;
}

/* Shortcut capture modal */
.shortcut-capture-box {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.04);
    color: #555;
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    cursor: default;
    user-select: none;
    text-align: center;
    padding: 0 12px;
}
.shortcut-capture-box.is-valid {
    border-color: rgba(18, 206, 24, 0.55);
    background: rgba(18, 206, 24, 0.10);
    color: #d9ffdc;
}
.shortcut-capture-box.is-invalid {
    border-color: rgba(255, 76, 96, 0.65);
    background: rgba(255, 76, 96, 0.08);
    color: #ffd6dc;
}

.shortcut-error {
    min-height: 18px;
    font-size: 12px;
    color: #ff5c6c;
    text-align: center;
    line-height: 1.4;
}

.shortcut-save-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    filter: grayscale(0.2);
}
