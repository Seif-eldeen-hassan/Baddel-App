    // ── Logo: SGDB → Steam CDN → RAWG → IGDB cover؛ لو فشل التحميل أو مفيش لوجو نعرض اسم اللعبة ──
    const logoDecision = {
        value: artLocked ? (game.logo || null) : (images.logo || game.logo || null),
