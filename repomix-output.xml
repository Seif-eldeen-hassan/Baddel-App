        if (!fsSync.existsSync(savedDir)) return [];
        const entries = await fs.readdir(savedDir, { withFileTypes: true });
        return entries
            .filter(e => e.isDirectory() && !e.name.includes('_OLD_'))
            .map(e => e.name);
    } catch { return []; }
}


async function getProfilesWithMeta(savedDir) {
