    const values = [
        title,
        entry?.title?.['*'],
        entry?.game?.title?.['*'],
        entry?.title,
        entry?.name,
        entry?._embedded?.product?.title,
        entry?.product?.title,
        entry?._libraryEntry?.title?.['*'],
        entry?._libraryEntry?.title,
        entry?._libraryEntry?.name,
