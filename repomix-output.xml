        game.launcherGameId,
        game?.allIds?.riot,
        command,
        gameName,
        gameId,
        game.id
    ].filter(Boolean).join(' ').toLowerCase();

    const productMatch = String(command || '').toLowerCase().match(/--launch-product=([a-z_]+)/i);
