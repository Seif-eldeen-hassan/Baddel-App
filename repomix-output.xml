    const vs = {
        items: [{ id: 'g1', title: 'Game 1' }],
        cardPool: new Map([[0, {}]]),
        totalHeight: 3200,
    };

    // Simulate _agEnsureVirtualGridIntegrity
    if (!vs.items.length === 0 || !(vs.cardPool instanceof Map) || vs.cardPool.size === 0) {
