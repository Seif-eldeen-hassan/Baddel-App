        } catch {
            return null;
        }
    }

    /**
     * Remove stored credentials for a specific account (called on unlink).
     */
    deleteCredentialsForAccount(steamId) {
        try {
            const cache = this._loadCache();
            if (cache._steamCredentialsByAccount) {
