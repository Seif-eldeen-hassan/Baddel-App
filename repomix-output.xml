        <p id="updateNotesFooter" class="update-notes-footer">Thanks for using Baddel.</p>

        <button type="button" class="update-notes-primary-btn" onclick="closeUpdateNotesModal()">
            Continue
        </button>
    </div>
</div><!-- end updateNotesModal -->

<div id="analyticsConsentOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:99999; align-items:center; justify-content:center; backdrop-filter:blur(8px);">
    
    <div id="analyticsConsentModal" style="
        background: #111;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 35px 40px;
        max-width: 750px;
        width: 90%;
        position: relative;
        animation: consentSlideIn 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
        box-shadow: 0 25px 60px rgba(0,0,0,0.8);
    ">
        
        <div style="display: flex; justify-content: center; margin-bottom: 30px;">
            <div style="width:64px; height:64px; border-radius:18px; background:rgba(34,255,68,0.06); border:1px solid rgba(34,255,68,0.15); display:flex; align-items:center; justify-content:center; box-shadow: 0 0 24px rgba(34,255,68,0.12), 0 10px 20px rgba(0,0,0,0.4);">
                <img src="assets/app_icon.png" alt="Baddel" style="width:46px; height:46px; border-radius:12px; object-fit:cover;">
            </div>
        </div>

        <div class="consent-grid">
            
            <div dir="ltr" style="font-family: 'Montserrat', sans-serif;">
                <h3 style="font-family:'Outfit', sans-serif; font-size: 1.3rem; font-weight: 800; color: #fff; margin:0 0 10px;">Help improve Baddel</h3>
                <p style="font-size: 0.85rem; color: rgba(255,255,255,0.5); line-height: 1.6; margin: 0 0 24px;">
                    Baddel can share <strong style="color:rgba(255,255,255,0.8);">anonymous usage data</strong> to help us understand which features matter most.
                </p>

                <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.05); border-radius:14px; padding:18px;">
                    <p style="font-size:0.7rem; font-weight:700; color:rgba(255,255,255,0.3); text-transform:uppercase; margin:0 0 16px; letter-spacing:1px;">What gets shared</p>
                    
                    <div class="consent-list-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1D9E75" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
                        <span style="font-size:0.82rem; color:rgba(255,255,255,0.7);">Platforms you use (Steam, Riot...)</span>
                    </div>
                    <div class="consent-list-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1D9E75" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
                        <span style="font-size:0.82rem; color:rgba(255,255,255,0.7);">Session length (e.g. 30–60 min)</span>
                    </div>
                    <div class="consent-list-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1D9E75" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
                        <span style="font-size:0.82rem; color:rgba(255,255,255,0.7);">Feature usage (UI clicks)</span>
                    </div>
                    <div class="consent-list-item" style="margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.05);">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E24B4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        <span style="font-size:0.82rem; color:#E24B4A;">No names, titles, or account IDs</span>
                    </div>
                </div>
            </div>

            <div dir="rtl" style="font-family: 'Tajawal', sans-serif;">
                <h3 style="font-size: 1.4rem; font-weight: 800; color: #fff; margin:0 0 8px;">ساعدنا في تحسين بَدِّل</h3>
                <p style="font-size: 0.95rem; color: rgba(255,255,255,0.5); line-height: 1.6; margin: 0 0 22px;">
                    البرنامج بيتيح مشاركة <strong style="color:rgba(255,255,255,0.8);">بيانات استخدام مجهولة الهوية</strong> عشان نفهم أكتر مميزات بتستخدمها ونطورها.
                </p>

                <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.05); border-radius:14px; padding:18px;">
                    <p style="font-size:0.85rem; font-weight:700; color:rgba(255,255,255,0.4); margin:0 0 16px;">إيه اللي بيتم جمعه؟</p>
                    
                    <div class="consent-list-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1D9E75" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
                        <span style="font-size:0.95rem; font-weight:500; color:rgba(255,255,255,0.7);">المنصات اللي بتلعب عليها</span>
                    </div>
                    <div class="consent-list-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1D9E75" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
                        <span style="font-size:0.95rem; font-weight:500; color:rgba(255,255,255,0.7);">مدة اللعب التقريبية لكل جلسة</span>
                    </div>
                    <div class="consent-list-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1D9E75" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
                        <span style="font-size:0.95rem; font-weight:500; color:rgba(255,255,255,0.7);">تفاعلك مع أزرار وخصائص اللانشر</span>
                    </div>
                    <div class="consent-list-item" style="margin-top: 16px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.05);">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E24B4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        <span style="font-size:0.95rem; font-weight:500; color:rgba(226,75,74,0.9);">مش بنسجل أي أسماء أو إيميلات</span>
                    </div>
                </div>
            </div>

        </div>

        <div style="border-top: 1px solid rgba(255,255,255,0.06); padding-top: 24px; display: flex; flex-direction: column; align-items: center; gap: 20px;">
            
            <p style="font-size:0.75rem; color:rgba(255,255,255,0.3); margin:0; text-align: center; max-width: 500px; line-height: 1.6;">
                Data is linked to a random device ID. You can opt out anytime from Settings.<br>
                <span style="font-family: 'Tajawal', sans-serif; font-size: 0.85rem; display: block; margin-top: 4px;">الداتا مربوطة برقم عشوائي مش بحسابك، وتقدر تقفلها في أي وقت.</span>
            </p>

            <div style="display:flex; gap:12px; width: 100%; max-width: 500px;">
                <button onclick="handleConsentDecline()" style="
                    flex:1; padding:12px; border-radius:10px;
                    background:transparent; border:1px solid rgba(255,255,255,0.1);
                    color:rgba(255,255,255,0.5); cursor:pointer; transition:0.2s;
                    display: flex; flex-direction: column; align-items: center; gap: 4px;
                " onmouseover="this.style.borderColor='rgba(255,255,255,0.2)';this.style.color='rgba(255,255,255,0.8)'"
                   onmouseout="this.style.borderColor='rgba(255,255,255,0.1)';this.style.color='rgba(255,255,255,0.5)'">
                    <span style="font-size:0.85rem; font-weight:600; font-family:'Montserrat',sans-serif;">No thanks</span>
                    <span style="font-size:0.85rem; font-weight:500; font-family:'Tajawal',sans-serif;">لا، شكراً</span>
                </button>
                
                <button onclick="handleConsentAccept()" style="
                    flex:1.5; padding:12px; border-radius:10px;
                    background:#fff; border:1px solid #fff;
                    color:#000; cursor:pointer; transition:0.2s;
                    display: flex; flex-direction: column; align-items: center; gap: 4px;
                " onmouseover="this.style.background='rgba(255,255,255,0.85)'"
                   onmouseout="this.style.background='#fff'">
                    <span style="font-size:0.85rem; font-weight:700; font-family:'Montserrat',sans-serif;">Share anonymous data</span>
                    <span style="font-size:0.95rem; font-weight:700; font-family:'Tajawal',sans-serif;">موافق على المشاركة</span>
                </button>
            </div>

        </div>

    </div>
</div>

    <div id="platformsModal" class="modal-overlay">
