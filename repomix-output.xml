    border-top: 1px solid rgba(255,255,255,0.06);
    flex-shrink: 0;
}


/* ============================================================
   GAME SETTINGS MODAL — UPGRADED
   ============================================================ */

.gs-modal {
    width: 700px;
    max-width: 95vw;
    padding: 28px;
    max-height: 88vh;
    overflow-y: auto;
}

.gs-modal-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
}

/* Images section: 3 columns */
.gs-images-section {
    display: grid;
    grid-template-columns: 160px 1fr 160px;
    gap: 16px;
    margin-top: 18px;
}

.gs-image-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
}


.gs-image-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 600;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

.gs-reset-btn {
    opacity: 0;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.08); /* لون رمادي شفاف هادي جداً */
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.gs-image-block:hover .gs-reset-btn {
    opacity: 1;
    pointer-events: auto;
}

.gs-reset-btn:hover {
    background: rgba(255, 255, 255, 0.15); /* ينور شوية لما تقف عليه */
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-1px);
}

/* Preview wrapper base */
.gs-preview-wrapper {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    background: #0d0d0d;
    border: 1px solid rgba(255,255,255,0.07);
    cursor: default;
    width: 100%; /* ضيف دي عشان تضمن إن العرض مظبوط */
}

/* Hero/Banner: landscape */
.gs-hero-wrapper {
    aspect-ratio: 16 / 7;
    cursor: grab;
}

.gs-hero-img {
    object-fit: cover;
    height: 100%;
    width: auto;
    min-width: 100%;
    position: absolute; /* التعديل السحري: هيمنع الصورة من مط الـ Modal */
    top: 0;             /* التثبيت لفوق */
    left: 0;            /* التثبيت للشمال */
    /* Pan handled via marginLeft JS */
}

/* Cover: portrait (2:3 approx) */
.gs-cover-wrapper {
    aspect-ratio: 2 / 3;
    cursor: grab;
}

.gs-cover-wrapper:active { 
    cursor: grabbing; 
}

.gs-cover-wrapper .gs-preview-img {
    object-fit: cover;
    object-position: center bottom;
}

.gs-hero-wrapper:active { cursor: grabbing; }

.gs-hero-pan-hint {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.62rem;
    color: rgba(255,255,255,0.3);
    background: rgba(0,0,0,0.5);
    padding: 2px 8px;
    border-radius: 10px;
    pointer-events: none;
    white-space: nowrap;
    transition: opacity 0.3s;
}

/* Logo: square transparent-bg */
.gs-logo-wrapper {
    aspect-ratio: 1 / 1;
}

.gs-logo-bg-checker {
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(45deg, #1a1a1a 25%, transparent 25%),
        linear-gradient(-45deg, #1a1a1a 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #1a1a1a 75%),
        linear-gradient(-45deg, transparent 75%, #1a1a1a 75%);
    background-size: 16px 16px;
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    background-color: #111;
    opacity: 0.6;
    pointer-events: none;
}

.gs-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.2s;
}

.gs-logo-img {
    object-fit: contain;
    padding: 10%;
    position: relative;
    z-index: 1;
}

/* Empty logo placeholder */
.gs-logo-empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.72rem;
    color: rgba(255,255,255,0.2);
    z-index: 1;
}

/* Overlay actions (hover reveal) */
.gs-overlay-actions {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0);
    opacity: 0;
    transition: opacity 0.2s, background 0.2s;
    z-index: 10;
}

.gs-preview-wrapper:hover .gs-overlay-actions {
    opacity: 1;
    background: rgba(0,0,0,0.55);
}

.gs-change-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.18);
    color: #fff;
    padding: 7px 14px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    transition: background 0.15s;
}
.gs-change-btn:hover { background: rgba(255,255,255,0.22); }

/* ============================================================
   RESPONSIVE: لو الشاشة ضيقة نحط الـ hero فوق والـ cover+logo تحت
   ============================================================ */
@media (max-width: 580px) {
    .gs-images-section {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto auto;
    }
    .gs-hero-block {
        grid-column: 1 / -1;
        order: -1;
    }
}

/* لما زرار الـ Reset الصغير يتقفل */
.gs-reset-btn:disabled {
    opacity: 0.3; /* خافت */
    background: rgba(255, 255, 255, 0.1); /* رمادي شفاف */
