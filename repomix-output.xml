                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
        
        <div style="display: flex; height: 380px;">
            
            <div id="platformsSidebar" style="width: 220px; border-right: 1px solid rgba(255,255,255,0.05); padding: 15px; background: rgba(0,0,0,0.2); overflow-y: auto;">
                
                <div class="platform-nav-item active" id="plat-nav-epic" onclick="openPlatformDetails('epic')">
