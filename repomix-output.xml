    opacity: 1 !important;
}

.surprise-me-section.has-hero-bg #roulettePoolBtn,
.roulette-section.has-hero-bg #roulettePoolBtn {
    background:
        linear-gradient(
            180deg,
            rgba(20, 20, 20, 0.82),
            rgba(5, 5, 5, 0.70)
        ) !important;
    border-color: rgba(255, 255, 255, 0.28) !important;
    color: #fff !important;
    box-shadow:
        0 12px 32px rgba(0, 0, 0, 0.48),
        0 0 0 1px rgba(0, 0, 0, 0.28),
        inset 0 1px 0 rgba(255, 255, 255, 0.12) !important;
}

#roulettePoolBtn:hover {
    background:
        linear-gradient(
            180deg,
            rgba(42, 42, 42, 0.9),
            rgba(14, 14, 14, 0.78)
        ) !important;
    border-color: rgba(255, 255, 255, 0.45) !important;
    color: #fff !important;
    transform: translateY(-1px);
}

/* Main CTA يفضل أبيض بس مش عريض زيادة */
.btn-play-result {
    width: 100% !important;
    max-width: 320px;
    height: 46px;
    border-radius: 13px;
