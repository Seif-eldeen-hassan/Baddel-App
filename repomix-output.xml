/* ═══════════════════════════════════════════════════════════════
   INSTALLED GAMES — DISPLAY PREFERENCES  (mirrors ag- patterns)
   ═══════════════════════════════════════════════════════════════ */

/* ── Sticky toolbar wrapper ─────────────────────────────────── */
.ig-toolbar-sticky {
    position: sticky;
    top: 0;
    z-index: 40;
    border-radius: 10px;
    transition: background 0.2s ease, box-shadow 0.2s ease, backdrop-filter 0.2s ease;
    /* overflow visible so dropdown menus can escape the toolbar row */
    overflow: visible;
}

.ig-toolbar-sticky.is-stuck {
    background: rgba(14, 14, 14, 0.82);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.55);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0;
}

/* ── Toolbar inner row: left group pushes right group to the end ─ */
.ig-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0 12px;
    flex-wrap: wrap;
    overflow: visible;
}

/* LEFT: search + platform + sort */
.ig-filter-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1 1 auto;
    flex-wrap: wrap;
    overflow: visible;
}

/* RIGHT: view toggle + display + count — mirrors .ag-controls-group from accounts.css */
/* ag-controls-group is already defined in accounts.css; no duplicate needed here.
   If accounts.css is absent the rule below is the safe fallback. */
.ig-toolbar .ag-controls-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    margin-left: auto;
    overflow: visible;
}

/* ── IG sort/platform dropdown trigger ──────────────────────── */
/* Mirrors ag-sort-trigger from accounts.css */
.ig-sort-dropdown {
    position: relative;
}

.ig-sort-trigger {
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    color: #ccc;
    padding: 7px 12px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    font-size: 0.82rem;
    white-space: nowrap;
    transition: border-color 0.12s, color 0.12s;
    min-width: 110px;
    justify-content: space-between;
}

.ig-sort-trigger:hover {
    border-color: #444;
    color: #fff;
}

/* ── IG dropdown menu ───────────────────────────────────────── */
/* Overrides .dropdown-menu defaults to ensure correct positioning
   and high enough z-index to clear the sticky toolbar and cards.  */
.ig-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 160px;
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 8px;
    z-index: 200;          /* above sticky toolbar z-index:40 and card hover z-index:10 */
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    animation: fadeUp 0.12s ease;
}

.ig-dropdown-menu.active { display: block; }

/* ── Spacing below sticky toolbar so first card row doesn't collide ── */
/* ISSUE 3 fix: 16px breathing room below the toolbar before cards start */
#gamesGrid,
.ig-list-view {
    margin-top: 16px;
}

/* ── Grid density classes ─────────────────────────────────────
   Controls card column width via auto-fill minmax.
   Aspect-ratio 2/3 is set on .game-card itself.
   FIX: Use 1fr as max so cards actually stretch to fill available space.
   A fixed max (like 260px) caps card growth and makes density differences
   imperceptible on wide screens. The min value controls how many columns
   auto-fill creates, which is the real size lever. */
#gamesGrid.density-compact {
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)) !important;
    gap: 12px !important;
}
#gamesGrid.density-normal {
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)) !important;
    gap: 20px !important;
}
#gamesGrid.density-large {
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)) !important;
    gap: 26px !important;
}

/* Compact: shrink padding and font so text fits in ~110px-wide cards */
#gamesGrid.density-compact .gc-info {
    padding: 8px;
    gap: 2px;
}
#gamesGrid.density-compact .gc-name {
    font-size: 0.72rem;
    line-height: 1.2;
}
#gamesGrid.density-compact .gc-time {
    font-size: 9px;
    gap: 3px;
}
#gamesGrid.density-compact .gc-time svg {
    width: 9px;
    height: 9px;
}

/* Large: slightly more generous */
#gamesGrid.density-large .gc-info {
    padding: 22px;
}
#gamesGrid.density-large .gc-name {
    font-size: 1.1rem;
}

/* ── ISSUE 3: Reduce hover lift on first row so cards clear the toolbar ──
   The toolbar is sticky at z-index 40. Cards hover to z-index 10.
   The lift (translateY -8px) combined with no top margin caused the first
   row to visually overlap the toolbar. We pull the lift down to -4px.
   This only applies inside installedGamesView so All Games is untouched. */
#installedGamesView .game-card:hover {
    transform: translateY(-4px) scale(1.03);
}

/* ── List view container ────────────────────────────────────── */
.ig-list-view {
    display: flex;
    flex-direction: column;
    width: 100%;
}

/* Smooth density transition on rows */
.ig-list-view .ag-list-row {
    transition: min-height 0.18s ease, padding 0.18s ease;
}

/* List density row heights — min-height + padding both change so the
   difference between Compact / Normal / Comfortable is unmistakable. */
.ig-list-view.density-compact     .ag-list-row { min-height: 44px; padding-top: 2px;  padding-bottom: 2px;  }
.ig-list-view.density-normal      .ag-list-row { min-height: 58px; padding-top: 6px;  padding-bottom: 6px;  }
.ig-list-view.density-comfortable .ag-list-row { min-height: 76px; padding-top: 11px; padding-bottom: 11px; }

/* Thumbnail scales with density — override accounts.css to keep circle */
.ig-list-view.density-compact .ag-list-thumb,
.ig-list-view.density-compact .ag-list-thumb-placeholder { width: 28px; height: 28px; border-radius: 50%; }
.ig-list-view.density-comfortable .ag-list-thumb,
.ig-list-view.density-comfortable .ag-list-thumb-placeholder { width: 48px; height: 48px; border-radius: 50%; }

/* ── Result count (safe fallback if accounts.css is absent) ─── */
.ag-result-count { font-size: 0.75rem; color: #555; white-space: nowrap; }
#igResultCount:empty { display: none; }

/* ── All Games account-menu: ensure high z-index & not clipped ─
   ISSUE 4 fallback: even without overflow-x:hidden the menu needs
   a z-index above the toolbar and cards.                       */
#agAccountMenu {
    z-index: 200;
}

/* ═══════════════════════════════════════════════════════════════
   FAVORITE HEART BUTTON ON GAME CARDS
   ═══════════════════════════════════════════════════════════════ */
.gc-fav-btn {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.12);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.65);
    opacity: 0;
    transform: scale(0.75);
    transition: opacity 0.18s ease, transform 0.18s ease, color 0.15s, background 0.15s;
    z-index: 4;
    padding: 0;
    flex-shrink: 0;
}

.game-card:hover .gc-fav-btn,
.game-card:focus-within .gc-fav-btn {
    opacity: 1;
    transform: scale(1);
}

/* Already favorited: always show the filled heart */
.gc-fav-btn.gc-fav-active {
    color: #ff375f;
    opacity: 1;
    transform: scale(1);
}

.gc-fav-btn:hover {
    background: rgba(0, 0, 0, 0.75);
    color: #ff375f;
    transform: scale(1.12) !important;
    border-color: rgba(255, 55, 95, 0.4);
}

.gc-fav-btn:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.7);
    outline-offset: 2px;
    opacity: 1;
    transform: scale(1);
}

.gc-fav-btn svg { pointer-events: none; }

/* ── Installed Games — field visibility via grid class toggles ─── */
#gamesGrid.ig-hide-title    .gc-name      { display: none; }
#gamesGrid.ig-hide-platform .gc-platforms { display: none; }
#gamesGrid.ig-hide-playtime .gc-time      { display: none; }

.gc-lastplayed {
    font-size: 10px;
    color: var(--text-sec);
    opacity: 0.7;
    display: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
#gamesGrid.ig-show-lastplayed .gc-lastplayed { display: block; }

/* ═══════════════════════════════════════════════════════════════ */
/* ═══════════════════════════════════════════════════════════════
   JUMP BACK IN — Recently Played Section (Reference Design)
   ═══════════════════════════════════════════════════════════════ */

/* ── Section padding override ──────────────────────────────── */
#recentlyPlayedSection {
    padding: 30px 40px;
}

/* ── Header row ─────────────────────────────────────────────── */
/* ══════════════════════════════════════════════════════════════
   RECENTLY PLAYED — "Jump Back In" section
   Design matches the reference cont-card cinematic style.
   ══════════════════════════════════════════════════════════════ */

/* ── Section header ──────────────────────────────────────────── */
.jbi-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 28px;
    gap: 24px;
}

.jbi-header-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.jbi-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-code);
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
}

.jbi-index {
    color: #3dff6e;
    font-weight: 500;
}

.jbi-label {
    /* inherits from .jbi-eyebrow — no overrides needed */
}

.jbi-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1;
    letter-spacing: -0.03em;
    display: flex;
    align-items: center;
    gap: 10px;
}
.jbi-title::before {
    content: '';
    display: block;
    width: 3px;
    height: 18px;
    background: var(--accent);
    border-radius: 3px;
    flex-shrink: 0;
}

.jbi-subtitle {
    font-style: normal;
    font-size: 2rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.38);
    letter-spacing: -0.03em;
}

/* ── Filter pills (right side of header) ─────────────────────── */
.jbi-filters {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
}

.jbi-filter {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.02);
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    font-family: var(--font-main);
}

.jbi-filter:hover {
    border-color: rgba(255, 255, 255, 0.22);
    color: #fff;
}

.jbi-filter--active {
    color: #3dff6e !important;
    border-color: rgba(61, 255, 110, 0.35) !important;
    background: rgba(61, 255, 110, 0.07) !important;
    font-weight: 600;
}

/* ── Grid ────────────────────────────────────────────────────── */
.jbi-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 20px;
    align-items: start;
}

/* ── Card base — full cinematic overlay card ─────────────────── */
.jbi-card {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: #0d0d0d;
    cursor: pointer;
    aspect-ratio: 16 / 9;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 0.3s ease;
}

.jbi-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.18);
    z-index: 10;
}

/* ── Cover image fills entire card ───────────────────────────── */
.jbi-cover {
    position: absolute;
    inset: 0;
}

/* Bottom-heavy gradient overlay — same as reference cont-card */
.jbi-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.95) 0%,
        rgba(0, 0, 0, 0.55) 40%,
        rgba(0, 0, 0, 0.10) 70%,
        transparent 100%
    );
    z-index: 1;
}

.jbi-cover-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111;
    color: rgba(255, 255, 255, 0.10);
    font-size: 3rem;
    font-weight: 800;
    font-family: var(--font-heading);
    letter-spacing: 0.05em;
}

.jbi-cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease, transform 0.35s ease;
}

.jbi-cover-img.img-loaded {
    opacity: 1;
}

.jbi-card:hover .jbi-cover-img {
    transform: scale(1.04);
}

/* Subtle watermark label top-left (same as reference) */
.jbi-cover-label {
    position: absolute;
    top: 14px;
    left: 14px;
    font-size: 9px;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.28);
    font-family: var(--font-code);
    text-transform: uppercase;
    z-index: 2;
    pointer-events: none;
}

/* ── Meta overlay — sits on top of gradient, bottom-left ─────── */
.jbi-body {
    position: absolute;
    left: 20px;
    right: 72px;          /* leave room for the play button */
    bottom: 18px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: none;
    padding: 0;
}

/* "LAST PLAYED · x days ago" tag */
.jbi-last-played {
    font-family: var(--font-code);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    line-height: 1;
}

.jbi-info-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.jbi-text {
    min-width: 0;
}

.jbi-name {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.1;
    letter-spacing: -0.02em;
}

.jbi-card--featured .jbi-name {
    font-size: 2rem;
    letter-spacing: -0.03em;
}

.jbi-sub {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.55);
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    overflow: hidden;
}

/* Dot separator between sub items */
.jbi-sub .jbi-sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    flex-shrink: 0;
}

/* ── Progress bar ────────────────────────────────────────────── */
.jbi-progress-track {
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 6px;
    /* width constrained by parent .jbi-body */
}

.jbi-card--featured .jbi-progress-track {
    width: 240px;
    max-width: 100%;
}

.jbi-progress-fill {
    height: 100%;
    background: #3dff6e;
    box-shadow: 0 0 8px rgba(61, 255, 110, 0.5);
    border-radius: 2px;
    transition: width 0.5s ease;
}

/* ── Play / Resume button — absolute, bottom-right ───────────── */
.jbi-play-btn {
    position: absolute;
    right: 18px;
    bottom: 18px;
    z-index: 4;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.92);
    color: #000;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding-left: 2px; /* optical ▶ centre */
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.jbi-play-btn:hover,
.jbi-card:hover .jbi-play-btn {
    background: #3dff6e;
    color: #000;
    transform: scale(1.08);
    box-shadow: 0 12px 36px rgba(61, 255, 110, 0.35);
}

.jbi-card--featured .jbi-play-btn {
    width: 58px;
    height: 58px;
}

.jbi-card--featured .jbi-play-btn svg {
    width: 20px;
    height: 20px;
}

/* ── Responsive ──────────────────────────────────────────────── */
@media (max-width: 900px) {
    .jbi-grid {
        grid-template-columns: 1fr 1fr;
    }
    .jbi-card--featured {
        grid-column: 1 / -1;
    }
}

@media (max-width: 600px) {
    .jbi-grid {
        grid-template-columns: 1fr;
    }
    .jbi-card--featured {
        grid-column: 1;
    }
}

/* ============================================================
   SYNCED LIBRARY SUGGESTIONS  –  Epic-style featured panel
   ============================================================ */

.synced-suggestions-section {
    padding: 28px 40px 36px;
}

.synced-wrap {
    position: relative;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 18px;
    overflow: hidden;
    background: #111113;
}

/* ── Decorative header pattern ── */
.synced-wrap::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 130px;
    pointer-events: none;
    z-index: 0;
    background-image:
        /* subtle dot grid */
        radial-gradient(circle, rgba(18,206,24,0.18) 1px, transparent 1px),
        /* green glow */
        radial-gradient(ellipse at 70% -20%, rgba(18,206,24,0.12) 0%, transparent 60%),
        /* dark fade at bottom */
        linear-gradient(to bottom, rgba(17,17,19,0) 0%, #111113 100%);
    background-size: 28px 28px, 100% 100%, 100% 100%;
    background-position: 0 0, 0 0, 0 0;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0) 100%);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0) 100%);
}

/* ── Head ── */
.synced-head {
    position: relative;
    z-index: 1;
    padding: 26px 32px 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
}

.synced-head-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    min-width: 0;
}

.synced-eye {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #12ce18;
    display: flex;
    align-items: center;
    gap: 8px;
}

.synced-pulse {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #12ce18;
    box-shadow: 0 0 8px #12ce18;
    flex-shrink: 0;
    animation: synced-pulse-anim 2s infinite;
}

@keyframes synced-pulse-anim {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
}

.synced-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.85rem;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #f5f5f7;
    margin: 0;
}

.synced-sub {
    color: rgba(255,255,255,0.38);
    font-size: 0.8rem;
    max-width: 480px;
    margin: 0;
    line-height: 1.5;
}

.synced-counts {
    display: flex;
    gap: 16px;
    align-self: flex-start;
    flex-shrink: 0;
}

/* Inline count — no box, just clean text */
.synced-count-inline {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
}

.sci-label {
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.28);
    font-weight: 600;
}

.sci-num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1;
    color: #f5f5f7;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
}

.sci-num.green { color: #12ce18; }

[data-ready-count] {
    display: inline-block;
    min-width: 2.5ch;
    text-align: right;
}

/* .sc, .sc .k, .sc .v — migrated to .synced-count-inline / .sci-* */
.sc .v.green { color: #12ce18; }
.sugg-stat { display: none; }

/* ── Filter row ── */
.synced-filters {
    padding: 18px 32px 16px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    margin-top: 18px;
}

.sugg-pill {
    padding: 6px 15px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.08);
    background: transparent;
    color: rgba(255,255,255,0.45);
    font-size: 0.73rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
}
.sugg-pill:hover {
    border-color: rgba(255,255,255,0.18);
    color: rgba(255,255,255,0.8);
    background: rgba(255,255,255,0.03);
}
.sugg-pill.active {
    color: #12ce18;
    border-color: rgba(18,206,24,0.4);
    background: rgba(18,206,24,0.07);
    font-weight: 700;
}

/* ── Loading ── */
.synced-sugg-loading {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 32px;
    color: rgba(255,255,255,0.28);
    font-size: 0.82rem;
}

.synced-spinner {
    width: 15px;
    height: 15px;
    border: 2px solid rgba(255,255,255,0.07);
    border-top-color: #12ce18;
    border-radius: 50%;
    animation: synced-spin 0.7s linear infinite;
    flex-shrink: 0;
}
@keyframes synced-spin { to { transform: rotate(360deg); } }

/* ── Body: 72/28 cinematic split ── */
.synced-body {
    display: grid;
    grid-template-columns: 3.2fr 1.3fr;
    gap: 0;
    align-items: stretch;
    min-height: 420px;
    height: 500px;
}

/* ── Feature column (left hero) ── */
.synced-feature {
    padding: 0;
    position: relative;
    overflow: hidden;
}

.sf-hero {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 500px;
    overflow: hidden;
    animation: sf-fade-in 0.4s ease;
}

@keyframes sf-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
}

.sf-hero-img {
    position: absolute;
    inset: -5%;
    background-size: cover;
    background-position: center 20%;
    transform-origin: center center;
    animation: sf-ken-burns 30s ease-in-out infinite alternate;
}

@keyframes sf-ken-burns {
    from { transform: scale(1); }
    to   { transform: scale(1.04); }
}

.sf-hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(10,10,14,0.05) 0%,
        rgba(10,10,14,0.20) 35%,
        rgba(10,10,14,0.75) 65%,
        rgba(10,10,14,0.97) 100%
    );
}

.sf-hero-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #141420 0%, #191924 100%);
}

/* Position counter – top-right of hero */
.sf-pos-counter {
    position: absolute;
    top: 18px;
    right: 20px;
    font-size: 0.62rem;
    font-weight: 700;
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.06em;
    background: rgba(0,0,0,0.38);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    padding: 4px 10px;
    font-variant-numeric: tabular-nums;
    z-index: 2;
}
.sf-pos-counter span { color: rgba(255,255,255,0.28); }

/* Content anchored bottom-left */
.sf-hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 36px 40px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 2;
}



.sf-title {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 20px rgba(0,0,0,0.5);
    margin: 0;
}

/* Logo lockup — replaces .sf-title when a game logo image is available */
.sf-logo {
    display: block;
    width: auto;
    height: auto;
    max-width: min(46vw, 480px);
    max-height: 128px;
    object-fit: contain;
    object-position: left center;
    /* Subtle drop-shadow so the logo reads against bright hero art */
    filter: drop-shadow(0 2px 12px rgba(0,0,0,0.55));
}

.sf-genres {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 2px;
}
.sf-genre-pill {
    font-size: 0.6rem;
    font-weight: 600;
    color: rgba(255,255,255,0.45);
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 2px 8px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.sf-desc {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.5);
    line-height: 1.55;
    margin: 2px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 520px;
}

.sf-cta {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    align-items: center;
}

.sf-btn-install {
    background: #12ce18;
    color: #021205;
    border: none;
    border-radius: 8px;
    padding: 10px 26px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: 0.04em;
    transition: filter 0.15s, transform 0.1s;
    box-shadow: 0 3px 14px rgba(18,206,24,0.28);
}
.sf-btn-install:hover { filter: brightness(1.1); transform: translateY(-1px); }
.sf-btn-install:active { transform: translateY(0); filter: brightness(0.95); }

.sf-btn-details {
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.75);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px;
    padding: 10px 22px;
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    letter-spacing: 0.03em;
    backdrop-filter: blur(6px);
    transition: background 0.15s, border-color 0.15s, transform 0.1s;
}
.sf-btn-details:hover {
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.22);
    transform: translateY(-1px);
}
.sf-btn-details:active { transform: translateY(0); }

.sugg-invert { filter: invert(1) brightness(0.85); }

/* ── Rail column (right) ── */
.synced-rail {
    display: flex;
    flex-direction: column;
    background: rgba(10,10,13,0.7);
    border-left: 1px solid rgba(255,255,255,0.05);
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.08) transparent;
    height: 100%;
}
.synced-rail::-webkit-scrollbar { width: 4px; }
.synced-rail::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 2px; }

.synced-rail-hdr {
    padding: 14px 16px 10px;
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.2);
    border-bottom: 1px solid rgba(255,255,255,0.04);
    flex-shrink: 0;
}

.sugg-rail-row {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 11px 14px;
    cursor: pointer;
    border-bottom: 1px solid rgba(255,255,255,0.035);
    transition: background 0.15s;
    outline: none;
    position: relative;
    flex-shrink: 0;
    flex: 1;
}
.sugg-rail-row:last-child { border-bottom: none; }
.sugg-rail-row:hover { background: rgba(255,255,255,0.04); }
.sugg-rail-row:focus-visible { box-shadow: inset 0 0 0 2px rgba(18,206,24,0.35); }

.sugg-rail-row.active { background: rgba(18,206,24,0.06); }
.sugg-rail-row.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 10px;
    width: 2.5px;
    border-radius: 0 2px 2px 0;
    background: #12ce18;
    box-shadow: 0 0 8px rgba(18,206,24,0.5);
}

.srr-thumb {
    width: 44px;
    min-width: 44px;
    height: 58px;
    border-radius: 5px;
    background-color: rgba(255,255,255,0.05);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    box-shadow: 0 2px 6px rgba(0,0,0,0.5);
}

.srr-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.srr-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255,255,255,0.75);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.25;
    transition: color 0.15s;
}
.sugg-rail-row:hover .srr-title { color: rgba(255,255,255,0.92); }
.sugg-rail-row.active .srr-title { color: #fff; }

.srr-plat {
    display: flex;
    align-items: center;
    gap: 4px;
    opacity: 0.42;
    transition: opacity 0.15s;
}
.sugg-rail-row:hover .srr-plat,
.sugg-rail-row.active .srr-plat { opacity: 0.62; }
.srr-plat img {
    width: 11px;
    height: 11px;
    object-fit: contain;
}
.srr-plat span {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: rgba(255,255,255,0.65);
    text-transform: uppercase;
}

.srr-chevron {
    font-size: 0.8rem;
    color: #12ce18;
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.15s;
    line-height: 1;
    font-weight: 300;
}
.sugg-rail-row.active .srr-chevron { opacity: 0.65; }

/* ── Empty state ── */
.synced-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 52px 32px;
    gap: 14px;
}
.synced-empty-icon {
    color: rgba(255,255,255,0.16);
    flex-shrink: 0;
}
.synced-empty-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
}
.synced-empty-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255,255,255,0.32);
}
.synced-empty-sub {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.18);
    max-width: 360px;
    line-height: 1.55;
}

/* ── Responsive: stack on narrow viewports ── */
@media (max-width: 1100px) {
    .synced-body {
        grid-template-columns: 1fr;
        min-height: auto;
    }
    .synced-feature { border-bottom: 1px solid rgba(255,255,255,0.05); }
    .sf-hero { min-height: 340px; }
    .sf-hero-content { padding: 24px 28px; }
    .sf-title { font-size: 1.7rem; }
    .sf-logo { max-width: min(72vw, 320px); max-height: 90px; }
    .synced-rail {
        flex-direction: row;
        flex-wrap: wrap;
        border-left: none;
        border-top: 1px solid rgba(255,255,255,0.05);
        overflow-x: auto;
        overflow-y: hidden;
    }
    .synced-rail-hdr { display: none; }
    .sugg-rail-row {
        flex: 1 1 45%;
        border-bottom: none;
        border-right: 1px solid rgba(255,255,255,0.035);
        min-height: 64px;
    }
    .sugg-rail-row:nth-child(2n) { border-right: none; }
    .sugg-rail-row.active::before {
        top: 0; bottom: auto;
        left: 10px; right: 10px;
        width: auto; height: 2.5px;
        border-radius: 0 0 2px 2px;
    }
    .srr-chevron { display: none; }
}

/* ============================================================
   SYNCED SUGGESTIONS — NO-ACCOUNT CTA
   ============================================================ */
.synced-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 245px;
    padding: 44px 32px 52px;
    gap: 14px;
    text-align: center;
