/* ========================================= */
/* MAIN APP LOADER (CINEMATIC ENTRY)         */
/* ========================================= */
/* ═══════════════════════════════════════════════════════
   BADDEL SPLASH SCREEN — JS-driven, no CSS auto-play
═══════════════════════════════════════════════════════ */

/* ── Container ─────────────────────────────────────── */
.loader-container {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: #060608;
    z-index: 99999;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s;
    overflow: hidden;
}
.loader-container.active {
    opacity: 1; pointer-events: all;
    visibility: visible;
}

/* ── Particle canvas ────────────────────────────────── */
.splash-canvas {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    opacity: 0;
    transition: opacity 1.6s ease;
    pointer-events: none;
}
.splash-canvas.visible { opacity: 1; }

/* ── Scan line sweep ────────────────────────────────── */
.splash-scan {
    position: absolute;
    left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg,
        transparent 0%,
        rgba(255,255,255,0.0) 10%,
        rgba(255,255,255,0.55) 50%,
        rgba(255,255,255,0.0) 90%,
        transparent 100%
    );
    top: -2px;
    opacity: 0;
    z-index: 10;
    pointer-events: none;
}

/* ── Corner brackets — tech UI ──────────────────────── */
.splash-corner {
    position: absolute;
    width: 26px; height: 26px;
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.7s cubic-bezier(.16,1,.3,1);
    z-index: 8;
    pointer-events: none;
}
.splash-corner::before,
.splash-corner::after {
    content: '';
    position: absolute;
    background: rgba(255,255,255,0.4);
}
.splash-corner::before { width: 100%; height: 1.5px; top: 0; }
.splash-corner::after  { width: 1.5px; height: 100%; top: 0; }

.splash-corner-tl { top: 24px; left: 28px; transform: translate(-6px,-6px); }
.splash-corner-tr { top: 24px; right: 28px; transform: translate(6px,-6px); transform-origin: right top; }
.splash-corner-bl { bottom: 24px; left: 28px; transform: translate(-6px,6px); transform-origin: left bottom; }
.splash-corner-br { bottom: 24px; right: 28px; transform: translate(6px,6px); transform-origin: right bottom; }

.splash-corner-tr::before { right: 0; }
.splash-corner-tr::after  { right: 0; left: auto; }
.splash-corner-bl::before { bottom: 0; top: auto; }
.splash-corner-bl::after  { bottom: 0; top: auto; }
.splash-corner-br::before { bottom: 0; top: auto; right: 0; }
.splash-corner-br::after  { right: 0; left: auto; bottom: 0; top: auto; }

.splash-corner.visible {
    opacity: 1;
    transform: translate(0,0) !important;
}

/* ── Top HUD bar ────────────────────────────────────── */
.splash-hud-top {
    position: absolute;
    top: 24px; left: 58px; right: 58px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 9;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.5s ease 0.2s, transform 0.6s cubic-bezier(.16,1,.3,1) 0.2s;
    pointer-events: none;
}
.splash-hud-top.visible { opacity: 1; transform: translateY(0); }

/* ── Bottom HUD bar ─────────────────────────────────── */
.splash-hud-bot {
    position: absolute;
    bottom: 24px; left: 58px; right: 58px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 9;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease 0.3s, transform 0.6s cubic-bezier(.16,1,.3,1) 0.3s;
    pointer-events: none;
}
.splash-hud-bot.visible { opacity: 1; transform: translateY(0); }

.splash-hud-text {
    font-family: var(--font-code);
    font-size: 8.5px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.18);
}
.splash-hud-dot {
    width: 4px; height: 4px; border-radius: 50%;
    background: rgba(255,255,255,0.5);
    animation: splashHudPulse 2s ease-in-out infinite;
}

/* ── Vignette ───────────────────────────────────────── */
.splash-vignette {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 75% 70% at 50% 50%, transparent 25%, rgba(0,0,0,0.75) 100%);
    pointer-events: none;
    z-index: 5;
}

/* ── Center stage ───────────────────────────────────── */
.splash-center {
    position: relative; z-index: 6;
    display: flex; flex-direction: column; align-items: center;
    gap: 0;
    opacity: 1;
}

/* ── Logo ring system ───────────────────────────────── */
.splash-logo-wrap {
    position: relative;
    width: 96px; height: 96px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 32px;
    opacity: 0;
    transform: scale(0.72);
    transition: opacity 0.7s cubic-bezier(.16,1,.3,1),
                transform 0.9s cubic-bezier(.16,1,.3,1);
}
.splash-logo-wrap.visible {
    opacity: 1; transform: scale(1);
}

/* ── Premium arc loader ─────────────────────────────── */

/* Static orbit baseline */
.splash-ring-outer {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.05);
    opacity: 0;
    transition: opacity 0.5s ease 0.6s;
    pointer-events: none;
}
.splash-logo-wrap.visible .splash-ring-outer { opacity: 1; }

/* SVG arc spinner — sits as a pseudo-element via a wrapper div */
.splash-ring-inner {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.5s ease 0.8s;
    pointer-events: none;
    /* SVG drawn via the ring canvas below */
}
.splash-logo-wrap.visible .splash-ring-inner { opacity: 1; }

/* Arc canvas — the actual animated element */
.splash-arc-svg {
    position: absolute;
    inset: -10px;
    width: calc(100% + 20px);
    height: calc(100% + 20px);
    opacity: 0;
    transition: opacity 0.5s ease 0.7s;
    pointer-events: none;
    overflow: visible;
}
.splash-logo-wrap.visible .splash-arc-svg { opacity: 1; }

/* Outer arc track (static faint circle) */
.splash-arc-track {
    fill: none;
    stroke: rgba(255,255,255,0.06);
    stroke-width: 1.2;
}

/* Primary chasing arc */
.splash-arc-primary {
    fill: none;
    stroke: rgba(255,255,255,0.85);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: 52 136;   /* arc length, gap to complete the circle */
    stroke-dashoffset: 0;
    transform-origin: center;
    animation: splashArcSpin 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    filter: drop-shadow(0 0 4px rgba(255,255,255,0.5));
}

/* Secondary trailing arc, smaller & dimmer */
.splash-arc-secondary {
    fill: none;
    stroke: rgba(255,255,255,0.22);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-dasharray: 28 160;
    stroke-dashoffset: 60;
    transform-origin: center;
    animation: splashArcSpin 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    animation-delay: -0.45s;
}

/* Inner micro-arc (tighter radius, counter-spin) */
.splash-arc-inner {
    fill: none;
    stroke: rgba(255,255,255,0.18);
    stroke-width: 1px;
    stroke-linecap: round;
    stroke-dasharray: 18 94;
    stroke-dashoffset: 0;
    transform-origin: center;
    animation: splashArcSpinReverse 2.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

/* Four static tick marks on the orbit ring */
.splash-arc-tick {
    fill: none;
    stroke: rgba(255,255,255,0.18);
    stroke-width: 2.5;
    stroke-linecap: round;
}

/* Logo image box */
.splash-logo-box {
    position: relative;
    width: 64px; height: 64px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow:
        0 0 0 1px rgba(255,255,255,0.07),
        0 20px 48px rgba(0,0,0,0.7),
        inset 0 1px 0 rgba(255,255,255,0.08);
}
/* Glint sweep */
.splash-logo-box::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
        115deg,
        transparent 0%,
        rgba(255,255,255,0.12) 45%,
        rgba(255,255,255,0.18) 50%,
        transparent 55%
    );
    transform: translateX(-200%);
    animation: splashLogoGlint 3.5s ease-in-out 1.2s infinite;
    z-index: 2;
}
.splash-logo-img {
    width: 100%; height: 100%;
    display: block;
    object-fit: cover;
    filter: brightness(0.92);
}

/* ── Wordmark ───────────────────────────────────────── */
.splash-wordstack {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    overflow: hidden;
    width: 100%;
    text-align: center;
}

.splash-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(20px, 2.2vw, 26px);
    letter-spacing: 0.52em;
    color: rgba(255,255,255,0.92);

    display: block;
    width: max-content;
    margin: 0 auto;
    text-align: center;
    padding-left: 0.52em;
    padding-right: 0;

    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.8s cubic-bezier(.16,1,.3,1);
}
.splash-name.visible { clip-path: inset(0 0% 0 0); }

.splash-sub {
    font-family: var(--font-code);
    font-size: 8.5px; letter-spacing: 0.28em; text-transform: uppercase;
    color: rgba(255,255,255,0.22);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(.16,1,.3,1);
}
.splash-sub.visible { opacity: 1; transform: translateY(0); }

/* ── Status row ─────────────────────────────────────── */
.splash-status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    opacity: 0;
    transition: opacity 0.4s ease;
}
.splash-status.visible { opacity: 1; }

.splash-status-dash {
    width: 18px; height: 1px;
    background: rgba(255,255,255,0.28);
}
.splash-status-text {
    font-family: var(--font-code);
    font-size: 8px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.28);
    transition: opacity 0.18s ease;
}
.splash-status-cursor {
    width: 1px; height: 10px;
    background: rgba(255,255,255,0.4);
    animation: splashCursorBlink 0.9s step-end infinite;
}

/* ── Progress hairline ──────────────────────────────── */
.splash-progress-track {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: rgba(255,255,255,0.04);
    z-index: 3;
    overflow: hidden;
}
.splash-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg,
        rgba(255,255,255,0.0) 0%,
        rgba(255,255,255,0.85) 60%,
        rgba(255,255,255,1.0) 100%
    );
    position: relative;
    will-change: width;
}
.splash-progress-bar::after {
    content: '';
    position: absolute;
    right: 0; top: -3px;
    width: 4px; height: 8px;
    background: #fff;
    border-radius: 2px;
    box-shadow: 0 0 12px 3px rgba(255,255,255,0.65);
}

/* ════════════════════════════════════════════════════
   KEYFRAMES
   ════════════════════════════════════════════════════ */

@keyframes splashArcSpin {
    0%   { transform: rotate(-90deg); }
    100% { transform: rotate(270deg); }
}
@keyframes splashArcSpinReverse {
    0%   { transform: rotate(90deg); }
    100% { transform: rotate(-270deg); }
}
@keyframes splashLogoGlint {
    0%  { transform: translateX(-200%); }
    40% { transform: translateX(200%); }
    100%{ transform: translateX(200%); }
}
@keyframes splashHudPulse {
    0%,100% { opacity: 0.5; transform: scale(1); }
    50%     { opacity: 1;   transform: scale(1.5); }
}
@keyframes splashCursorBlink {
    0%,100% { opacity: 1; }
    50%     { opacity: 0; }
}

/* ========================================= */
/* 🚀 AAA CINEMATIC LAUNCH OVERLAY           */
/* ========================================= */
.launch-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    z-index: 99998; background: #000; display: flex; align-items: center;
    justify-content: center; opacity: 0; pointer-events: none; 
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s;
}

.launch-overlay.active { 
    opacity: 1; pointer-events: all; 
    visibility: visible;
}

.launch-bg-wrapper { position: absolute; inset: 0; z-index: 0; overflow: hidden; }

.launch-bg-img {
    width: 100%; height: 100%; background-size: cover; background-position: center;
    filter: blur(6px) brightness(0.3); transform: scale(1.05);
}
.launch-overlay.active .launch-bg-img {
    animation: cinematicZoom 10s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

.vignette-overlay { position: absolute; inset: 0; background: radial-gradient(circle at center, transparent 15%, #000 95%); }

.launch-content {
    position: relative; z-index: 1; text-align: center; display: flex; flex-direction: column; align-items: center;
    transform: translateY(20px); opacity: 0;
}
.launch-overlay.active .launch-content {
    animation: riseUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s forwards;
}

.launch-game-logo {
    max-width: 320px; max-height: 130px; object-fit: contain; margin-bottom: 35px;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.8));
    animation: floatLogo 4s ease-in-out infinite;
}

.aaa-loader-container { display: flex; flex-direction: column; align-items: center; gap: 12px; width: 280px; }

.aaa-loader-text-row { display: flex; align-items: center; gap: 10px; }
.pulse-dot { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 10px var(--accent); animation: pulseDot 1.5s infinite; }
.aaa-status-text { color: rgba(255,255,255,0.9); font-size: 0.75rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }

.aaa-progress-track { width: 100%; height: 2px; background: rgba(255,255,255,0.08); border-radius: 2px; position: relative; overflow: hidden; }
.aaa-progress-fill {
    position: absolute; top: 0; left: -50%; width: 50%; height: 100%;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: scanline 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.aaa-progress-glow {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    box-shadow: 0 0 15px var(--accent); opacity: 0; animation: pulseGlow 1.8s infinite;
}

/* ========================================= */
/* 10. DRAG & DROP SMOOTHNESS (APPLE TV)     */
/* ========================================= */

.sortable-drag {
    opacity: 1 !important;
    transform: scale(1.08) translateY(-10px) !important;
    box-shadow: 0 30px 60px rgba(0,0,0,0.9) !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    cursor: grabbing !important;
    z-index: 9999 !important;
}

.sortable-ghost {
    opacity: 0.2;
    transform: scale(0.9);
    background: rgba(255, 255, 255, 0.05);
    border: 2px dashed rgba(255, 255, 255, 0.15);
    border-radius: 12px;
}

body.is-dragging, body.is-dragging * {
    cursor: grabbing !important;
}

.highlight-swap {
    border: 2px solid var(--accent) !important;
    transform: scale(1.05) !important;
    box-shadow: 0 10px 30px rgba(255, 255, 255, 0.2) !important;
    filter: brightness(1.2);
}

/* ── Drag handle — shown in top-left on card hover ── */
/* Drag handle: bottom-center, no background, only on hover */
.gc-drag-handle {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    z-index: 4;
    width: 32px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease, color 0.15s ease;
    cursor: grab;
    pointer-events: none;
}

.game-card:hover .gc-drag-handle {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
}

.gc-drag-handle:hover {
    color: rgba(255, 255, 255, 0.9);
}

.gc-drag-handle:active,
body.is-dragging .gc-drag-handle {
    cursor: grabbing;
}

/* ========================================= */
/* 11. SURPRISE ME (ROULETTE) - FULL WIDTH   */
/* ========================================= */
/* ── Surprise Me / Roulette Section — Compact Widget ─────────── */
.surprise-me-section,
.roulette-section {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    margin-top: 40px;
    margin-bottom: 40px;
    margin-inline: 40px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background-image:
        radial-gradient(rgba(255, 255, 255, 0.012) 1px, transparent 1px),
        linear-gradient(145deg, rgba(22, 22, 22, 0.95) 0%, rgba(10, 10, 10, 0.7) 100%);
    background-size: 28px 28px, 100% 100%;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
}

/* Background layers */
.surprise-me-section::before,
.roulette-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(circle at 50% 50%, rgba(255,255,255,.018), transparent 55%);
}

/* Overlay for hero bg state */
.surprise-me-section.has-hero-bg::after,
.roulette-section.has-hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
        linear-gradient(180deg,
            rgba(0,0,0,0.28) 0%,
            rgba(0,0,0,0.08) 40%,
            rgba(0,0,0,0.14) 65%,
            rgba(0,0,0,0.32) 100%
        ),
        radial-gradient(ellipse at center,
            rgba(0,0,0,0) 0%,
            rgba(0,0,0,0) 44%,
            rgba(0,0,0,0.32) 76%,
            rgba(0,0,0,0.62) 100%
        );
    box-shadow: inset 0 0 24px rgba(0,0,0,0.4);
}

/* All content above layers */
.surprise-me-section > *,
.roulette-section > * {
    position: relative;
    z-index: 2;
}
.surprise-me-section.has-hero-bg > *,
.roulette-section.has-hero-bg > * {
    position: relative;
    z-index: 2;
}

/* Hero bg image layer */
.surprise-me-section.has-hero-bg,
.roulette-section.has-hero-bg {
    background-image: none;
    background-color: #060606;
    border-color: rgba(255,255,255,0.055);
}

.surprise-me-section.has-hero-bg::before,
.roulette-section.has-hero-bg::before {
    content: "";
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: var(--roulette-hero-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: inherit;
    transform: scale(1.02);
    filter: brightness(0.92) saturate(1.06);
}

/* ── Shell: inner padding container ───────────────────────────── */
.roulette-shell {
    padding: 28px 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

/* ── Header: title + mode selector side by side ──────────────── */
.surprise-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
}

.surprise-header .section-title::before {
    display: none !important;
}

.surprise-header-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.surprise-header .section-title {
    font-size: 2.2rem;
    margin: 0;
    text-shadow: 0 2px 14px rgba(0,0,0,0.5);
    justify-content: flex-start;
    gap: 0;
}

.surprise-header p {
    font-size: 0.9rem;
    color: #888;
    margin: 0;
    line-height: 1.4;
}

/* ── Mode selector: pill row ──────────────────────────────────── */
.roulette-mode-selector {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.roulette-mode-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #555;
    margin: 0;
    white-space: nowrap;
}

.roulette-mode-btns {
    display: flex;
    gap: 7px;
}

.roulette-mode-btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.09);
    background: rgba(255,255,255,0.05);
    color: #999;
    cursor: pointer;
    transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.15s;
    font-family: inherit;
    white-space: nowrap;
}

.roulette-mode-btn:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.22);
    color: #ddd;
    transform: translateY(-1px);
}

.roulette-mode-btn.active {
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.46);
    color: #fff;
    box-shadow: 0 3px 12px rgba(0,0,0,0.22);
}

.roulette-mode-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    opacity: 0.65;
    transition: opacity 0.18s;
}
.roulette-mode-btn.active .roulette-mode-icon { opacity: 1; }

.roulette-mode-title {
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.02em;
}

.roulette-mode-sub {
    font-size: 0.66rem;
    color: #555;
    transition: color 0.18s;
}
.roulette-mode-btn.active .roulette-mode-sub { color: #888; }

/* has-hero-bg mode selector adjustments */
.surprise-me-section.has-hero-bg .roulette-mode-btn,
.roulette-section.has-hero-bg .roulette-mode-btn {
    background: rgba(0,0,0,0.28);
    border: 1px solid rgba(255,255,255,0.20);
    color: rgba(255,255,255,0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
}

.surprise-me-section.has-hero-bg .roulette-mode-btn.active,
.roulette-section.has-hero-bg .roulette-mode-btn.active {
    background: rgba(255,255,255,0.90);
    color: #000;
    border-color: rgba(255,255,255,0.95);
}

/* has-hero-bg text legibility */
.surprise-me-section.has-hero-bg .section-title,
.surprise-me-section.has-hero-bg .surprise-header p,
.surprise-me-section.has-hero-bg .roulette-mode-label {
    color: rgba(255,255,255,0.95);
    text-shadow: 0 2px 8px rgba(0,0,0,0.8);
}

/* ── Two-column layout ────────────────────────────────────────── */
.roulette-layout {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 36px;
}

.roulette-card-zone {
    flex-shrink: 0;
}

.roulette-action-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
}

/* ── Roulette card ────────────────────────────────────────────── */
.roulette-card {
    width: 200px;
    aspect-ratio: 2 / 3;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 12px 36px rgba(0,0,0,0.65);
    border: 1px solid rgba(255,255,255,0.1);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
    background: #0d0d0d;
}

/* ========================================= */

/* ========================================= */
#rouletteImg,
.roulette-card img#rouletteImg,
.roulette-card img {
    width: 100%; height: 100%; object-fit: cover; object-position: center;
    transition: filter 0.1s ease,
        transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    display: block;
}

.roulette-card.has-poster #rouletteGraphic { display: none !important; }
.roulette-card.has-poster #rouletteImg {
    display: block !important;
    opacity: 1 !important;
    object-fit: cover;
    object-position: center;
}

.roulette-card.spinning.has-poster #rouletteImg {
    display: block !important;
    opacity: 1 !important;
    object-fit: cover;
    object-position: center;
}

.roulette-card:not(.spinning):hover img {
    transform: scale(1.05);
    filter: brightness(0.6);
}

.roulette-card.spinning img {
    filter: blur(5px) brightness(0.7);
    transform: scale(1.05);
}

.roulette-card.winner {
    transform: scale(1.035);
    box-shadow: 0 20px 50px rgba(255,255,255,0.2);
    border-color: rgba(255,255,255,0.5);
}
.roulette-card.winner img { filter: brightness(1.1); }
.roulette-card.winner #rouletteImg.final-poster {
    transform: none !important;
    filter: none;
}

.roulette-overlay {
    position: absolute; inset: 0;
    /* Keep the subtle bottom vignette for card depth — no text inside */
    background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 40%);
    z-index: 5;
    pointer-events: none;
}

/* Caption below the card — clean, no clutter on the image */
.roulette-caption {
    margin-top: 10px;
    min-height: 2.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 8px;
}

.roulette-caption-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
    transition: opacity 0.15s ease;
}

/* Dim the placeholder text */
.roulette-caption-name:empty,
.roulette-card:not(.winner):not(.spinning) ~ .roulette-caption .roulette-caption-name {
    color: rgba(255, 255, 255, 0.35);
}

/* ========================================= */

/* ========================================= */
.roulette-css-graphic {
    position: absolute; inset: 0; width: 100%; height: 100%;
    
    
    background: transparent !important; 
    
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; z-index: 2;
}

.magic-blur {
    position: absolute; width: 150%; height: 150%;
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
    filter: blur(40px); opacity: 0.8;
}

.crystal-orb {
    position: relative; width: 120px; height: 120px;
    border-radius: 50%; 
    
    
    background: rgba(255, 255, 255, 0.005);
    
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.05), 0 10px 40px rgba(0, 0, 0, 0.5);
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px);
    animation: orbFloat 6s ease-in-out infinite; z-index: 3;
}

.inner-glow {
    width: 60px; height: 60px; border-radius: 50%;
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 70%);
    filter: blur(10px); animation: glowPulse 4s ease-in-out infinite;
}

.crystal-orb::after {
    content: '?'; font-family: var(--font-heading); font-size: 3rem; font-weight: 800;
    color: rgba(255, 255, 255, 0.1); position: absolute; text-shadow: 0 0 10px rgba(255, 255, 255, 0.1);
}

/* ========================================= */

/* ========================================= */
.roulette-controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.roulette-spin-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

/* ── Roulette mode selector — no longer used standalone, kept for compat ── */
.roulette-mode-selector-compat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
    position: relative;
    z-index: 1;
}

.roulette-mode-label-compat {
    font-size: 0.72rem;
    display: none;
}

@media (max-width: 600px) {
    .roulette-mode-sub { display: none; }
    .roulette-mode-btn { padding: 6px 11px; }
    .surprise-header { flex-direction: column; align-items: flex-start; gap: 12px; }
}

@media (max-width: 850px) {
    .roulette-layout {
        flex-direction: column;
        align-items: center;
        gap: 24px;
    }
    .roulette-action-panel {
        width: 100%;
        align-items: center;
    }
    .roulette-controls {
        width: 100%;
        align-items: center;
    }
    .roulette-spin-row {
        width: 100%;
        justify-content: center;
    }
    .btn-spin, .btn-play-result {
        width: 100%;
        max-width: 320px;
        justify-content: center;
        height: 46px;
    }
    .surprise-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
    }
    .roulette-shell { padding: 22px 22px 26px; }
}

.btn-spin {
    background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.15);
    padding: 13px 24px; border-radius: 11px; font-size: 0.95rem; font-weight: 700;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 9px; 
    backdrop-filter: blur(10px); transition: 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    flex: 1;
}
.btn-spin:hover:not(:disabled) { 
    background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.4); 
    transform: translateY(-2px); box-shadow: 0 8px 18px rgba(0,0,0,0.3); 
}
.btn-spin:disabled { opacity: 0.38; cursor: not-allowed; }

.btn-play-result {
    background: white; color: black; border: none;
    padding: 13px 24px; border-radius: 11px; font-size: 0.95rem; font-weight: 900;
    cursor: pointer; transition: 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 6px 20px rgba(255,255,255,0.22); display: flex; align-items: center; justify-content: center; gap: 8px;
    animation: fadeUp 0.3s ease forwards; width: 100%;
}
.btn-play-result:hover { 
    transform: translateY(-2px) scale(1.02); box-shadow: 0 12px 28px rgba(255,255,255,0.38); 
}

/* ========================================= */

/* ========================================= */
@keyframes orbFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}
@keyframes glowPulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.1); }
}
@keyframes cinematicZoom { from { transform: scale(1.05); } to { transform: scale(1.12); } }
@keyframes riseUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes floatLogo { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
@keyframes scanline { 0% { left: -50%; } 100% { left: 100%; } }
@keyframes pulseDot { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(0.7); opacity: 0.3; } }
@keyframes pulseGlow { 0%, 100% { opacity: 0; } 50% { opacity: 0.3; } }
@keyframes spin { to { transform: rotate(360deg); } }
.spin-anim { animation: spin 1s linear infinite; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
@keyframes slideInRight { from { transform: translateX(20px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
@keyframes fadeOutUp { to { opacity: 0; transform: translateY(-10px); } }

/* Keyframes Animations */
/* Animations */
@keyframes loadingBar { 0% { left: -40%; width: 40%; } 50% { left: 30%; width: 60%; } 100% { left: 100%; width: 40%; } }
@keyframes pulseText { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; text-shadow: 0 0 10px rgba(0,255,136,0.5); } }

/* ============================================= */
/* GAMER HUD STATS SECTION (PERFORMANCE OPTIMIZED)*/
/* ============================================= */
.system-stats-section { padding: 30px 40px 60px 40px; }

.sys-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }

.sys-live-dot {
    display: flex; align-items: center; gap: 8px;
    background: rgba(48, 209, 88, 0.1); border: 1px solid rgba(48, 209, 88, 0.2);
    border-radius: 4px; padding: 4px 10px;
}
.live-pulse { width: 8px; height: 8px; background: #30d158; border-radius: 50%; animation: blink 1.5s infinite; }
.live-label { font-size: 0.65rem; font-weight: 800; color: #30d158; letter-spacing: 1px; }
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

.hud-grid {
    display: grid; 
    /* 🔴 الكروت هتصغر لحد 180px وبعدين تنزل سطر جديد تلقائي */
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); 
    gap: 15px; /* */
}

.hud-card {
    background: #0f0f0f; 
    border: 1px solid #222; border-radius: 8px; padding: 20px;
    display: flex; flex-direction: column; gap: 10px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.5);
    transition: 0.2s;
}
.hud-card:hover { border-color: #444; background: #141414; transform: translateY(-3px); }

.hud-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 10px; /* 🔴 بيضمن إن الكلام ملمسش بعضه أبداً */
}

.hud-title {
    font-size: 1.1rem; /* */
    flex-shrink: 0;   /* 🔴 بيمنع كلمة NETWORK إنها تنضغط أو تصغر */
}

.hud-value {
    white-space: nowrap; /* 🔴 بيضمن إن الرقم والـ ms يفضلوا في سطر واحد */
}
.ping-val { color: #0a84ff; }

.hud-model { 
    font-size: 0.75rem; 
    color: #666; 
    
    
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    white-space: normal;
    line-height: 1.3;
    height: 2.6em; 
}
.hud-bar-bg { width: 100%; height: 6px; background: #222; border-radius: 3px; overflow: hidden; }
.hud-bar-fill { height: 100%; width: 0%; transition: width 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); }
.cpu-fill { background: #0a84ff; }
.gpu-fill { background: #ff453a; }
.ram-fill { background: #30d158; }

.hud-bottom { display: flex; justify-content: space-between; font-size: 0.75rem; color: #888; }
.hud-bottom strong { color: #ccc; }

.net-speeds { display: flex; flex-direction: column; gap: 6px; margin-top: 5px; }
.net-stat { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; font-weight: 600; color: #ccc; font-variant-numeric: tabular-nums; }
.net-icon.down { color: #0a84ff; }
.net-icon.up { color: #30d158; }

.hud-footer {
    margin-top: 20px; font-size: 0.7rem; color: #444; text-align: right;
    font-weight: 600; letter-spacing: 0.5px;
}

.item-icon svg { 
    width: 18px; 
    height: 18px; 
    display: block; 
}

.picker-header { 
    display: flex; 
    align-items: center; 
    gap: 10px; 
    margin-bottom: 15px; 
    padding-bottom: 15px; 
