test('Jump Back In canonicalizes recent games before resolving display image', () => {
    const src = fs.readFileSync(path.join(ROOT, 'src', 'js', 'app', 'game-card.js'), 'utf8');
    assert.match(src, /function _canonicalizeRecentGame/);
