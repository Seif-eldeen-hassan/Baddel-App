.linked-account-message {
    color: #888;
    font-size: 0.72rem;
    padding-top: 4px;
    border-top: 1px solid rgba(255,255,255,0.05);
}

.acc-mini-spinner {
    width: 10px;
    height: 10px;
    border: 2px solid rgba(102, 192, 244, 0.2);
    border-top-color: #66c0f4;
    border-radius: 50%;
