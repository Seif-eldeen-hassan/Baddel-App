        fetchMetadata(imgEl, game);
    } else {
        window.__baddelExploreCoverHydrationController?.reconcile?.('card-created');
    }

    // Favorite heart — stop propagation so it doesn't open Game Details
    const favBtn = card.querySelector('.gc-fav-btn');
