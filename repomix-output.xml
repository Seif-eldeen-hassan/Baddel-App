const ROOT            = path.resolve(__dirname, '..');
const APP_JS          = fs.readFileSync(path.join(ROOT, 'src/js/app.js'),                        'utf8');
const GAME_CARD_JS    = fs.readFileSync(path.join(ROOT, 'src/js/app/game-card.js'),               'utf8');
