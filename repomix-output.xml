.ag-sort-menu { min-width: 170px; }
.ag-sort-item.active { color: #fff !important; background: rgba(255,255,255,0.06) !important; }

/* ══════════════════════════════════════════════════════════════
   VIEW MODE TOGGLE
══════════════════════════════════════════════════════════════ */
.ag-view-toggle {
    display: flex;
    align-items: center;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px;
    overflow: hidden;
