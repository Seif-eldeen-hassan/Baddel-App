    const _buildRatingPill = (label, sublabel, score, maxScore, color) => {
        const s  = Number(score);
        const mx = Number(maxScore) || 100;
        const displayScore = mx <= 10 ? s.toFixed(1) : Math.round(s);
        const displayMax   = mx <= 10 ? mx : Math.round(mx);

        // Source icon mapping
