        0 0 0 1px rgba(0, 0, 0, 0.28),
        inset 0 1px 0 rgba(255, 255, 255, 0.12);
}

.btn-spin:hover:not(:disabled) {
    background:
        linear-gradient(
            180deg,
            rgba(38, 38, 38, 0.88),
            rgba(12, 12, 12, 0.78)
