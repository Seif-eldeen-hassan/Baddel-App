<file path="src/css/quick-switcher.css">
/* ── Quick Switcher — Full-Screen Carousel Overlay ─────────────────────────── */

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --qs-green:          #12CE18;
    --qs-green-dim:      rgba(18, 206, 24, 0.30);
    --qs-text-1:         rgba(255, 255, 255, 0.93);
    --qs-text-2:         rgba(255, 255, 255, 0.60);
    --qs-text-3:         rgba(255, 255, 255, 0.32);
    --qs-text-4:         rgba(255, 255, 255, 0.16);
    --qs-active-accent:  #12CE18;
}

/* ── Base ────────────────────────────────────────────────────────────────────── */

html, body {
    width: 100%;
    height: 100%;
    background: transparent !important;
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* ── Full-screen overlay ─────────────────────────────────────────────────────── */

.qs-overlay {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.74);
    backdrop-filter: blur(10px) saturate(0.85);
    -webkit-backdrop-filter: blur(10px) saturate(0.85);
    font-family: -apple-system, 'Segoe UI', system-ui, sans-serif;
    color: var(--qs-text-1);
    gap: 0;
    /* Start invisible; JS adds .is-open after accounts are rendered for a unified reveal. */
    opacity: 0;
    transform: scale(0.985);
}

/* Single reveal animation — fired once all content is ready. */
.qs-overlay.is-open {
    animation: qs-reveal 0.20s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes qs-reveal {
    from { opacity: 0; transform: scale(0.985); }
    to   { opacity: 1; transform: scale(1); }
}

/* ── Close button ────────────────────────────────────────────────────────────── */

.qs-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.10);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.40);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    z-index: 20;
}
.qs-close:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--qs-text-1);
}

/* ── Search zone ─────────────────────────────────────────────────────────────── */

.qs-search-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-bottom: 36px;
}

.qs-title-line {
    display: flex;
    align-items: center;
    gap: 10px;
}

.qs-title-text {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--qs-text-4);
    user-select: none;
}

.qs-hotkey-hint {
    font-size: 9px;
    color: var(--qs-text-4);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 5px;
    padding: 2px 6px;
    white-space: nowrap;
    user-select: none;
}

.qs-searchbar {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 580px;
    max-width: 90vw;
    height: 52px;
    padding: 0 20px;
    background: rgba(14, 16, 18, 0.90);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 28px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition: border-color 0.15s, box-shadow 0.15s;
}
.qs-searchbar:focus-within {
    border-color: rgba(18, 206, 24, 0.32);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.55), 0 0 0 3px rgba(18, 206, 24, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

.qs-search-icon {
    color: rgba(255, 255, 255, 0.26);
    flex-shrink: 0;
}

.qs-search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 16px;
    font-weight: 400;
    color: var(--qs-text-1);
    caret-color: var(--qs-green);
    min-width: 0;
}
.qs-search-input::placeholder {
    color: rgba(255, 255, 255, 0.22);
}

/* ── Platform filter icon buttons ────────────────────────────────────────────── */

.qs-platform-filters {
    display: flex;
    gap: 6px;
    justify-content: center;
    max-width: 580px;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px 2px;
}
.qs-platform-filters::-webkit-scrollbar { display: none; }
.qs-platform-filters:empty              { display: none; }

.qs-filter-chip {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    padding: 0;
    transition: background 0.13s, border-color 0.13s, box-shadow 0.13s;
    overflow: hidden;
}
.qs-filter-chip:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.14);
}
.qs-filter-chip.is-active {
    background: rgba(18, 206, 24, 0.12);
    border-color: rgba(18, 206, 24, 0.28);
    box-shadow: 0 0 8px rgba(18, 206, 24, 0.18);
}

/* Platform icon inside the button */
.qs-filter-icon {
    width: 16px;
    height: 16px;
    object-fit: contain;
    display: block;
    opacity: 0.48;
    transition: opacity 0.13s;
}
.qs-filter-chip:hover .qs-filter-icon,
.qs-filter-chip.is-active .qs-filter-icon { opacity: 0.88; }

/* Epic Games icon is dark on transparent — invert to white */
.qs-filter-chip[data-platform="epic"] .qs-filter-icon {
    filter: brightness(0) invert(1);
}

/* Fallback single-letter for platforms with no bundled icon */
.qs-filter-fallback {
    font-size: 10px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.50);
    user-select: none;
}
.qs-filter-chip:hover .qs-filter-fallback,
.qs-filter-chip.is-active .qs-filter-fallback { color: rgba(255, 255, 255, 0.85); }

/* "All accounts" grid icon uses currentColor */
.qs-filter-all {
    color: rgba(255, 255, 255, 0.40);
}
.qs-filter-all:hover       { color: rgba(255, 255, 255, 0.75); }
.qs-filter-all.is-active   { color: rgba(255, 255, 255, 0.88); }

/* Keyboard focus ring for platform filter chips */
.qs-filter-chip:focus-visible {
    outline: 2px solid rgba(18, 206, 24, 0.55);
    outline-offset: 2px;
}

/* ── Switching status ────────────────────────────────────────────────────────── */

.qs-switch-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.62);
    min-height: 26px;
    margin-top: 4px;
    opacity: 0;
    transition: opacity 0.20s ease;
    pointer-events: none;
    user-select: none;
}
.qs-switch-status.is-visible { opacity: 1; }

.qs-switch-status-spinner {
    width: 13px;
    height: 13px;
    border: 2px solid rgba(255, 255, 255, 0.10);
    border-top-color: var(--qs-green);
    border-radius: 50%;
    animation: qs-spin 0.65s linear infinite;
    flex-shrink: 0;
}

/* ── Carousel wrapper ────────────────────────────────────────────────────────── */

.qs-carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
}

/* ── Nav arrows ──────────────────────────────────────────────────────────────── */

.qs-nav {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.32);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    z-index: 15;
    margin: 0 28px;
}
.qs-nav:hover {
    background: rgba(255, 255, 255, 0.09);
    color: var(--qs-text-1);
    border-color: rgba(255, 255, 255, 0.16);
}
.qs-nav:disabled {
    opacity: 0.18;
    cursor: default;
}

/* ── Carousel track ──────────────────────────────────────────────────────────── */

/* ID overrides the legacy .qs-deck-results scroll constraints */
#quickSwitcherList {
    max-height: none !important;
    overflow: visible !important;
    height: 280px;
    scrollbar-width: none;
}

.qs-carousel {
    flex: 1;
    position: relative;
    height: 280px;
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* ── Carousel item / account card ────────────────────────────────────────────── */

.qs-carousel-item.qs-card {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    min-height: 46px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--qs-text-1);
    text-align: center;
    transform-origin: center center;
    /* JS sets --shift-x, --scale, --opacity, --z via inline style */
    transform: translate(calc(-50% + var(--shift-x, 0px)), -50%) scale(var(--scale, 1));
    opacity: var(--opacity, 1);
    z-index: var(--z, 1);
    transition:
        transform 0.30s cubic-bezier(0.16, 1, 0.3, 1),
        opacity   0.30s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    outline: none;
}

/* Keyboard focus on the selected card — avatar glow brightens slightly */
.qs-carousel-item.qs-card:focus-visible {
    outline: none;
}
.qs-carousel-item.qs-card:focus-visible .qs-card-avatar {
    box-shadow:
        0 0 0 6px rgba(18, 206, 24, 0.16),
        0 0 44px rgba(18, 206, 24, 0.30),
        0 14px 42px rgba(0, 0, 0, 0.58);
}

/* ── Card avatar ─────────────────────────────────────────────────────────────── */

.qs-card-avatar {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 2px solid rgba(255, 255, 255, 0.09);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    transition: border-color 0.28s, box-shadow 0.28s, background 0.28s;
}

.qs-card.is-selected .qs-card-avatar {
    border-color: rgba(18, 206, 24, 0.50);
    background: rgba(18, 206, 24, 0.05);
    box-shadow:
        0 0 0 5px rgba(18, 206, 24, 0.10),
        0 0 40px rgba(18, 206, 24, 0.22),
        0 12px 40px rgba(0, 0, 0, 0.55);
}

.qs-card.is-active .qs-card-avatar {
    box-shadow:
        inset 2px 0 0 var(--qs-active-accent),
        0 0 0 4px rgba(18, 206, 24, 0.12),
        0 0 40px rgba(18, 206, 24, 0.18),
        0 12px 40px rgba(0, 0, 0, 0.50);
}

.qs-card.is-active.is-selected .qs-card-avatar {
    border-color: rgba(18, 206, 24, 0.60);
    background: rgba(18, 206, 24, 0.07);
    box-shadow:
        inset 2px 0 0 var(--qs-active-accent),
        0 0 0 5px rgba(18, 206, 24, 0.14),
        0 0 40px rgba(18, 206, 24, 0.28),
        0 12px 40px rgba(0, 0, 0, 0.55);
}

.qs-card-icon {
    width: 48px;
    height: 48px;
    object-fit: contain;
    display: block;
}

.qs-card-icon-fallback {
    font-size: 30px;
    font-weight: 800;
    color: var(--qs-text-2);
    user-select: none;
}

/* Epic icon inversion */
.qs-card[data-platform="epic"] .qs-card-icon {
    filter: brightness(0) invert(1);
    opacity: 0.85;
}

/* ── Card body / text ────────────────────────────────────────────────────────── */

.qs-card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    max-width: 160px;
    min-width: 0;
}

.qs-card-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--qs-text-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 160px;
    transition: color 0.25s;
}

.qs-card.is-selected .qs-card-name {
    font-size: 15px;
    color: var(--qs-text-1);
}

.qs-card-platform {
    font-size: 10px;
    color: var(--qs-text-3);
    white-space: nowrap;
    transition: color 0.25s;
}

.qs-card.is-selected .qs-card-platform {
    color: var(--qs-text-2);
}

/* ── Card state / active pill ────────────────────────────────────────────────── */

.qs-card-state {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
}

.qs-active-pill {
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--qs-green);
    background: rgba(18, 206, 24, 0.09);
    border: 1px solid rgba(18, 206, 24, 0.18);
    border-radius: 20px;
    padding: 2px 7px;
}

/* ── Enter glyph ─────────────────────────────────────────────────────────────── */

.qs-enter-glyph {
    font-size: 13px;
    color: var(--qs-green);
    opacity: 0;
    transition: opacity 0.12s;
    line-height: 1;
}
.qs-card:hover .qs-enter-glyph,
.qs-carousel-item.is-selected .qs-enter-glyph {
    opacity: 0.65;
}

/* ── Switching state ─────────────────────────────────────────────────────────── */

.qs-carousel-item.is-switching,
.qs-card.is-switching {
    opacity: 0.25 !important;
    pointer-events: none;
}

/* ── Loading state ───────────────────────────────────────────────────────────── */

.qs-loading {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--qs-text-3);
    font-size: 13px;
}

.qs-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.07);
    border-top-color: var(--qs-green);
    border-radius: 50%;
    animation: qs-spin 0.65s linear infinite;
    flex-shrink: 0;
}

@keyframes qs-spin { to { transform: rotate(360deg); } }

/* ── Empty state ─────────────────────────────────────────────────────────────── */

.qs-carousel-empty {
    color: var(--qs-text-3);
    font-size: 15px;
    font-weight: 500;
}

/* ── Error ───────────────────────────────────────────────────────────────────── */

.qs-error {
    margin-top: 24px;
    font-size: 12px;
    color: #ff5c6c;
    min-height: 0;
    transition: all 0.15s;
}
.qs-error:not(:empty),
.qs-error-bar:not(:empty) {
    padding: 8px 16px;
    background: rgba(255, 76, 96, 0.08);
    border: 1px solid rgba(255, 76, 96, 0.20);
    border-radius: 10px;
}

/* ── Keyboard hints ──────────────────────────────────────────────────────────── */

.qs-deck-hints {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.17);
    letter-spacing: 0.02em;
    user-select: none;
    white-space: nowrap;
}

/* ── Reduced motion ──────────────────────────────────────────────────────────── */

@media (prefers-reduced-motion: reduce) {
    .qs-overlay.is-open    { animation: none; opacity: 1; transform: none; }
    .qs-carousel-item.qs-card { transition: none; }
    .qs-card-avatar        { transition: none; }
    .qs-spinner                  { animation: none; border-top-color: var(--qs-text-3); }
    .qs-switch-status-spinner    { animation: none; border-top-color: var(--qs-text-3); }
    .qs-filter-chip    { transition: none; }
    .qs-filter-icon    { transition: none; }
    .qs-nav                { transition: none; }
    .qs-close              { transition: none; }
    .qs-searchbar          { transition: none; }
    .qs-enter-glyph        { transition: none; }
}

/* ── Legacy compatibility stubs (required by test suite) ─────────────────────── */

/* These classes are not used in the carousel HTML but are checked by tests.     */
/* They are intentionally minimal and do not affect rendered output.              */

@keyframes qs-enter {
    from { opacity: 0; transform: translateY(-12px) scale(0.97); }
    to   { opacity: 1; transform: none; }
}

.qs-deck { max-width: 640px; }

.qs-bar { }

.qs-bar-shortcut {
    font-size: 9px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 5px;
    padding: 1px 5px;
}

.qs-deck-results {
    max-height: calc(100vh - 340px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.07) transparent;
}

.qs-platform-group { display: flex; flex-direction: column; gap: 3px; }
.qs-platform-chip  { display: inline-flex; align-items: center; gap: 5px; }
.qs-platform-count { font-size: 8.5px; }

.qs-chip-icon {
    width: 10px;
    height: 10px;
    object-fit: contain;
    display: block;
    opacity: 0.45;
}

.qs-chip-icon-fallback { font-size: 8px; }

.qs-shortcut-label {
    font-size: 9px;
    color: rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 4px;
    padding: 1px 5px;
}

/* Chip-level Epic icon inversion */
.qs-platform-chip[data-platform="epic"] .qs-chip-icon {
    filter: brightness(0) invert(1);
    opacity: 0.65;
}

/* Non-carousel fallback card styles (used by legacy test expectations) */
.qs-card {
    cursor: pointer;
    min-height: 46px;
}

.qs-card.is-active { }

.qs-card.is-selected {
    outline: none;
}

.qs-card.is-active.is-selected { }

/* ── Error-bar alias ─────────────────────────────────────────────────────────── */

.qs-error-bar {
    font-size: 12px;
    color: #ff5c6c;
    min-height: 0;
}
