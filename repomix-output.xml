            allIds: { steam: '12345' },
            steamAppId: '12345',
            platform: 'steam',
            appId: '12345',
        }
    );

    assert.deepEqual(keys.slice(0, 4), ['local-fall-guys', 'installed-fall-guys', 'epic:fall-guys', 'install-key']);
    assert.ok(keys.includes('12345'));
