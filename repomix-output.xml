<file path="src/css/play-launcher.css">
/* ============================================================
   BADDEL LAUNCHER - PLAY LAUNCHER MODAL (play-launcher.css)
   Aesthetic: Premium Dark, Cinematic, Glassmorphism
   ============================================================ */
@import url('./fonts.css');

/* ── Backdrop ── */
.pl-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease, backdrop-filter 0.3s ease;
}
.pl-backdrop.visible {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(20px) saturate(180%);
}

/* ── Modal Container ── */
.pl-modal {
    width: 560px;
    max-width: calc(100vw - 40px);
    max-height: 88vh;
    background: #111114;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow:
        0 0 0 1px rgba(255,255,255,0.04),
        0 40px 80px rgba(0, 0, 0, 0.7),
        0 0 120px rgba(0, 0, 0, 0.5);
    transform: scale(0.92) translateY(20px);
    opacity: 0;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease;
    will-change: transform, opacity;
}
.pl-modal.visible {
    transform: scale(1) translateY(0);
    opacity: 1;
}

/* ── Hero ── */
.pl-hero {
    position: relative;
    height: 130px;
    background-size: cover;
    background-position: center top;
    flex-shrink: 0;
}
.pl-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(0,0,0,0.35) 0%,
        rgba(17,17,20,0.9) 70%,
        #111114 100%
    );
}
.pl-hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 16px;
    padding: 0 24px 20px;
    height: 100%;
}
.pl-game-cover {
    width: 52px;
    height: 68px;
    object-fit: cover;
    object-position: center bottom;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    flex-shrink: 0;
}
.pl-game-cover-placeholder {
    width: 52px;
    height: 68px;
    border-radius: 10px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 700;
    color: rgba(255,255,255,0.4);
    flex-shrink: 0;
}
.pl-game-info {
    flex: 1;
    min-width: 0;
}
.pl-game-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 4px;
}
.pl-game-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #f5f5f7;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-brand);
}

/* ── Close Button ── */
.pl-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 10;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.7);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, transform 0.2s;
}
.pl-close-btn:hover {
    background: rgba(255,255,255,0.15);
    color: #fff;
    transform: scale(1.1) rotate(90deg);
}

/* ── Body ── */
.pl-body {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.1) transparent;
    padding: 4px 0 8px;
}
.pl-body::-webkit-scrollbar { width: 4px; }
.pl-body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }

/* ── Section ── */
.pl-section {
    padding: 18px 24px;
}
.pl-section-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
}
.pl-step-badge {
    width: 22px;
    height: 22px;
    border-radius: 50%;
