<file path="src/css/play-launcher.css">
/* ============================================================
   BADDEL LAUNCHER - PLAY LAUNCHER MODAL (play-launcher.css)
   Aesthetic: Premium Dark, Cinematic, Glassmorphism
   ============================================================ */
@import url('./fonts.css');

/* ── Backdrop ── */
.pl-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease, backdrop-filter 0.3s ease;
}
.pl-backdrop.visible {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(20px) saturate(180%);
}

/* ── Modal Container ── */
.pl-modal {
    width: 560px;
    max-width: calc(100vw - 40px);
    max-height: 88vh;
    background: #111114;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow:
        0 0 0 1px rgba(255,255,255,0.04),
        0 40px 80px rgba(0, 0, 0, 0.7),
        0 0 120px rgba(0, 0, 0, 0.5);
    transform: scale(0.92) translateY(20px);
    opacity: 0;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease;
    will-change: transform, opacity;
}
.pl-modal.visible {
    transform: scale(1) translateY(0);
    opacity: 1;
}

/* ── Hero ── */
.pl-hero {
    position: relative;
    height: 130px;
    background-size: cover;
    background-position: center top;
    flex-shrink: 0;
}
.pl-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(0,0,0,0.35) 0%,
        rgba(17,17,20,0.9) 70%,
        #111114 100%
    );
}
.pl-hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 16px;
    padding: 0 24px 20px;
    height: 100%;
}
.pl-game-cover {
    width: 52px;
    height: 68px;
    object-fit: cover;
    object-position: center bottom;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    flex-shrink: 0;
}
.pl-game-cover-placeholder {
    width: 52px;
    height: 68px;
    border-radius: 10px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 700;
    color: rgba(255,255,255,0.4);
    flex-shrink: 0;
}
.pl-game-info {
    flex: 1;
    min-width: 0;
}
.pl-game-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 4px;
}
.pl-game-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #f5f5f7;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-brand);
}

/* ── Close Button ── */
.pl-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 10;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.7);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, transform 0.2s;
}
.pl-close-btn:hover {
    background: rgba(255,255,255,0.15);
    color: #fff;
    transform: scale(1.1) rotate(90deg);
}

/* ── Body ── */
.pl-body {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.1) transparent;
    padding: 4px 0 8px;
}
.pl-body::-webkit-scrollbar { width: 4px; }
.pl-body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }

/* ── Section ── */
.pl-section {
    padding: 18px 24px;
}
.pl-section-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
}
.pl-step-badge {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    font-size: 0.7rem;
    font-weight: 700;
    color: rgba(255,255,255,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.pl-section-title {
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    text-transform: uppercase;
    letter-spacing: 0.08em;
}
.pl-section-sub {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.3);
    margin-left: auto;
}

/* ── Divider ── */
.pl-divider {
    height: 1px;
    background: rgba(255,255,255,0.05);
    margin: 0 24px;
}

/* ── Platform Cards ── */
.pl-platforms-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}
.pl-platform-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 14px 16px 12px;
    background: rgba(255,255,255,0.03);
    border: 1.5px solid rgba(255,255,255,0.07);
    border-radius: 14px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    min-width: 88px;
    user-select: none;
}
.pl-platform-card:hover {
    background: rgba(255,255,255,0.07);
    border-color: rgba(255,255,255,0.15);
    transform: translateY(-2px);
}
.pl-platform-card.selected {
    background: color-mix(in srgb, var(--plat-accent, #fff) 12%, transparent);
    border-color: var(--plat-accent, #fff);
    box-shadow: 0 0 16px color-mix(in srgb, var(--plat-accent, #fff) 20%, transparent);
}
.pl-platform-icon-wrap {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.pl-platform-icon-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}
.pl-platform-name {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    text-align: center;
    white-space: nowrap;
}
.pl-platform-card.selected .pl-platform-name {
    color: #fff;
}
.pl-primary-star {
    position: absolute;
    top: 6px;
    right: 8px;
    font-size: 0.75rem;
    color: #ffd700;
    line-height: 1;
}

/* Set Primary hint */
.pl-platform-card .pl-set-primary-btn {
    display: none;
    position: absolute;
    top: -10px;
    right: -10px;
    background: #1c1c1e;
    border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.5);
    font-size: 0.6rem;
    padding: 2px 6px;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    z-index: 5;
    transition: 0.2s;
}
.pl-platform-card:hover .pl-set-primary-btn {
    display: block;
}
.pl-set-primary-btn:hover {
    color: #ffd700;
    border-color: rgba(255,215,0,0.3);
}

/* Primary hint line */
.pl-primary-hint {
    margin-top: 10px;
    font-size: 0.72rem;
    color: #ffd700;
    opacity: 0;
    transition: opacity 0.4s ease;
    height: 16px;
}

/* ── Accounts List ── */
.pl-accounts-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 215px; /* 🟢 الارتفاع ثابت دايماً عشان نمنع حركة الفتح والقفل */
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.08) transparent;
    padding-right: 4px;
    transition: opacity 0.15s ease-in-out;
}
.pl-accounts-list::-webkit-scrollbar { width: 4px; }
.pl-accounts-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 4px; }

/* ── Loading State ── */
.pl-accounts-loading {
    display: flex;
    align-items: center;
    justify-content: center; /* 🟢 توسيط اللودنج في النص بالظبط */
    height: 100%; /* 🟢 بياخد مساحة الصندوق كله */
    gap: 10px;
    margin: 0;
    color: rgba(255,255,255,0.4);
    font-size: 0.85rem;
}

.pl-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255,255,255,0.1);
    border-top-color: rgba(255,255,255,0.5);
    border-radius: 50%;
    animation: plSpin 0.8s linear infinite;
}
@keyframes plSpin { to { transform: rotate(360deg); } }

.pl-no-accounts {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center; /* 🟢 توسيط في النص بالظبط */
    height: 100%; /* 🟢 بياخد مساحة الصندوق كله */
    gap: 8px;
    margin: 0;
    color: rgba(255,255,255,0.3);
    font-size: 0.82rem;
    text-align: center;
}
.pl-no-accounts svg { opacity: 0.3; }
.pl-no-accounts-sub {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.2);
    max-width: 260px;
    line-height: 1.5;
}
.pl-btn-no-account-play {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.7);
    padding: 8px 18px;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
}
.pl-btn-no-account-play:hover {
    background: rgba(255,255,255,0.14);
    color: #fff;
}

/* ── Account Row ── */
.pl-account-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    background: rgba(255,255,255,0.03);
    border: 1.5px solid rgba(255,255,255,0.05);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
    position: relative;
}
.pl-account-row:hover {
    background: rgba(255,255,255,0.07);
    border-color: rgba(255,255,255,0.1);
}
.pl-account-row.selected {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.25);
}
.pl-account-row.selected .pl-account-check::after {
    opacity: 1;
    transform: scale(1);
}
.pl-account-row.no-switch {
    border-style: dashed;
    border-color: rgba(255,255,255,0.08);
}
.pl-account-row.no-switch:hover {
    border-color: rgba(255,255,255,0.15);
}

.pl-account-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    border: 1.5px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: rgba(255,255,255,0.6);
    flex-shrink: 0;
    overflow: hidden;
}
.pl-account-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%; 
}
.no-switch-icon {
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.35);
}

.pl-account-info {
    flex: 1;
    min-width: 0;
}
.pl-account-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: #f5f5f7;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.pl-account-sub {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.35);
    margin-top: 2px;
}

.pl-owned-badge {
    font-size: 0.65rem;
    font-weight: 600;
    color: #30d158;
    background: rgba(48, 209, 88, 0.12);
    border: 1px solid rgba(48, 209, 88, 0.25);
    padding: 3px 8px;
    border-radius: 6px;
    white-space: nowrap;
}

.pl-account-check {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.15);
    flex-shrink: 0;
    position: relative;
    transition: border-color 0.2s;
}
.pl-account-row.selected .pl-account-check {
    border-color: #fff;
    background: #fff;
}
.pl-account-check::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 5px;
    height: 8px;
    border: 2px solid #111;
    border-top: none;
    border-left: none;
    transform: translate(-50%, -60%) rotate(45deg) scale(0);
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
}
.pl-account-row.selected .pl-account-check::after {
    opacity: 1;
    transform: translate(-50%, -60%) rotate(45deg) scale(1);
}

.pl-link-btn {
    background: none;
    border: none;
    color: rgba(255,255,255,0.5);
    text-decoration: underline;
    cursor: pointer;
    font-size: 0.8rem;
    padding: 0;
}
.pl-link-btn:hover { color: #fff; }

/* ── Footer ── */
.pl-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    padding: 16px 24px;
    border-top: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.01);
    flex-shrink: 0;
}
.pl-btn-cancel {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.5);
    padding: 9px 20px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
}
.pl-btn-cancel:hover {
    background: rgba(255,255,255,0.1);
    color: #fff;
}
.pl-btn-launch {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    color: #000;
    border: none;
    padding: 10px 26px;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    letter-spacing: 0.02em;
}
.pl-btn-launch:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(255,255,255,0.2);
}
.pl-btn-launch:active {
    transform: scale(0.97);
}

/* ── Ownership Badges ── */
.pl-badge-unknown {
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.45);
    border: 1px solid rgba(255,255,255,0.12);
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 10px;
    white-space: nowrap;
    cursor: help;
}
.pl-badge-missing {
    color: #ffb020;
    background: rgba(255, 176, 32, 0.10);
    border-color: rgba(255, 176, 32, 0.30);
}
.po-row-disabled {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
}
.pl-badge-owned {
    color: #30d158;
    background: rgba(48, 209, 88, 0.12);
    border-color: rgba(48, 209, 88, 0.25);
}
.pl-badge-not-owned {
    color: rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.08);
}
.pl-badge-install-only {
    color: #ffb020;
    background: rgba(255, 176, 32, 0.12);
    border-color: rgba(255, 176, 32, 0.35);
}
.pl-badge-synced {
    color: #66c0f4;
    background: rgba(102, 192, 244, 0.1);
    border-color: rgba(102, 192, 244, 0.2);
}

/* ── Ghost Account Row (owned but not in switcher) ── */
.pl-account-row-ghost {
    opacity: 0.6;
    cursor: default !important;
    pointer-events: none;
    border-style: dashed !important;
    border-color: rgba(48, 209, 88, 0.2) !important;
    background: rgba(48, 209, 88, 0.03) !important;
    position: relative;
}

/* نخلي الـ tooltip wrapper يقدر ياخد الـ hover */
.pl-ghost-wrapper {
    position: relative;
    pointer-events: auto;
    border-radius: 12px;
}
/* جسر وهمي يسد الـ gap بين الـ row والـ tooltip عشان الـ hover ميتكسرش */
.pl-ghost-wrapper::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    height: 14px;
    z-index: 99;
}
.pl-ghost-wrapper:hover .pl-ghost-tooltip,
.pl-ghost-tooltip:hover {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
}

/* ── Ghost Custom Tooltip ── */
.pl-ghost-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    background: #1c1c20;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    padding: 10px 13px 13px;
    width: 240px;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
    box-shadow: 0 8px 32px rgba(0,0,0,0.6);
}
.pl-ghost-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: rgba(255,255,255,0.12);
}
.pl-ghost-tooltip-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: #f5f5f7;
    margin-bottom: 4px;
}
.pl-ghost-tooltip-body {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.5;
    margin-bottom: 9px;
}
.pl-ghost-go-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
    color: rgba(255,255,255,0.85);
    padding: 6px 12px;
    border-radius: 7px;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.18s, color 0.18s;
    letter-spacing: 0.02em;
}
.pl-ghost-go-btn:hover {
    background: rgba(255,255,255,0.15);
    color: #fff;
}




.pl-selected-platform-icon img {
    width: 20px;
    height: 20px;
    object-fit: contain;
}

.pl-selected-platform-hint {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    width: fit-content;
    max-width: 100%;

    margin: 6px 0 10px 0;
    padding: 5px 9px;

    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);

    background: rgba(255, 255, 255, 0.035);
    box-shadow: none;
}

.pl-selected-platform-icon {
    width: 20px;
    height: 20px;
    border-radius: 999px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: color-mix(in srgb, var(--plat-accent, #fff) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--plat-accent, #fff) 28%, transparent);

    flex: 0 0 auto;
}

.pl-selected-platform-icon img {
    width: 12px;
    height: 12px;
    object-fit: contain;
}

.pl-selected-platform-text {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
}

.pl-selected-platform-kicker {
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
    font-weight: 700;
    line-height: 1;
}

.pl-selected-platform-name {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.82);
    font-weight: 800;
    line-height: 1;
}
