});

// ── 9. CSS styles present ────────────────────────────────────────────────────

test('accounts.css defines .acc-shortcut-btn', () => {
    assert.match(ACC_CSS, /\.acc-shortcut-btn/);
});

test('accounts.css defines .acc-shortcut-pill', () => {
