.empty-state:hover {
    background: rgba(255, 255, 255, 0.02);
    border-color: rgba(255, 255, 255, 0.1);
}

.empty-icon {
    width: 56px;
    height: 56px;
    margin-bottom: 20px;
    color: #444; 
}

.empty-title {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    color: #777;
    letter-spacing: 1px;
}

.empty-subtext {
    font-family: var(--font-main);
    font-size: 0.9rem;
    font-weight: 500;
    color: #444;
    margin-top: 10px;
}

/* loader-tagline removed — replaced by .splash-tagline above */

/* ========================================= */
/* PLAYTIME FILTER DROPDOWN (CUSTOM)         */
/* ========================================= */
.playtime-filter-container { display: inline-flex; align-items: center; gap: 10px; }

.playtime-trigger {
    background-color: #151515;
    border: 1px solid #333;
    color: #ddd;
    padding: 4px 12px;
    border-radius: 8px;
    font-size: 0.75rem;
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: space-between;
