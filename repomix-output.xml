    font-size: 0.88rem;
}

.plb-text span {
    color: #555;
    font-size: 0.78rem;
    line-height: 1.4;
}

.plb-btn {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 7px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.15);
    color: #ccc;
    border-radius: 8px;
