                    ${sublabelHtml}
                </div>
                <div class="gd-pill-score" style="color:${color}">
                    ${displayScore}<span class="gd-pill-max">/${displayMax}</span>
                </div>
            </div>`;
    };

    // ── Source config: label, color, pill grouping ──────────────────────────
    // كل source ممكن يطلع كـ group مستقل أو يتجمع مع غيره
    const SOURCE_CONFIG = {
