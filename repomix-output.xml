/* ============================================================
   🌟 Siderbar Logos Hover Effect (Invert to Original)
   ============================================================ */

/* 1. الوضع الطبيعي: قلب الصور لبيضاء عشان تبان على الخلفية السودة */
img.invert-on-dark {
    filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgba(255,255,255,0.3));
    transition: filter 0.25s ease-in-out; /* عشان القلبة تبقى ناعمة */
}

/* Active state on dark glass bg — keep icons white */
.nav-item.active img.invert-on-dark {
    filter: brightness(0) invert(1);
}

