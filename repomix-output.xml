    display: flex;
    align-items: center;
    gap: 9px;
}

.ag-pc-logo img {
    width: 26px;
    height: 26px;
    object-fit: contain;
    flex-shrink: 0;
}

.ag-pc-logo img.ag-pc-invert {
    filter: brightness(0) invert(1);
    opacity: 0.85;
}

.ag-pc-platform-name {
    font-family: var(--font-heading);
