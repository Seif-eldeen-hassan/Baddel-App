}

.acc-pin-btn.is-pinned svg {
    fill: currentColor; /* ده السر اللي بيخلي البيت مفرغ يتحول لبيت مليان */
}


/* ========================================= */
/* ROCKSTAR GAMES STYLES                     */
/* ========================================= */
.acc-btn-rockstar:hover {
    background: rgba(252, 175, 23, 0.1); 
    color: #fcaf17;
    border-color: rgba(252, 175, 23, 0.4);
    box-shadow: 0 5px 15px rgba(252, 175, 23, 0.2);
}

.acc-btn-rockstar:hover svg {
    color: #fcaf17;
}

/* لو عندك بادج للمنصة في كارت الأكاونت */
.acc-plat-badge.rockstar {
    background: #fcaf17;
    color: #000; /* عشان الكلام يبقى مقروء على الأصفر */
}

/* ========================================= */
/* PLATFORM SYNC — All Games & Link Banner   */
/* ========================================= */

/* ── Toolbar sticky wrapper ─────────────────────────────────── */
.ag-toolbar-sticky {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(8, 8, 8, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    padding: 12px 0 10px;
    margin-bottom: 16px;
    transition: border-color 0.2s ease, padding 0.2s ease, box-shadow 0.2s ease;
}
.ag-toolbar-sticky.is-stuck {
    border-bottom-color: rgba(255, 255, 255, 0.06);
    padding: 7px 0 6px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
}

/* ── Toolbar (search + filters + sort) ─────────────────────── */
.ag-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: nowrap;
    margin-bottom: 0;
}

/* Filter group — pills + account + installed — takes remaining space */
.ag-filter-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
    /* overflow: hidden removed — it clips position:absolute dropdown children
       (agAccountMenu) even though they are positioned outside the flow.
       Text overflow on pill/trigger labels is handled by min-width:0 +
       text-overflow on those elements directly instead. */
    overflow: visible;
}

/* Controls group — sort / view / display / count — fixed right */
.ag-controls-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

/* Search */
.ag-search-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px;
    padding: 0 10px 0 12px;
    height: 34px;
    flex-shrink: 0;
    width: 200px;
    transition: border-color 0.15s, width 0.2s ease;
}
.ag-search-wrap:focus-within {
    border-color: rgba(255,255,255,0.18);
    width: 240px;
}
.ag-search-wrap svg { color: #444; flex-shrink: 0; }
.ag-search-input {
    background: none; border: none; outline: none;
    color: #ddd; font-size: 0.8rem;
    font-family: var(--font-main, sans-serif);
    width: 100%;
    min-width: 0;
}
.ag-search-input::placeholder { color: #3a3a3a; }

/* Search clear (X) button */
.ag-search-clear {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: #555;
    cursor: pointer;
    padding: 2px;
    border-radius: 3px;
    transition: color 0.12s;
    flex-shrink: 0;
    line-height: 0;
}
.ag-search-clear:hover { color: #aaa; }

/* Platform filter pills */
.ag-filter-pills {
    display: flex;
    align-items: center;
    gap: 5px;
}

/* Account dropdown (theme-styled, non-native select) */
.ag-account-dropdown {
    min-width: 180px;
}

.ag-account-trigger {
    min-width: 180px;
    height: 34px;
    padding: 0 12px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    color: #b9b9b9;
    font-size: 0.75rem;
}

.ag-account-trigger:hover {
    border-color: rgba(255,255,255,0.18);
}

.ag-account-menu {
    width: 100%;
    max-height: 280px;
    overflow-y: auto;
    z-index: 200; /* was 120 — must exceed ag-toolbar-sticky z-index:50 and card z-index:10 */
}

.ag-pill {
    height: 34px;
    padding: 0 13px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.07);
    background: rgba(255,255,255,0.03);
    color: #666;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-main, sans-serif);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    white-space: nowrap;
}
.ag-pill:hover {
    background: rgba(255,255,255,0.07);
    color: #aaa;
    border-color: rgba(255,255,255,0.13);
}
.ag-pill.active {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.2);
    color: #fff;
}
.ag-pill-icon {
    width: 13px; height: 13px;
    object-fit: contain;
    opacity: 0.7;
}
.ag-pill-icon-invert {
    filter: brightness(0) invert(1);
}

/* Sort select */
.ag-sort-wrap {
    display: flex;
    align-items: center;
    gap: 7px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px;
    padding: 0 12px;
    height: 34px;
    transition: border-color 0.15s;
}
.ag-sort-wrap svg { color: #444; flex-shrink: 0; }
.ag-sort-select {
    background: none; border: none; outline: none;
    color: #888; font-size: 0.75rem; font-weight: 600;
    font-family: var(--font-main, sans-serif);
    cursor: pointer;
    appearance: none; -webkit-appearance: none;
    padding-right: 4px;
}
.ag-sort-select option { background: #111; color: #ccc; }
.ag-sort-wrap:focus-within { border-color: rgba(255,255,255,0.15); }

/* Result count */
.ag-result-count {
    font-size: 0.7rem;
    font-weight: 600;
    color: #3a3a3a;
    letter-spacing: 0.5px;
    white-space: nowrap;
}

/* ── Game card wrapper for All Games ────────────────────────── */
.agc-card .game-card-img-wrap {
    position: relative;
    overflow: hidden;
}

/* Multi-platform subtle accent */
.agc-multi .game-card-img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: inherit;
    pointer-events: none;
    z-index: 4;
}

/* Gradient from top so badges always readable */
.agc-top-gradient {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 55px;
    background: linear-gradient(to bottom, rgba(0,0,0,0.52) 0%, transparent 100%);
    pointer-events: none;
    z-index: 2;
}

/* ── Badge strip — top-right corner ─────────────────────────── */
.agc-badges-strip {
    position: absolute;
    top: 7px; 
    right: 7px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 3;
    align-items: flex-end;
    
    /* التعديل هنا */
    opacity: 0;
    transform: translateY(-5px); /* حركة خفيفة من فوق لتحت */
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none; /* عشان ميعطلش الكليك على الكارت وهي مخفية */
}

.agc-card:hover .agc-badges-strip {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
}

/* ── Individual badge ─────────────────────────────────────────── */
.agc-badge {
    --bc: #ffffff;
    width: 24px; height: 24px;
    border-radius: 7px;
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid color-mix(in srgb, var(--bc) 26%, transparent);
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 2px 6px rgba(0,0,0,0.4);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    flex-shrink: 0;
}

.agc-card:hover .agc-badge {
    border-color: color-mix(in srgb, var(--bc) 52%, transparent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--bc) 20%, transparent),
                0 2px 6px rgba(0,0,0,0.4);
    transform: scale(1.06);
}

.agc-badge-img {
    width: 13px; height: 13px;
    object-fit: contain; display: block;
    opacity: 0.8;
    transition: opacity 0.2s;
}
.agc-card:hover .agc-badge-img { opacity: 1; }

.agc-badge-invert {
    filter: brightness(0) invert(1) !important;
    opacity: 0.75;
}
.agc-card:hover .agc-badge-invert { opacity: 1; }

.agc-badge-dot {
    width: 7px; height: 7px;
    border-radius: 50%; opacity: 0.85;
}

.agc-badge-overflow {
    font-size: 0.55rem; font-weight: 800;
    color: rgba(255,255,255,0.5);
    letter-spacing: 0.3px;
    font-family: var(--font-heading, sans-serif);
    border-color: rgba(255,255,255,0.1);
}
.agc-card:hover .agc-badge-overflow {
    color: rgba(255,255,255,0.9);
    border-color: rgba(255,255,255,0.28);
}

.agc-placeholder {
    background: linear-gradient(135deg, #111 0%, #0a0a0a 100%) !important;
    display: flex !important;
    align-items: center; justify-content: center;
}

/* بانر الـ "Connect Platform" */
.platform-link-banner {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 20px;
}

.epic-link-banner {
    border-color: rgba(255,255,255,0.12);
