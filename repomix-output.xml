test('launcher:open-install-url: ALLOWED_PLATFORMS is [\'steam\', \'epic\']', () => {
    assert.match(INSTALL_SRC, /ALLOWED_PLATFORMS\s*=\s*\[\s*'steam'\s*,\s*'epic'\s*\]/);
