/* ── All Games route-lock and layout-shift prevention ── */
body.ag-route-pending #allGamesView {
    overflow-anchor: none;
}

#allGamesView.ag-first-paint-lock {
    overflow-anchor: none;
}

/* Legacy rule — kept for any remaining references */
#allGamesView.ag-layout-loading {
    overflow-anchor: none;
}

#allGamesGrid {
    overflow-anchor: none;
}

.ag-route-skeleton {
    min-height: calc(100vh - 180px);
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-sec, rgba(255,255,255,0.45));
    box-sizing: border-box;
}

.ag-route-skeleton .acc-spinner {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
}

/* Legacy stable loading panel */
.ag-stable-loading-panel {
    min-height: 520px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-sec, rgba(255,255,255,0.45));
}

.ag-stable-loading-panel .acc-spinner {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
}


/* ── Ready to Install mode — hide the Installed filter chip ── */
body.ag-ready-mode .ag-installed-toggle { display: none !important; }

/* ── Ready to Install loading state ─────────────────────────────────────────── */

/* Sibling wrapper inserted next to allGamesGrid inside library-section. */
.ag-rti-loading-wrap {
    width: 100%;
    box-sizing: border-box;
}

/* Full-height centering container. Uses grid/place-items for robust centering
   that works regardless of the parent element's display mode. */
.ag-ready-loading-state {
    width: 100%;
    min-height: calc(100vh - 180px);
    display: grid;
    place-items: center;
    text-align: center;
    box-sizing: border-box;
}

/* Inner column flex layout for spinner + text. */
.ag-ready-loading-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
}

.ag-rls-spinner {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-width: 2.5px;
}

.ag-rls-title {
