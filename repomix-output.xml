    color: rgb(255, 94, 81);
}

.error-message--centered {
    align-items: center;
}

.error-message--start {
    align-items: start;
}

.resend-code {
    font-size: 13px;
    color: #f2f2f2;
    margin-top: 25px;
    margin-bottom: 30px;
    color: rgba(242, 242, 242, 0.9);
}

.tooltip {
    visibility: hidden;
    position: absolute;
    font-size: 13px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: 300;
    background: #2c2b2e;
    border-radius: 3px;
    box-shadow: 0px 2px 10px 0px rgba(0, 0, 0, 0.3);
    padding: 10px 15px;
    line-height: 15px;
}
