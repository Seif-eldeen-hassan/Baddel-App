.main-footer__container--left {
    margin-right: auto;
    margin-left: 25px;
}

@media (max-height: 380px) {
    .main-footer {
        position: unset;
        bottom: unset;
        width: unset;
    }
}

.main-footer.not-sticky {
    position: unset;
    bottom: unset;
    width: unset;
}

@media (min-height: 490px) {
    .main-footer.not-sticky {
        position: absolute;
        bottom: 0;
        width: 100%;
    }
}

/* BUTTONS */

.basic-button {
