    assert.equal(result.matchedKeys.hero, 'local-fall-guys');
    assert.equal(result.matchedKeys.logo, 'FallGuys');
    assert.ok(calls.includes('hero:local-fall-guys'));
    assert.ok(calls.includes('logo:FallGuys'));
});

