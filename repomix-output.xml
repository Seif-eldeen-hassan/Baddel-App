            globalThis.crypto.getRandomValues(values);
            return Array.from(values).join('-');
        }
    } catch {}
    const perfNow = typeof performance !== 'undefined' && performance.now ? performance.now() : 0;
    return `${Date.now()}-${perfNow}-${Math.random()}`;
