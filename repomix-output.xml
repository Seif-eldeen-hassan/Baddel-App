}

/* ROW 2: Filters row — pills may wrap but account+installed stay together */
.ag-toolbar-row--filters {
    flex-wrap: wrap;
}

.ag-toolbar-row--filters .ag-filter-group {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 5px 6px;
    min-width: 0;
    flex: 1 1 auto;
}

.ag-filter-pills {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    flex-wrap: nowrap;
}

