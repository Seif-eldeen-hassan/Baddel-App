let _carouselItems    = [];
let _selIdx           = 0;
let _closeAfterSwitch = true;
let _platformFilter   = 'all';
let _isSwitching      = false;
let _focusZone        = 'accounts'; // 'platforms' | 'accounts'
let _platformFocusIdx = 0;         // index of keyboard-focused chip in filtersEl

