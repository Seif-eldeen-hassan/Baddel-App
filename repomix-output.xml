    assert.match(fn, /rockstar/);
});

// ── 6. accountShortcutHandlers.js IPC handlers registered ───────────────────

test('main.js registers account-shortcuts:list IPC handler', () => {
    assert.match(ACCOUNT_SHORTCUT_HANDLERS_JS, /account-shortcuts:list/);
