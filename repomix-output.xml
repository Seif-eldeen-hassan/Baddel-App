            makeSwitcherProfile('yes',  { _resolvedSyncId: 'yes' }),
            makeSwitcherProfile('unk'),
        ],
        syncAccounts: [
            makeSyncAccount('yes'),
            makeSyncAccount('no'),
        ],
        syncedLibrary: [makeLibGame({ steamLicensedAccountIds: ['yes'] })],
    });
