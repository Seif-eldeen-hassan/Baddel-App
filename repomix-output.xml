                <div class="modal-actions" style="justify-content:center;">
                    <button class="btn-cancel" onclick="closeUpdateModal()">Hide — Downloading in background</button>
                </div>
            </div>

            <!-- State 4: error during download (never reverts to available — shows retry) -->
            <div id="updateStateError" style="display:none;">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ff3b30" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
