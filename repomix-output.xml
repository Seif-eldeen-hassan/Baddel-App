    const needle = identity ? String(identity) : '';
    for (const map of [_artworkCacheLookupInFlight, _artworkCacheLookupResolved]) {
        for (const key of [...map.keys()]) {
            if (!needle || String(key).includes(needle)) map.delete(key);
