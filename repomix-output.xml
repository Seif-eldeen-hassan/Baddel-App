    .surprise-header { flex-direction: column; align-items: flex-start; gap: 12px; }
}

@media (max-width: 850px) {
    .roulette-layout {
        flex-direction: column;
        align-items: center;
        gap: 24px;
    }
    .roulette-action-panel {
        width: 100%;
        align-items: center;
    }
    .roulette-controls {
        width: 100%;
        align-items: center;
    }
