.consent-list-item:last-child { margin-bottom: 0; }

/* ── What's New / Update Notes Modal ─────────────────────────────────────── */
.update-notes-modal {
    position: fixed; inset: 0; z-index: 200000;
    display: none; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.62); backdrop-filter: blur(12px);
}
.update-notes-modal.active { display: flex; }
.update-notes-dialog {
    width: min(660px, calc(100vw - 32px));
    background: #151515; border: 1px solid rgba(255,255,255,0.12);
    border-radius: 22px; padding: 36px 32px 32px;
    box-shadow: 0 24px 80px rgba(0,0,0,0.58);
    position: relative; color: #fff; text-align: center;
    max-height: calc(100vh - 48px); overflow-y: auto;
}
.update-notes-dialog .modal-close {
    position: absolute; top: 16px; right: 18px;
    background: none; border: none; color: rgba(255,255,255,0.4);
    font-size: 1.1rem; cursor: pointer; line-height: 1;
    transition: color 0.15s;
}
.update-notes-dialog .modal-close:hover { color: #fff; }
.update-notes-icon {
    font-size: 2.4rem; margin-bottom: 14px; display: block;
}
.update-notes-dialog h2 {
    font-size: 1.25rem; font-weight: 700; margin: 0 0 8px; color: #fff;
}
.update-notes-dialog > p:first-of-type {
    font-size: 0.9rem; color: rgba(255,255,255,0.55); margin: 0 0 22px;
}
.update-notes-list {
    text-align: left; display: flex; flex-direction: column; gap: 14px;
    margin-bottom: 22px;
}
.update-notes-item {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09);
    border-radius: 12px; padding: 14px 16px;
}
.update-notes-item-title {
    font-size: 0.875rem; font-weight: 600; color: #fff; margin: 0 0 4px;
}
.update-notes-item-desc {
    font-size: 0.8rem; color: rgba(255,255,255,0.5); margin: 0; line-height: 1.45;
}
.update-notes-footer {
    font-size: 0.78rem; color: rgba(255,255,255,0.35); margin: 0 0 20px;
}
.update-notes-primary-btn {
    background: linear-gradient(135deg, #22c55e, #16a34a);
    box-shadow: 0 0 24px rgba(34, 197, 94, 0.28);
    border: none; border-radius: 10px; color: #fff;
    font-size: 0.9rem; font-weight: 600; padding: 11px 32px;
    cursor: pointer; transition: background 0.2s, box-shadow 0.2s, transform 0.1s;
    display: block; width: 100%;
    outline-offset: 3px;
}
.update-notes-primary-btn:hover {
    background: linear-gradient(135deg, #34d399, #22c55e);
    box-shadow: 0 0 32px rgba(34, 197, 94, 0.38);
}
.update-notes-primary-btn:focus-visible {
    outline: 2px solid #22c55e;
}
.update-notes-primary-btn:active { transform: scale(0.98); }

/* Featured two-card row (primary features) */
.update-notes-featured-row {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
}
/* Smaller feature cards grid (secondary features) */
.update-notes-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
}
/* Large highlighted card — overrides .update-notes-item base */
.update-notes-featured-card {
    border-color: rgba(34, 197, 94, 0.3); background: rgba(34, 197, 94, 0.06); padding: 18px;
}
/* Smaller card — tighter padding than base .update-notes-item */
.update-notes-grid-card {
    padding: 12px 14px;
}
/* Eyebrow label on featured cards — small, muted, uppercase */
.update-notes-featured-card .update-notes-item-title {
    font-size: 0.72rem; font-weight: 600; color: rgba(255,255,255,0.4);
    text-transform: uppercase; letter-spacing: 0.07em; margin: 0 0 5px;
}
/* Feature headline — the main benefit statement */
.update-notes-item-headline {
    font-size: 0.95rem; font-weight: 700; color: #22c55e;
    margin: 0 0 6px; line-height: 1.3;
}
/* Description in featured cards — slightly brighter than base */
.update-notes-featured-card .update-notes-item-desc {
    font-size: 0.82rem; color: rgba(255,255,255,0.6);
}
/* Helper / best-for line */
.update-notes-item-helper {
    font-size: 0.72rem; color: rgba(255,255,255,0.28);
    margin: 8px 0 0; line-height: 1.4; font-style: italic;
}
/* Stack cards on narrow screens */
@media (max-width: 560px) {
    .update-notes-featured-row,
    .update-notes-grid { grid-template-columns: 1fr; }
}

/* ── Feature tour slider (type: feature-tour) ───────────────────────────────── */
.update-notes-dialog.tour-mode {
    width: min(880px, calc(100vw - 32px));
    padding: 0; overflow: hidden; text-align: left;
}
.update-notes-dialog.tour-mode .modal-close {
    z-index: 10; background: rgba(0,0,0,0.4);
    border-radius: 50%; width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
}
.un-tour { display: flex; flex-direction: column; margin: 0; gap: 0; }
.un-tour-slides { position: relative; }
.un-tour-slide {
    display: none; flex-direction: row; min-height: 360px;
}
.un-tour-slide.active { display: flex; }
.un-tour-text {
    flex: 0 0 42%; padding: 36px 36px 32px 36px;
    display: flex; flex-direction: column; justify-content: center;
}
.un-tour-image {
    flex: 0 0 58%; background: #0e0e0e;
    border-left: 1px solid rgba(255,255,255,0.07);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
}
.un-tour-img {
    width: 100%; height: 100%; object-fit: cover; display: block;
}
.un-tour-img-placeholder {
    width: 100%; height: 100%; min-height: 360px;
    background: linear-gradient(135deg, #1c1c1c 0%, #101010 100%);
}
.un-tour-label {
    font-size: 0.68rem; font-weight: 700; color: #22c55e;
    text-transform: uppercase; letter-spacing: 0.1em;
    display: block; margin-bottom: 10px;
}
.un-tour-headline {
    font-size: 1.5rem; font-weight: 800; color: #fff;
    margin: 0 0 12px; line-height: 1.2;
}
.un-tour-desc {
    font-size: 0.875rem; color: rgba(255,255,255,0.62);
    margin: 0 0 16px; line-height: 1.6;
}
.un-tour-badge {
    display: inline-block;
    background: rgba(34,197,94,0.12); border: 1px solid rgba(34,197,94,0.35);
    color: #22c55e; font-size: 0.8rem; font-weight: 600; font-family: monospace;
    padding: 5px 12px; border-radius: 7px; margin-bottom: 16px;
    letter-spacing: 0.03em;
}
.un-tour-helper {
    font-size: 0.78rem; color: rgba(255,255,255,0.32);
    margin: 0; line-height: 1.5; font-style: italic;
}
.un-tour-nav {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 14px 24px 18px;
    background: #0f0f0f; border-radius: 0 0 22px 22px;
    display: flex; flex-direction: column; gap: 10px;
}
.un-tour-dots {
    display: flex; gap: 7px; justify-content: center; align-items: center;
}
.un-tour-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(255,255,255,0.15); cursor: pointer;
    transition: background 0.2s, transform 0.2s; border: none;
    display: inline-block;
}
.un-tour-dot.active { background: #22c55e; transform: scale(1.35); }
.un-tour-controls {
    display: flex; align-items: center; justify-content: space-between;
}
.un-tour-counter {
    font-size: 0.75rem; color: rgba(255,255,255,0.28);
    font-variant-numeric: tabular-nums;
}
.un-tour-btn-group { display: flex; gap: 8px; }
.un-tour-back {
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.55); font-size: 0.85rem; font-weight: 500;
    padding: 8px 22px; border-radius: 9px; cursor: pointer;
    transition: background 0.15s, color 0.15s;
}
.un-tour-back:hover:not(:disabled) { background: rgba(255,255,255,0.1); color: #fff; }
.un-tour-back:disabled { opacity: 0.28; cursor: default; }
.un-tour-next {
    background: linear-gradient(135deg, #22c55e, #16a34a);
    box-shadow: 0 0 18px rgba(34,197,94,0.22);
    border: none; color: #fff; font-size: 0.85rem; font-weight: 600;
    padding: 8px 26px; border-radius: 9px; cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s;
    min-width: 96px;
}
.un-tour-next:hover {
    background: linear-gradient(135deg, #34d399, #22c55e);
    box-shadow: 0 0 26px rgba(34,197,94,0.32);
}
.un-tour-next:active { transform: scale(0.98); }
@media (max-width: 640px) {
    .un-tour-slide { flex-direction: column-reverse; min-height: auto; }
    .un-tour-text { flex: none; padding: 28px 24px 18px; }
    .un-tour-image { flex: none; min-height: 200px; border-left: none;
        border-top: 1px solid rgba(255,255,255,0.07); }
    .un-tour-img-placeholder { min-height: 200px; }
    .un-tour-headline { font-size: 1.2rem; }
}

/* Tour header — icon + title + subtitle above the slide area */
.un-tour-header {
    display: none;
    align-items: center;
    gap: 14px;
    padding: 18px 52px 16px 22px; /* right: 52px clears the X close button */
    border-bottom: 1px solid rgba(255,255,255,0.07);
}
.update-notes-dialog.tour-mode .un-tour-header { display: flex; }
.un-tour-header-icon {
    flex-shrink: 0;
    width: 40px; height: 40px;
    border-radius: 10px;
    background: rgba(34,197,94,0.1);
    border: 1px solid rgba(34,197,94,0.22);
    display: flex; align-items: center; justify-content: center;
}
.un-tour-header-title {
    font-size: 0.95rem; font-weight: 700; color: #fff;
    margin: 0 0 3px; line-height: 1.3;
}
.un-tour-header-subtitle {
    font-size: 0.73rem; color: rgba(255,255,255,0.38);
    margin: 0; line-height: 1.4;
}
/* Hide old card-layout elements in tour mode (belt-and-suspenders alongside JS) */
.update-notes-dialog.tour-mode .update-notes-icon,
.update-notes-dialog.tour-mode #updateNotesTitle,
.update-notes-dialog.tour-mode #updateNotesSubtitle,
.update-notes-dialog.tour-mode #updateNotesFooter,
.update-notes-dialog.tour-mode .update-notes-primary-btn { display: none !important; }

/* ================================================================ */
/* SIDEBAR v2 — Glass panels redesign                               */
/* ================================================================ */

/* Sidebar nav content — no scroll; content must fit without scrolling */
.sidebar-scroll-content {
    flex: 1;
    min-height: 0;
    overflow: hidden;
}

/* ── Status bar ── */
.sidebar-status {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    margin-bottom: 14px;
    font-size: 0.68rem;
    color: rgba(255,255,255,0.35);
    letter-spacing: 0.3px;
    flex-grow: 0;   /* must not expand in the sidebar flex column */
    flex-shrink: 0;
}
.sidebar.collapsed .sidebar-status { display: none; }

.sidebar-status-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
    flex-shrink: 0;
    animation: sbStatusPulse 3s ease-in-out infinite;
}
@keyframes sbStatusPulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.5; }
}

/* ── Section HUD label ── */
.sidebar-section-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.18);
    text-transform: uppercase;
    padding: 0 14px;
    margin: 8px 0 6px;
}
.sidebar.collapsed .sidebar-section-label { display: none; }

/* ── Library badge on section header ── */
.sidebar-nav-badge {
    margin-left: auto;
    font-size: 0.62rem;
    font-weight: 700;
    color: rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.06);
    border-radius: 20px;
    padding: 1px 7px;
    letter-spacing: 0.3px;
}
.sidebar.collapsed .sidebar-nav-badge { display: none; }

/* ── Glass panel base ── */
.sidebar-panel {
    margin: 10px 0 0;
    border-radius: 10px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    padding: 12px;
    overflow: hidden;
}
.sidebar.collapsed .sidebar-panel { display: none !important; }

.sidebar-panel-label {
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.2);
    text-transform: uppercase;
    margin-bottom: 10px;
}

/* ── 01 Jump Back In card ── */
.jump-back-card { padding: 10px; }

.jb-inner {
    border-radius: 8px;
    height: 88px;
    background: #1a1a1a;
    background-size: cover;
    background-position: center;
    position: relative;
    overflow: hidden;
    cursor: pointer;
}
.jb-inner:hover .jb-overlay { background: rgba(0,0,0,0.55); }
.jb-inner:hover .jb-play { opacity: 1; transform: scale(1); }

.jb-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.3) 60%, transparent 100%);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 8px 10px;
    transition: background 0.15s;
}

.jb-info { flex: 1; min-width: 0; }

.jb-platform {
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 2px;
}

.jb-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
}

.jb-meta {
    font-size: 0.62rem;
    color: rgba(255,255,255,0.5);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.jb-play {
    flex-shrink: 0;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--accent);
    border: none;
    color: #000;
    font-size: 0.65rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.15s, transform 0.15s;
    margin-left: 8px;
}
.jb-play:hover { background: #4ade80; }

/* ── 02 Active Accounts card ── */
.active-account-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 4px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.12s;
    font-size: 0.75rem;
}
.active-account-row:hover { background: rgba(255,255,255,0.06); }

.acc-plat-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
}

.acc-plat-name {
    color: rgba(255,255,255,0.75);
    font-weight: 500;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.acc-plat-count {
    font-size: 0.65rem;
    color: rgba(255,255,255,0.3);
    font-weight: 600;
}

.acc-status-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    box-shadow: 0 0 4px var(--accent);
}

/* ── 03 Library Pulse card ── */
.sidebar-pulse-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.sidebar-metric {
    background: rgba(255,255,255,0.04);
    border-radius: 7px;
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.sidebar-metric-value {
    font-size: 1.2rem;
    font-weight: 800;
    color: #fff;
    line-height: 1;
    font-family: var(--font-heading, sans-serif);
}

.sidebar-metric-label {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: rgba(255,255,255,0.3);
    text-transform: uppercase;
}

/* ================================================================ */
/* BADDEL SMART SIDEBAR — v3                                        */
/* ================================================================ */

/* Hide the compatibility layer — IDs exist for JS but never shown */
.baddel-compat-layer {
    display: none !important;
    position: absolute;
    left: -9999px;
    width: 0;
    height: 0;
    overflow: hidden;
}

/* Status row with platform dots */
.baddel-sidebar-status {
    display: flex;
    align-items: center;
    gap: 6px;
}

.baddel-plat-dots {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
}

.baddel-plat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    opacity: 0.85;
}
.sidebar.collapsed .baddel-plat-dots { display: none; }

/* Panel base — override any old display:none */
.baddel-sidebar-panel {
    display: block !important;
    margin-top: 12px;
}

/* Jump Back In empty state */
.jb-empty-msg {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.25);
    text-align: center;
    padding: 12px 0;
    letter-spacing: 0.3px;
}

/* Active accounts placeholder */
.baddel-acc-placeholder {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.25);
    text-align: center;
    padding: 10px 0;
    letter-spacing: 0.3px;
}

/* Active account row */
.baddel-acc-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 4px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.12s;
}
.baddel-acc-row:hover { background: rgba(255,255,255,0.06); }

.baddel-acc-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
}

.baddel-acc-name {
    font-size: 0.74rem;
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.baddel-acc-count {
    font-size: 0.64rem;
    color: rgba(255,255,255,0.3);
    font-weight: 600;
}

.baddel-acc-live {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    box-shadow: 0 0 4px var(--accent);
}

/* Library Pulse — ensure 2x2 grid with 4 tiles */
#sidebarLibraryPulse .sidebar-pulse-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

/* Collections panel */
.baddel-sidebar-collections .add-coll-btn {
    margin-top: 10px;
    width: 100%;
}

/* Collection items inside sidebar panel */
.baddel-sidebar-collections #collectionsList .nav-item {
    height: 36px;
    border-radius: 7px;
    margin-bottom: 2px;
    padding: 0 10px;
    font-size: 0.8rem;
}

/* Sidebar nav badge — green accent when active */
.nav-item.active .sidebar-nav-badge {
    background: rgba(18, 206, 24, 0.15);
    color: var(--accent);
}

/* Collapsed sidebar: hide panels entirely */
.sidebar.collapsed .baddel-sidebar-panel { display: none !important; }

/* ================================================================ */
/* SIDEBAR POLISH — v4                                              */
/* ================================================================ */

/* 1. Sidebar width is controlled by --sidebar-width (280px) in :root.
      The base .sidebar rule already uses the variable with min/max-width locks. */

/* 2. Compact, premium nav items with correct font size */
.nav-item {
    height: 40px;
    font-size: 0.82rem;
    gap: 10px;
    margin-bottom: 2px;
}

/* 3. Active accent bar — green glow only, no white bleed */
.nav-item.active::before {
    box-shadow: 0 0 5px rgba(18,206,24,0.5);
}

/* 4. Status dot — true brand green (#12CE18), not inherited white --accent */
.sidebar-status-dot {
    background: #12CE18;
    box-shadow: 0 0 5px rgba(18,206,24,0.55);
}

/* 5. Nav count badge — slightly more readable, doesn't shrink */
.sidebar-nav-badge {
    color: rgba(255,255,255,0.5);
    background: rgba(255,255,255,0.09);
    flex-shrink: 0;
}

/* 6. Jump Back In — darker gradient so bright artwork doesn't bleed */
.jb-overlay {
    background: linear-gradient(
        to top,
        rgba(0,0,0,0.92) 0%,
        rgba(0,0,0,0.62) 45%,
        rgba(0,0,0,0.28) 100%
    );
}

/* 7. Jump Back In play button — brand green */
.jb-play { background: #12CE18; color: #000; }
.jb-play:hover { background: #0fb316; }

/* 8. Active account live indicator — brand green */
.baddel-acc-live {
    background: #12CE18;
    box-shadow: 0 0 4px rgba(18,206,24,0.55);
}

/* 9. Empty Active Accounts panel — hidden entirely by JS adding this class */
.baddel-sidebar-panel.baddel-hidden { display: none !important; }

/* 10. Library Pulse metric value — slightly more compact */
.sidebar-metric-value { font-size: 1.05rem; }

/* 11. Collections list items — compact */
.baddel-sidebar-collections #collectionsList .nav-item {
    height: 34px;
    font-size: 0.78rem;
    margin-bottom: 1px;
}

/* ================================================================ */
/* SIDEBAR HYBRID — section-based redesign                          */
/* ================================================================ */

/* ── Section headers (LIBRARY / ACCOUNTS / MANAGE) ── */
.sb-section-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    height: 28px;
    margin-top: 14px;
    margin-bottom: 2px;
    cursor: pointer;
    user-select: none;
}
.sb-sec-static { cursor: default; }

.sb-sec-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.22);
    text-transform: uppercase;
    flex: 1;
}

.sb-sec-chevron {
    color: rgba(255,255,255,0.2);
    transition: transform 0.18s ease;
    flex-shrink: 0;
}
.sb-chevron-closed { transform: rotate(-90deg); }

.sb-section-header:hover .sb-sec-label { color: rgba(255,255,255,0.38); }
.sb-section-header:hover .sb-sec-chevron { color: rgba(255,255,255,0.35); }
.sb-sec-static:hover .sb-sec-label,
