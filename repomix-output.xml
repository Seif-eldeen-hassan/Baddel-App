;(function () {
const _allGamesArtworkRoot = typeof window !== 'undefined' ? window : globalThis;
const _gameArtworkResolver = (typeof require === 'function')
    ? require('./GameArtworkResolver')
    : _allGamesArtworkRoot.BaddelGameArtworkResolver;

