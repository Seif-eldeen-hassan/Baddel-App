// ─── formatPlaytime behavior ──────────────────────────────────────────────────

test('formatPlaytime(0) returns "0h 0m"', () => {
    assert.equal(formatPlaytime(0), '0h 0m');
});

test('formatPlaytime(null) returns "0h 0m"', () => {
