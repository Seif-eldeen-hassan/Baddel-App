    try {
        // Namespace must be >= 10 chars and match /^[a-f0-9\-]+$/i
        engine._syncDetectedGamesToMetadataServer([
            {
                scannerPlatform: 'epic',
                namespace: 'aaaaaaaaaa', // 10 hex chars — passes validation
                name: 'Epic Game',
            },
