    min-height: min(350px, 52dvh);
    margin-top: 0;
}

@keyframes betaFeedbackIn {
    from { opacity: 0; transform: translateY(14px) scale(0.985); }
    to   { opacity: 1; transform: translateY(0)    scale(1);     }
}

.beta-feedback-banner {
    position: fixed;
    left: calc(var(--sidebar-width) + 12px);
    right: 18px;
    bottom: 18px;
    min-height: 58px;
    padding: 10px 12px 10px 14px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    z-index: 99990;
    color: rgba(255, 255, 255, 0.92);
    background:
        linear-gradient(135deg, rgba(18, 206, 24, 0.16), rgba(18, 18, 18, 0.88) 42%, rgba(0, 0, 0, 0.88)),
        rgba(12, 12, 12, 0.92);
    border: 1px solid rgba(18, 206, 24, 0.26);
    box-shadow:
        0 18px 45px rgba(0, 0, 0, 0.42),
        0 0 0 1px rgba(255, 255, 255, 0.04) inset,
        0 0 28px rgba(18, 206, 24, 0.09);
    backdrop-filter: blur(18px);
