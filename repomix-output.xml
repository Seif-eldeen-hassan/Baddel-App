<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data: file:; img-src 'self' data: blob: file: http: https:; media-src 'self' data: blob: file: http: https:; frame-src https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com; connect-src 'self' http: https:;">
    <title>Baddel Launcher</title>
        <link rel="stylesheet" href="renderer.bundle.css">
</head>
<body>

    <div class="title-bar">
        <div class="help-dropdown-wrap" id="helpDropdownWrap">
            <button type="button" class="help-btn" onclick="toggleHelpDropdown(event)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                Help &amp; Feedback
                <svg class="help-dropdown-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="help-dropdown-menu" id="helpDropdownMenu">
                <button type="button" class="help-dropdown-item" onclick="handleHelpDropdownAction(event,'help')">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    Help &amp; Feedback
                </button>
                <button type="button" class="help-dropdown-item" onclick="handleHelpDropdownAction(event,'bug')">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    Report a Bug
                </button>
                <button type="button" class="help-dropdown-item help-dropdown-item--community" onclick="handleHelpDropdownAction(event,'community')">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    Community &amp; Socials
                </button>
            </div>
        </div>
        <!-- Update notification badge — hidden by default, shown when update found -->
        <button id="updateBadgeBtn" class="update-badge-btn" onclick="openUpdateModal()" style="display:none;">
            <span id="updateBadgeLabel">Update Available</span>
        </button>
        <div class="drag-region" style="flex-grow: 1; height: 100%; -webkit-app-region: drag;"></div>
        <div class="window-controls">
            <button class="control-btn btn-min" onclick="window.electronAPI.minimizeApp()">
                <svg width="12" height="12" viewBox="0 0 12 12"><rect fill="currentColor" width="10" height="1" x="1" y="5.5"></rect></svg>
            </button>
            <button class="control-btn btn-max" onclick="window.electronAPI.maximizeApp()">
                <svg width="12" height="12" viewBox="0 0 12 12"><rect width="9" height="9" x="1.5" y="1.5" fill="none" stroke="currentColor"></rect></svg>
            </button>
            <button class="control-btn btn-close" onclick="window.electronAPI.closeApp()">
                <svg width="12" height="12" viewBox="0 0 12 12"><polygon fill="currentColor" points="11 1.576 6.583 6 11 10.424 10.424 11 6 6.583 1.576 11 1 10.424 5.417 6 1 1.576 1.576 1 6 5.417 10.424 1"></polygon></svg>
            </button>
        </div>
    </div>

    <div class="main-layout">
        <aside class="sidebar" id="mainSidebar">
            <button class="sidebar-toggle" id="toggleBtn" onclick="toggleSidebar()">
                <span id="toggleIcon">&#9664;</span>
            </button>

            <!-- ── Brand header ── -->
            <div class="sidebar-logo-area" onclick="navigateToHome()" title="Go to Home">
                <div class="brand-mark">
                    <img src="assets/app_icon.png" class="main-sidebar-logo" alt="Baddel">
                </div>
                <div class="brand-lockup nav-text">
                    <span class="brand-name">BADDEL</span>
                    <span class="brand-line"></span>
                </div>
            </div>

            <!-- ── Hidden compat layer — IDs accounts.js writes to but doesn't show ── -->
            <div class="baddel-compat-layer" aria-hidden="true">
                <div id="sectionBtn-library" class="sidebar-section-btn"></div>
                <div id="sectionBtn-accounts" class="sidebar-section-btn"></div>
                <div id="subItems-library" class="sidebar-sub-items"></div>
                <div id="subItems-accounts" class="sidebar-sub-items"></div>
                <div id="bottomBtnIcon"></div><span id="bottomBtnText"></span>
            </div>

            <!-- ── Scrollable sidebar content ── -->
            <div class="sidebar-scroll-content">

                <!-- ── Home ── -->
                <div class="nav-item" id="nav-home" onclick="navigateToHome()">
                    <div class="nav-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    </div>
                    <span class="nav-text">Home</span>
                </div>

                <!-- ── LIBRARY section ── -->
                <div class="sb-section-header" id="sbSecLibrary" onclick="sbToggleSection('library')">
