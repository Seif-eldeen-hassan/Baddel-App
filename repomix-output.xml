/* Settings social icon row */
.community-social-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}
.community-social-icon-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
