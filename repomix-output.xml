        fullDescSection.dataset.gdCreatorAction = 'edit-field';
        fullDescSection.dataset.field = 'description';
        fullDescSection.dataset.label = 'Full Description';
        if (!(_gdCreatorDraft?.description) && !fullDescText.textContent.trim()) {
