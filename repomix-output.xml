        console.log(
            `[VSDBG] _vsRender force=${forceRemeasure} reason=${reason}`,
            `view=${typeof currentView !== 'undefined' ? currentView : '?'}`,
            `rti=${window.agReadyOnly || false} installedOnly=${window.agInstalledOnly || false}`,
            `scrollTop=${_dbgScroller?.scrollTop ?? '?'}`,
