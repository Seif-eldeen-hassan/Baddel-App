                    <div class="consent-list-item" style="margin-top: 16px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.05);">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E24B4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        <span style="font-size:0.95rem; font-weight:500; color:rgba(226,75,74,0.9);">مش بنسجل أي أسماء أو إيميلات</span>
                    </div>
                </div>
            </div>

        </div>

        <div style="border-top: 1px solid rgba(255,255,255,0.06); padding-top: 24px; display: flex; flex-direction: column; align-items: center; gap: 20px;">
            
            <p style="font-size:0.75rem; color:rgba(255,255,255,0.3); margin:0; text-align: center; max-width: 500px; line-height: 1.6;">
