// ─── helper: extract first function body by name ──────────────────────────────
function extractFnSource(src, name) {
    const start = src.indexOf(`function ${name}`);
    if (start === -1) return null;
    let depth = 0, i = start;
    while (i < src.length) {
        if (src[i] === '{') depth++;
        else if (src[i] === '}') { depth--; if (depth === 0) break; }
        i++;
    }
    return src.slice(start, i + 1);
}

