.asc-play-btn::before {
    content: attr(data-tooltip); 
    position: absolute;
    right: 125%; 
    top: 50%;
    transform: translateY(-50%) scale(0.8) translateX(5px);
    background: #111;
    color: #fff;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 0.65rem;
