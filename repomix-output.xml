    if (!img || !cleanUrl) return false;
    img.onerror = null;
    img.src = cleanUrl;
    img.style.display = 'block';
    img.style.opacity = '1';
    img.dataset.lastGoodImage = cleanUrl;
    img.closest?.('.roulette-card')?.classList.add('has-poster');
    if (graphic) graphic.style.display = 'none';
