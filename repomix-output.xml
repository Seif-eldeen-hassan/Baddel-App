// ── 8. Renderer: shortcut helpers in accounts.js ────────────────────────────

test('accounts.js defines _loadShortcutsMap', () => {
    assert.match(ACC_JS, /function _loadShortcutsMap/);
});

test('accounts.js defines _shortcutBtnHtml', () => {
