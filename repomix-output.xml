                    <svg class="sb-sec-chevron" id="sbChevronLibrary" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </div>
                <div class="sb-section-body" id="sbBodyLibrary">
                    <div class="nav-item sb-sub-item" id="nav-all-games" onclick="navigateToAllGames()">
                        <div class="nav-icon">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                        </div>
                        <span class="nav-text">All Games</span>
                        <span class="sidebar-nav-badge" id="allGamesCount">—</span>
                    </div>
                    <div class="nav-item sb-sub-item" id="nav-installed" onclick="navigateToInstalled()">
                        <div class="nav-icon">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                        </div>
                        <span class="nav-text">Installed</span>
                        <span class="sidebar-nav-badge" id="sbNavInstalled">—</span>
                    </div>
                    <div class="nav-item sb-sub-item" id="nav-ready" onclick="navigateToReadyToInstall()">
                        <div class="nav-icon">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        </div>
                        <span class="nav-text">Ready to Install</span>
                        <span class="sidebar-nav-badge" id="sbNavReady">—</span>
                    </div>
                    <div class="nav-item sb-sub-item" id="nav-fav" onclick="filterByCollection('fav_system_default')">
                        <div class="nav-icon fav-heart">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                        </div>
                        <span class="nav-text">Favorites</span>
                    </div>
                    <!-- Legacy compat: kept empty so renderSidebar() doesn't crash -->
                    <div id="collectionsList" style="display:none"></div>
                </div>

                <!-- ── COLLECTIONS section ── -->
                <div class="sb-section-header" id="sbSecCollections" onclick="sbToggleSection('collections')">
                    <span class="sb-sec-label">COLLECTIONS</span>
                    <svg class="sb-sec-chevron" id="sbChevronCollections" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </div>
                <div class="sb-section-body" id="sbBodyCollections">
                    <!-- Populated by renderSidebarCollectionsList() -->
                </div>

                <!-- ── ACCOUNTS section ── -->
                <div class="sb-section-header" id="sbSecAccounts" onclick="sbToggleSection('accounts')">
                    <span class="sb-sec-label">ACCOUNTS</span>
                    <svg class="sb-sec-chevron sb-chevron-closed" id="sbChevronAccounts" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </div>
                <div class="sb-section-body" id="sbBodyAccounts" style="display:none">
                    <div class="nav-item sb-sub-item platform-item" id="nav-steam" onclick="selectAccountPlatform('steam')">
                        <div class="nav-icon platform-icon steam-icon">
                            <img src="assets/Steam.png" alt="Steam" style="width:16px;height:16px;object-fit:contain;">
                        </div>
                        <span class="nav-text">Steam</span>
                        <span class="platform-count" id="steamCount">—</span>
                    </div>
                    <div class="nav-item sb-sub-item platform-item" id="nav-epic" onclick="selectAccountPlatform('epic')">
                        <div class="nav-icon platform-icon epic-icon">
                            <img src="assets/epic.svg" alt="Epic" style="width:16px;height:16px;object-fit:contain;filter:brightness(0) invert(1);">
                        </div>
                        <span class="nav-text">Epic Games</span>
                        <span class="platform-count" id="epicCount">—</span>
                    </div>
                    <div class="nav-item sb-sub-item platform-item" id="nav-ea" onclick="selectAccountPlatform('ea')">
                        <div class="nav-icon platform-icon ea-icon">
                            <img src="assets/ea.png" alt="EA" style="width:18px;height:18px;object-fit:contain;">
                        </div>
                        <span class="nav-text">EA App</span>
                        <span class="platform-count" id="eaCount">—</span>
                    </div>
                    <div class="nav-item sb-sub-item platform-item" id="nav-riot" onclick="selectAccountPlatform('riot')">
                        <div class="nav-icon platform-icon riot-icon">
                            <img src="assets/riot.png" alt="Riot" style="width:18px;height:18px;object-fit:contain;">
                        </div>
                        <span class="nav-text">Riot Games</span>
                        <span class="platform-count" id="riotCount">—</span>
                    </div>
                    <div class="nav-item sb-sub-item platform-item" id="nav-rockstar" onclick="selectAccountPlatform('rockstar')">
                        <div class="nav-icon platform-icon rockstar-icon">
                            <img src="assets/Rockstar_Games_Logo.svg.png" alt="Rockstar" style="width:16px;height:16px;object-fit:contain;">
                        </div>
                        <span class="nav-text">Rockstar</span>
                        <span class="platform-count" id="rockstarCount">—</span>
                    </div>
                    <div class="nav-item sb-sub-item platform-item" id="nav-ubisoft" onclick="selectAccountPlatform('ubisoft')">
                        <div class="nav-icon platform-icon ubisoft-icon">
                            <img src="assets/Ubisoft_white.png" alt="Ubisoft" style="width:16px;height:16px;object-fit:contain;">
                        </div>
                        <span class="nav-text">Ubisoft</span>
                        <span class="platform-count" id="ubisoftCount">—</span>
                    </div>
                    <div class="nav-item sb-sub-item platform-item" id="nav-discord" onclick="selectAccountPlatform('discord')">
                        <div class="nav-icon platform-icon discord-icon">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
                        </div>
                        <span class="nav-text">Discord</span>
                        <span class="platform-count" id="discordCount">—</span>
                    </div>
                </div>

                <!-- ── MANAGE section ── -->
                <div class="sb-section-header sb-sec-static" id="sbSecManage">
                    <span class="sb-sec-label">MANAGE</span>
                </div>
                <div class="nav-item sb-sub-item" id="nav-collections" onclick="sbGoManageCollections()">
                    <div class="nav-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                    </div>
                    <span class="nav-text">Collections</span>
                </div>
                <div class="nav-item sb-sub-item" id="nav-settings" onclick="openSettingsModal()">
                    <div class="nav-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    </div>
                    <span class="nav-text">Settings</span>
                </div>


            </div><!-- end sidebar-scroll-content -->

            <!-- ── Context action button ── -->
            <button class="sb-ctx-btn add-coll-btn" id="btn-new-coll" onclick="handleSidebarContextBtn()">
                <svg class="sb-ctx-icon" id="sbCtxIcon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span class="nav-text" id="sbCtxBtnText">New Collection</span>
            </button>
        </aside>

        <main class="content-area" id="mainContentArea">
            
            <section class="cinematic-hero" id="heroSection">
                <div class="hero-bg-parallax" id="heroBg"></div>
                <div class="hero-vignette"></div>
                <div class="hero-content">
                    <img id="heroLogo" class="hero-game-logo" src="" alt="Game Logo" style="display: none;">
                    <h1 id="heroTitle" class="hero-game-title">Welcome to Baddel</h1>
                    <div class="hero-stats" id="heroStats" style="display: none;">
                        <span class="stat-badge playtime-stat"><span id="heroPlaytime">0h</span></span>
                        <span class="stat-badge">Last Played: <span id="heroLastPlayed">Never</span></span>
                    </div>
                    <div class="hero-actions">
                        <button class="btn-play-hero" id="heroPlayBtn" onclick="triggerPlayFromHero()" style="display: none;">&#9654; PLAY NOW</button>
                        <button class="btn-secondary-hero" id="heroSettingsBtn" onclick="openCurrentGameSettings()" style="display: none;">&#9881;</button>
                    </div>
                </div>
            </section>

            <div id="libraryView">
                
                <section class="account-shortcuts-section" id="accountsShortcutsSection" style="display: none;">
                    <h2 class="jbi-title" style="font-size: 1.4rem; margin-bottom: 20px;">Quick Accounts</h2>
                    <div class="accounts-shortcuts-inner" id="accountsShortcutsInner"></div>
                </section>

                <section class="recently-played-section" id="recentlyPlayedSection" style="display: none;">
                    <div class="jbi-header" style="margin-bottom: 28px;">
                        <div class="jbi-header-left">
                            <h2 class="jbi-title" style="font-size: 1.4rem; ">Jump Back In <em class="jbi-subtitle" id="recentSessionCount"></em></h2>
                        </div>
                    </div>
                    <div class="jbi-grid" id="recentGrid"></div>
                </section>

                <section class="explore-section">
                    <header class="explore-header">
                        <h2 class="section-title">Explore Library</h2>
                        <div class="explore-controls">
                            <button class="explore-nav-btn" id="exploreNavLeft" onclick="exploreCarouselPrev()">&#9664;</button>
                            <button class="explore-nav-btn" id="exploreNavRight" onclick="exploreCarouselNext()">&#9654;</button>
                            <button class="view-all-btn" onclick="navigateToInstalled()">View All</button>
                        </div>
                    </header>
                    <div class="games-grid explore-grid" id="exploreGrid"></div>
                </section>

                <!-- ── SYNCED LIBRARY SUGGESTIONS ─────────────────────────── -->
                <section class="synced-suggestions-section" id="syncedSuggestionsSection" style="display:none;">
                    <div class="synced-wrap">

                        <!-- Head: eyebrow + title + subtitle | counts card -->
                        <div class="synced-head">
                            <div class="synced-head-left">
                                <div class="synced-eye">
                                    <span class="synced-pulse"></span>
                                    From your synced libraries
                                </div>
                                <h2 class="synced-title">Ready to Install</h2>
                                <p class="synced-sub">Owned but not yet on this machine — one click to queue the download.</p>
                            </div>
                            <div class="synced-counts" id="syncedSuggStats"></div>
                        </div>

                        <!-- Filter row -->
                        <div class="synced-filters">
                            <button class="sugg-pill active" data-filter="all"   onclick="setSyncedFilter('all',this)">Recommended</button>
                            <button class="sugg-pill"        data-filter="steam"  onclick="setSyncedFilter('steam',this)">From Steam</button>
                            <button class="sugg-pill"        data-filter="epic"   onclick="setSyncedFilter('epic',this)">From Epic</button>
                        </div>

                        <!-- CTA: no linked accounts -->
                        <div class="synced-cta" id="syncedSuggCTA" style="display:none;">
                            <div class="synced-cta-icon">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.5"/>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <p class="synced-cta-msg">Connect a gaming account to see your owned-but-not-installed games here.</p>
                            <div id="syncedCtaBtns" class="synced-cta-btns"></div>
                        </div>

                        <!-- Loading state -->
