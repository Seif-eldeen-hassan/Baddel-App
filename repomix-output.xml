/* ========================================= */
/* ALL GAMES GRID (Updated Size - Slightly Larger) */
/* ========================================= */
#allGamesGrid {
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)) !important;
    gap: 20px;
    /* حجز ارتفاع ثابت لكل صف = يمنع layout shift أثناء السكرول */
    grid-auto-rows: auto;
}

#allGamesGrid .game-card {
    /*
     * الـ virtual scroll بيتولى الـ rendering بنفسه (بيخبي ويظهر الـ rows)
     * مش محتاجين content-visibility هنا — بتتعارض مع position:absolute على الـ rows
     */
    display: flex;
    flex-direction: column;
    contain: layout style;
}

/* الغلاف بـ aspect-ratio ثابت = مفيش collapse أو expand أبدًا */
#allGamesGrid .game-card-img-wrap {
    position: relative;
    width: 100%;
    /*
     * ⚠️ مهم: لازم تتطابق مع حساب _vsMeasure في accounts.js
     * الـ JS بيحسب: cardH = colW * (3/2)
     * يعني الارتفاع = 1.5 × العرض  →  aspect-ratio = 2/3
     */
    aspect-ratio: 2 / 3;
    flex-shrink: 0;
    overflow: hidden;
}

#allGamesGrid .game-card-title {
    font-size: 0.95rem; /* كبرنا الخط حاجة بسيطة عشان يليق مع الحجم الجديد */
    font-weight: 600;
}
#allGamesGrid .game-card-info {
    display: none !important;
}

/* Native Lazy Load — نفس غلاف الداشبورد: cover + أسفل، ونفس hover الصورة */
#allGamesGrid .native-lazy-load {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.3s ease-out,
        transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),
        filter 0.4s ease;
    object-fit: cover;
    object-position: center bottom;
    width: 100%;
    height: 100%;
    will-change: opacity, transform;
}

#allGamesGrid .game-card:hover .native-lazy-load {
    transform: scale(1.05);
    filter: brightness(0.6);
}

/* placeholder بدون صورة — يملأ نفس مساحة الغلاف */
#allGamesGrid .game-card-img-wrap .game-card-img.agc-placeholder,
#allGamesGrid .agc-img-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
}

#allGamesGrid .game-card-img-wrap:has(.native-lazy-load.loaded) .agc-img-fallback {
    display: none;
}

#allGamesGrid .native-lazy-load.loaded {
    opacity: 1;
}

@keyframes imagePopIn {
    0% { opacity: 0; filter: brightness(0.5); }
    100% { opacity: 1; filter: brightness(1); }
}


/* ============================================================ */
/*  SKELETON LOADER ANIMATION                                   */
/* ============================================================ */
.gd-skeleton {
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.05) 25%, rgba(255, 255, 255, 0.1) 50%, rgba(255, 255, 255, 0.05) 75%);
    background-size: 200% 100%;
    animation: gdSkeletonShimmer 1.5s infinite linear;
    border-radius: 4px;
}

@keyframes gdSkeletonShimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}

/* ========================================= */
/* 🏷️ GENRE TAGS STYLING                     */
/* ========================================= */
.gd-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
}

.gd-genre-tag {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #ddd;
    padding: 6px 14px;
    border-radius: 20px; /* شكل الـ Pill (حبة الدواء) */
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: all 0.2s ease;
    cursor: default;
}

.gd-genre-tag:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
}


/* ========================================= */
/* 📸 SCREENSHOTS GRID FIX                   */
/* ========================================= */
.gd-screenshots {
    display: grid;
    /* بيظبط عدد الصور في الصف أوتوماتيك حسب حجم الشاشة */
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); 
    gap: 15px;
    margin-top: 10px;
}

.gd-screenshot-thumb {
    cursor: pointer;
    border-radius: 8px;
    overflow: hidden;
    /* السحر هنا: بيحجز مكان الصورة 16:9 قبل ما تحمل عشان متعملش زحلقة */
    aspect-ratio: 16 / 9; 
    background: rgba(255, 255, 255, 0.03); /* لون رمادي خفيف مكان الصورة وهي بتحمل */
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.gd-screenshot-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    animation: gdFadeIn 0.3s ease-out forwards; /* ظهور سريع وناعم */
}

/* حركة شيك لما تقف على الصورة بالماوس */
.gd-screenshot-thumb:hover {
    transform: scale(1.03);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
    border-color: rgba(255, 255, 255, 0.15);
    z-index: 2;
}

@keyframes gdFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

