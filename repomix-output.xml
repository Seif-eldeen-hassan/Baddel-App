}

/* Panel itself: no transform, no clipping */
#allGamesGrid.ag-empty-mode .ag-empty-onboarding {
    width: min(760px, 100%);
    max-width: 760px;
    max-height: none !important;
    margin: 0 auto;
    transform: none !important;
    box-sizing: border-box;
    overflow: visible !important;
}

/* ── Onboarding panel internals ───────────────────────────────────── */
.ag-empty-onboarding {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 32px 40px;
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    /* Very subtle green glow — not neon */
    background: radial-gradient(
        ellipse 65% 50% at 50% 52%,
        rgba(0, 200, 90, 0.045) 0%,
        transparent 70%
    );
}

/* ── Heading & sub-text ───────────────────────────────────────────── */
.ag-empty-heading {
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.01em;
    margin-bottom: 10px;
    text-align: center;
    position: relative;
}

.ag-empty-sub {
    font-family: var(--font-main);
    font-size: 0.88rem;
    color: var(--text-sec);
    text-align: center;
    max-width: 380px;
    line-height: 1.55;
    margin-bottom: 36px;
    position: relative;
}

/* ── Platform cards row ───────────────────────────────────────────── */
.ag-platform-cards {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
}

.ag-platform-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    width: 230px;
    padding: 22px 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    transition:
        background-color 0.18s ease,
        border-color 0.18s ease,
        transform 0.18s ease;
    cursor: default;
}

.ag-platform-card:hover {
    background: rgba(255, 255, 255, 0.065);
    border-color: rgba(0, 210, 100, 0.22);
    transform: translateY(-2px);
}

/* ── Card logo row ────────────────────────────────────────────────── */
.ag-pc-logo {
    display: flex;
    align-items: center;
    gap: 9px;
}

.ag-pc-logo img {
    width: 26px;
    height: 26px;
    object-fit: contain;
    flex-shrink: 0;
}

.ag-pc-logo img.ag-pc-invert {
    filter: brightness(0) invert(1);
    opacity: 0.85;
}

.ag-pc-platform-name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
}

/* ── Card description ─────────────────────────────────────────────── */
.ag-pc-desc {
    font-size: 0.78rem;
