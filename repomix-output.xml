<file path="baddel-steam-integration/src/steam_network/custom_login/css/style.css">
/* Local fonts — path is 5 levels up from this css/ dir to the project root */
@font-face {
    font-family: 'Montserrat';
    src: url('../../../../../assets/fonts/Montserrat-VariableFont_wght.ttf') format('truetype');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
}
@font-face {
    font-family: 'Montserrat';
    src: url('../../../../../assets/fonts/Montserrat-Italic-VariableFont_wght.ttf') format('truetype');
    font-weight: 100 900;
    font-style: italic;
    font-display: swap;
}
@font-face {
    font-family: 'Outfit';
    src: url('../../../../../assets/fonts/Outfit-VariableFont_wght.ttf') format('truetype');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
}

:root {
    --bg: #000000;
    --surface: #111114;
    --surface-hover: rgba(255, 255, 255, 0.08);
    --border: rgba(255, 255, 255, 0.1);
    --text: #f5f5f7;
    --text-muted: #86868b;
    --accent: #ffffff;
    --danger: #ff453a;
    --success: #30d158;
    --radius: 24px;
    --radius-sm: 12px;
    --bezier: cubic-bezier(0.2, 0.8, 0.2, 1);
    --font-main: 'Montserrat', -apple-system, sans-serif;
    --font-heading: 'Outfit', -apple-system, sans-serif;
}

/* ── Reset & Base ── */
* { box-sizing: border-box; margin: 0; padding: 0; }

body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-main);
    overflow: hidden;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
}

.no-error, .no-fallback { display: none !important; }

/* ── Container ── */
.main-wrapper {
    width: 100%;
    height: 100%;
    max-width: 520px;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 40px 100px rgba(0,0,0,0.8);
}

/* ── Header ── */
.main-header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
    background: rgba(255,255,255,0.01);
    position: relative;
    z-index: 10;
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.brand { display: flex; align-items: center; gap: 14px; }
.steam-logo-icon { width: 34px; height: 34px; filter: drop-shadow(0 0 8px rgba(255,255,255,0.2)); }
.title { font-family: var(--font-heading); font-size: 1.1rem; font-weight: 800; color: #fff; }
.subtitle { font-size: 0.75rem; color: var(--text-muted); margin-top: 1px; }

.close-btn {
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--border);
    color: var(--text-muted);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    position: absolute;
    top: 18px;
    right: 20px;
    margin: 0;
    padding: 0;
}
.close-btn:hover { background: rgba(255,255,255,0.12); color: #fff; transform: scale(1.1); }

/* ── Content ── */
.main-content {
    flex: 1;
    padding: 35px 40px;
    overflow-y: auto;
}

.auth-view { border: none; }
.view-header { margin-bottom: 30px; }
.section-title { font-family: var(--font-heading); font-size: 1.6rem; font-weight: 900; color: #fff; margin-bottom: 8px; }
.section-desc { font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; }

/* ── Inputs ── */
.field-group { margin-bottom: 24px; position: relative; }

.modern-input {
    width: 100%;
    height: 56px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 20px 16px 6px;
    color: #fff;
    font-family: var(--font-main);
    font-size: 1rem;
    font-weight: 500;
    transition: all 0.2s var(--bezier);
}

.modern-input:focus {
    outline: none;
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.3);
    box-shadow: 0 0 0 4px rgba(255,255,255,0.05);
}

.floating-label label {
    position: absolute;
    left: 16px;
    top: 18px;
    font-size: 0.95rem;
    color: var(--text-muted);
    pointer-events: none;
    transition: all 0.2s var(--bezier);
}

.modern-input:focus + label,
.modern-input:not(:placeholder-shown) + label {
    top: 8px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
}

/* ── Password Wrapper ── */
.password-wrapper { position: relative; }
.toggle-password-btn {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 8px;
}
.toggle-password-btn:hover { color: #fff; }
.toggle-password-btn.visible { color: var(--success); }
.eye-icon { width: 20px; height: 20px; }

/* ── Error Boxes ── */
.error-box {
    background: rgba(255, 69, 58, 0.1);
    border: 1px solid rgba(255, 69, 58, 0.2);
    color: #ff6961;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    animation: shake 0.4s var(--bezier);
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
}

/* ── Steam Guard (Code) ── */
.steam-guard-input {
    text-align: center;
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    padding: 10px;
}

.timer-display {
    text-align: center;
    margin-top: 12px;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
}
.timer-val { color: var(--text); }
.timer-val.expired { color: var(--danger); }

.resend-wrapper { margin-left: 4px; }
.resend-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 2px 4px;
    border-radius: 4px;
    transition: all 0.2s;
}
.resend-link:hover {
    background: rgba(255, 255, 255, 0.1);
    text-decoration: underline;
}

/* ── Waiting for Approval ── */
.waiting-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    padding: 20px 0;
}

.approval-visual { position: relative; width: 100px; height: 100px; display: flex; align-items: center; justify-content: center; }
.pulse-ring {
    position: absolute; inset: 0; border: 2px solid var(--accent); border-radius: 50%;
    animation: pulse 2s infinite cubic-bezier(0.4, 0, 0.6, 1);
}
@keyframes pulse {
    0% { transform: scale(0.8); opacity: 0.8; }
    100% { transform: scale(1.5); opacity: 0; }
}
.device-icon { color: #fff; filter: drop-shadow(0 0 15px rgba(255,255,255,0.3)); }

.waiting-status { display: flex; align-items: center; gap: 12px; color: var(--text-muted); font-size: 0.9rem; font-weight: 600; }

/* ── Auth Methods ── */
.auth-options-divider {
    display: flex;
    align-items: center;
    gap: 15px;
    margin: 36px 0 18px;
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    position: relative;
    z-index: 1;
    clear: both;
}
.auth-options-divider::before, .auth-options-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
}

.auth-methods-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.auth-method-item,
.support-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.2s var(--bezier);
}

.auth-method-item:hover,
.support-card:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.2);
    transform: scale(1.02);
}

.support-section {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.08);
}

.support-label {
    margin-bottom: 14px;
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.method-icon {
    width: 40px;
    height: 40px;
    background: rgba(255,255,255,0.06);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
}

.method-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.method-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0;
    line-height: 1.25;
}
.method-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.45;
}
.qr-container { display: flex; flex-direction: column; align-items: center; gap: 16px; }
.qr-box {
    width: 220px; height: 220px; background: #fff; border-radius: 16px; padding: 12px;
    display: flex; align-items: center; justify-content: center;
}
.qr-placeholder { display: flex; flex-direction: column; align-items: center; gap: 10px; color: #000; }
.qr-status { font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; }

/* ── Footer ── */
.main-footer {
    padding: 24px 30px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255,255,255,0.01);
}

.help-link, .forgot-password, .fallback-link {
    color: var(--text-muted); font-size: 0.85rem; font-weight: 600; text-decoration: none; transition: color 0.2s;
}
.help-link:hover, .forgot-password:hover, .fallback-link:hover { color: #fff; }

.primary-btn {
    background: #fff;
    color: #000;
    border: none;
    padding: 12px 24px;
    border-radius: 14px;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: all 0.3s var(--bezier);
    box-shadow: 0 10px 30px rgba(255,255,255,0.15);
}

.primary-btn:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 15px 40px rgba(255,255,255,0.25); }
.primary-btn:active { transform: scale(0.98); }

.text-btn { background: none; border: none; color: var(--text-muted); font-weight: 700; cursor: pointer; padding: 10px; }
.text-btn:hover { color: #fff; }

/* ── Overlays ── */
.loading-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(12px);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: all 0.4s var(--bezier); z-index: 1000;
}
.loading-overlay.active { opacity: 1; pointer-events: all; }

.spinner-container {
    display: flex; flex-direction: column; align-items: center; gap: 20px;
    transform: translateY(-20px);
}

.spinner {
    width: 48px; height: 48px; border: 4px solid rgba(255,255,255,0.05); border-top-color: #fff;
    border-radius: 50%; animation: spin 1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    box-shadow: 0 0 20px rgba(255,255,255,0.1);
}

.loading-overlay p {
    font-family: var(--font-heading); font-size: 1.1rem; font-weight: 700; color: #fff;
    letter-spacing: 0.02em; text-shadow: 0 2px 10px rgba(0,0,0,0.5);
}

/* ── Security Note ── */
.security-note {
    margin: 24px 0;
    padding: 16px;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.security-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.4;
    font-weight: 500;
}

.security-item svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: rgba(255,255,255,0.4);
}

/* ── Animations ── */
.fade-in { animation: fadeIn 0.4s var(--bezier); }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
</file>

<file path="baddel-steam-integration/src/steam_network/custom_login/index.html">
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta http-equiv="X-UA-Compatible" content="ie=edge">
	<link rel="stylesheet" href="../../commonWeb/css/common.css">
	<link rel="stylesheet" href="css/style.css">
	<title>Connect with Steam</title>
</head>

<body class="apple-tv-theme">
	<div class="container main-wrapper">
		<header class="main-header">
			<div class="header-content">
				<div class="brand">
					<img class="steam-logo-icon" src="../../commonWeb/img/icon-steam-logo.svg" alt="Steam logo">
					<div class="brand-text">
						<h1 class="title">Connect with Steam</h1>
						<p class="subtitle">Securely link your account to Baddel</p>
					</div>
				</div>
				<button class="close-btn" id="closeModalBtn" title="Close (Esc)">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
				</button>
			</div>
		</header>

		<main class="main-content">
			<form id="main-form" class="main-form" action="/" method="GET">
				<!-- 1. LOGIN INFO (Username/Password) -->
				<fieldset id="getLoginInfo" class="auth-view" style="display: none;">
					<div class="view-header">
						<h2 class="section-title">Sign In</h2>
						<p class="section-desc">Enter your Steam credentials to continue.</p>
					</div>
					
					<div class="field-group floating-label">
						<input class="modern-input" type="text" id="step-1-username" name="username" placeholder=" " required disabled="disabled">
						<label for="step-1-username">Steam Username</label>
					</div>

					<div class="field-group floating-label">
						<div class="password-wrapper">
							<input class="modern-input" type="password" id="step-1-password" name="password" placeholder=" " required disabled="disabled">
							<label for="step-1-password">Password</label>
							<button type="button" class="toggle-password-btn" title="Toggle visibility">
								<svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
							</button>
						</div>
					</div>

					<!-- Security Reassurance -->
					<div class="security-note">
						<div class="security-item">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
							<span>Your credentials are encrypted and never stored on our servers.</span>
						</div>
						<div class="security-item">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
							<span>Baddel ensures your privacy and data security.</span>
						</div>
					</div>

					<div class="error-box no-error" id="bad-password">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
						<span>The account name or password that you have entered is incorrect.</span>
					</div>

					<div class="error-box no-error" id="steamguard-expired">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
						<span>Steam Guard session expired. Please log in again.</span>
					</div>
				</fieldset>

				<!-- 2. STEAM GUARD EMAIL -->
				<fieldset id="steamGuardEmail" class="auth-view" style="display:none;">
					<div class="view-header">
						<h2 class="section-title">Check Your Email</h2>
						<p class="section-desc">We've sent a code to your Steam-linked email address.</p>
					</div>

					<div class="field-group code-input-container">
						<input class="modern-input steam-guard-input" type="text" id="step-1-code" name="code" maxlength="5" placeholder="ABCDE" disabled="disabled">
						<div class="timer-display" id="emailTimer">
							Code expires in <span class="timer-val">60s</span>
							<span class="resend-wrapper" style="display:none;">
								&bull; <a href="#" class="resend-link" onclick="resendCode()">Resend</a>
							</span>
						</div>
					</div>

					<div class="info-note">
						<p>If you don't see it, check your spam folder or wait a minute before requesting a new one.</p>
						<a href="https://help.steampowered.com/en/wizard/HelpWithSteamGuardCode" class="help-link" target="_blank">Need help?</a>
					</div>

					<div class="error-box no-error">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
						<span>Invalid code. Please check and try again.</span>
					</div>
				</fieldset>

				<!-- 3. STEAM GUARD PHONE (Code) -->
				<fieldset id="steamGuardPhone" class="auth-view" style="display:none;">
					<div class="view-header">
						<h2 class="section-title">Steam Mobile App</h2>
						<p class="section-desc">Enter the 5-character code from your Steam Mobile Authenticator.</p>
					</div>

					<div class="field-group code-input-container">
						<input class="modern-input steam-guard-input" type="text" id="step-4-code" name="code" maxlength="5" placeholder="ABCDE" disabled="disabled">
						<div class="timer-display" id="phoneTimer">
							New code in <span class="timer-val">30s</span>
							<span class="resend-wrapper" style="display:none;">
								&bull; <a href="#" class="resend-link" onclick="resendCode()">Restart Login</a>
							</span>
						</div>
					</div>

					<div class="error-box no-error">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
						<span>Invalid code. Please check and try again.</span>
					</div>
				</fieldset>

				<!-- 4. STEAM GUARD CONFIRM (Approval Request) -->
				<fieldset id="steamGuardConfirm" class="auth-view" style="display:none;">
					<div class="view-header">
						<h2 class="section-title">Approve Login in Steam App</h2>
						<p class="section-desc">Open your Steam mobile app and tap <strong>Approve</strong>. We will continue automatically.</p>
					</div>

					<div class="waiting-container">
						<div class="approval-visual">
							<div class="pulse-ring"></div>
							<div class="device-icon">
								<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
							</div>
						</div>
						<div class="waiting-status">
							<div class="spinner-small"></div>
							<span>Waiting for your approval. This will continue automatically.</span>
						</div>
					</div>

					<div class="auth-options-divider no-fallback">
						<span>OR USE ANOTHER METHOD</span>
					</div>

					<div class="auth-methods-list">
						<a id="fallback-tag" class="auth-method-item no-fallback" href="#">
							<div class="method-icon">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
							</div>
							<div class="method-info">
								<div class="method-name">Use Email Code</div>
								<div class="method-desc">Get a code sent to your email</div>
							</div>
						</a>
					</div>

					<div class="support-section">
						<div class="support-label">Need help instead?</div>
						<a href="https://help.steampowered.com/en/wizard/HelpWithLogin" class="support-card" target="_blank">
							<div class="method-icon">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
							</div>
							<div class="method-info">
								<div class="method-name">Help, I can't sign in</div>
								<div class="method-desc">Troubleshoot login issues</div>
							</div>
						</a>
					</div>

					<div class="error-box no-error">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
						<span>Confirmation failed. Please try again.</span>
					</div>
				</fieldset>

				<!-- 5. METHOD CHOOSER -->
				<fieldset id="chooseMethod" class="auth-view" style="display:none;">
					<div class="view-header">
						<h2 class="section-title">How would you like to sign in?</h2>
						<p class="section-desc">Choose a method to link your Steam account.</p>
					</div>

					<div class="auth-methods-list" style="gap:12px;">
						<a class="auth-method-item" href="baddel://auth/qr-start" id="chooseQR">
							<div class="method-icon">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="3" height="3"/></svg>
							</div>
							<div class="method-info">
								<div class="method-name">Scan QR Code</div>
								<div class="method-desc">Use your Steam mobile app — no password needed</div>
							</div>
						</a>
						<a class="auth-method-item" href="baddel://auth/login-form" id="choosePassword">
							<div class="method-icon">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
							</div>
							<div class="method-info">
								<div class="method-name">Username &amp; Password</div>
								<div class="method-desc">Sign in with your Steam credentials</div>
							</div>
						</a>
					</div>
				</fieldset>

				<!-- 6. QR CODE LOGIN -->
				<fieldset id="steamGuardQR" class="auth-view" style="display:none;">
					<div class="view-header">
						<h2 class="section-title">Scan QR Code</h2>
						<p class="section-desc">Open the Steam app, tap on the QR icon, and scan this code for instant login.</p>
					</div>

					<div class="qr-container">
						<div class="qr-box" id="steamQRCode">
							<!-- QR Code will be rendered here -->
							<div class="qr-placeholder">
								<div class="spinner"></div>
							</div>
						</div>
						<div class="qr-status">Scanning...</div>
					</div>

					<a class="text-btn" href="baddel://auth/login-form" id="switchToUserPass">Back to password</a>
				</fieldset>
			</form>
		</main>

		<footer class="main-footer">
			<div class="footer-links">
				<a class="forgot-password" href="https://help.steampowered.com/en/wizard/HelpWithLogin" target="_blank">Forgot password?</a>
			</div>
			<div class="footer-actions" id="actionButtons">
				<button class="primary-btn" type="submit" form="main-form" id="continueBtn">
					<span>Continue</span>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
				</button>
			</div>
		</footer>
	</div>

	<!-- Loading Overlay -->
	<div id="loadingOverlay" class="loading-overlay">
		<div class="spinner-container">
			<div class="spinner"></div>
			<p>Authenticating...</p>
		</div>
	</div>

	<script>
		// --- CONFIG & STATE ---
		const viewLookup = {
			login: "login",
			steamGuard: "steamguard",
			steamAuthenticator: "steamauthenticator",
			steamAuthenticatorConfirm: "steamauthenticator_confirm",
			steamQR: "steam_qr",
			chooseMethod: "choose_method",
		};

		const fieldSetsObj = {
			loginFieldSet: document.querySelector("#getLoginInfo"),
			loginInputs: document.querySelectorAll("#getLoginInfo input"),
			loginError: document.querySelectorAll("#getLoginInfo .error-box"),

			steamGuardFieldSet: document.querySelector("#steamGuardEmail"),
			steamGuardInputs: document.querySelectorAll("#steamGuardEmail input"),
			steamGuardError: document.querySelectorAll("#steamGuardEmail .error-box"),

			steamAuthenticatorFieldset: document.querySelector("#steamGuardPhone"),
			steamAuthenticatorInputs: document.querySelectorAll("#steamGuardPhone input"),
			steamAuthenticatorError: document.querySelectorAll("#steamGuardPhone .error-box"),

			steamAuthenticatorConfirmFieldset: document.querySelector("#steamGuardConfirm"),
			steamAuthenticatorConfirmInputs: document.querySelectorAll("#steamGuardConfirm input"),
			steamAuthenticatorConfirmError: document.querySelectorAll("#steamGuardConfirm .error-box"),

			chooseMethodFieldset: document.querySelector("#chooseMethod"),
			steamQRFieldset: document.querySelector("#steamGuardQR"),
		};

		// --- HELPERS ---

		function showLoading(show = true) {
			document.getElementById('loadingOverlay').classList.toggle('active', show);
		}

		function handleEnablingInputs(inputs) {
			for (let input of inputs) {
				input.disabled = false;
			}
		}

		function togglePasswordVisibility() {
			const input = document.getElementById("step-1-password");
			const btn = document.querySelector(".toggle-password-btn");
			if (input.type === "password") {
				input.type = "text";
				btn.classList.add("visible");
			} else {
				input.type = "password";
				btn.classList.remove("visible");
			}
		}

		// --- TIMERS ---
		function startTimer(duration, displayId) {
			let timer = duration, minutes, seconds;
			const display = document.querySelector(`#${displayId} .timer-val`);
			const resendWrapper = document.querySelector(`#${displayId} .resend-wrapper`);
			const interval = setInterval(() => {
				minutes = parseInt(timer / 60, 10);
				seconds = parseInt(timer % 60, 10);

				seconds = seconds < 10 ? "0" + seconds : seconds;
				display.textContent = (minutes > 0 ? minutes + ":" : "") + seconds + "s";

				if (--timer < 0) {
					clearInterval(interval);
					display.textContent = "Expired";
					display.classList.add('expired');
					if (resendWrapper) resendWrapper.style.display = 'inline';
				}
			}, 1000);
			return interval;
		}

		function resendCode() {
			const url = new URL(window.location.href);
			url.searchParams.set('view', 'login');
			url.searchParams.delete('errored');
			window.location.href = url.href;
		}

		// --- MAIN LOGIC ---

		function handleParamsAndForms() {
			const urlParams = new URLSearchParams(window.location.search);
			const formElement = document.querySelector("#main-form");
			const forgotPasswordButtonElement = document.querySelector(".forgot-password");
			const continueBtn = document.getElementById('continueBtn');

			let view = urlParams.get("view");
			let errored = urlParams.get("errored") == 'true';
			let act, loc, inp, err = null;

			// Reset all views
			document.querySelectorAll('.auth-view').forEach(v => v.style.display = 'none');

			switch (view) {
				case viewLookup.steamGuard:
					loc = fieldSetsObj.steamGuardFieldSet;
					inp = fieldSetsObj.steamGuardInputs;
					act = "/two_factor_mail_finished";
					err = errored ? fieldSetsObj.steamGuardError : null;
					startTimer(60, 'emailTimer');
					break;
				case viewLookup.steamAuthenticator:
					loc = fieldSetsObj.steamAuthenticatorFieldset;
					inp = fieldSetsObj.steamAuthenticatorInputs;
					act = "/two_factor_mobile_finished";
					err = errored ? fieldSetsObj.steamAuthenticatorError : null;
					startTimer(30, 'phoneTimer');
					break;
				case viewLookup.steamAuthenticatorConfirm:
					loc = fieldSetsObj.steamAuthenticatorConfirmFieldset;
					inp = fieldSetsObj.steamAuthenticatorConfirmInputs;
					act = "/two_factor_confirm_finished";
					err = errored ? fieldSetsObj.steamAuthenticatorConfirmError : null;
					continueBtn.querySelector('span').textContent = 'Confirm on Phone';
					break;
				case viewLookup.chooseMethod:
					loc = fieldSetsObj.chooseMethodFieldset;
					inp = [];
					act = "/login_finished";
					continueBtn.style.display = 'none';
					break;
				case viewLookup.steamQR:
					loc = fieldSetsObj.steamQRFieldset;
					inp = [];
					act = "/login_finished";
					continueBtn.style.display = 'none';
					break;
				case viewLookup.login:
				default:
					loc = fieldSetsObj.loginFieldSet;
					inp = fieldSetsObj.loginInputs;
					act = "/login_finished";
					err = errored ? fieldSetsObj.loginError : null;
					forgotPasswordButtonElement.style.display = "block";
					break;
			}

			formElement.action = act;
			handleEnablingInputs(inp);

			if (err) {
				for (let e of err) e.classList.remove("no-error");
			}

			loc.style.display = "block";
			loc.classList.add('fade-in');

			// Fallback logic
			if (view == viewLookup.steamAuthenticatorConfirm) {
				let fallbackMeth = urlParams.get("fallbackMethod");
				let fallbackStr = urlParams.get("fallbackMsg");
				if (fallbackMeth) {
					let fallbackTag = document.getElementById("fallback-tag");
					let fallbackHolder = fallbackTag; // Using the tag itself now
					let curr_href = new URL(window.location.href);

					curr_href.searchParams.set('view', fallbackMeth);
					curr_href.searchParams.set('view-msg', fallbackStr);
					fallbackTag.href = curr_href.href;

					let niceText = "Use a fallback method";
					let methodTitle = "Use a different method";
					let methodDesc = "Try another authentication way";

					if (fallbackMeth == viewLookup.steamGuard) {
						methodTitle = "Use Email Code";
						methodDesc = "Get a code sent to your email";
					} else if (fallbackMeth == viewLookup.steamAuthenticator) {
						methodTitle = "Use Mobile Code";
						methodDesc = "Enter the code from your app";
					}

					fallbackTag.querySelector('.method-name').textContent = methodTitle;
					fallbackTag.querySelector('.method-desc').textContent = methodDesc;
					fallbackTag.classList.remove("no-fallback");
					document.querySelector('.auth-options-divider').classList.remove('no-fallback');
				}
			}

			// Login specific errors
			if (view == viewLookup.login && err) {
				let badPass = document.getElementById("bad-password");
				let expiredError = document.getElementById("steamguard-expired");
				let expired = urlParams.get("expired");
				
				if (expired == "true") {
					expiredError.classList.remove("no-error");
					badPass.classList.add("no-error");
				} else {
					badPass.classList.remove("no-error");
					expiredError.classList.add("no-error");
				}
			}
		}

		// --- INITIALIZATION ---

		document.addEventListener("DOMContentLoaded", () => {
			handleParamsAndForms();

			// Restore saved username
			const savedUser = localStorage.getItem('steam_username_tmp');
			if (savedUser) {
				const userInp = document.getElementById('step-1-username');
				if (userInp) userInp.value = savedUser;
			}

			// Save username as they type
			document.getElementById('step-1-username')?.addEventListener('input', (e) => {
				localStorage.setItem('steam_username_tmp', e.target.value);
			});

			// Event Listeners
			document.querySelector(".toggle-password-btn")?.addEventListener("click", togglePasswordVisibility);
			
			document.getElementById('main-form').addEventListener('submit', () => {
				showLoading(true);
			});

			document.getElementById('closeModalBtn').addEventListener('click', () => {
				// Electron window close signal
				window.close();
			});

			// ESC to close
			window.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') window.close();
			});
		});
	</script>
</body>

</html>
