        assert.deepEqual(readJson(path.join(dir, 'sync_link.json')), { platformAccountId: 'old-id' });
    } finally {
        rmDir(testUserData);
    }
});

test('_findMatchingEpicSwitcherProfile falls back to folder-name match when sync_link is missing', async () => {
