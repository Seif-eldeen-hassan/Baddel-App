    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
}

.platform-sync-simple-summary span {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.07);
