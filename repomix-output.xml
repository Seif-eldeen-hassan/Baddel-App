    box-shadow: 0 0 14px color-mix(in srgb, var(--plat-accent, #fff) 20%, transparent);
}

/* Discord avatar is round — keep it perfectly round */
.acc-card-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
}

/* Card info */
.acc-card-info {
    flex: 1;
    min-width: 0;
}

.acc-card-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: #ccc;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 3px;
    letter-spacing: 0.2px;
}

.acc-card-platform {
    font-size: 0.7rem;
    color: #444;
    font-weight: 500;
}

/* Card actions */
.acc-card-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

/* Switch button — juicy, platform-themed */
.acc-switch-btn {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: var(--text-main, #ccc);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    font-family: var(--font-main, sans-serif);
    letter-spacing: 0.3px;
    position: relative;
    overflow: hidden;
}

.acc-switch-btn::before {
    content: '';
    position: absolute; inset: 0;
    background: var(--btn-accent, #ffffff);
    opacity: 0;
    transition: opacity 0.2s ease;
}

.acc-switch-btn:hover {
    border-color: var(--btn-accent, #ffffff);
    color: color-mix(in srgb, var(--btn-accent, #ffffff) 100%, #000);
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--btn-accent, #fff) 25%, transparent),
                0 0 0 1px color-mix(in srgb, var(--btn-accent, #fff) 20%, transparent);
    background: color-mix(in srgb, var(--btn-accent, #ffffff) 12%, transparent);
}

.acc-switch-btn:active {
    transform: translateY(0) scale(0.98);
}

.acc-switch-btn svg {
    transition: transform 0.2s ease;
}

.acc-switch-btn:hover svg {
    transform: rotate(180deg);
}

.acc-switch-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: none !important;
    box-shadow: none !important;
}

/* Rename button */
.acc-rename-btn {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #333;
    cursor: pointer;
    transition: all 0.15s ease;
}

.acc-rename-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: #888;
    transform: scale(1.05);
}

/* Delete button */
.acc-delete-btn {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #333;
    cursor: pointer;
    transition: all 0.15s ease;
}

.acc-delete-btn:hover {
    background: rgba(255, 59, 48, 0.08);
    border-color: rgba(255, 59, 48, 0.25);
    color: #ff3b30;
    transform: scale(1.05);
}

/* ============================================================ */
/* 9. EMPTY STATE & LOADING                                     */
/* ============================================================ */

.accounts-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    gap: 12px;
    text-align: center;
}

.accounts-empty p {
    font-size: 0.9rem;
    font-weight: 600;
    color: #2e2e2e;
}

.accounts-empty span {
    font-size: 0.75rem;
    color: #222;
}

.accounts-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 40px;
    color: #2a2a2a;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.5px;
}

/* ============================================================ */
/* 10. SPINNERS                                                  */
/* ============================================================ */

.acc-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    animation: accSpin 0.7s linear infinite;
}

.acc-mini-spinner {
    width: 11px;
    height: 11px;
    border: 2px solid rgba(0, 0, 0, 0.15);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: accSpin 0.7s linear infinite;
    display: inline-block;
}

@keyframes accSpin {
    to { transform: rotate(360deg); }
}

/* ============================================================ */
/* 11. COLLAPSED SIDEBAR FIXES                                  */
/* ============================================================ */

.sidebar.collapsed .sidebar-sub-items .nav-text,
.sidebar.collapsed .sidebar-section-btn .nav-text,
.sidebar.collapsed .sidebar-sub-header {
    opacity: 0;
    pointer-events: none;
    display: none;
}

.sidebar.collapsed .sidebar-section-btn {
    padding: 0;
    justify-content: center;
    width: 48px;
    height: 48px;
}

.sidebar.collapsed .sidebar-sub-items {
    padding-left: 0;
    border-left: none;
    margin-left: 0;
}

/* ============================================================ */
/* 12. PLATFORM ACTIVE STATES IN SIDEBAR                        */
/* ============================================================ */

#nav-steam.active   { background: #66c0f4 !important; color: #000 !important; }
#nav-steam.active .platform-icon { color: #1b2838 !important; }

#nav-epic.active    { background: #f0f0f0 !important; color: #000 !important; }
#nav-epic.active .platform-icon { color: #000 !important; }
#nav-epic.active img { filter: brightness(0) saturate(100%) !important; }

#nav-ea.active      { background: #ff4545 !important; color: #fff !important; }
#nav-ea.active .platform-icon { color: #fff !important; }

#nav-riot.active    { background: #d32f2e !important; color: #fff !important; }
#nav-riot.active .platform-icon { color: #fff !important; }

#nav-ubisoft.active { background: #00a8ff !important; color: #fff !important; }
#nav-ubisoft.active .platform-icon { color: #fff !important; }

#nav-discord.active { background: #5865F2 !important; color: #fff !important; }
#nav-discord.active .platform-icon { color: #fff !important; }

#nav-steam.active   .platform-count,
#nav-epic.active    .platform-count { background: rgba(0,0,0,0.12); color: rgba(0,0,0,0.4); }

#nav-ea.active      .platform-count,
#nav-riot.active    .platform-count,
#nav-ubisoft.active .platform-count,
#nav-discord.active .platform-count { background: rgba(0,0,0,0.15); color: rgba(255,255,255,0.45); }

/* ============================================================ */
/* 13. DISCORD CARD SPECIAL (avatar image)                      */
/* ============================================================ */

.discord-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* ============================================================ */
/* 14. ANIMATIONS                                               */
/* ============================================================ */

@keyframes blobFloat {
    from { transform: translateY(0px) scale(1); }
    to   { transform: translateY(-20px) scale(1.05); }
}


/* أضف هذا داخل قسم: 8. ACCOUNT CARDS في ملف accounts.css */

/* Pin/Send to Home button */
.acc-pin-btn {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #333;
    cursor: pointer;
    transition: all 0.15s ease;
}

.acc-pin-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: var(--plat-accent, #fff); /* ياخد لون المنصة */
    transform: scale(1.05);
}

/* ========================================= */
/* 📌 PINNED STATE FOR ACCOUNT CARDS         */
/* ========================================= */
.acc-pin-btn.is-pinned {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: var(--plat-accent, #fff);
}

.acc-pin-btn.is-pinned svg {
    fill: currentColor; /* ده السر اللي بيخلي البيت مفرغ يتحول لبيت مليان */
}


/* ========================================= */
/* ROCKSTAR GAMES STYLES                     */
/* ========================================= */
.acc-btn-rockstar:hover {
    background: rgba(252, 175, 23, 0.1); 
    color: #fcaf17;
    border-color: rgba(252, 175, 23, 0.4);
    box-shadow: 0 5px 15px rgba(252, 175, 23, 0.2);
}

.acc-btn-rockstar:hover svg {
    color: #fcaf17;
}

/* لو عندك بادج للمنصة في كارت الأكاونت */
.acc-plat-badge.rockstar {
    background: #fcaf17;
    color: #000; /* عشان الكلام يبقى مقروء على الأصفر */
}

/* ========================================= */
/* PLATFORM SYNC — All Games & Link Banner   */
/* ========================================= */

/* ── Toolbar sticky wrapper ─────────────────────────────────── */
.ag-toolbar-sticky {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(8, 8, 8, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    padding: 12px 0 10px;
    margin-bottom: 16px;
    /* padding intentionally excluded from transition — height change causes visible jump */
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.ag-toolbar-sticky.is-stuck {
    border-bottom-color: rgba(255, 255, 255, 0.06);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
    /* padding kept identical to avoid layout height change when is-stuck toggles */
}

/* ── Toolbar (search + filters + sort) ─────────────────────── */
.ag-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: nowrap;
    margin-bottom: 0;
}

/* Filter group — pills + account + installed — takes remaining space */
.ag-filter-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
    /* overflow: hidden removed — it clips position:absolute dropdown children
       (agAccountMenu) even though they are positioned outside the flow.
       Text overflow on pill/trigger labels is handled by min-width:0 +
       text-overflow on those elements directly instead. */
    overflow: visible;
}

/* Controls group — sort / view / display / count — fixed right */
.ag-controls-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

/* Search */
.ag-search-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px;
    padding: 0 10px 0 12px;
    height: 34px;
    flex-shrink: 0;
    width: 200px;
    transition: border-color 0.15s, width 0.2s ease;
}
.ag-search-wrap:focus-within {
    border-color: rgba(255,255,255,0.18);
    width: 240px;
}
.ag-search-wrap svg { color: #444; flex-shrink: 0; }
.ag-search-input {
    background: none; border: none; outline: none;
    color: #ddd; font-size: 0.8rem;
    font-family: var(--font-main, sans-serif);
    width: 100%;
    min-width: 0;
}
.ag-search-input::placeholder { color: #3a3a3a; }

/* Search clear (X) button */
.ag-search-clear {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: #555;
    cursor: pointer;
    padding: 2px;
    border-radius: 3px;
    transition: color 0.12s;
    flex-shrink: 0;
    line-height: 0;
}
.ag-search-clear:hover { color: #aaa; }

/* Platform filter pills */
.ag-filter-pills {
    display: flex;
    align-items: center;
    gap: 5px;
}

/* Account dropdown (theme-styled, non-native select) */
.ag-account-dropdown {
    min-width: 180px;
}

.ag-account-trigger {
    min-width: 180px;
    height: 34px;
    padding: 0 12px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    color: #b9b9b9;
    font-size: 0.75rem;
}

.ag-account-trigger:hover {
    border-color: rgba(255,255,255,0.18);
}

.ag-account-menu {
    width: 100%;
    max-height: 280px;
    overflow-y: auto;
    z-index: 200; /* was 120 — must exceed ag-toolbar-sticky z-index:50 and card z-index:10 */
}

.ag-pill {
    height: 34px;
    padding: 0 13px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.07);
    background: rgba(255,255,255,0.03);
    color: #666;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-main, sans-serif);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    white-space: nowrap;
}
.ag-pill:hover {
    background: rgba(255,255,255,0.07);
    color: #aaa;
    border-color: rgba(255,255,255,0.13);
}
.ag-pill.active {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.2);
    color: #fff;
}
.ag-pill-icon {
    width: 13px; height: 13px;
    object-fit: contain;
    opacity: 0.7;
}
.ag-pill-icon-invert {
    filter: brightness(0) invert(1);
}

/* Sort select */
.ag-sort-wrap {
    display: flex;
    align-items: center;
    gap: 7px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px;
    padding: 0 12px;
    height: 34px;
    transition: border-color 0.15s;
}
.ag-sort-wrap svg { color: #444; flex-shrink: 0; }
.ag-sort-select {
    background: none; border: none; outline: none;
    color: #888; font-size: 0.75rem; font-weight: 600;
    font-family: var(--font-main, sans-serif);
    cursor: pointer;
    appearance: none; -webkit-appearance: none;
    padding-right: 4px;
}
.ag-sort-select option { background: #111; color: #ccc; }
.ag-sort-wrap:focus-within { border-color: rgba(255,255,255,0.15); }

/* Result count */
.ag-result-count {
    font-size: 0.7rem;
    font-weight: 600;
    color: #3a3a3a;
    letter-spacing: 0.5px;
    white-space: nowrap;
}

/* ── Game card wrapper for All Games ────────────────────────── */
.agc-card .game-card-img-wrap {
    position: relative;
    overflow: hidden;
}

/* Multi-platform subtle accent */
.agc-multi .game-card-img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: inherit;
    pointer-events: none;
    z-index: 4;
}

/* Gradient from top so badges always readable */
.agc-top-gradient {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 55px;
    background: linear-gradient(to bottom, rgba(0,0,0,0.52) 0%, transparent 100%);
    pointer-events: none;
    z-index: 2;
}

/* ── Badge strip — top-right corner ─────────────────────────── */
.agc-badges-strip {
    position: absolute;
    top: 7px; 
    right: 7px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 3;
    align-items: flex-end;
    
    /* التعديل هنا */
    opacity: 0;
    transform: translateY(-5px); /* حركة خفيفة من فوق لتحت */
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none; /* عشان ميعطلش الكليك على الكارت وهي مخفية */
}

.agc-card:hover .agc-badges-strip {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
}

/* ── Individual badge ─────────────────────────────────────────── */
.agc-badge {
    --bc: #ffffff;
    width: 24px; height: 24px;
    border-radius: 7px;
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid color-mix(in srgb, var(--bc) 26%, transparent);
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 2px 6px rgba(0,0,0,0.4);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    flex-shrink: 0;
}

.agc-card:hover .agc-badge {
    border-color: color-mix(in srgb, var(--bc) 52%, transparent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--bc) 20%, transparent),
                0 2px 6px rgba(0,0,0,0.4);
    transform: scale(1.06);
}

.agc-badge-img {
    width: 13px; height: 13px;
    object-fit: contain; display: block;
    opacity: 0.8;
    transition: opacity 0.2s;
}
.agc-card:hover .agc-badge-img { opacity: 1; }

.agc-badge-invert {
    filter: brightness(0) invert(1) !important;
    opacity: 0.75;
}
.agc-card:hover .agc-badge-invert { opacity: 1; }

.agc-badge-dot {
    width: 7px; height: 7px;
    border-radius: 50%; opacity: 0.85;
}

.agc-badge-overflow {
    font-size: 0.55rem; font-weight: 800;
    color: rgba(255,255,255,0.5);
    letter-spacing: 0.3px;
    font-family: var(--font-heading, sans-serif);
    border-color: rgba(255,255,255,0.1);
}
.agc-card:hover .agc-badge-overflow {
    color: rgba(255,255,255,0.9);
    border-color: rgba(255,255,255,0.28);
}

.agc-placeholder {
    background: linear-gradient(135deg, #111 0%, #0a0a0a 100%) !important;
    display: flex !important;
    align-items: center; justify-content: center;
}

/* بانر الـ "Connect Platform" */
.platform-link-banner {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 20px;
}

.epic-link-banner {
    border-color: rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.04);
}

.plb-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    background: rgba(255,255,255,0.06);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.plb-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.plb-text strong {
    color: #ddd;
    font-size: 0.88rem;
}

.plb-text span {
    color: #555;
    font-size: 0.78rem;
    line-height: 1.4;
}

.plb-btn {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 7px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.15);
    color: #ccc;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
}

.plb-btn:hover {
    background: rgba(255,255,255,0.12);
    color: #fff;
    border-color: rgba(255,255,255,0.25);
}

/* Mini list في الـ Link Library panel */
.epic-library-mini-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.epic-lib-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 8px;
    border-radius: 8px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.04);
    transition: background 0.15s;
}

.epic-lib-row:hover {
    background: rgba(255,255,255,0.05);
}

.epic-lib-thumb {
    width: 36px;
    height: 48px;
    border-radius: 4px;
    object-fit: cover;
    flex-shrink: 0;
}

.epic-lib-thumb-placeholder {
    background: rgba(255,255,255,0.06);
}

.epic-lib-title {
    flex: 1;
    color: #ccc;
    font-size: 0.84rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Platforms Modal Styling */
.platforms-modal {
    width: 480px;
    background: #0f0f0f;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.platforms-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.platform-card {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    padding: 15px;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid transparent;
}

.platform-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
}

.platform-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 20px;
    margin-right: 15px;
}
.platform-card .epic-icon { background: #313131; color: #fff; }

.platform-info h3 { margin: 0; font-size: 16px; color: #fff; }
.platform-info span { font-size: 12px; color: #888; }
.arrow-icon { margin-left: auto; color: #666; font-size: 20px; }

.details-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.back-btn {
    background: none; border: none; color: #888; cursor: pointer; font-size: 14px;
}
.back-btn:hover { color: #fff; }

.accounts-list-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 300px;
    overflow-y: auto;
    margin-bottom: 20px;
}

.platform-sync-status-panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 16px;
    padding: 14px 16px;
