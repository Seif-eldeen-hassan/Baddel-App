    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px;
    gap: 8px;
    align-items: center;
}

/* Spin Again: ثابت، واضح، مش glass شفاف زيادة */
.btn-spin {
    flex: none !important;
    width: 100% !important;
    min-width: 0;
    height: 44px;
    padding: 0 18px;
    border-radius: 13px;
    font-size: 0.88rem;
    font-weight: 800;

    background: rgba(10, 10, 10, 0.74);
    color: rgba(255, 255, 255, 0.96);
