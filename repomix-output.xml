        custom &&
        typeof custom === 'object' &&
        (
            custom.title ||
            custom.posterImage ||
            custom.coverImage ||
            custom.heroImage ||
            custom.logoImage ||
            custom.logoMode ||
            custom.shortDescription ||
            custom.description ||
            custom.developer ||
            custom.publisher ||
            custom.releaseDate ||
            custom.genres?.length ||
