});

test('hygiene: roulette.js contains no mojibake sequences (common Windows-1252 → UTF-8 mangling)', () => {
    // Mojibake: Latin-1 supplement immediately following Ã or  (U+00C3, U+00C2)
    // These arise when UTF-8 multibyte sequences are misread as Windows-1252.
    assert.doesNotMatch(ROULETTE_JS, /Ã[-¿]/u);
    assert.doesNotMatch(ROULETTE_JS, /Â[-¿]/u);
});

test('hygiene: roulette.js contains no informal interjections', () => {
    // Guard against informal code comments (exclamatory words in all-caps or with
    // repeated characters) that are not part of string literals.
    // Only check comment lines (starting with //).
    const commentLines = ROULETTE_JS.split('\n').filter(l => l.trimStart().startsWith('//'));
    for (const line of commentLines) {
        assert.doesNotMatch(line, /\bWTF\b|\bOMG\b|\bLOL\b/i,
            `Informal interjection found in comment: ${line.trim()}`);
    }
});

