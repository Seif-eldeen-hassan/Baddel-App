    assert.match(body, /installed[\s\S]{0,200}collectionId\s*=\s*null/);
});

test('igSelectPlatform: saves filter state only when in installed view', () => {
    const body = extractFn(ACC_JS, 'window.igSelectPlatform = function(value, label)');
