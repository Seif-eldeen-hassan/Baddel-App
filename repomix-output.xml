            if (typeof window._onSyncLibraryUpdated === 'function') window._onSyncLibraryUpdated();
        } else {
            _preserveActiveScrollDuring('library-updated', () => {
                applyFilters();
                if (typeof window._onSyncLibraryUpdated === 'function') window._onSyncLibraryUpdated();
            });
        }
    });
}


