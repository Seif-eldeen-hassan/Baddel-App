    assert.ok('closeAfterSwitch' in DEFAULTS);
    assert.ok('showSearchOnOpen' in DEFAULTS);
    assert.equal(DEFAULTS.accelerator, 'Ctrl+Alt+B');
    assert.equal(DEFAULTS.position,    'right');
    assert.equal(DEFAULTS.version,     1);
});

