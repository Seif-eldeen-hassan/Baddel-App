        .then(r => {
            const m = r.stdout.match(/REG_\w+\s+(.+)/);
            return m ? m[1].trim() : null;
        })
        .catch(() => null);
}

function regSet(key, value, type, data) {
    return execFileAsync('reg.exe', ['add', key, '/v', value, '/t', type, '/d', data, '/f']).catch(() => null);
}

