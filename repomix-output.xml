                    <div style="display: flex; flex-direction: column;">
                        <span style="font-weight: 600; font-size: 0.9rem;">Steam</span>
                        <span id="steamAccountsCount" style="font-size: 0.7rem; color: #888;">0 Linked</span>
                    </div>
                </div>
                
            </div>

            <div id="platformDetailsView" style="flex: 1; padding: 20px 25px; overflow-y: auto; display: flex; flex-direction: column; background: #0f0f0f; position: relative;">
                
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h3 id="currentPlatformTitle" style="margin: 0; font-family: var(--font-heading); font-size: 1.2rem;">Epic Games</h3>
                </div>

                <div id="platformSyncStatusPanel" class="platform-sync-status-panel" style="display:none;"></div>
                
                <div id="linkedAccountsList" class="accounts-list-container" style="flex: 1; margin-bottom: 15px;">
                </div>

                <div id="platformSyncSimpleOverlay" class="platform-sync-simple-overlay">
                    <div class="platform-sync-simple-box">
                        <div id="platformSyncSimpleSpinner" class="acc-spinner platform-sync-simple-spinner"></div>
