function _gsLooseKey(value) {
    return String(value || '')
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9]/g, '');
}

function _gsAddKey(set, value) {
    const raw = String(value || '').trim().toLowerCase();
    if (raw) set.add(raw);

    const loose = _gsLooseKey(value);
    if (loose) set.add(loose);
}

function _gsCollectAgPatchKeys(game = {}) {
    const keys = new Set();

    [
        game.id,
        game.installedId,
        game.appName,
        game.appid,
        game.appId,
        game.namespace,
        game.catalogNamespace,
        game.catalogItemId,
        game.launcherGameId,
        game.allIds?.steam,
        game.allIds?.epic,
        game.originalName,
        game.originalTitle,
        game.name,
        game.title
    ].forEach(v => _gsAddKey(keys, v));

    [
        game.originalName,
        game.originalTitle,
        game.name,
        game.title
    ].forEach(v => {
        const titleKey = _gsLooseKey(v);
        if (titleKey) keys.add(`title:${titleKey}`);
    });

    return keys;
}

function _gsMatchesAgGame(localGame, agGame) {
    const localKeys = _gsCollectAgPatchKeys(localGame);
    const agKeys = _gsCollectAgPatchKeys(agGame);

    for (const key of agKeys) {
        if (localKeys.has(key)) return true;
    }

    return false;
}

function _gsPatchAllGamesTitleAfterRename(localGame, newName) {
    const patchOne = (game) => {
        if (!game || !_gsMatchesAgGame(localGame, game)) return false;

        game.title = newName;
        game.name = newName;
        game.customTitle = newName;
        game.customTitleLocked = true;
        game.titleSource = 'creator';
        game.titleUpdatedAt = localGame.titleUpdatedAt || Date.now();

        return true;
    };

    let changed = 0;

    if (Array.isArray(window._allGamesCache)) {
        window._allGamesCache.forEach(g => {
            if (patchOne(g)) changed++;
        });
    }

    if (Array.isArray(window._vs?.items)) {
        window._vs.items.forEach(g => {
            if (patchOne(g)) changed++;
        });
    }

    if (window._vs?.cardCache instanceof Map) {
        window._vs.cardCache.clear();
    }

    if (changed > 0 && typeof _applyAgFilters === 'function') {
        try {
            _applyAgFilters({ resetScroll: false });
        } catch (_) {}
    }

    if (changed > 0 && typeof window._vsRender === 'function') {
        try {
            window._vsRender(true);
        } catch (_) {}
    }
}

async function saveGameSettings() {
    if (!selectedGameId) return;

    const g = allGamesData.find(x => String(x.id) === String(selectedGameId));
    if (!g) return;

    const _patch = {};
    const _artworkTs    = Date.now();  // single timestamp for the whole settings save
    const _changedTypes = [];          // tracks which art types were updated (cover/hero/logo)

    // 1. حفظ الاسم الجديد للعبة (لو اتغير)
    const nameInput = document.getElementById('editGameNameInput');
    if (nameInput) {
        const newName = nameInput.value.trim();
        if (newName && newName !== g.name) {
            const oldName = g.name || g.title || '';
            const res = await window.electronAPI.renameGame(selectedGameId, newName);

            if (!g.originalName && oldName && oldName !== newName) {
                g.originalName = oldName;
            }

            g.name = newName;
            g.title = newName;
            g.customTitle = newName;
            g.customTitleLocked = true;
            g.titleSource = 'creator';
            g.titleUpdatedAt = res?.titleUpdatedAt || Date.now();
            _patch.name = newName;

            if (typeof _gsPatchAllGamesTitleAfterRename === 'function') {
                _gsPatchAllGamesTitleAfterRename(g, newName);
            }
        }
    }

    // 2. تطبيق كل تغييرات الصور اللي متسجلة في الـ Draft
    for (const type in pendingImageChanges) {
        const change = pendingImageChanges[type];

        if (change.action === 'update') {
            const res = await window.electronAPI.updateGameImage(selectedGameId, change.path, type);
            localStorage.setItem(`${type}_${selectedGameId}`, change.path);

            if (type === 'cover') {
                g.cover        = change.path;
                g.image        = change.path;
                g.coverUrl     = change.path;
                g.defaultImage = change.path;
                _patch.cover   = change.path;
            }
            if (type === 'hero') {
                g.hero        = change.path;
                g.heroImage   = change.path;
                g.heroUrl     = change.path;
                g.defaultHero = change.path;
                _patch.hero   = change.path;
            }
            if (type === 'logo') {
                g.logo        = change.path;
                g.logoUrl     = change.path;
                g.defaultLogo = change.path;
                _patch.logo   = change.path;
            }

            _changedTypes.push(type);

            // Keep frontend memory in sync immediately.
            // Use artworkSource:'settings' (not 'creator') so Game Detail
            // priority logic knows a newer Settings save overrides older Creator art.
            g.customArtworkLocked = true;
            g.artworkSource    = 'settings';
            g.artworkUpdatedAt = _artworkTs;
        } else if (change.action === 'reset') {
            localStorage.removeItem(`${type}_${selectedGameId}`);
            let restoredPath = null;
            try {
                const res = await window.electronAPI.resetGameImage(selectedGameId, type);
                if (res && res.status === 'success') restoredPath = res.path;
            } catch (err) {
                console.error('Failed to reset in backend:', err);
            }

            if (type === 'cover') {
                g.image        = restoredPath;
                g.coverUrl     = restoredPath;
                g.defaultImage = restoredPath;
            }
            if (type === 'hero') {
                g.heroImage   = restoredPath;
                g.heroUrl     = restoredPath;
                g.defaultHero = restoredPath;
            }
            if (type === 'logo') {
                g.logo        = restoredPath;
                g.logoUrl     = restoredPath;
                g.defaultLogo = restoredPath;
                _patch.logoCleared = true;
            }
        }
    }

    // Propagate changes to all live in-memory stores (sugg rail, _allGamesCache, VS)
    if (Object.keys(_patch).length) {
        if (_changedTypes.length) {
            _patch.artworkSource    = 'settings';
            _patch.artworkUpdatedAt = _artworkTs;
        }
        if (typeof window.__baddelApplyGameCustomOverride === 'function') {
            window.__baddelApplyGameCustomOverride(g, _patch);
        }
        // Clear stale Creator Mode artwork from localStorage customGameDetails so
        // _gdApplyCustomToGame no longer lets old posterImage win over game.image.
        if (_changedTypes.length && typeof window._gdClearCustomDetailArtwork === 'function') {
            window._gdClearCustomDetailArtwork(g, _changedTypes);
        }
        // If Game Detail is open for this game, update _gdCurrentGame and re-render.
        if (typeof window._gdApplyExternalPatch === 'function') {
            window._gdApplyExternalPatch(g, _patch);
        }
    }

    // تنظيف الـ Draft بعد الحفظ
    pendingImageChanges = {};

    // 3. نقفل الـ Modal ونعمل Refresh للمكتبة مرة واحدة بس
    showToast('Settings saved successfully!', 'success');
    refreshAllViews();
    closeGameSettings();
}
</file>

<file path="src/css/accounts.css">
/* ============================================================ */
/* BADDEL LAUNCHER — ACCOUNTS CSS (REDESIGN v3)               */
/* Premium quality. No AI slop.                               */
/* ============================================================ */
@import url('./fonts.css');

/* ============================================================ */
/* 1. SIDEBAR SECTION BUTTONS                                   */
/* ============================================================ */

.sidebar-section-btn {
    height: 44px;
    border-radius: 8px;
    padding: 0 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    margin-bottom: 2px;
    margin-top: 6px;
    position: relative;
    transition: all 0.15s ease;
    color: var(--text-sec);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 1px;
}

.sidebar-section-btn:hover {
    background: rgba(255, 255, 255, 0.04);
    color: #666;
}

.sidebar-section-btn.active {
    background: transparent;
    color: #888;
}

.sidebar-section-btn .nav-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    opacity: 0.7;
}

.section-chevron {
    margin-left: auto;
    font-size: 0.55rem;
    opacity: 0.3;
    transition: transform 0.2s ease;
}

.sidebar.collapsed .section-chevron { display: none; }

/* ============================================================ */
/* 2. SIDEBAR SUB ITEMS                                         */
/* ============================================================ */

.sidebar-sub-items {
    padding-left: 6px;
    border-left: 1px solid rgba(255, 255, 255, 0.04);
    margin-left: 8px;
    margin-bottom: 4px;
}

.sidebar-sub-header {
    margin-top: 16px;
    margin-bottom: 6px;
    padding-left: 14px;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: rgba(255, 255, 255, 0.12);
    text-transform: uppercase;
}

.sidebar.collapsed .sidebar-sub-items {
    padding-left: 0;
    border-left: none;
    margin-left: 0;
}

/* ============================================================ */
/* 3. PLATFORM ITEMS IN SIDEBAR                                 */
/* ============================================================ */

.platform-item {
    position: relative;
}

.platform-count {
    font-size: 0.65rem;
    color: #2a2a2a;
    font-weight: 700;
    margin-left: auto;
    padding: 2px 7px;
    background: transparent;
    border-radius: 20px;
    font-family: var(--font-heading, sans-serif);
    transition: all 0.15s;
    letter-spacing: 0.5px;
}

.platform-item.active .platform-count {
    color: rgba(255, 255, 255, 0.5);
}

.sidebar.collapsed .platform-count { display: none; }

.platform-icon { transition: color 0.15s; }
.steam-icon   { color: #66c0f4; }
.epic-icon    { color: #ffffff; }
.ea-icon      { color: #ff6b35; }
.riot-icon    { color: #ff4655; }
.ubisoft-icon { color: #00a8ff; }
.discord-icon { color: #ffffff; }
.platform-item.active .platform-icon { color: #000000 !important; }

/* ============================================================ */
/* 4. ACCOUNTS VIEW WRAPPER                                     */
/* ============================================================ */

#accountsView {
    height: 100%;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #1e1e1e transparent;
}

#accountsView::-webkit-scrollbar { width: 3px; }
#accountsView::-webkit-scrollbar-track { background: transparent; }
#accountsView::-webkit-scrollbar-thumb { background: #1e1e1e; border-radius: 2px; }

.accounts-page {
    display: flex;
    flex-direction: column;
    min-height: 100%;
}

/* ============================================================ */
/* 5. ACCOUNTS HERO — PREMIUM REDESIGN                          */
/* ============================================================ */

.accounts-hero-v2 {
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    /* CSS custom props injected from JS */
    --plat-color: #0f0f0f;
    --plat-accent: #ffffff;
}

/* ── Diagonal background split ── */
.accounts-hero-v2::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(
        108deg,
        color-mix(in srgb, var(--plat-accent) 6%, #0a0a0a) 0%,
        color-mix(in srgb, var(--plat-accent) 6%, #0a0a0a) 40%,
        #080808 40%
    );
    z-index: 0;
}

/* ── Grid overlay fading left to right ── */
.hero-grid-overlay {
    position: absolute; inset: 0;
    background-image:
        linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
    z-index: 0;
    mask-image: linear-gradient(108deg, black 0%, black 35%, transparent 55%);
    -webkit-mask-image: linear-gradient(108deg, black 0%, black 35%, transparent 55%);
}

/* ── Accent glow (soft, not blinding) ── */
.hero-glow-blob {
    position: absolute;
    background: var(--plat-accent);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
}

.blob-1 {
    top: -60px; left: -60px;
    width: 320px; height: 320px;
    filter: blur(120px);
    opacity: 0.08;
}

.blob-2 {
    bottom: -80px; right: 5%;
    width: 400px; height: 400px;
    filter: blur(150px);
    opacity: 0.04;
}

/* ── Giant watermark text ── */
.hero-watermark {
    position: absolute;
    left: -10px; top: -24px;
    font-family: var(--font-heading, sans-serif);
    font-weight: 900;
    font-size: 180px;
    line-height: 1;
    color: var(--plat-accent);
    opacity: 0.025;
    letter-spacing: -6px;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    white-space: nowrap;
}

/* ── Thin accent line at top ── */
.accounts-hero-v2::after {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(
        90deg,
        transparent 0%,
        color-mix(in srgb, var(--plat-accent) 50%, transparent) 30%,
        color-mix(in srgb, var(--plat-accent) 50%, transparent) 55%,
        transparent 100%
    );
    z-index: 3;
}

/* ── Inner layout ── */
.accounts-hero-content-v2 {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 28px;
    padding: 44px 48px 0 48px;
}

/* ── Logo box ── */
.acc-hero-logo-box {
    width: 92px;
    height: 92px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid color-mix(in srgb, var(--plat-accent) 18%, transparent);
    border-bottom: 3px solid var(--plat-accent);
    border-radius: 18px;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 16px 40px rgba(0,0,0,0.5);
}

/* Glass shimmer inside logo box */
.acc-hero-logo-box::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 45%;
    background: linear-gradient(to bottom, rgba(255,255,255,0.05), transparent);
    z-index: 1;
    pointer-events: none;
}

.acc-hero-main-logo {
    width: 54px;
    height: 54px;
    object-fit: contain;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.4));
}

.invert-hero-logo {
    filter: brightness(0) invert(1) drop-shadow(0 4px 12px rgba(0,0,0,0.4));
}

/* ── Text stack ── */
.acc-hero-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 14px;
}

.acc-hero-platform-eyebrow {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--plat-accent);
    text-transform: uppercase;
    opacity: 0.7;
}

.acc-hero-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 2.8rem;
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 1;
    color: #fff;
    margin: 0;
}

.acc-hero-meta-row {
    display: flex;
    align-items: center;
    gap: 16px;
}

.acc-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: color-mix(in srgb, var(--plat-accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--plat-accent) 18%, transparent);
    color: color-mix(in srgb, var(--plat-accent) 65%, #888);
    padding: 5px 12px;
    border-radius: 5px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    width: fit-content;
}

/* Pulsing dot inside badge */
.pulse-dot-mini {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
    animation: pulseDot 2s infinite ease-in-out;
}

@keyframes pulseDot {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.25; }
}

.acc-hero-stat {
    font-size: 0.72rem;
    color: #444;
    font-weight: 600;
}
.acc-hero-stat strong {
    color: #888;
    font-weight: 700;
}

/* ── Actions (right side) ── */
.accounts-hero-actions-v2 {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 0 48px 24px 48px;
    justify-content: flex-end;
    margin-top: auto;
}

/* Full inner row so content + actions sit side by side */
.accounts-hero-inner-row {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
}

/* ── Tab bar under hero ── */
.acc-hero-tabs {
    position: relative;
    z-index: 2;
    display: flex;
    padding: 0 48px;
    margin-top: 20px;
    border-bottom: 1px solid #161616;
}

.acc-hero-tab {
    padding: 11px 0;
    margin-right: 28px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #2a2a2a;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: all 0.15s;
    text-transform: uppercase;
}

.acc-hero-tab:hover { color: #555; }
.acc-hero-tab.active {
    color: var(--plat-accent);
    border-bottom-color: var(--plat-accent);
}

/* ============================================================ */
/* 6. ACCOUNTS BUTTONS                                          */
/* ============================================================ */

.acc-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    font-family: var(--font-main, sans-serif);
    transition: all 0.15s ease;
    white-space: nowrap;
    letter-spacing: 0.3px;
}

.acc-btn-primary {
    background: var(--btn-accent, #ffffff);
    color: #000;
}

.acc-btn-primary:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
}

.acc-btn-primary:active {
    transform: translateY(0);
}

.acc-btn-secondary {
    background: transparent;
    color: #555;
    border: 1px solid #222;
}

.acc-btn-secondary:hover {
    background: #111;
    border-color: #2e2e2e;
    color: #888;
}

/* ============================================================ */
/* 7. ACCOUNTS LIST SECTION                                     */
/* ============================================================ */

.accounts-list-section {
    padding: 28px 48px;
    flex: 1;
    background: #080808;
}

.accounts-list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}

.accounts-list-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: #555;
    text-transform: uppercase;
}

.accounts-list-count {
    font-size: 0.68rem;
    color: #444;
    font-weight: 700;
    letter-spacing: 0.5px;
    font-family: var(--font-heading, sans-serif);
}

/* ============================================================ */
/* 8. ACCOUNT CARDS                                             */
/* ============================================================ */

.accounts-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.account-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 15px 20px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 10px;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    cursor: default;
    position: relative;
    overflow: hidden;
}

/* Accent bar on the left edge (appears on hover) */
.account-card::before {
    content: '';
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--plat-accent, #fff);
    opacity: 0;
    transition: opacity 0.2s ease;
    border-radius: 0 2px 2px 0;
}

.account-card:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.1);
    transform: translateX(3px);
}

.account-card:hover::before {
    opacity: 1;
}

/* Account number */
.acc-card-num {
    font-family: var(--font-heading, sans-serif);
    font-size: 0.68rem;
    font-weight: 800;
    color: #333;
    width: 22px;
    flex-shrink: 0;
    letter-spacing: 0.5px;
}

/* Avatar */
.acc-card-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--acc-color, var(--plat-accent, #fff)) 80%, #fff);
    flex-shrink: 0;
    transition: all 0.2s ease;
    overflow: hidden;
}

.account-card:hover .acc-card-avatar {
    border-color: color-mix(in srgb, var(--plat-accent, #fff) 30%, transparent);
    background: color-mix(in srgb, var(--plat-accent, #fff) 8%, transparent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--plat-accent, #fff) 20%, transparent);
}

/* Discord avatar is round — keep it perfectly round */
.acc-card-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
}

/* Card info */
.acc-card-info {
    flex: 1;
    min-width: 0;
}

.acc-card-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: #ccc;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 3px;
    letter-spacing: 0.2px;
}

.acc-card-platform {
    font-size: 0.7rem;
    color: #444;
    font-weight: 500;
}

/* Card actions */
.acc-card-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

/* Switch button — juicy, platform-themed */
.acc-switch-btn {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: var(--text-main, #ccc);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    font-family: var(--font-main, sans-serif);
    letter-spacing: 0.3px;
    position: relative;
    overflow: hidden;
}

.acc-switch-btn::before {
    content: '';
    position: absolute; inset: 0;
    background: var(--btn-accent, #ffffff);
    opacity: 0;
    transition: opacity 0.2s ease;
}

.acc-switch-btn:hover {
    border-color: var(--btn-accent, #ffffff);
    color: color-mix(in srgb, var(--btn-accent, #ffffff) 100%, #000);
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--btn-accent, #fff) 25%, transparent),
                0 0 0 1px color-mix(in srgb, var(--btn-accent, #fff) 20%, transparent);
    background: color-mix(in srgb, var(--btn-accent, #ffffff) 12%, transparent);
}

.acc-switch-btn:active {
    transform: translateY(0) scale(0.98);
}

.acc-switch-btn svg {
    transition: transform 0.2s ease;
}

.acc-switch-btn:hover svg {
    transform: rotate(180deg);
}

.acc-switch-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: none !important;
    box-shadow: none !important;
}

/* Rename button */
.acc-rename-btn {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #333;
    cursor: pointer;
    transition: all 0.15s ease;
}

.acc-rename-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: #888;
    transform: scale(1.05);
}

/* Delete button */
.acc-delete-btn {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #333;
    cursor: pointer;
    transition: all 0.15s ease;
}

.acc-delete-btn:hover {
    background: rgba(255, 59, 48, 0.08);
    border-color: rgba(255, 59, 48, 0.25);
    color: #ff3b30;
    transform: scale(1.05);
}

/* ============================================================ */
/* 9. EMPTY STATE & LOADING                                     */
/* ============================================================ */

.accounts-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    gap: 12px;
    text-align: center;
}

.accounts-empty p {
    font-size: 0.9rem;
    font-weight: 600;
    color: #2e2e2e;
}

.accounts-empty span {
    font-size: 0.75rem;
    color: #222;
}

.accounts-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 40px;
    color: #2a2a2a;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.5px;
}

/* ============================================================ */
/* 10. SPINNERS                                                  */
/* ============================================================ */

.acc-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    animation: accSpin 0.7s linear infinite;
}

.acc-mini-spinner {
    width: 11px;
    height: 11px;
    border: 2px solid rgba(0, 0, 0, 0.15);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: accSpin 0.7s linear infinite;
    display: inline-block;
}

@keyframes accSpin {
    to { transform: rotate(360deg); }
}

/* ============================================================ */
/* 11. COLLAPSED SIDEBAR FIXES                                  */
/* ============================================================ */

.sidebar.collapsed .sidebar-sub-items .nav-text,
.sidebar.collapsed .sidebar-section-btn .nav-text,
.sidebar.collapsed .sidebar-sub-header {
    opacity: 0;
    pointer-events: none;
    display: none;
}

.sidebar.collapsed .sidebar-section-btn {
    padding: 0;
    justify-content: center;
    width: 48px;
    height: 48px;
}

.sidebar.collapsed .sidebar-sub-items {
    padding-left: 0;
    border-left: none;
    margin-left: 0;
}

/* ============================================================ */
/* 12. PLATFORM ACTIVE STATES IN SIDEBAR                        */
/* ============================================================ */

#nav-steam.active   { background: #66c0f4 !important; color: #000 !important; }
#nav-steam.active .platform-icon { color: #1b2838 !important; }

#nav-epic.active    { background: #f0f0f0 !important; color: #000 !important; }
#nav-epic.active .platform-icon { color: #000 !important; }
#nav-epic.active img { filter: brightness(0) saturate(100%) !important; }

#nav-ea.active      { background: #ff4545 !important; color: #fff !important; }
#nav-ea.active .platform-icon { color: #fff !important; }

#nav-riot.active    { background: #d32f2e !important; color: #fff !important; }
#nav-riot.active .platform-icon { color: #fff !important; }

#nav-ubisoft.active { background: #00a8ff !important; color: #fff !important; }
