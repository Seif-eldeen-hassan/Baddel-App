    const result = await ipc.handles.get('get-hidden-games')();
    assert.deepEqual(result, []);
});

// ── reorder-library ───────────────────────────────────────────────────────────

test('games.ipc: reorder-library is registered exactly once', () => {
    const ipc = makeFakeIpc();
    gamesIpc.register(ipc, makeDeps());
