        }
    }

    const shortDescSection = document.getElementById('gdShortDescSection');
    const shortDescText = document.getElementById('gdShortDescText');
    
    if (shortDescSection && shortDescText) {
        if (finalDesc) {
            shortDescText.innerHTML = esc(finalDesc);
