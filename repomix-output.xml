/* ============================================================
   ROULETTE RESULT CONTROLS - HERO SAFE BUTTONS
   Fixes Spin Again + Settings visibility over bright hero images
   ============================================================ */

/* خلي منطقة الزراير compact ومش ماسكة عرض كبير */
.roulette-action-panel {
    flex: 0 1 360px;
    max-width: 360px;
    align-items: flex-start;
}

.roulette-controls {
    width: 100%;
    max-width: 320px;
    gap: 10px;
}

.roulette-spin-row {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px;
    gap: 8px;
    align-items: center;
}

/* Spin Again: ثابت، واضح، مش glass شفاف زيادة */
.btn-spin {
    flex: none !important;
    width: 100% !important;
    min-width: 0;
    height: 44px;
    padding: 0 18px;
    border-radius: 13px;
    font-size: 0.88rem;
    font-weight: 800;

    background: rgba(10, 10, 10, 0.74);
    color: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.22);

    box-shadow:
        0 10px 26px rgba(0, 0, 0, 0.38),
