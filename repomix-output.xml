function makeTempDir(prefix = 'baddel-scanner-') {
    return fs.mkdtempSync(path.join(os.tmpdir(), prefix));
}

function makeEngine(options = {}) {
    const dbFolder = makeTempDir();
    return new BaddelEngine({
