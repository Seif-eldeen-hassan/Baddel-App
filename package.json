{
  "name": "baddel-launcher",
  "version": "2.3.0",
  "description": "Baddel Launcher - The AI Powered Gaming Hub",
  "main": "main.js",
  "author": "Baddel Team",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "steamgriddb": "^2.2.1",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.baddel.launcher",
    "productName": "Baddel Launcher",
    "compression": "maximum",
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "Logo.ico"
    },
    "portable": {
      "artifactName": "BaddelLauncher_Portable.exe",
      "requestExecutionLevel": "admin"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "node_modules/**/*",
      "package.json",
      "main.js",
      "preload.js",
      "dashboard.html",
      "gameScanner.js",
      "collectionsHandler.js",
      "assets/**/*",
      "services/**/*",
      "Logo.ico",   
      "!dist",
      "!.git",
      "!.vscode"
    ]
  }
}