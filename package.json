{
  "name": "baddel-launcher",
  "version": "3.1.3",
  "description": "Baddel Launcher - The AI Powered Gaming Hub",
  "main": "main.js",
  "author": "Baddel Team",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "keytar": "^7.9.0",
    "ps-list": "^7.2.0",
    "steamgriddb": "^2.2.1",
    "systeminformation": "^5.31.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.baddel.launcher",
    "productName": "Baddel Launcher",
    "extends": null,
    "asar": true,
    "asarUnpack": [
      "node_modules/ps-list/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Seif-eldeen-hassan",
        "repo": "Baddel-Releases"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "Logo.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "main.js",
      "preload.js",
      "gameScanner.js",
      "collectionsHandler.js",
      "tour.js",
      "dashboard.html",
      "assets/**/*",
      "node_modules/**/*",
      "!dist",
      "!**/*.ts",
      "!.git",
      "!.vscode"
    ]
  }
}